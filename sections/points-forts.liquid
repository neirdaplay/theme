  <g class="pfo-accent-plein"><circle cx="10.7" cy="17.3" r="1.7"/><path d="M19.2 11.4c-.9-1-1.4-2-1.4-3 0-1.3.8-2.5 2.3-3.6-.2 1.5.3 2.4 1 3.2.8.9 1.3 1.8 1.3 2.9a3 3 0 01-5.9.7c.6.4 1.4.4 2.7-.2z"/></g>
