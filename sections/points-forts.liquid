    { "type": "range", "id": "row_gap_mobile", "label": "Espace entre les lignes (mobile)", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "icon_size", "label": "Taille des icônes (bureau)", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "icon_size_mobile", "label": "Taille des icônes (mobile)", "min": 14, "max": 64, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "icon_stroke", "label": "Épaisseur du trait des icônes", "min": 0.6, "max": 3, "step": 0.2, "default": 1.4 },
    { "type": "range", "id": "icon_gap", "label": "Espace icône / texte (bureau)", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "icon_gap_mobile", "label": "Espace icône / texte (mobile)", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "label_size", "label": "Taille du texte (bureau)", "min": 11, "max": 30, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "label_size_mobile", "label": "Taille du texte (mobile)", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 15 },
