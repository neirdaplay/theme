    { "type": "color", "id": "color_text", "label": "Texte des points forts", "default": "#FFFFFF" },
    { "type": "color", "id": "color_ico", "label": "Icônes — trait principal", "default": "#FFFFFF" },
    { "type": "color", "id": "color_accent", "label": "Icônes — accent", "default": "#E8762C" }
