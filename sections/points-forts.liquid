  <g class="pfo-body-plein"><circle cx="6.6" cy="5.1" r="0.62"/><circle cx="9.1" cy="5.1" r="0.62"/></g>
  <g class="pfo-accent"><circle cx="12" cy="14.5" r="4.3"/></g>
  <g class="pfo-accent-plein"><circle cx="12" cy="14.5" r="1.5"/></g>
</svg>
{%- endcapture -%}

