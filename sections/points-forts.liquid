{% comment %}
  points-forts.liquid
  Un bandeau sombre : un titre centré, le produit d'un côté, ses points forts
  de l'autre, chacun porté par une icône.

  Les icônes sont dessinées ici, au trait et en deux tons — un corps neutre,
  un détail accentué. Chaque bloc peut leur préférer une image déposée par le
  marchand ; l'image l'emporte toujours.

  Le visuel du produit déborde du bloc par son côté, d'une valeur réglable et
  distincte sur mobile et sur bureau : c'est ce débordement qui donne au
  produit son échelle sans l'écraser.

  Fichier autonome : styles et comportement sont en ligne, rien à déposer
  dans assets/.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign atouts = section.blocks | where: 'type', 'atout'
-%}

{% style %}
/* ==========================================================================
   Points forts — tout est porté par .pfo
   ========================================================================== */

#shopify-section-{{ section.id }} .pfo {
  --pfo-bg: {{ s.color_bg }};
  --pfo-title: {{ s.color_title }};
  --pfo-text: {{ s.color_text }};
  --pfo-ico: {{ s.color_ico }};
  --pfo-accent: {{ s.color_accent }};

  --pfo-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  display: block;
  background: var(--pfo-bg);
  color: var(--pfo-text);
  font-family: var(--pfo-font);
  -webkit-font-smoothing: antialiased;
}

#shopify-section-{{ section.id }} .pfo *,
#shopify-section-{{ section.id }} .pfo *::before,
#shopify-section-{{ section.id }} .pfo *::after { box-sizing: border-box; }

.pfo__wrap {
  max-width: {{ s.container_width }}px;
  margin-inline: auto;
  /* Le débordement du visuel sort du bloc : sans cette coupe, il ferait
     apparaître une barre de défilement horizontale sur toute la page. */
  overflow: hidden;
  padding: {{ s.padding_top_mobile }}px {{ s.gutter_mobile }}px {{ s.padding_bottom_mobile }}px;
}

.pfo__title {
  max-width: {{ s.titre_max_mobile }}px;
  margin: 0 auto {{ s.titre_gap_mobile }}px;
  color: var(--pfo-title);
  font-size: {{ s.titre_size_mobile }}px;
  font-weight: {{ s.titre_weight }};
  line-height: 1.18;
  text-align: center;
}

/* --------------------------------------------------------------------------
   Les deux colonnes
   -------------------------------------------------------------------------- */

.pfo__grid {
  display: grid;
  grid-template-columns: {{ s.media_width_mobile }}fr {{ 100 | minus: s.media_width_mobile }}fr;
  align-items: {{ s.media_align }};
  gap: {{ s.column_gap_mobile }}px;
}

.pfo__media { min-width: 0; }

.pfo__media img {
  display: block;
  width: 100%;
  height: auto;
}

/* Le visuel sort du bloc par son côté. La largeur est rendue à l'identique,
   si bien que l'image grandit au lieu d'être tirée hors cadre. */
.pfo__media--gauche {
  margin-left: calc({{ s.media_bleed_mobile }}px * -1);
  width: calc(100% + {{ s.media_bleed_mobile }}px);
}

.pfo__media--droite {
  margin-right: calc({{ s.media_bleed_mobile }}px * -1);
  width: calc(100% + {{ s.media_bleed_mobile }}px);
}

/* Visuel à droite : l'ordre du balisage ne change pas, seule la grille
   inverse les colonnes. Le texte reste lu en premier. */
.pfo__grid--droite .pfo__media { grid-column: 2; grid-row: 1; }
.pfo__grid--droite .pfo__list { grid-column: 1; grid-row: 1; }

/* --------------------------------------------------------------------------
   La liste des points forts
   -------------------------------------------------------------------------- */

.pfo__list {
  display: grid;
  align-content: {{ s.list_align }};
  gap: {{ s.row_gap_mobile }}px;
  margin: 0;
  padding: 0;
  list-style: none;
  min-width: 0;
}

.pfo__row {
  display: flex;
  align-items: center;
  gap: {{ s.icon_gap_mobile }}px;
  min-width: 0;
}

.pfo__ico {
  flex: 0 0 auto;
  display: inline-flex;
  width: {{ s.icon_size_mobile }}px;
  height: {{ s.icon_size_mobile }}px;
}

.pfo__ico svg { width: 100%; height: 100%; }
.pfo__ico img { width: 100%; height: 100%; object-fit: contain; }

/* Les deux tons de l'icône. Le corps au trait, l'accent par-dessus ; la
   découpe reprend le fond, ce qui creuse la coche sans la peindre. */
.pfo__ico .pfo-body {
  fill: none;
  stroke: var(--pfo-ico);
  stroke-width: {{ s.icon_stroke }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.pfo__ico .pfo-body-plein { fill: var(--pfo-ico); stroke: none; }

.pfo__ico .pfo-accent {
  fill: none;
  stroke: var(--pfo-accent);
  stroke-width: {{ s.icon_stroke }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.pfo__ico .pfo-accent-plein { fill: var(--pfo-accent); stroke: none; }

.pfo__ico .pfo-cut {
  fill: none;
  stroke: var(--pfo-bg);
  stroke-width: {{ s.icon_stroke | plus: 0.4 }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.pfo__label {
  min-width: 0;
  color: var(--pfo-text);
  font-size: {{ s.label_size_mobile }}px;
  font-weight: {{ s.label_weight }};
  line-height: 1.3;
}

/* --------------------------------------------------------------------------
   Bureau
   -------------------------------------------------------------------------- */

@media screen and (min-width: {{ s.breakpoint }}px) {
  .pfo__wrap {
    padding: {{ s.padding_top }}px {{ s.gutter }}px {{ s.padding_bottom }}px;
  }

  .pfo__title {
    max-width: {{ s.titre_max }}px;
    margin-bottom: {{ s.titre_gap }}px;
    font-size: {{ s.titre_size }}px;
  }

  .pfo__grid {
    grid-template-columns: {{ s.media_width }}fr {{ 100 | minus: s.media_width }}fr;
    gap: {{ s.column_gap }}px;
  }

  .pfo__media--gauche {
    margin-left: calc({{ s.media_bleed }}px * -1);
    width: calc(100% + {{ s.media_bleed }}px);
  }

  .pfo__media--droite {
    margin-right: calc({{ s.media_bleed }}px * -1);
    width: calc(100% + {{ s.media_bleed }}px);
  }

  .pfo__list { gap: {{ s.row_gap }}px; }
  .pfo__row { gap: {{ s.icon_gap }}px; }
  .pfo__ico { width: {{ s.icon_size }}px; height: {{ s.icon_size }}px; }
  .pfo__label { font-size: {{ s.label_size }}px; }
}
{% endstyle %}

{%- comment -%}
  ---------- Les icônes ----------
  Chacune est capturée une fois, puis choisie par bloc. Deux groupes : le
  corps au trait, et l'accent coloré. Aucune couleur n'est écrite ici — tout
  vient de la feuille de style, donc des réglages.
{%- endcomment -%}

{%- capture ico_lave_vaisselle -%}
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
