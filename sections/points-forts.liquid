  <g class="pfo-accent"><path d="M4 20.4L12 12.2"/></g>
</svg>
{%- endcapture -%}

{%- liquid
  assign has_media = false
  if s.image != blank
    assign has_media = true
  endif
-%}

<section class="pfo" {{ section.shopify_attributes }}>
  <div class="pfo__wrap">
    {%- if s.show_title and s.titre != blank -%}
      <h2 class="pfo__title">{{ s.titre }}</h2>
    {%- endif -%}

    <div class="pfo__grid pfo__grid--{{ s.media_side }}">
      {%- if has_media -%}
        <div class="pfo__media pfo__media--{{ s.media_side }}">
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 900, 1200, 1400',
              sizes: '(min-width: 900px) 50vw, 55vw',
              loading: 'lazy',
              alt: s.image_alt
          }}
        </div>
      {%- elsif request.design_mode -%}
        {%- comment -%}
          Sans visuel, la colonne de gauche serait un vide inexpliqué. Dans
          l'éditeur seulement, on dit quoi y mettre.
        {%- endcomment -%}
        <div class="pfo__media pfo__media--{{ s.media_side }}">
          <p class="pfo__label">{{ s.image_todo }}</p>
        </div>
      {%- endif -%}

      <ul class="pfo__list">
        {%- for block in atouts -%}
          {%- liquid
            assign a = block.settings
            case a.icone
              when 'lave_vaisselle'
                assign svg = ico_lave_vaisselle
              when 'temperature'
                assign svg = ico_temperature
              when 'ustensiles'
                assign svg = ico_ustensiles
              when 'sans_pfas'
                assign svg = ico_sans_pfas
              when 'induction'
                assign svg = ico_induction
              when 'garantie'
                assign svg = ico_garantie
              when 'four'
                assign svg = ico_four
              when 'eco'
                assign svg = ico_eco
              else
                assign svg = ''
            endcase
          -%}
          <li class="pfo__row" {{ block.shopify_attributes }}>
            {%- if a.image != blank -%}
              <span class="pfo__ico">
                {{ a.image | image_url: width: 160 | image_tag: widths: '40, 80, 120, 160', loading: 'lazy', alt: '' }}
              </span>
            {%- elsif svg != blank -%}
              <span class="pfo__ico" aria-hidden="true">{{ svg }}</span>
            {%- endif -%}
            {%- if a.texte != blank -%}
              <span class="pfo__label">{{ a.texte }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Points forts",
  "tag": "section",
  "class": "section-points-forts",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "container_width", "label": "Largeur du contenu", "min": 600, "max": 1800, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "breakpoint", "label": "Bascule mobile / bureau", "min": 600, "max": 1200, "step": 10, "unit": "px", "default": 900 },
    {
      "type": "select",
      "id": "media_side",
      "label": "Côté du visuel",
      "options": [
        { "value": "gauche", "label": "À gauche" },
        { "value": "droite", "label": "À droite" }
      ],
      "default": "gauche"
    },
    {
      "type": "select",
      "id": "media_align",
      "label": "Alignement vertical",
      "options": [
        { "value": "center", "label": "Centré" },
        { "value": "start", "label": "En haut" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "media_width", "label": "Largeur du visuel (bureau)", "info": "En % de la largeur du bloc.", "min": 25, "max": 70, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "media_width_mobile", "label": "Largeur du visuel (mobile)", "min": 25, "max": 70, "step": 1, "unit": "%", "default": 45 },
    { "type": "range", "id": "column_gap", "label": "Espace entre les colonnes (bureau)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "column_gap_mobile", "label": "Espace entre les colonnes (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "gutter", "label": "Marge latérale (bureau)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "gutter_mobile", "label": "Marge latérale (mobile)", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top", "label": "Marge haute (bureau)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse (bureau)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Marge haute (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Marge basse (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },

    { "type": "header", "content": "Visuel du produit" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Un PNG à fond transparent donne le meilleur résultat sur un fond sombre." },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "range", "id": "media_bleed", "label": "Débordement (bureau)", "info": "De combien le visuel sort du bloc par son côté.", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "media_bleed_mobile", "label": "Débordement (mobile)", "min": 0, "max": 300, "step": 4, "unit": "px", "default": 80 },
    { "type": "text", "id": "image_todo", "label": "Rappel dans l'éditeur", "default": "Dépose ici le visuel du produit." },

    { "type": "header", "content": "Titre" },
    { "type": "checkbox", "id": "show_title", "label": "Afficher le titre", "default": true },
    { "type": "text", "id": "titre", "label": "Titre", "default": "Conçue pour tout encaisser" },
    { "type": "range", "id": "titre_size", "label": "Taille (bureau)", "min": 16, "max": 64, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "titre_size_mobile", "label": "Taille (mobile)", "min": 14, "max": 48, "step": 1, "unit": "px", "default": 26 },
    {
      "type": "select",
      "id": "titre_weight",
      "label": "Graisse",
      "options": [
        { "value": "500", "label": "Moyenne" },
        { "value": "600", "label": "Demi-grasse" },
        { "value": "700", "label": "Grasse" },
        { "value": "800", "label": "Très grasse" }
      ],
      "default": "800"
