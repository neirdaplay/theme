    { "type": "range", "id": "titre_max", "label": "Largeur maximale (bureau)", "info": "Au-delà, le titre passe à la ligne.", "min": 200, "max": 1200, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "titre_max_mobile", "label": "Largeur maximale (mobile)", "min": 140, "max": 600, "step": 10, "unit": "px", "default": 260 },
