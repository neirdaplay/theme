    { "type": "richtext", "id": "lede_aidante", "label": "Chapô", "default": "<p>[Chapô — avatar aidante — paragraphe 1]</p><p>[Chapô — avatar aidante — paragraphe 2]</p><p>[Chapô — avatar aidante — pile de prix]</p>" },
    { "type": "text", "id": "bascule_aidante", "label": "Ligne de bascule", "default": "[Ligne de bascule — avatar aidante]" },
    { "type": "text", "id": "point1_titre_aidante", "label": "Variante A — titre", "default": "[Variante A — titre — avatar aidante]" },
