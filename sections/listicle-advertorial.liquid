{% comment %}
  listicle-advertorial.liquid
  Page listicle publicitaire.

  Le contenu est unique : la bascule multi-avatars a été retirée. Le paramètre
  d'URL ?a= subsiste pour la seule traçabilité — il n'a plus aucun effet sur
  ce qui s'affiche, il sert à savoir quelle publicité a produit la vente.

  Il reste assaini par liste blanche : sa valeur part dans les attributs de
  commande et dans le dataLayer, elle ne doit donc jamais être arbitraire. La
  liste est éditable dans le schéma, pour ajouter un avatar sans toucher au
  code.

  Trois valeurs reviennent dans plusieurs textes : le prix, la remise et le
  poids. Elles sont sorties en réglages de section et remplacées à l'affichage
  partout où [prix], [remise] et [poids] apparaissent.

  CSS et JS sont en ligne, comme toutes les sections de ce thème : les envois
  de fichiers dans assets/ échouaient. Seuls les deux snippets sont externes.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sizes = section.blocks | where: 'type', 'size'

  comment
    Compteur d'images : la première grande image de la page est chargée en
    priorité, toutes les suivantes en différé.
  endcomment
  assign img_seen = 0
  assign point_i = 0
-%}

{% style %}
/* ==========================================================================
   Listicle publicitaire — tout est porté par .lad
   ========================================================================== */

/* Les variables sont posées à la fois sur la section et sur la barre : celle-ci
   est déplacée dans <body> au chargement et perd alors l'héritage. */
#shopify-section-{{ section.id }} .lad,
#lad-sticky-{{ section.id }} {
  --lad-bg: {{ s.color_bg }};
  --lad-ink: {{ s.color_text }};
  --lad-accent: {{ s.color_accent }};
  --lad-muted: {{ s.color_muted }};
  --lad-cta-bg: {{ s.color_cta_bg }};
  --lad-cta-ink: {{ s.color_cta_text }};
  --lad-sticky-bg: {{ s.color_sticky_bg }};
  --lad-sticky-ink: {{ s.color_sticky_text }};
  --lad-pill-bg: {{ s.color_pill_bg }};
  --lad-pill-ink: {{ s.color_pill_text }};
  --lad-card-bg: {{ s.color_card_bg }};
  --lad-h1-accent: {{ s.color_h1_accent }};
  {%- comment -%}
    L'interligne est réglé en pourcentage entier : Shopify refuse un pas de
    curseur inférieur au dixième, et les décimales d'un curseur sont une
    source d'erreurs à l'enregistrement. On divise ici.
  {%- endcomment -%}
  --lad-lead: {{ s.line_height | divided_by: 100.0 }};
  --lad-cta-fit: {{ s.cta_media_fit }};
  --lad-cta-pad: {% if s.cta_media_fit == 'cover' %}0{% else %}28px{% endif %};
  --lad-panel-bg: {{ s.color_panel_bg }};
  --lad-line: color-mix(in srgb, {{ s.color_text }} 14%, transparent);
  --lad-check: {{ s.color_check }};
  /* Le gras est plus foncé que le texte courant : c'est ce qui le fait
     ressortir sans changer de graisse. La variable était appelée sans être
     définie, la déclaration était donc simplement ignorée. */
  --lad-strong: {{ s.color_strong }};

  --lad-max: {{ s.container_width }}px;
  --lad-size: {{ s.font_size }}px;
  --lad-media-col: {{ s.point_media_width }}%;
  --lad-point-gap: {{ s.point_column_gap }}px;
  --lad-point-space: {{ s.point_space }}px;

  --lad-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  background: var(--lad-bg);
  color: var(--lad-ink);
  font-family: var(--lad-font);
  /* Audience 45-65 ans : la base ne descend pas sous 17 px. */
  font-size: var(--lad-size);
  line-height: var(--lad-lead);
  -webkit-font-smoothing: antialiased;
}

#shopify-section-{{ section.id }} .lad *,
#shopify-section-{{ section.id }} .lad *::before,
#shopify-section-{{ section.id }} .lad *::after {
  box-sizing: border-box;
}

.lad__wrap {
  max-width: var(--lad-max);
  margin-inline: auto;
  padding: 24px 18px 56px;
}

/* --------------------------------------------------------------------------
   Barre haute
   -------------------------------------------------------------------------- */

/* La barre est déplacée dans <body> au chargement. Un ancêtre porteur d'un
   `transform`, d'un `filter` ou d'un `will-change` suffit à faire de
   `position: fixed` un positionnement relatif à cet ancêtre : la barre se
   posait alors sur le titre au lieu de coiffer la fenêtre. Beaucoup de thèmes
   animent leurs sections à l'apparition, c'est donc un piège courant.
   Rattachée au corps du document, plus rien ne peut s'interposer. */
.lad__sticky {
  position: fixed;
  inset: 0 0 auto;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  padding: 9px 14px;
  background: var(--lad-sticky-bg);
  color: var(--lad-sticky-ink);
  font-family: var(--lad-font);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  text-align: center;
  transform: translateY(-100%);
  transition: transform 0.22s ease;
}

.lad__sticky.is-on { transform: none; }

.lad__sticky-clock {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-variant-numeric: tabular-nums;
}

/* Affichage en pavés, comme sur la référence : deux chiffres et leur libellé. */
.lad__clock-cell {
  display: inline-grid;
  justify-items: center;
  min-width: 34px;
  padding: 3px 6px;
  border-radius: 5px;
  background: color-mix(in srgb, var(--lad-sticky-ink) 18%, transparent);
  line-height: 1.05;
}

.lad__clock-cell b { font-size: 14px; font-weight: 700; }
.lad__clock-cell span { font-size: 8px; font-weight: 600; opacity: 0.75; }

.lad__clock-sep { opacity: 0.5; }

/* Réservé aux lecteurs d'écran : le compte à rebours visuel bat à la seconde,
   celui-ci n'est mis à jour qu'une fois par minute pour ne pas noyer
   l'utilisatrice sous les annonces. */
.lad__sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* --------------------------------------------------------------------------
   Titre, chapô, encadré, ligne de bascule
   -------------------------------------------------------------------------- */

.lad__h1 {
  margin: 0 0 18px;
  font-size: calc(var(--lad-size) * 1.75);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.015em;
}

/* Le passage encadré de <b> prend la seconde couleur. Un seul champ suffit
   donc au titre bicolore, et le marchand choisit lui-même où la bascule se
   fait — pas de découpe imposée en deux réglages. */
.lad__h1 b {
  color: var(--lad-h1-accent);
  font-weight: inherit;
}

.lad__lede { margin: 0 0 22px; }
.lad__lede p { margin: 0 0 1.25em; }
.lad__lede > *:last-child { margin-bottom: 0; }
.lad__lede ul { margin: 0 0 1.25em; padding-left: 1.2em; }
.lad__lede li { margin-bottom: 0.5em; }

/* Les mots importants ressortent partout de la même façon. */
.lad__lede strong,
.lad__lede b,
.lad__point-text strong,
.lad__point-text b {
  color: var(--lad-strong);
  font-weight: 700;
}

.lad__note {
  margin: 0 0 20px;
  padding: 14px 16px;
  border-left: 4px solid var(--lad-accent);
  border-radius: 0 8px 8px 0;
  background: color-mix(in srgb, var(--lad-accent) 8%, transparent);
  font-weight: 600;
}

.lad__bascule {
  margin: 0 0 22px;
  font-size: calc(var(--lad-size) * 1.1);
  font-weight: 700;
  line-height: 1.35;
}

/* --------------------------------------------------------------------------
   Badge auteur
   -------------------------------------------------------------------------- */

/* Carte encadrée plutôt qu'une ligne entre deux filets : c'est ce qui donne
   à la signature son air de mention vérifiée. */
.lad__author {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 34px;
  padding: 12px 14px;
  border: 1px solid var(--lad-line);
  border-radius: 12px;
  background: var(--lad-card-bg);
}

.lad__author-photo {
  flex: 0 0 auto;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  overflow: hidden;
  background: color-mix(in srgb, var(--lad-ink) 8%, transparent);
}

.lad__author-photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lad__author-name {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: calc(var(--lad-size) * 0.94);
  font-weight: 700;
}

.lad__author-check {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px 2px 6px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--lad-check) 12%, transparent);
  color: var(--lad-check);
  font-size: calc(var(--lad-size) * 0.76);
  font-weight: 700;
}

.lad__author-check svg { width: 1.1em; height: 1.1em; fill: currentColor; }

.lad__author-role {
  color: var(--lad-accent);
  font-weight: 600;
  font-size: calc(var(--lad-size) * 0.84);
  line-height: 1.3;
}

/* --------------------------------------------------------------------------
   Points numérotés
   -------------------------------------------------------------------------- */

.lad__point { margin: 0 0 var(--lad-point-space); }

.lad__point-head { margin: 0 0 14px; }

.lad__point-title {
  margin: 0;
  font-size: calc(var(--lad-size) * 1.32);
  font-weight: 700;
  line-height: 1.26;
  letter-spacing: -0.01em;
}

/* Numéro dans le fil du titre — « 4. Titre » — comme sur la référence. */
.lad__point-num { color: inherit; }

/* L'autre traitement : un gros chiffre coloré détaché du titre. */
.lad__point--bignum .lad__point-head {
  display: flex;
  align-items: baseline;
  gap: 12px;
}

.lad__point--bignum .lad__point-num {
  flex: 0 0 auto;
  color: var(--lad-accent);
  font-size: calc(var(--lad-size) * 2.2);
  font-weight: 700;
  line-height: 1;
}

/* Rapport imposé et recadrage par le centre : les photos du marchand
   n'auront pas toutes le même format, et sans cela chaque point prenait une
   hauteur différente. Le rapport étant fixé, la place est réservée avant le
   chargement : aucun décalage de mise en page. */
.lad__point-media {
  margin: 0 0 16px;
  aspect-ratio: 100 / {{ s.point_media_ratio }};
}

.lad__point-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 12px;
}

.lad__point-text p { margin: 0 0 1.25em; }
.lad__point-text > *:last-child { margin-bottom: 0; }

.lad__micro {
  display: inline-block;
  margin-top: 12px;
  /* Zone tactile de 44 px obtenue par le rembourrage, pas par l'interligne :
     un interligne de 44 px écartelait le lien dès qu'il passait sur deux
     lignes, ce qui arrive sur toutes les colonnes étroites. */
  padding: 11px 0;
  min-height: 44px;
  line-height: 1.4;
  color: var(--lad-accent);
  font-size: calc(var(--lad-size) * 0.94);
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   Blocs CTA
   -------------------------------------------------------------------------- */

.lad__cta {
  position: relative;
  margin: 0 0 38px;
  border: 1px solid var(--lad-line);
  border-radius: 16px;
  background: var(--lad-card-bg);
  text-align: center;
}

/* Le panneau du visuel a son propre fond : c'est lui qui donne à la carte ses
   deux moitiés. Sur mobile il coiffe la carte, sur bureau il l'habille à
   gauche. Les rayons sont posés côté par côté plutôt qu'avec overflow:hidden,
   qui couperait la pastille débordant du bord haut. */
.lad__cta-media {
  margin: 0;
  padding: var(--lad-cta-pad);
  border-radius: 15px 15px 0 0;
  background: var(--lad-panel-bg);
  overflow: hidden;
}

.lad__cta-media img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: var(--lad-cta-fit);
}

.lad__cta-body { padding: 24px 18px; }

.lad__cta-pill {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  display: inline-block;
  padding: 7px 16px;
  border-radius: 999px;
  background: var(--lad-pill-bg);
  color: var(--lad-pill-ink);
  font-size: calc(var(--lad-size) * 0.74);
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1.2;
  white-space: nowrap;
}

.lad__cta-over {
  display: block;
  margin: 0 0 6px;
  color: var(--lad-muted);
  font-size: calc(var(--lad-size) * 0.78);
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

/* Le passage mis en gras par le marchand prend la couleur d'accent : c'est
   le titre à deux tons de la référence, sans champ supplémentaire. */
.lad__cta-title b { color: var(--lad-accent); }

.lad__cta-title {
  margin: 0 0 10px;
  font-size: calc(var(--lad-size) * 1.3);
  font-weight: 700;
  line-height: 1.22;
}

.lad__cta-text { margin: 0 0 14px; }
.lad__cta-text p { margin: 0 0 0.7em; }
.lad__cta-text > *:last-child { margin-bottom: 0; }

.lad__cta-list {
  margin: 0 0 16px;
  padding: 0;
  list-style: none;
  text-align: left;
}

.lad__cta-list li {
  position: relative;
  margin-bottom: 8px;
  padding-left: 26px;
  font-size: calc(var(--lad-size) * 0.94);
}

.lad__cta-list li::before {
  content: "";
  position: absolute;
  top: 0.45em;
  left: 4px;
  width: 10px;
  height: 6px;
  border-left: 2px solid var(--lad-cta-bg);
  border-bottom: 2px solid var(--lad-cta-bg);
  transform: rotate(-45deg);
}

.lad__cta-clock {
  margin: 0 0 12px;
  font-size: calc(var(--lad-size) * 0.94);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.lad__btn {
  display: block;
  width: 100%;
  min-height: 54px;
  padding: 15px 20px;
  border: 0;
  border-radius: 999px;
  background: var(--lad-cta-bg);
  color: var(--lad-cta-ink);
  font-family: inherit;
  font-size: calc(var(--lad-size) * 1.02);
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}

.lad__cta-line {
  margin: 14px 0 0;
  padding: 10px 0;
  border-block: 1px solid var(--lad-line);
  font-size: calc(var(--lad-size) * 0.86);
  font-weight: 600;
}

.lad__cta-sub {
  margin: 12px 0 0;
  color: var(--lad-muted);
  font-size: calc(var(--lad-size) * 0.84);
}

/* --------------------------------------------------------------------------
   Sélecteur de pointure
   -------------------------------------------------------------------------- */

.lad__finder {
  margin: 0 0 38px;
  padding: 20px 18px;
  border: 1px solid color-mix(in srgb, var(--lad-ink) 14%, transparent);
  border-radius: 16px;
}

.lad__finder-title {
  margin: 0 0 8px;
  font-size: calc(var(--lad-size) * 1.2);
  font-weight: 700;
}

.lad__finder-intro { margin: 0 0 16px; }
.lad__finder-intro p { margin: 0 0 0.7em; }

.lad__finder-fields {
  display: grid;
  gap: 14px 18px;
  margin: 0 0 18px;
}

/* Les deux libellés n'ont pas la même hauteur — « (facultatif) » fait passer
   le second sur deux lignes. Sans cela les champs se retrouvaient à des
   hauteurs différentes : la colonne pousse donc le champ vers le bas. */
.lad__field {
  display: flex;
  flex-direction: column;
}

.lad__field .lad__input-wrap { margin-top: auto; }

.lad__label {
  display: block;
  margin: 0 0 6px;
  font-size: calc(var(--lad-size) * 0.94);
  font-weight: 600;
}

.lad__optional {
  color: var(--lad-muted);
  font-weight: 500;
}

.lad__input-wrap { position: relative; }

.lad__input {
  width: 100%;
  min-height: 52px;
  /* Les flèches natives du champ numérique n'apparaissent que sur celui qui a
     le focus, ce qui décalait « cm » et donnait deux champs d'aspect
     différent. On les retire, la saisie au clavier suffit. */
  appearance: textfield;
  -moz-appearance: textfield;
  padding: 12px 46px 12px 14px;
  border: 1px solid color-mix(in srgb, var(--lad-ink) 28%, transparent);
  border-radius: 10px;
  background: #fff;
  color: var(--lad-ink);
  font-family: inherit;
  /* 16 px minimum, sinon iOS zoome à la mise au point du champ. */
  font-size: max(16px, calc(var(--lad-size) * 0.98));
}

.lad__input::-webkit-outer-spin-button,
.lad__input::-webkit-inner-spin-button {
  appearance: none;
  -webkit-appearance: none;
  margin: 0;
}

.lad__unit {
  position: absolute;
  top: 50%;
  right: 14px;
  transform: translateY(-50%);
  color: var(--lad-muted);
  font-size: calc(var(--lad-size) * 0.9);
}

.lad__finder-out {
  margin: 16px 0 0;
  padding: 14px 16px;
  border-radius: 12px;
  background: color-mix(in srgb, var(--lad-accent) 10%, transparent);
  font-weight: 600;
}

.lad__finder-out[hidden] { display: none; }

.lad__help { margin: 16px 0 0; }

.lad__help-sum {
  padding: 11px 0;
  min-height: 44px;
  line-height: 1.4;
  color: var(--lad-accent);
  font-size: calc(var(--lad-size) * 0.9);
  font-weight: 600;
  cursor: pointer;
}

.lad__help-body {
  padding-top: 6px;
  color: var(--lad-muted);
  font-size: calc(var(--lad-size) * 0.9);
}

/* --------------------------------------------------------------------------
   Comparatif
   -------------------------------------------------------------------------- */

.lad__compare { margin: 0 0 38px; }

.lad__compare-title {
  margin: 0 0 12px;
  font-size: calc(var(--lad-size) * 1.2);
  font-weight: 700;
}

.lad__compare-table {
  width: 100%;
  border-collapse: collapse;
  font-size: calc(var(--lad-size) * 0.92);
}

.lad__compare-table th,
.lad__compare-table td {
  padding: 10px 8px;
  border-bottom: 1px solid color-mix(in srgb, var(--lad-ink) 12%, transparent);
  text-align: left;
  vertical-align: top;
}

.lad__compare-table th { font-weight: 700; }
.lad__compare-table td:not(:first-child) { text-align: center; }

/* --------------------------------------------------------------------------
   Clôture
   -------------------------------------------------------------------------- */

.lad__close { margin: 44px 0 0; }

.lad__close-title {
  margin: 0 0 12px;
  font-size: calc(var(--lad-size) * 1.35);
  font-weight: 700;
  line-height: 1.24;
  text-align: center;
}

.lad__close-sub {
  margin: 0 0 20px;
  color: var(--lad-muted);
  text-align: center;
}

/* --------------------------------------------------------------------------
   Bureau : l'image passe à gauche du texte, le reste reste une colonne.
   -------------------------------------------------------------------------- */

@media screen and (min-width: 760px) {
  .lad__wrap { padding: 36px 24px 80px; }
  .lad__h1 { font-size: calc(var(--lad-size) * 2.3); }
  .lad__btn { display: inline-block; width: auto; min-width: 320px; }
  .lad__finder-fields { grid-template-columns: 1fr 1fr; }
  .lad__btn--finder { min-width: 260px; }

  /* Trois rangées, dont la dernière absorbe le surplus : sans ce 1fr, la
     hauteur de l'image se répartirait entre les rangées qu'elle traverse et
     décollerait le titre de son texte. */
  .lad__point {
    display: grid;
    grid-template-columns: var(--lad-media-col) 1fr;
    grid-template-rows: auto auto 1fr;
    column-gap: var(--lad-point-gap);
    row-gap: 0;
  }

  .lad__point-media {
    grid-column: 1;
    grid-row: 1 / span 3;
    margin: 0;
    align-self: {{ s.point_media_align }};
  }

  {%- if s.point_media_align == 'stretch' %}
  /* Étirée, l'image prend la hauteur du titre et du texte réunis : c'est ce
     qui fait lire le point comme une section image + texte plutôt que comme
     une vignette posée à côté d'un paragraphe. Le rapport imposé doit alors
     s'effacer, sinon il rendrait la hauteur à nouveau fixe. */
  .lad__point-media {
    aspect-ratio: auto;
    min-height: {{ s.point_media_min }}px;
  }

  .lad__point-media img { height: 100%; }
  {%- endif %}

  .lad__point-head { grid-column: 2; grid-row: 1; }
  .lad__point-text { grid-column: 2; grid-row: 2; }
  .lad__micro { grid-column: 2; grid-row: 3; align-self: start; }

  /* Un point sans image reprend toute la largeur. */
  .lad__point--nomedia { display: block; }

  /* Carte en deux panneaux : le visuel à gauche sur son propre fond, le texte
     à droite sur le fond de la carte. `stretch` donne au panneau la hauteur
     entière — c'est ce qui fait que le visuel « fait la taille de la carte ». */
  .lad__cta--split {
    display: flex;
    align-items: stretch;
    padding: 0;
  }

  .lad__cta--split .lad__cta-media {
    flex: 0 0 {{ s.cta_media_width }}%;
    padding: var(--lad-cta-pad);
    border-radius: 15px 0 0 15px;
    /* La grille donne au visuel une zone aux deux dimensions connues : il peut
       alors occuper tout le panneau. `height: 100%` seul ne résolvait rien,
       faute de hauteur définie sur le parent. */
    display: grid;
    place-items: stretch;
    overflow: hidden;
  }

  /* « Remplir » convient à une photo d'ambiance, qu'on peut rogner ; « en
     entier » à un packshot, qu'on ne peut pas. */
  .lad__cta--split .lad__cta-media img {
    width: 100%;
    height: 100%;
    object-fit: var(--lad-cta-fit);
  }

  .lad__cta--split .lad__cta-body {
    flex: 1 1 auto;
    padding: 34px 32px;
  }

  .lad__cta--split .lad__btn { width: 100%; min-width: 0; }

  /* Sans visuel, l'enveloppe occupe seule toute la carte. */
  .lad__cta--split.lad__cta--nomedia { display: block; }

  /* Image à droite : les colonnes s'échangent, l'ordre du DOM ne bouge pas. */
  .lad__point--rev { grid-template-columns: 1fr var(--lad-media-col); }
  .lad__point--rev .lad__point-media { grid-column: 2; }
  .lad__point--rev .lad__point-head,
  .lad__point--rev .lad__point-text,
  .lad__point--rev .lad__micro { grid-column: 1; }
}
{% endstyle %}

<section
  class="lad"
  id="lad-{{ section.id }}"
  data-lad
  data-lad-avatar="{{ s.default_avatar }}"
  data-lad-allowed="{{ s.avatar_allowed | escape }}"
  data-lad-hours="{{ s.countdown_hours }}"
  data-lad-key="lad-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {%- comment -%}
    Résolution de l'avatar, pour la seule traçabilité : ?a= puis session puis
    cookie puis le défaut rendu par le serveur. La liste blanche sert aussi de
    source des valeurs — la fonction renvoie l'entrée trouvée, jamais la
    chaîne reçue. Rien venant de l'URL n'atteint donc le DOM.
  {%- endcomment -%}
  <script>
    (function () {
      var root = document.currentScript.parentNode;
      var OK = (root.getAttribute('data-lad-allowed') || '')
        .split(',')
        .map(function (v) { return v.trim().toLowerCase(); })
        .filter(Boolean);

      function clean(v) {
        if (typeof v !== 'string') return null;
        var i = OK.indexOf(v.trim().toLowerCase());
        return i === -1 ? null : OK[i];
      }

      function fromCookie() {
        var m = document.cookie.match(/(?:^|;\s*)lad_avatar=([^;]*)/);
        return m ? clean(decodeURIComponent(m[1])) : null;
      }

      var fromUrl = null;
      try {
        fromUrl = clean(new URLSearchParams(window.location.search).get('a'));
      } catch (e) {}

      var stored = null;
      try {
        stored = clean(window.sessionStorage.getItem('lad_avatar'));
      } catch (e) {}

      var chosen =
        fromUrl || stored || fromCookie() || clean(root.getAttribute('data-lad-avatar')) || OK[0] || '';

      root.setAttribute('data-lad-avatar', chosen);
      document.documentElement.setAttribute('data-avatar', chosen);

      try {
        window.sessionStorage.setItem('lad_avatar', chosen);
      } catch (e) {}
      try {
        var exp = new Date(Date.now() + 30 * 864e5).toUTCString();
        document.cookie =
          'lad_avatar=' + encodeURIComponent(chosen) + ';expires=' + exp + ';path=/;SameSite=Lax';
      } catch (e) {}
    })();
  </script>

  {%- if s.show_sticky and s.sticky_text != blank -%}
    <div class="lad__sticky" id="lad-sticky-{{ section.id }}" data-lad-sticky>
      <span>{{ s.sticky_text | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</span>
      {%- if s.sticky_countdown -%}
        <span
          class="lad__sticky-clock"
          data-lad-clock
          data-lad-clock-style="{{ s.countdown_style }}"
          data-lad-clock-labels="{{ s.countdown_labels | escape }}"
          data-lad-clock-end="{{ s.countdown_end_text | escape }}"
        >
          <span data-lad-clock-value>--h --m --s</span>
        </span>
        {%- comment -%}
          Une seule source d'annonce pour toute la page, rafraîchie à la
          minute : aria-live sur un compteur à la seconde rendrait la page
          inutilisable au lecteur d'écran.
        {%- endcomment -%}
        <span class="lad__sr" aria-live="polite" data-lad-clock-sr></span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="lad__wrap">
    {%- if s.h1 != blank -%}
      <h1 class="lad__h1">{{ s.h1 | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</h1>
    {%- endif -%}

    {%- if s.lede != blank -%}
      <div class="lad__lede">{{ s.lede | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</div>
    {%- endif -%}

    {%- if s.note != blank -%}
      <p class="lad__note">{{ s.note | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</p>
    {%- endif -%}

    {%- if s.bascule != blank -%}
      <p class="lad__bascule">{{ s.bascule | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</p>
    {%- endif -%}

    {%- if s.show_author and s.author_name != blank -%}
      <div class="lad__author">
        {%- comment -%}
          La photo d'auteur ne compte pas dans `img_seen` : 48 px de côté, ce
          n'est jamais le plus grand élément affiché, et lui donner la priorité
          la retirait à la première image de point, seule candidate au LCP.
        {%- endcomment -%}
        {%- if s.author_image != blank -%}
          <span class="lad__author-photo">
            {{
              s.author_image
              | image_url: width: 160
              | image_tag: widths: '48, 96, 160', loading: 'eager', alt: s.author_image_alt
            }}
          </span>
        {%- endif -%}
        <span>
          <span class="lad__author-name">
            {{ s.author_name }}
            {%- if s.author_verified and s.author_verified_label != blank -%}
              <span class="lad__author-check">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm-1.1 14.6l-4-4 1.5-1.5 2.5 2.5 5.2-5.2 1.5 1.5-6.7 6.7z"/></svg>
                {{ s.author_verified_label }}
              </span>
            {%- endif -%}
          </span>
          {%- if s.author_role != blank -%}
            <span class="lad__author-role">{{ s.author_role }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- comment -%}
      ---------- Blocs ----------
      L'ordre de l'éditeur fait foi : rien n'est réordonné au rendu. Les blocs
      `size` ne s'affichent pas ici, ils alimentent le sélecteur de pointure.
    {%- endcomment -%}
    {%- assign cta_seen = 0 -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'point' -%}
          {%- liquid
            assign b = block.settings
            assign point_i = point_i | plus: 1

            comment
              Côté de l'image. « Alterner » fait basculer un point sur deux,
              ce qui donne la succession de sections image + texte voulue.
            endcomment
            assign reversed = false
            if s.point_media_side == 'right'
              assign reversed = true
            elsif s.point_media_side == 'alternate'
              assign parity = point_i | modulo: 2
              if parity == 0
                assign reversed = true
              endif
            endif
          -%}
          <article
            class="lad__point{% if b.image == blank %} lad__point--nomedia{% endif %}{% if reversed %} lad__point--rev{% endif %}{% if s.point_number_style == 'big' %} lad__point--bignum{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if b.numero != blank or b.titre != blank -%}
              <div class="lad__point-head">
                {%- if s.point_number_style == 'big' -%}
                  {%- if b.numero != blank -%}
                    <span class="lad__point-num">{{ b.numero }}</span>
                  {%- endif -%}
                  {%- if b.titre != blank -%}
                    <h2 class="lad__point-title">{{ b.titre | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</h2>
                  {%- endif -%}
                {%- else -%}
                  {%- comment -%}
                    Le numéro entre dans le fil du titre — « 4. Titre ». Le
                    point final est ajouté ici, et retiré au préalable pour ne
                    pas en obtenir deux si le marchand l'a déjà saisi.
                  {%- endcomment -%}
                  <h2 class="lad__point-title">
                    {%- if b.numero != blank -%}
                      <span class="lad__point-num">{{ b.numero | strip | replace: '.', '' }}.</span>
                      {{ ' ' }}
                    {%- endif -%}
                    {%- if b.titre != blank -%}
                      {{ b.titre | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}
                    {%- endif -%}
                  </h2>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if b.image != blank -%}
              {%- assign img_seen = img_seen | plus: 1 -%}
              <div class="lad__point-media">
                {%- if img_seen == 1 -%}
                  {{
                    b.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '360, 540, 720, 1080, 1200',
                      sizes: '(min-width: 760px) 40vw, 92vw',
                      loading: 'eager',
                      fetchpriority: 'high',
                      alt: b.image_alt
                  }}
                {%- else -%}
                  {{
                    b.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '360, 540, 720, 1080, 1200',
                      sizes: '(min-width: 760px) 40vw, 92vw',
                      loading: 'lazy',
                      alt: b.image_alt
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if b.texte != blank -%}
              <div class="lad__point-text">{{ b.texte | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</div>
            {%- endif -%}

            {%- comment -%}
              Le micro-lien retombe sur la destination des boutons quand aucune
              adresse propre n'est saisie, sinon le texte resterait invisible.
              Il porte data-lad-go pour recevoir, lui aussi, l'avatar et les
              UTM : sans cela un clic ici perdait toute l'attribution.
            {%- endcomment -%}
            {%- if b.micro_lien_texte != blank -%}
              {%- assign micro_url = b.micro_lien_url | default: s.cta_url -%}
              {%- if micro_url != blank -%}
                <a class="lad__micro" href="{{ micro_url }}" data-lad-go="micro_{{ b.numero | default: forloop.index }}">
                  {{ b.micro_lien_texte }}
                </a>
              {%- endif -%}
            {%- endif -%}
          </article>

        {%- when 'cta' -%}
          {%- assign cta_seen = cta_seen | plus: 1 -%}
          {%- capture cta_position -%}cta_{{ cta_seen }}{%- endcapture -%}
          <div {{ block.shopify_attributes }}>
            {%- render 'listicle-cta-block',
              position: cta_position,
              layout: s.cta_layout,
              produit: block.settings.produit,
              pastille: block.settings.pastille,
              surtitre: block.settings.surtitre,
              titre: block.settings.titre,
              texte: block.settings.texte,
              puces: block.settings.puces,
              bouton: block.settings.bouton,
              ligne: block.settings.ligne,
              sous_texte: block.settings.sous_texte,
              url: s.cta_url,
              image: block.settings.image,
              image_alt: block.settings.image_alt,
              compteur: block.settings.compteur,
              compteur_fin: s.countdown_end_text,
              compteur_style: s.countdown_style,
              compteur_labels: s.countdown_labels,
              prix: s.prix,
              remise: s.remise,
              poids: s.poids
            -%}
          </div>

        {%- when 'size_finder' -%}
          <div {{ block.shopify_attributes }}>
            {%- render 'listicle-size-finder', block: block, sizes: sizes -%}
          </div>

        {%- when 'comparatif' -%}
          {%- liquid
            assign c = block.settings
            assign rows = c.lignes | strip | newline_to_br | split: '<br />'
          -%}
          <div class="lad__compare" {{ block.shopify_attributes }}>
            {%- if c.titre != blank -%}
              <p class="lad__compare-title">{{ c.titre }}</p>
            {%- endif -%}
            {%- if c.lignes != blank -%}
              <table class="lad__compare-table">
                <thead>
                  <tr>
                    <th scope="col">{{ c.col_critere }}</th>
                    <th scope="col">{{ c.col_a }}</th>
                    <th scope="col">{{ c.col_b }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for row in rows -%}
                    {%- assign cells = row | split: '|' -%}
                    {%- if cells.size > 1 -%}
                      <tr>
                        <th scope="row">{{ cells[0] | strip }}</th>
                        <td>{{ cells[1] | strip }}</td>
                        <td>{{ cells[2] | strip }}</td>
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- if s.close_title != blank or s.close_button != blank -%}
      <div class="lad__close">
        {%- if s.close_title != blank -%}
          <p class="lad__close-title">{{ s.close_title | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</p>
        {%- endif -%}
        {%- if s.close_sub != blank -%}
          <p class="lad__close-sub">{{ s.close_sub | replace: '[prix]', s.prix | replace: '[remise]', s.remise | replace: '[poids]', s.poids }}</p>
        {%- endif -%}
        {%- render 'listicle-cta-block',
          position: 'cta_final',
          layout: s.cta_layout,
          produit: s.close_produit,
          pastille: s.close_pastille,
          surtitre: s.close_surtitre,
          titre: s.close_cta_title,
          texte: s.close_cta_text,
          puces: s.close_bullets,
          bouton: s.close_button,
          ligne: s.close_line,
          sous_texte: s.close_note,
          url: s.cta_url,
          image: s.close_image,
          image_alt: s.close_image_alt,
          compteur: s.close_countdown,
          compteur_fin: s.countdown_end_text,
          compteur_style: s.countdown_style,
          compteur_labels: s.countdown_labels,
          prix: s.prix,
          remise: s.remise,
          poids: s.poids
        -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('lad-{{ section.id }}');
    if (!root || root.dataset.ladReady === '1') return;
    root.dataset.ladReady = '1';

    var avatar = root.getAttribute('data-lad-avatar');

    /* ---------------------------------------------------------------- *
     * Mesure — dataLayer et pixel Meta
     * ---------------------------------------------------------------- */

    window.dataLayer = window.dataLayer || [];

    function push(payload) {
      payload.avatar = avatar;
      try {
        window.dataLayer.push(payload);
      } catch (e) {}
    }

    push({ event: 'avatar_view' });

    /* ---------------------------------------------------------------- *
     * Compte à rebours — une seule horloge pour toute la page
     * ---------------------------------------------------------------- */

    /* La barre haute quitte la section pour le corps du document. Un ancêtre
       porteur d'un `transform` fait de `position: fixed` un positionnement
       relatif à cet ancêtre : la barre se posait alors sur le titre au lieu de
       coiffer la fenêtre. Beaucoup de thèmes animent leurs sections à
       l'apparition, c'est un piège fréquent et invisible en aperçu isolé. */
    var bar = root.querySelector('[data-lad-sticky]');
    if (bar) {
      var twin = document.getElementById(bar.id);
      if (twin && twin !== bar && twin.parentNode === document.body) {
        // L'éditeur de thème rejoue la section : on retire l'exemplaire précédent.
        twin.parentNode.removeChild(twin);
      }
      document.body.appendChild(bar);
    }

    var clocks = root.querySelectorAll('[data-lad-clock]');
    if (bar) clocks = [].slice.call(clocks).concat([].slice.call(bar.querySelectorAll('[data-lad-clock]')));
    var srCell = (bar || root).querySelector('[data-lad-clock-sr]');
    var lastMinuteSpoken = -1;

    function deadline() {
      var key = root.dataset.ladKey + ':deadline';
      var hours = parseFloat(root.dataset.ladHours) || 9;
      var stored = null;
      try {
        stored = window.localStorage.getItem(key);
      } catch (e) {}

      var at = stored ? parseInt(stored, 10) : NaN;
      if (!isNaN(at) && at > 0) return at;

      /* Première visite seulement. Une fois posée, l'échéance ne bouge plus :
         le compteur ne redémarre jamais, y compris après rechargement. */
      at = Date.now() + hours * 3600 * 1000;
      try {
        window.localStorage.setItem(key, String(at));
      } catch (e) {}
      return at;
    }

    var endsAt = clocks.length ? deadline() : 0;
    var timer = null;

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    /* Trois pavés séparés par deux deux-points. Les nœuds sont construits une
       seule fois puis seuls les chiffres changent : reconstruire le balisage
       à chaque seconde ferait clignoter la barre. */
    function paintCells(host, clock, parts) {
      var labels = (clock.getAttribute('data-lad-clock-labels') || '').split(',');
      if (!host.__cells) {
        host.textContent = '';
        host.__cells = [];
        for (var i = 0; i < parts.length; i++) {
          if (i > 0) {
            var sep = document.createElement('span');
            sep.className = 'lad__clock-sep';
            sep.textContent = ':';
            host.appendChild(sep);
          }
          var box = document.createElement('span');
          box.className = 'lad__clock-cell';
          var digits = document.createElement('b');
          var label = document.createElement('span');
          label.textContent = (labels[i] || '').trim();
          box.appendChild(digits);
          box.appendChild(label);
          host.appendChild(box);
          host.__cells.push(digits);
        }
      }
      for (var k = 0; k < parts.length; k++) host.__cells[k].textContent = parts[k];
    }

    function tick() {
      var left = endsAt - Date.now();

      if (left <= 0) {
        for (var i = 0; i < clocks.length; i++) {
          var over = clocks[i].getAttribute('data-lad-clock-end') || '';
          var slot = clocks[i].querySelector('[data-lad-clock-value]');
          if (slot) {
            slot.__cells = null;
            slot.textContent = over;
          }
        }
        if (srCell) srCell.textContent = clocks.length ? clocks[0].getAttribute('data-lad-clock-end') || '' : '';
        if (timer) window.clearInterval(timer);
        return;
      }

      var total = Math.floor(left / 1000);
      var h = Math.floor(total / 3600);
      var m = Math.floor((total % 3600) / 60);
      var sec = total % 60;
      var text = pad(h) + 'h ' + pad(m) + 'm ' + pad(sec) + 's';

      for (var j = 0; j < clocks.length; j++) {
        var cell = clocks[j].querySelector('[data-lad-clock-value]');
        if (!cell) continue;

        if (clocks[j].getAttribute('data-lad-clock-style') === 'cells') {
          paintCells(cell, clocks[j], [pad(h), pad(m), pad(sec)]);
        } else {
          cell.textContent = text;
        }
      }

      /* Le lecteur d'écran n'est prévenu qu'au changement de minute. */
      if (srCell && m !== lastMinuteSpoken) {
        lastMinuteSpoken = m;
        srCell.textContent = pad(h) + ' heures ' + pad(m) + ' minutes';
      }
    }

    if (clocks.length) {
      tick();
      timer = window.setInterval(tick, 1000);
    }

    /* ---------------------------------------------------------------- *
     * Barre haute et profondeur de lecture
     * ---------------------------------------------------------------- */

    var sticky = bar;
    var marks = [25, 50, 75, 100];
    var fired = {};
    var viewContentSent = false;
    var waiting = false;

    function onScroll() {
      if (waiting) return;
      waiting = true;
      window.requestAnimationFrame(function () {
        waiting = false;

        if (sticky) {
          if (window.scrollY > 400) sticky.classList.add('is-on');
          else sticky.classList.remove('is-on');
        }

        var doc = document.documentElement;
        var scrollable = doc.scrollHeight - window.innerHeight;
        var pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 100;

        for (var i = 0; i < marks.length; i++) {
          var mark = marks[i];
          if (pct >= mark && !fired[mark]) {
            fired[mark] = true;
            push({ event: 'scroll_depth', percent: mark });

            /* ViewContent à mi-page, pas au chargement : une lectrice qui
               rebondit en deux secondes n'a rien vu. */
            if (mark === 50 && !viewContentSent && typeof window.fbq === 'function') {
              viewContentSent = true;
              window.fbq('track', 'ViewContent', { content_category: avatar });
            }
          }
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ---------------------------------------------------------------- *
     * Liens sortants — traçabilité
     * ---------------------------------------------------------------- */

    var TRACKED = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'ttclid'];

    function carried() {
      var out = {};
      try {
        var q = new URLSearchParams(window.location.search);
        for (var i = 0; i < TRACKED.length; i++) {
          var v = q.get(TRACKED[i]);
          if (v) out[TRACKED[i]] = v;
        }
      } catch (e) {}
      return out;
    }

    function withParams(href) {
      try {
        var url = new URL(href, window.location.origin);
        if (avatar) url.searchParams.set('a', avatar);
        var extra = carried();
        for (var key in extra) {
          if (Object.prototype.hasOwnProperty.call(extra, key)) url.searchParams.set(key, extra[key]);
        }
        return url.toString();
      } catch (e) {
        return href;
      }
    }

    /* L'avatar rejoint les attributs de panier : il remonte alors dans la
       commande Shopify, donc dans les exports et les rapports. keepalive
       laisse la requête se terminer même si la navigation part aussitôt. */
    function stampCart() {
      var attrs = carried();
      if (avatar) attrs.avatar = avatar;
      try {
        return window.fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: attrs }),
          keepalive: true
        });
      } catch (e) {
        return null;
      }
    }

    var links = root.querySelectorAll('[data-lad-go]');
    for (var b = 0; b < links.length; b++) {
      links[b].addEventListener('click', function (event) {
        var el = event.currentTarget;
        var position = el.getAttribute('data-lad-go');
        push({ event: 'cta_click', cta_position: position });
        stampCart();
        el.setAttribute('href', withParams(el.getAttribute('href') || '#'));
      });
    }

    /* ---------------------------------------------------------------- *
     * Sélecteur de pointure
     * ---------------------------------------------------------------- */

    var finders = root.querySelectorAll('[data-lad-finder]');

    function readJson(scope, selector) {
      var tag = scope.querySelector(selector);
      if (!tag) return null;
      try {
        return JSON.parse(tag.textContent);
      } catch (e) {
        return null;
      }
    }

    function num(value) {
      if (value === null || value === undefined) return NaN;
      return parseFloat(String(value).replace(',', '.').replace(/[^0-9.\-]/g, ''));
    }

    for (var f = 0; f < finders.length; f++) {
      (function (box) {
        var table = readJson(box, '[data-lad-sizes]') || [];
        var copy = readJson(box, '[data-lad-finder-copy]') || {};
        var out = box.querySelector('[data-lad-finder-out]');
        var lenField = box.querySelector('[data-lad-len]');
        var widField = box.querySelector('[data-lad-wid]');
        var go = box.querySelector('[data-lad-finder-go]');
        if (!go || !out || !lenField) return;

        var margin = (num(copy.marge) || 0) / 10; // le réglage est en millimètres

        function say(text) {
          // textContent, jamais innerHTML : rien de saisi n'est interprété.
          out.textContent = text;
          out.hidden = false;
        }

        go.addEventListener('click', function () {
          var foot = num(lenField.value);
          if (isNaN(foot)) return say(copy.vide || '');
          if (foot < 20 || foot > 32) return say(copy.invalide || '');

          var width = widField ? num(widField.value) : NaN;
          var needLength = foot + margin;
          var best = null;

          for (var i = 0; i < table.length; i++) {
            var row = table[i];
            var rowLength = num(row.longueur);
            var rowWidth = num(row.largeur);
            if (isNaN(rowLength) || rowLength < needLength) continue;
            if (!isNaN(width) && !isNaN(rowWidth) && rowWidth < width) continue;
            if (best === null || rowLength < num(best.longueur)) best = row;
          }

          /* Aucune pointure ne convient : on le dit, on n'en invente pas une. */
          if (!best) return say(copy.aucune || '');

          var message = String(copy.ok || '')
            .replace('[taille]', String(best.eu))
            .replace('[largeur]', String(best.largeur));
          say(message);
          push({ event: 'size_finder_result', pointure: String(best.eu) });
        });
      })(finders[f]);
    }
  })();
</script>

