    { "type": "text", "id": "sticky_text", "label": "Texte de la barre", "default": "[Barre haute — texte promo]" },
    { "type": "checkbox", "id": "sticky_countdown", "label": "Afficher le compte à rebours dans la barre", "default": true },

    { "type": "header", "content": "Compte à rebours" },
