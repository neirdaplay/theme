    { "type": "text", "id": "bascule_grossesse", "label": "Ligne de bascule", "default": "[Ligne de bascule — avatar grossesse]" },
    { "type": "text", "id": "point1_titre_grossesse", "label": "Variante A — titre", "default": "[Variante A — titre — avatar grossesse]" },
    { "type": "richtext", "id": "point1_texte_grossesse", "label": "Variante A — texte", "default": "<p>[Variante A — paragraphe 1 — avatar grossesse]</p><p>[Variante A — paragraphe 2 — avatar grossesse]</p>" },
    { "type": "text", "id": "point5_titre_grossesse", "label": "Variante B — titre", "default": "[Variante B — titre — avatar grossesse]" },
    { "type": "richtext", "id": "point5_texte_grossesse", "label": "Variante B — texte", "default": "<p>[Variante B — paragraphe 1 — avatar grossesse]</p><p>[Variante B — paragraphe 2 — avatar grossesse]</p>" },

    { "type": "header", "content": "Badge auteur" },
    { "type": "checkbox", "id": "show_author", "label": "Afficher le badge", "default": true },
    { "type": "image_picker", "id": "author_image", "label": "Photo" },
    { "type": "text", "id": "author_image_alt", "label": "Texte alternatif de la photo", "default": "[Alt — photo auteur]" },
    { "type": "text", "id": "author_name", "label": "Prénom", "default": "[Prénom]" },
    { "type": "checkbox", "id": "author_verified", "label": "Afficher la pastille", "default": true },
    { "type": "text", "id": "author_verified_label", "label": "Texte de la pastille", "default": "Vérifiée" },
    { "type": "text", "id": "author_role", "label": "Libellé de rôle", "info": "Champ libre. À toi de vérifier que ce libellé correspond à la réalité.", "default": "Passionnée de chaussures minimalistes" },

    { "type": "header", "content": "Clôture" },
    { "type": "text", "id": "close_title", "label": "Titre d'engagement", "default": "[Titre de clôture]" },
    { "type": "text", "id": "close_cta_title", "label": "Titre du bloc d'achat", "default": "[Titre — bloc d'achat final]" },
    { "type": "richtext", "id": "close_cta_text", "label": "Texte du bloc d'achat", "default": "<p>[Texte — bloc d'achat final]</p>" },
    { "type": "image_picker", "id": "close_image", "label": "Image du bloc d'achat" },
    { "type": "text", "id": "close_image_alt", "label": "Texte alternatif", "default": "[Alt — image bloc d'achat final]" },
    { "type": "text", "id": "close_button", "label": "Libellé du bouton", "default": "[Libellé du bouton final]" },
    { "type": "text", "id": "close_sub", "label": "Mention sous le bouton", "default": "[Mention sous le bouton final]" },
    { "type": "checkbox", "id": "close_countdown", "label": "Reprendre le compte à rebours", "default": true },

    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Texte", "default": "#1B1B1B" },
    { "type": "color", "id": "color_muted", "label": "Texte secondaire", "default": "#5B5B5B" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#1F6B3A" },
    { "type": "color", "id": "color_cta_bg", "label": "Fond des boutons", "default": "#1F6B3A" },
    { "type": "color", "id": "color_cta_text", "label": "Texte des boutons", "default": "#FFFFFF" },
    { "type": "color", "id": "color_sticky_bg", "label": "Fond de la barre haute", "default": "#1B1B1B" },
    { "type": "color", "id": "color_sticky_text", "label": "Texte de la barre haute", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "numero", "label": "Numéro", "default": "1" },
        { "type": "text", "id": "titre", "label": "Titre", "default": "[Point — titre]" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "[Alt — image du point]" },
        { "type": "richtext", "id": "texte", "label": "Texte", "default": "<p>[Point — paragraphe 1]</p><p>[Point — paragraphe 2]</p>" },
        { "type": "text", "id": "micro_lien_texte", "label": "Micro-lien — texte" },
        { "type": "url", "id": "micro_lien_url", "label": "Micro-lien — destination" },
        {
          "type": "select",
          "id": "variable_slot",
          "label": "Variante liée à l'avatar",
          "info": "Le titre et le texte de ce point sont alors lus dans les réglages de l'avatar actif. Le numéro, l'image et le micro-lien restent ceux du bloc.",
          "options": [
            { "value": "none", "label": "Aucune — contenu fixe" },
            { "value": "a", "label": "Variante A" },
            { "value": "b", "label": "Variante B" }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "cta",
      "name": "Bloc CTA",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre", "default": "[CTA — titre]" },
        { "type": "richtext", "id": "texte", "label": "Texte", "default": "<p>[CTA — texte]</p>" },
