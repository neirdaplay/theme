{% comment %}
  main-product-custom.liquid
  Self-contained high-conversion product section.
  Assets: assets/product-custom.css, assets/product-custom.js
  Template: templates/product.custom.json
{% endcomment %}

{{ 'product-custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-custom.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign pdp_variant = product.selected_or_first_available_variant
  assign pdp_allocations = pdp_variant.selling_plan_allocations
  assign pdp_has_plans = false
  if pdp_allocations.size > 0
    assign pdp_has_plans = true
  endif

  comment
    Best subscription discount vs. the one-time price, used for the plan badge.
  endcomment
  assign pdp_best_discount = 0
  if pdp_variant.price > 0
    for alloc in pdp_allocations
      assign alloc_disc = pdp_variant.price | minus: alloc.price | times: 100.0 | divided_by: pdp_variant.price | round
      if alloc_disc > pdp_best_discount
        assign pdp_best_discount = alloc_disc
      endif
    endfor
  endif

  comment
    Which card starts selected. Falls back to one-time when no plan exists.
  endcomment
  assign pdp_default_mode = s.default_plan
  unless pdp_has_plans
    assign pdp_default_mode = 'onetime'
  endunless

  assign pdp_rating = s.rating_value | default: 0.0
  assign pdp_rating_pct = pdp_rating | divided_by: 5.0 | times: 100

  comment
    root_url is "/" on a single-locale shop and "/fr" on a localised one, so
    append then collapse the double slash rather than hardcoding "/checkout".
  endcomment
  assign pdp_checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'
-%}

{%- comment -%} ---------- Reusable inline icons ---------- {%- endcomment -%}
{%- capture icon_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.6 5.3 5.8.85-4.2 4.1.99 5.8L10 14.8l-5.19 2.75.99-5.8-4.2-4.1 5.8-.85z"/></svg>{%- endcapture -%}
{%- capture icon_stars_row -%}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>{%- endcapture -%}
{%- capture icon_chevron -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4"/></svg>{%- endcapture -%}
{%- capture icon_info -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8"/><path d="M10 9v5" stroke-linecap="round"/><circle cx="10" cy="6.2" r="1" fill="currentColor" stroke="none"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 17s-6.5-4.1-6.5-8.3A3.7 3.7 0 0110 6.3a3.7 3.7 0 016.5 2.4C16.5 12.9 10 17 10 17z"/></svg>{%- endcapture -%}
{%- capture icon_calendar -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="2.8" y="4.2" width="14.4" height="13" rx="2.4"/><path d="M2.8 8.4h14.4M6.6 2.6v3.2M13.4 2.6v3.2" stroke-linecap="round"/></svg>{%- endcapture -%}

<div
  class="pdp-custom"
  id="pdp-{{ section.id }}"
  data-pdp-root
  style="--navy: {{ s.color_navy }}; --navy-deep: {{ s.color_navy_deep }}; --orange: {{ s.color_orange }}; --orange-soft: {{ s.color_orange_soft }}; --cream: {{ s.color_cream }};"
>
  {%- comment -%} Price + cart config consumed by product-custom.js {%- endcomment -%}
  <script type="application/json" data-pdp-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "checkoutUrl": {{ pdp_checkout_url | json }},
      "afterAdd": {{ s.after_add_action | json }},
      "variantId": {{ pdp_variant.id | json }},
      "available": {{ pdp_variant.available | json }},
      "oneTime": {
        "price": {{ pdp_variant.price | json }},
        "priceFormatted": {{ pdp_variant.price | money | json }}
      },
      "plans": {
        {%- for alloc in pdp_allocations -%}
          {%- liquid
            assign a_disc = 0
            if pdp_variant.price > 0
              assign a_disc = pdp_variant.price | minus: alloc.price | times: 100.0 | divided_by: pdp_variant.price | round
            endif
          -%}
          {%- unless forloop.first %},{% endunless -%}
          {%- comment -%} Quoted: a JSON key must be a string, not a bare id. {%- endcomment -%}
          "{{ alloc.selling_plan.id }}": {
            "price": {{ alloc.price | json }},
            "priceFormatted": {{ alloc.price | money | json }},
            "compareAtFormatted": {{ pdp_variant.price | money | json }},
            "discount": {{ a_disc | json }},
            "name": {{ alloc.selling_plan.name | json }}
          }
        {%- endfor -%}
      },
      "strings": {
        "soldOut": {{ s.sold_out_label | json }},
        "genericError": {{ s.cart_error_label | json }}
      }
    }
  </script>

  {%- comment -%} ================= BLOCK 1 — Announcement bar ================= {%- endcomment -%}
  {%- if s.announce_enabled and s.announce_items != blank -%}
    <div class="pdp-announce">
      <div class="pdp-container">
        <div class="pdp-announce__inner">
          {%- assign announce_items = s.announce_items | split: '|' -%}
          {%- for item in announce_items -%}
            {%- assign item_text = item | strip -%}
            {%- if item_text != blank -%}
              {%- unless forloop.first -%}
                <span class="pdp-announce__sep" aria-hidden="true">|</span>
              {%- endunless -%}
              <span>{{ item_text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===================== BLOCK 2 — Hero ===================== {%- endcomment -%}
  <div class="pdp-hero">
    <div class="pdp-container">
      <div class="pdp-hero__grid">
        {%- comment -%} ---------- Left: gallery ---------- {%- endcomment -%}
        <div class="pdp-gallery">
          <div class="pdp-gallery__stage">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 9 -%}
                {%- assign img = media.preview_image -%}
                <div class="pdp-gallery__media" data-pdp-slide="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
                  {%- liquid
                    assign img_h = 1000
                    if img.aspect_ratio > 0
                      assign img_h = 1000 | divided_by: img.aspect_ratio | round
                    endif
                    assign img_loading = 'lazy'
                    assign img_priority = 'auto'
                    if forloop.first
                      assign img_loading = 'eager'
                      assign img_priority = 'high'
                    endif
                  -%}
                  {{
                    img
                    | image_url: width: 1000
                    | image_tag:
                      width: 1000,
                      height: img_h,
                      widths: '400,600,800,1000',
                      sizes: '(min-width: 768px) 50vw, 100vw',
                      loading: img_loading,
                      fetchpriority: img_priority,
                      alt: img.alt
                  }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="pdp-gallery__placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            {%- if s.review_badge_enabled and s.review_badge_word != blank -%}
              <div class="pdp-gallery__badge">
                <span>{{ s.review_badge_word }}</span>
                <span class="pdp-stars pdp-stars--green" style="--pdp-star-pct: {{ pdp_rating_pct }}%; --pdp-star-size: 14px;" role="img" aria-label="{{ s.rating_aria_label }}">
                  <span class="pdp-stars__row pdp-stars__row--empty" aria-hidden="true">{{ icon_stars_row }}</span>
                  <span class="pdp-stars__row pdp-stars__row--full" aria-hidden="true">{{ icon_stars_row }}</span>
                </span>
                {%- if s.review_badge_logo != blank -%}
                  {{
                    s.review_badge_logo
                    | image_url: width: 240
                    | image_tag:
                      width: 120,
                      height: 30,
                      class: 'pdp-gallery__badge-logo',
                      loading: 'eager',
                      alt: s.review_badge_logo.alt
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="pdp-thumbs" role="tablist" aria-label="{{ s.thumbs_aria_label }}">
              {%- for media in product.media limit: 9 -%}
                {%- assign img = media.preview_image -%}
                <button
                  type="button"
                  class="pdp-thumbs__btn"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  data-pdp-thumb="{{ forloop.index0 }}"
                  aria-label="{{ s.thumbs_item_label }} {{ forloop.index }}"
                >
                  {{
                    img
                    | image_url: width: 160
                    | image_tag: width: 80, height: 80, loading: 'lazy', alt: ''
                  }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if s.engage_text != blank -%}
            <div class="pdp-engage">
              <span class="pdp-engage__icon" aria-hidden="true">{{ icon_heart }}</span>
              <p class="pdp-engage__text">{{ s.engage_text }}</p>
              {%- if s.engage_info != blank -%}
                <button
                  type="button"
                  class="pdp-engage__info pdp-tip"
                  data-pdp-tooltip
                  aria-expanded="false"
                  aria-label="{{ s.info_button_label }}"
                >
                  {{ icon_info }}
                  <span class="pdp-tip__bubble" role="tooltip">{{ s.engage_info }}</span>
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- Right: product info ---------- {%- endcomment -%}
        <div class="pdp-info">
          <h1 class="pdp-info__title">{{ product.title | escape }}</h1>

          {%- if s.rating_value > 0 -%}
            <div class="pdp-info__rating">
              <span class="pdp-stars" style="--pdp-star-pct: {{ pdp_rating_pct }}%;" role="img" aria-label="{{ s.rating_aria_label }}">
                <span class="pdp-stars__row pdp-stars__row--empty" aria-hidden="true">{{ icon_stars_row }}</span>
                <span class="pdp-stars__row pdp-stars__row--full" aria-hidden="true">{{ icon_stars_row }}</span>
              </span>
              <a class="pdp-info__rating-link" href="#pdp-reviews-{{ section.id }}">
                {{ s.rating_value }} · {{ s.rating_count }} {{ s.rating_count_label }}
              </a>
            </div>
          {%- endif -%}

          {%- assign bullet_blocks = section.blocks | where: 'type', 'bullet' -%}
          {%- if bullet_blocks.size > 0 -%}
            <ul class="pdp-bullets">
              {%- for block in bullet_blocks -%}
                <li {{ block.shopify_attributes }}>
                  <span class="pdp-check" aria-hidden="true">{{ icon_check }}</span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- comment -%} ---------- Plan selector ---------- {%- endcomment -%}
          <div class="pdp-plans">
            <p class="pdp-eyebrow" id="pdp-plans-label-{{ section.id }}">{{ s.plans_eyebrow }}</p>

            <div
              class="pdp-plans__group"
              role="radiogroup"
              aria-labelledby="pdp-plans-label-{{ section.id }}"
              data-pdp-plan-group
            >
              {%- if pdp_has_plans -%}
                {%- comment -%} --- Card 1: subscription --- {%- endcomment -%}
                {%- assign sub_selected = false -%}
                {%- if pdp_default_mode == 'subscription' -%}
                  {%- assign sub_selected = true -%}
                {%- endif -%}
                {%- assign first_alloc = pdp_allocations.first -%}

                <div
                  class="pdp-plan"
                  data-pdp-plan-card="subscription"
                  data-selected="{{ sub_selected }}"
                >
                  {%- if pdp_best_discount > 0 and s.plan_badge_text != blank -%}
                    <span class="pdp-plan__badge">
                      {{- s.plan_badge_text | replace: '{discount}', pdp_best_discount -}}
                    </span>
                  {%- endif -%}

                  <div class="pdp-plan__head">
                    <button
                      type="button"
                      class="pdp-plan__hit"
                      role="radio"
                      aria-checked="{{ sub_selected }}"
                      tabindex="{% if sub_selected %}0{% else %}-1{% endif %}"
                      aria-labelledby="pdp-sub-name-{{ section.id }} pdp-sub-price-{{ section.id }}"
                      data-pdp-plan-radio="subscription"
                    ></button>

                    <span class="pdp-plan__radio" aria-hidden="true"></span>

                    <div class="pdp-plan__labels">
                      <span class="pdp-plan__name" id="pdp-sub-name-{{ section.id }}">
                        {{ s.plan_sub_title }}
                        {%- if s.plan_sub_tooltip != blank -%}
                          <button
                            type="button"
                            class="pdp-tip"
                            data-pdp-tooltip
                            aria-expanded="false"
                            aria-label="{{ s.info_button_label }}"
                          >
                            {{ icon_info }}
                            <span class="pdp-tip__bubble" role="tooltip">{{ s.plan_sub_tooltip }}</span>
                          </button>
                        {%- endif -%}
                      </span>
                      <span class="pdp-plan__sub">{{ s.plan_sub_caption }}</span>
                    </div>

                    <div class="pdp-plan__price" id="pdp-sub-price-{{ section.id }}" data-pdp-sub-price>
                      {%- if s.show_compare_price and first_alloc.price < pdp_variant.price -%}
                        <span class="pdp-plan__price-was" data-pdp-sub-compare>{{ pdp_variant.price | money }}</span>
                      {%- endif -%}
                      <span data-pdp-sub-amount>{{ first_alloc.price | money }}</span>
                    </div>
                  </div>

                  <div class="pdp-plan__body">
                    {%- comment -%} What's in the order {%- endcomment -%}
                    {%- if s.includes_1_label != blank or s.includes_2_label != blank -%}
                      <div class="pdp-includes">
                        <p class="pdp-includes__title">{{ s.includes_title }}</p>
                        <div class="pdp-includes__grid">
                          {%- for i in (1..2) -%}
                            {%- liquid
                              case i
                                when 1
                                  assign inc_label = s.includes_1_label
                                  assign inc_badge = s.includes_1_badge
                                  assign inc_image = s.includes_1_image
                                  assign inc_accent = s.includes_1_badge_accent
                                when 2
                                  assign inc_label = s.includes_2_label
                                  assign inc_badge = s.includes_2_badge
                                  assign inc_image = s.includes_2_image
                                  assign inc_accent = s.includes_2_badge_accent
                              endcase
                            -%}
                            {%- if inc_label != blank -%}
                              <div class="pdp-include">
                                {%- if inc_image != blank -%}
                                  {{
                                    inc_image
                                    | image_url: width: 136
                                    | image_tag:
                                      width: 68,
                                      height: 68,
                                      class: 'pdp-include__img',
                                      loading: 'lazy',
                                      alt: ''
                                  }}
                                {%- elsif product.featured_image != blank -%}
                                  {{
                                    product.featured_image
                                    | image_url: width: 136
                                    | image_tag:
                                      width: 68,
                                      height: 68,
                                      class: 'pdp-include__img',
                                      loading: 'lazy',
                                      alt: ''
                                  }}
                                {%- endif -%}
                                <div>
                                  <span class="pdp-include__label">{{ inc_label }}</span>
                                  {%- if inc_badge != blank -%}
                                    <span class="pdp-include__badge{% if inc_accent %} pdp-include__badge--orange{% endif %}">
                                      {{- inc_badge -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}

                    {%- comment -%} Frequency picker {%- endcomment -%}
                    <div class="pdp-freq__head">
                      <span class="pdp-freq__label" id="pdp-freq-label-{{ section.id }}">{{ s.freq_label }}</span>
                      {%- if s.freq_help_body != blank -%}
                        <button
                          type="button"
                          class="pdp-freq__help"
                          aria-expanded="false"
                          aria-controls="pdp-freq-help-{{ section.id }}"
                          data-pdp-collapse-trigger
                        >
                          {{ s.freq_help_label }}
                          {{ icon_chevron }}
                        </button>
                      {%- endif -%}
                    </div>

                    {%- if s.freq_help_body != blank -%}
                      <div class="pdp-collapse" id="pdp-freq-help-{{ section.id }}" data-pdp-collapse hidden>
                        <div class="pdp-collapse__inner">{{ s.freq_help_body }}</div>
                      </div>
                    {%- endif -%}

                    <div
                      class="pdp-freq__options"
                      role="radiogroup"
                      aria-labelledby="pdp-freq-label-{{ section.id }}"
                      data-pdp-freq-group
                    >
                      {%- for alloc in pdp_allocations -%}
                        {%- liquid
                          assign a_disc = 0
                          if pdp_variant.price > 0
                            assign a_disc = pdp_variant.price | minus: alloc.price | times: 100.0 | divided_by: pdp_variant.price | round
                          endif
                        -%}
                        <button
                          type="button"
                          class="pdp-freq__btn"
                          role="radio"
                          aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                          data-selling-plan-id="{{ alloc.selling_plan.id }}"
                          data-pdp-freq
                        >
                          <span class="pdp-freq__btn-text">
                            <span class="pdp-freq__name">{{ alloc.selling_plan.name }}</span>
                            {%- if a_disc > 0 and s.freq_save_text != blank -%}
                              <span class="pdp-freq__save">
                                {{- s.freq_save_text | replace: '{discount}', a_disc -}}
                              </span>
                            {%- endif -%}
                          </span>
                          <span class="pdp-freq__icon" aria-hidden="true">{{ icon_calendar }}</span>
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- comment -%} --- Card 2: one-time purchase --- {%- endcomment -%}
              {%- assign one_selected = false -%}
              {%- if pdp_default_mode == 'onetime' -%}
                {%- assign one_selected = true -%}
              {%- endif -%}

              <div class="pdp-plan" data-pdp-plan-card="onetime" data-selected="{{ one_selected }}">
                <div class="pdp-plan__head">
                  <button
                    type="button"
                    class="pdp-plan__hit"
                    role="radio"
                    aria-checked="{{ one_selected }}"
                    tabindex="{% if one_selected %}0{% else %}-1{% endif %}"
                    aria-labelledby="pdp-one-name-{{ section.id }} pdp-one-price-{{ section.id }}"
                    data-pdp-plan-radio="onetime"
                    data-variant-id="{{ pdp_variant.id }}"
                  ></button>

                  <span class="pdp-plan__radio" aria-hidden="true"></span>

                  <div class="pdp-plan__labels">
                    <span class="pdp-plan__name" id="pdp-one-name-{{ section.id }}">{{ s.plan_one_title }}</span>
                  </div>

                  <div class="pdp-plan__price" id="pdp-one-price-{{ section.id }}">
                    {{ pdp_variant.price | money }}
                  </div>
                </div>
              </div>
            </div>
          </div>

          {%- comment -%} ---------- Add to cart ---------- {%- endcomment -%}
          <div class="pdp-atc">
            <button
              type="button"
              class="pdp-btn pdp-btn--navy pdp-btn--block pdp-btn--lg"
              data-pdp-add
              data-pdp-hero-cta
              {% unless pdp_variant.available %}aria-disabled="true"{% endunless %}
            >
              <span data-pdp-add-label>
                {%- if pdp_variant.available -%}{{ s.cta_label }}{%- else -%}{{ s.sold_out_label }}{%- endif -%}
              </span>
            </button>
            <p class="pdp-atc__error" role="alert" data-pdp-error hidden></p>
          </div>

          {%- comment -%} ---------- Reassurance row ---------- {%- endcomment -%}
          {%- capture reassure_blob -%}
            {{- s.reassure_1_icon }}~{{ s.reassure_1_text }}|{{ s.reassure_2_icon }}~{{ s.reassure_2_text }}|{{ s.reassure_3_icon }}~{{ s.reassure_3_text -}}
          {%- endcapture -%}
          {%- assign reassure_items = reassure_blob | split: '|' -%}
          <ul class="pdp-reassure">
            {%- for item in reassure_items -%}
              {%- assign parts = item | split: '~' -%}
              {%- assign r_text = parts[1] | strip -%}
              {%- assign r_icon = parts[0] | strip -%}
              {%- if r_text != blank -%}
                <li>
                  {%- case r_icon -%}
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M10 2.4l6 2.2v5.1c0 3.5-2.4 6.6-6 7.9-3.6-1.3-6-4.4-6-7.9V4.6z" stroke-linejoin="round"/><path d="M7.4 10l1.9 1.9 3.4-3.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M1.9 5.4h9.3v8.2H1.9zM11.2 8.2h3.4l2.9 2.8v2.6h-6.3z" stroke-linejoin="round"/><circle cx="5.6" cy="15.1" r="1.6"/><circle cx="14.1" cy="15.1" r="1.6"/></svg>
                    {%- when 'medal' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10" cy="12.4" r="4.6"/><path d="M7.2 8L5.1 2.6M12.8 8l2.1-5.4" stroke-linecap="round"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M16.5 3.5c0 7.2-3.6 10.8-8 10.8a4.6 4.6 0 01-4.6-4.6c0-4.4 4.6-6.2 12.6-6.2z" stroke-linejoin="round"/><path d="M3.5 16.5c2.8-4.2 6.4-7.3 10.4-9.2" stroke-linecap="round"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M10 5.6V10l3 1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'heart' -%}
                      {{ icon_heart }}
                    {%- else -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M6.7 10.2l2.2 2.2 4.4-4.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endcase -%}
                  <span>{{ r_text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- comment -%} ---------- FAQ accordion ---------- {%- endcomment -%}
          {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
          {%- if faq_blocks.size > 0 -%}
            <div class="pdp-faq">
              <p class="pdp-eyebrow">{{ s.faq_eyebrow }}</p>
              <div class="pdp-faq__list">
                {%- for block in faq_blocks -%}
                  <div class="pdp-faq__item" {{ block.shopify_attributes }}>
                    <h2>
                      <button
                        type="button"
                        class="pdp-faq__trigger"
                        aria-expanded="false"
                        aria-controls="pdp-faq-{{ block.id }}"
                        data-pdp-collapse-trigger
                      >
                        <span>{{ block.settings.question }}</span>
                        {{ icon_chevron }}
                      </button>
                    </h2>
                    <div class="pdp-collapse pdp-faq__panel" id="pdp-faq-{{ block.id }}" data-pdp-collapse hidden>
                      <div class="pdp-collapse__inner">{{ block.settings.answer }}</div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

