{% comment %}
  main-product-custom.liquid
  Self-contained high-conversion product section.
  Assets: assets/product-custom.css, assets/product-custom.js
  Template: templates/product.custom.json
{% endcomment %}

{{ 'product-custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-custom.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign pdp_variant = product.selected_or_first_available_variant

  assign pdp_rating = s.rating_value | default: 0.0
  assign pdp_rating_pct = pdp_rating | divided_by: 5.0 | times: 100

  comment
    Percentage off, shown only when a compare-at price is actually set.
  endcomment
  assign pdp_discount = 0
  if pdp_variant.compare_at_price > pdp_variant.price
    assign pdp_discount = pdp_variant.compare_at_price | minus: pdp_variant.price | times: 100.0 | divided_by: pdp_variant.compare_at_price | round
  endif

  comment
    Review histogram. Bars are a share of the total, so the five buckets and
    the headline count stay consistent with each other.
  endcomment
  assign pdp_hist_total = s.stars_5 | plus: s.stars_4 | plus: s.stars_3 | plus: s.stars_2 | plus: s.stars_1
  assign pdp_reviews = section.blocks | where: 'type', 'review'

  comment
    root_url is "/" on a single-locale shop and "/fr" on a localised one, so
    append then collapse the double slash rather than hardcoding "/checkout".
  endcomment
  assign pdp_checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'
-%}

{%- comment -%} ---------- Reusable inline icons ---------- {%- endcomment -%}
{%- capture icon_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.6 5.3 5.8.85-4.2 4.1.99 5.8L10 14.8l-5.19 2.75.99-5.8-4.2-4.1 5.8-.85z"/></svg>{%- endcapture -%}
{%- capture icon_stars_row -%}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{{ icon_star }}{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>{%- endcapture -%}
{%- capture icon_chevron -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4"/></svg>{%- endcapture -%}
{%- capture icon_info -%}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8"/><path d="M10 9v5" stroke-linecap="round"/><circle cx="10" cy="6.2" r="1" fill="currentColor" stroke="none"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 17s-6.5-4.1-6.5-8.3A3.7 3.7 0 0110 6.3a3.7 3.7 0 016.5 2.4C16.5 12.9 10 17 10 17z"/></svg>{%- endcapture -%}
{%- capture icon_close -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/></svg>{%- endcapture -%}

<div
  class="pdp-custom"
  id="pdp-{{ section.id }}"
  data-pdp-root
  style="--navy: {{ s.color_navy }}; --navy-deep: {{ s.color_navy_deep }}; --orange: {{ s.color_orange }}; --orange-soft: {{ s.color_orange_soft }}; --cream: {{ s.color_cream }};"
>
  {%- comment -%}
    Stable anchor target for CTAs elsewhere on the page (the guarantee section
    links here by default). Kept separate from the section id, which changes.
  {%- endcomment -%}
  <span id="main-product" class="pdp-anchor"></span>

  {%- comment -%} Price + cart config consumed by product-custom.js {%- endcomment -%}
  <script type="application/json" data-pdp-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "checkoutUrl": {{ pdp_checkout_url | json }},
      "afterAdd": {{ s.after_add_action | json }},
      "variantId": {{ pdp_variant.id | json }},
      "available": {{ pdp_variant.available | json }},
      "oneTime": {
        "price": {{ pdp_variant.price | json }},
        "priceFormatted": {{ pdp_variant.price | money | json }}
      },
      "strings": {
        "soldOut": {{ s.sold_out_label | json }},
        "genericError": {{ s.cart_error_label | json }}
      }
    }
  </script>

  {%- comment -%} ================= BLOCK 1 — Announcement bar ================= {%- endcomment -%}
  {%- if s.announce_enabled and s.announce_items != blank -%}
    <div class="pdp-announce">
      <div class="pdp-container">
        <div class="pdp-announce__inner">
          {%- assign announce_items = s.announce_items | split: '|' -%}
          {%- for item in announce_items -%}
            {%- assign item_text = item | strip -%}
            {%- if item_text != blank -%}
              {%- unless forloop.first -%}
                <span class="pdp-announce__sep" aria-hidden="true">|</span>
              {%- endunless -%}
              <span>{{ item_text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===================== BLOCK 2 — Hero ===================== {%- endcomment -%}
  <div class="pdp-hero">
    <div class="pdp-container">
      <div class="pdp-hero__grid">
        {%- comment -%} ---------- Left: gallery ---------- {%- endcomment -%}
        <div class="pdp-gallery">
          <div class="pdp-gallery__stage">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 9 -%}
                {%- assign img = media.preview_image -%}
                <div class="pdp-gallery__media" data-pdp-slide="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
                  {%- liquid
                    assign img_h = 1000
                    if img.aspect_ratio > 0
                      assign img_h = 1000 | divided_by: img.aspect_ratio | round
                    endif
                    assign img_loading = 'lazy'
                    assign img_priority = 'auto'
                    if forloop.first
                      assign img_loading = 'eager'
                      assign img_priority = 'high'
                    endif
                  -%}
                  {{
                    img
                    | image_url: width: 1000
                    | image_tag:
                      width: 1000,
                      height: img_h,
                      widths: '400,600,800,1000',
                      sizes: '(min-width: 768px) 50vw, 100vw',
                      loading: img_loading,
                      fetchpriority: img_priority,
                      alt: img.alt
                  }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="pdp-gallery__placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            {%- if s.review_badge_enabled and s.review_badge_word != blank -%}
              <div class="pdp-gallery__badge">
                <span>{{ s.review_badge_word }}</span>
                <span class="pdp-stars pdp-stars--green" style="--pdp-star-pct: {{ pdp_rating_pct }}%; --pdp-star-size: 14px;" role="img" aria-label="{{ s.rating_aria_label }}">
                  <span class="pdp-stars__row pdp-stars__row--empty" aria-hidden="true">{{ icon_stars_row }}</span>
                  <span class="pdp-stars__row pdp-stars__row--full" aria-hidden="true">{{ icon_stars_row }}</span>
                </span>
                {%- if s.review_badge_logo != blank -%}
                  {{
                    s.review_badge_logo
                    | image_url: width: 240
                    | image_tag:
                      width: 120,
                      height: 30,
                      class: 'pdp-gallery__badge-logo',
                      loading: 'eager',
                      alt: s.review_badge_logo.alt
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="pdp-thumbs" role="tablist" aria-label="{{ s.thumbs_aria_label }}">
              {%- for media in product.media limit: 9 -%}
                {%- assign img = media.preview_image -%}
                <button
                  type="button"
                  class="pdp-thumbs__btn"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  data-pdp-thumb="{{ forloop.index0 }}"
                  aria-label="{{ s.thumbs_item_label }} {{ forloop.index }}"
                >
                  {{
                    img
                    | image_url: width: 160
                    | image_tag: width: 80, height: 80, loading: 'lazy', alt: ''
                  }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if s.engage_text != blank -%}
            <div class="pdp-engage">
              <span class="pdp-engage__icon" aria-hidden="true">{{ icon_heart }}</span>
              <p class="pdp-engage__text">{{ s.engage_text }}</p>
              {%- if s.impact_enabled -%}
                <button
                  type="button"
                  class="pdp-engage__info"
                  data-pdp-open-impact
                  aria-haspopup="dialog"
                  aria-label="{{ s.info_button_label }}"
                >
                  {{ icon_info }}
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- Right: product info ---------- {%- endcomment -%}
        <div class="pdp-info">
          <h1 class="pdp-info__title">{{ product.title | escape }}</h1>

          {%- if s.rating_value > 0 -%}
            <div class="pdp-info__rating">
              <span class="pdp-stars" style="--pdp-star-pct: {{ pdp_rating_pct }}%;" role="img" aria-label="{{ s.rating_aria_label }}">
                <span class="pdp-stars__row pdp-stars__row--empty" aria-hidden="true">{{ icon_stars_row }}</span>
                <span class="pdp-stars__row pdp-stars__row--full" aria-hidden="true">{{ icon_stars_row }}</span>
              </span>
              <button
                type="button"
                class="pdp-info__rating-link"
                data-pdp-reviews-toggle
                aria-expanded="false"
                aria-controls="pdp-revpop-{{ section.id }}"
              >
                <span>{{ s.rating_value }} · {{ s.rating_count }} {{ s.rating_count_label }}</span>
                {{ icon_chevron }}
              </button>

              {%- comment -%} Review summary, anchored under the link. {%- endcomment -%}
              <div class="pdp-revpop" id="pdp-revpop-{{ section.id }}" data-pdp-revpop hidden>
                <button
                  type="button"
                  class="pdp-revpop__close"
                  data-pdp-reviews-close
                  aria-label="{{ s.close_label }}"
                >
                  {{ icon_close }}
                </button>

                <div class="pdp-revpop__head">
                  <span class="pdp-revpop__score">{{ s.rating_value }}</span>
                  <span class="pdp-stars pdp-stars--brand" style="--pdp-star-pct: {{ pdp_rating_pct }}%; --pdp-star-size: 17px;" role="img" aria-label="{{ s.rating_aria_label }}">
                    <span class="pdp-stars__row pdp-stars__row--empty" aria-hidden="true">{{ icon_stars_row }}</span>
                    <span class="pdp-stars__row pdp-stars__row--full" aria-hidden="true">{{ icon_stars_row }}</span>
                  </span>
                  <p class="pdp-revpop__basis">
                    {{ s.reviews_basis_prefix }} <strong>{{ s.rating_count }}</strong> {{ s.rating_count_label }}
                  </p>
                </div>

                {%- if pdp_hist_total > 0 -%}
                  <ul class="pdp-hist">
                    {%- for i in (1..5) -%}
                      {%- liquid
                        assign star = 6 | minus: i
                        case star
                          when 5
                            assign bucket = s.stars_5
                          when 4
                            assign bucket = s.stars_4
                          when 3
                            assign bucket = s.stars_3
                          when 2
                            assign bucket = s.stars_2
                          else
                            assign bucket = s.stars_1
                        endcase
                        assign bucket_pct = bucket | times: 100.0 | divided_by: pdp_hist_total
                      -%}
                      <li class="pdp-hist__row">
                        <span class="pdp-hist__label">{{ star }} &#9733;</span>
                        <span class="pdp-hist__track">
                          <span class="pdp-hist__bar" style="width: {{ bucket_pct }}%;"></span>
                        </span>
                        <span class="pdp-hist__count">({{ bucket }})</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if pdp_reviews.size > 0 -%}
                  <div class="pdp-revpop__slider" data-pdp-review-slider>
                    {%- for block in pdp_reviews -%}
                      <article class="pdp-review" data-pdp-review="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
                        <div class="pdp-review__head">
                          {%- if block.settings.image != blank -%}
                            {{
                              block.settings.image
                              | image_url: width: 120
                              | image_tag: width: 60, height: 60, class: 'pdp-review__avatar', loading: 'lazy', alt: ''
                            }}
                          {%- endif -%}
                          <span class="pdp-review__name">{{ block.settings.name }}</span>
                          {%- if block.settings.verified -%}
                            <span class="pdp-review__verified">{{ icon_check }} {{ s.verified_label }}</span>
                          {%- endif -%}
                        </div>
                        <p class="pdp-review__text">{{ block.settings.text }}</p>
                      </article>
                    {%- endfor -%}
                  </div>

                  {%- if pdp_reviews.size > 1 -%}
                    <div class="pdp-revpop__nav">
                      <button type="button" class="pdp-revpop__arrow" data-pdp-review-prev aria-label="{{ s.prev_label }}">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3L5 8l5 5"/></svg>
                      </button>
                      <span class="pdp-revpop__dots" data-pdp-review-dots>
                        {%- for block in pdp_reviews -%}
                          <button type="button" class="pdp-revpop__dot" data-pdp-review-dot="{{ forloop.index0 }}" aria-label="{{ s.review_label }} {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
                        {%- endfor -%}
                      </span>
                      <button type="button" class="pdp-revpop__arrow pdp-revpop__arrow--next" data-pdp-review-next aria-label="{{ s.next_label }}">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5"/></svg>
                      </button>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- assign bullet_blocks = section.blocks | where: 'type', 'bullet' -%}
          {%- if bullet_blocks.size > 0 -%}
            <ul class="pdp-bullets">
              {%- for block in bullet_blocks -%}
                <li {{ block.shopify_attributes }}>
                  <span class="pdp-check" aria-hidden="true">{{ icon_check }}</span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- comment -%} ---------- Price ---------- {%- endcomment -%}
          {%- if s.show_price -%}
            <div class="pdp-price">
              <span class="pdp-price__now">{{ pdp_variant.price | money }}</span>
              {%- if pdp_discount > 0 -%}
                <s class="pdp-price__was">{{ pdp_variant.compare_at_price | money }}</s>
                {%- if s.save_label != blank -%}
                  <span class="pdp-price__save">
                    {{- s.save_label | replace: '[percent]', pdp_discount -}}
                  </span>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%} ---------- Add to cart ---------- {%- endcomment -%}
          <div class="pdp-atc">
            <button
              type="button"
              class="pdp-btn pdp-btn--navy pdp-btn--block pdp-btn--lg"
              data-pdp-add
              data-pdp-hero-cta
              {% unless pdp_variant.available %}aria-disabled="true"{% endunless %}
            >
              <span data-pdp-add-label>
                {%- if pdp_variant.available -%}{{ s.cta_label }}{%- else -%}{{ s.sold_out_label }}{%- endif -%}
              </span>
            </button>
            <p class="pdp-atc__error" role="alert" data-pdp-error hidden></p>
          </div>

          {%- comment -%} ---------- Reassurance row ---------- {%- endcomment -%}
          {%- capture reassure_blob -%}
            {{- s.reassure_1_icon }}~{{ s.reassure_1_text }}|{{ s.reassure_2_icon }}~{{ s.reassure_2_text }}|{{ s.reassure_3_icon }}~{{ s.reassure_3_text -}}
          {%- endcapture -%}
          {%- assign reassure_items = reassure_blob | split: '|' -%}
          <ul class="pdp-reassure">
            {%- for item in reassure_items -%}
              {%- assign parts = item | split: '~' -%}
              {%- assign r_text = parts[1] | strip -%}
              {%- assign r_icon = parts[0] | strip -%}
              {%- if r_text != blank -%}
                <li>
                  {%- case r_icon -%}
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M10 2.4l6 2.2v5.1c0 3.5-2.4 6.6-6 7.9-3.6-1.3-6-4.4-6-7.9V4.6z" stroke-linejoin="round"/><path d="M7.4 10l1.9 1.9 3.4-3.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M1.9 5.4h9.3v8.2H1.9zM11.2 8.2h3.4l2.9 2.8v2.6h-6.3z" stroke-linejoin="round"/><circle cx="5.6" cy="15.1" r="1.6"/><circle cx="14.1" cy="15.1" r="1.6"/></svg>
                    {%- when 'medal' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10" cy="12.4" r="4.6"/><path d="M7.2 8L5.1 2.6M12.8 8l2.1-5.4" stroke-linecap="round"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M16.5 3.5c0 7.2-3.6 10.8-8 10.8a4.6 4.6 0 01-4.6-4.6c0-4.4 4.6-6.2 12.6-6.2z" stroke-linejoin="round"/><path d="M3.5 16.5c2.8-4.2 6.4-7.3 10.4-9.2" stroke-linecap="round"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M10 5.6V10l3 1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- when 'heart' -%}
                      {{ icon_heart }}
                    {%- else -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M6.7 10.2l2.2 2.2 4.4-4.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endcase -%}
                  <span>{{ r_text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- comment -%} ---------- FAQ accordion ---------- {%- endcomment -%}
          {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
          {%- if faq_blocks.size > 0 -%}
            <div class="pdp-faq">
              <p class="pdp-eyebrow">{{ s.faq_eyebrow }}</p>
              <div class="pdp-faq__list">
                {%- for block in faq_blocks -%}
                  <div class="pdp-faq__item" {{ block.shopify_attributes }}>
                    <h2>
                      <button
                        type="button"
                        class="pdp-faq__trigger"
                        aria-expanded="false"
                        aria-controls="pdp-faq-{{ block.id }}"
                        data-pdp-collapse-trigger
                      >
                        <span>{{ block.settings.question }}</span>
                        {{ icon_chevron }}
                      </button>
                    </h2>
                    <div class="pdp-collapse pdp-faq__panel" id="pdp-faq-{{ block.id }}" data-pdp-collapse hidden>
                      <div class="pdp-collapse__inner">{{ block.settings.answer }}</div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Impact dialog ---------- {%- endcomment -%}
  {%- if s.impact_enabled -%}
    <div class="pdp-modal" data-pdp-impact hidden>
      <button
        type="button"
        class="pdp-modal__backdrop"
        data-pdp-impact-close
        tabindex="-1"
        aria-hidden="true"
      ></button>

      <div class="pdp-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="pdp-impact-title-{{ section.id }}" data-pdp-impact-dialog>
        <button type="button" class="pdp-modal__close" data-pdp-impact-close aria-label="{{ s.close_label }}">
          {{ icon_close }}
        </button>

        {%- if s.impact_image != blank -%}
          {%- liquid
            assign impact_h = 720
            if s.impact_image.aspect_ratio > 0
              assign impact_h = 720 | divided_by: s.impact_image.aspect_ratio | round
            endif
          -%}
          {{
            s.impact_image
            | image_url: width: 720
            | image_tag:
              width: 720,
              height: impact_h,
              class: 'pdp-modal__image',
              loading: 'lazy',
              alt: s.impact_image.alt
          }}
        {%- endif -%}

        <div class="pdp-modal__body">
          {%- if s.impact_intro != blank -%}
            <div class="pdp-modal__intro" id="pdp-impact-title-{{ section.id }}">{{ s.impact_intro }}</div>
          {%- endif -%}

          {%- if s.impact_step_title != blank or s.impact_step_text != blank -%}
            <div class="pdp-modal__step">
              {%- if s.impact_step_title != blank -%}
                <h3 class="pdp-modal__step-title">{{ s.impact_step_title }}</h3>
              {%- endif -%}
              {%- if s.impact_step_text != blank -%}
                <div class="pdp-modal__step-text">{{ s.impact_step_text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- assign partners = s.impact_partners | strip | newline_to_br | split: '<br />' -%}
          {%- if s.impact_partners_label != blank or partners.size > 0 -%}
            <div class="pdp-modal__partners">
              <div class="pdp-modal__partners-head">
                {%- if s.impact_partners_label != blank -%}
                  <span class="pdp-modal__partners-label">{{ s.impact_partners_label }}</span>
                {%- endif -%}
                {%- if s.impact_link_label != blank and s.impact_link_url != blank -%}
                  <a class="pdp-modal__link" href="{{ s.impact_link_url }}">{{ s.impact_link_label }}</a>
                {%- endif -%}
              </div>
              {%- if partners.size > 0 -%}
                <ul class="pdp-modal__partner-list">
                  {%- for partner in partners -%}
                    {%- assign partner_name = partner | strip_html | strip -%}
                    {%- if partner_name != blank -%}
                      <li class="pdp-modal__partner">{{ partner_name }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

