{% comment %}
  guarantee.liquid
  Standalone risk-free guarantee band: orange medallion, headline, reassurance
  cards and a CTA that anchor-scrolls back to the product section.

  Self-contained: styles and behaviour are both inlined below, so this file is
  the only thing that needs to exist in the theme.
{% endcomment %}

{%- comment -%}
  Styles are inlined rather than kept in assets/guarantee.css so the whole
  section is a single file: nothing else to upload, nothing that can go
  missing and leave the markup unstyled.
{%- endcomment -%}
{% style %}
/* ==========================================================================
   guarantee.css
   Styles for sections/guarantee.liquid
   Everything is scoped under .guarantee so the rest of the theme is untouched.
   ========================================================================== */

.guarantee {
  /* Palette */
  --gt-navy: #16295c;
  --gt-orange: #f26a21;
  --gt-orange-soft: #fdf0e8;
  --gt-muted: #8a8f9a;
  --gt-bg: #eaeff8;
  --gt-card: #fbf7f4;
  --gt-white: #ffffff;

  /* Shape. medallion derives from the inline *-set variable so the mobile
     media query below can still cap it. */
  --gt-card-max: 1060px;
  --gt-card-radius: 28px;
  --gt-medallion: var(--gt-medallion-set, 150px);

  /* Layout */
  --gt-gutter: 24px;
  --gt-pad: clamp(26px, 3.4vw, 48px);

  --gt-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  background: var(--gt-bg);
  font-family: var(--gt-font);
  -webkit-font-smoothing: antialiased;
}

.guarantee *,
.guarantee *::before,
.guarantee *::after {
  box-sizing: border-box;
}

/* Zero-specificity defaults so component classes always win. */
:where(.guarantee) :where(p) {
  margin: 0;
}

:where(.guarantee) :where(h2, h3) {
  margin: 0;
  font-size: inherit;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.15;
  color: var(--gt-navy);
}

:where(.guarantee) :where(ul) {
  margin: 0;
  padding: 0;
  list-style: none;
}

:where(.guarantee) :where(a) {
  color: inherit;
}

.guarantee :focus-visible {
  outline: 2px solid var(--gt-orange);
  outline-offset: 3px;
}

/* --------------------------------------------------------------------------
   Card
   -------------------------------------------------------------------------- */

.guarantee__container {
  max-width: calc(var(--gt-card-max) + var(--gt-gutter) * 2);
  margin-inline: auto;
  padding-inline: var(--gt-gutter);
}

.guarantee__card {
  position: relative;
  padding: var(--gt-pad);
  border-radius: var(--gt-card-radius);
  background: linear-gradient(145deg, #fdfaf7 0%, var(--gt-card) 58%, #f7f2ee 100%);
  overflow: hidden;
}

/* Warm halo in the top-right corner, as in the reference. */
.guarantee__card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    420px 320px at 88% 14%,
    rgba(242, 106, 33, 0.11),
    rgba(242, 106, 33, 0) 68%
  );
  pointer-events: none;
}

.guarantee--no-glow .guarantee__card::before {
  display: none;
}

.guarantee__grid {
  position: relative;
  display: grid;
  grid-template-columns: var(--gt-medallion) minmax(0, 1fr);
  gap: 48px;
  align-items: center;
}

.guarantee--no-medallion .guarantee__grid {
  grid-template-columns: minmax(0, 1fr);
}

/* --------------------------------------------------------------------------
   Medallion
   -------------------------------------------------------------------------- */

.guarantee__medallion {
  position: relative;
  display: grid;
  place-content: center;
  justify-items: center;
  width: var(--gt-medallion);
  height: var(--gt-medallion);
  border-radius: 50%;
  background: linear-gradient(145deg, #f58a4b 0%, var(--gt-orange) 46%, #e2570f 100%);
  box-shadow: 0 14px 36px rgba(242, 106, 33, 0.36);
  color: var(--gt-white);
  text-align: center;
}

/* Dashed inner ring */
.guarantee__medallion::after {
  content: "";
  position: absolute;
  inset: 9px;
  border: 2px dashed rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  pointer-events: none;
}

.guarantee__number {
  font-size: calc(var(--gt-medallion) * 0.31);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
}

.guarantee__unit {
  margin-top: 2px;
  font-size: calc(var(--gt-medallion) * 0.085);
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.18em;
  text-indent: 0.18em;
  text-transform: uppercase;
}

.guarantee__caption {
  margin-top: 6px;
  max-width: calc(var(--gt-medallion) * 0.74);
  font-size: calc(var(--gt-medallion) * 0.05);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0.05em;
  text-indent: 0.05em;
  text-transform: uppercase;
}

/* --------------------------------------------------------------------------
   Content
   -------------------------------------------------------------------------- */

.guarantee__eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--gt-navy);
}

.guarantee__eyebrow::before {
  content: "";
  flex: 0 0 auto;
  width: 22px;
  height: 2px;
  background: var(--gt-orange);
}

.guarantee--no-dash .guarantee__eyebrow::before {
  display: none;
}

.guarantee__title {
  margin-top: 14px;
  font-size: clamp(1.5rem, 1.05rem + 1.6vw, 2.125rem);
  color: var(--gt-navy);
}

.guarantee__text {
  margin-top: 14px;
  max-width: 460px;
  font-size: 15px;
  line-height: 1.6;
  color: var(--gt-muted);
}

/* ---- Sub-cards ---- */

.guarantee__items {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 14px;
  margin-top: 28px;
}

.guarantee__item {
  min-width: 0;
  padding: 18px;
  border: 1px solid rgba(22, 41, 92, 0.05);
  border-radius: 13px;
  background: var(--gt-white);
  box-shadow: 0 1px 2px rgba(22, 41, 92, 0.04);
}

.guarantee__item-icon {
  display: grid;
  place-items: center;
  width: 31px;
  height: 31px;
  border-radius: 9px;
  background: var(--gt-orange-soft);
  color: var(--gt-orange);
}

.guarantee__item-icon svg {
  width: 16px;
  height: 16px;
}

.guarantee__item-title {
  margin-top: 15px;
  font-size: 13px;
  line-height: 1.3;
}

.guarantee__item-text {
  margin-top: 7px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--gt-muted);
}

/* ---- Actions ---- */

.guarantee__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px 20px;
  margin-top: 28px;
}

.guarantee__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 50px;
  padding: 0 26px;
  border: 0;
  border-radius: 999px;
  background: var(--gt-orange);
  color: var(--gt-white);
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.2;
  text-decoration: none;
  box-shadow: 0 8px 22px rgba(242, 106, 33, 0.34);
  transition: transform 0.16s ease, background-color 0.16s ease, box-shadow 0.16s ease;
}

.guarantee__btn:hover {
  background: #e35c12;
  transform: translateY(-1px);
  box-shadow: 0 10px 26px rgba(242, 106, 33, 0.42);
}

.guarantee__btn:active {
  transform: translateY(0);
}

.guarantee__btn svg {
  flex: 0 0 auto;
  width: 15px;
  height: 15px;
}

.guarantee__note {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  line-height: 1.4;
  color: var(--gt-muted);
}

.guarantee__note svg {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  color: #9aa8c0;
}

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */

@media screen and (max-width: 899px) {
  .guarantee__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 26px;
    justify-items: start;
  }
}

@media screen and (max-width: 767px) {
  .guarantee {
    --gt-gutter: 20px;
    --gt-medallion: min(var(--gt-medallion-set, 150px), 36vw);
  }

  .guarantee__text {
    max-width: none;
  }

  .guarantee__actions {
    gap: 14px;
  }

  .guarantee__btn {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .guarantee *,
  .guarantee *::before,
  .guarantee *::after {
    transition-duration: 0.001ms !important;
  }
}
{% endstyle %}

{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'item'

  assign root_classes = 'guarantee'
  unless s.show_dash
    assign root_classes = root_classes | append: ' guarantee--no-dash'
  endunless
  unless s.show_medallion
    assign root_classes = root_classes | append: ' guarantee--no-medallion'
  endunless
  unless s.show_glow
    assign root_classes = root_classes | append: ' guarantee--no-glow'
  endunless

  comment
    The CTA either scrolls to an anchor on the page or navigates to a URL.
    A merchant may type the anchor with or without its leading #, so normalise
    it rather than rendering a broken relative link.
  endcomment
  assign cta_href = s.button_url
  if s.link_type == 'anchor'
    assign anchor_value = s.anchor_id | strip
    if anchor_value == blank
      assign anchor_value = '#main-product'
    endif
    assign anchor_first = anchor_value | slice: 0
    unless anchor_first == '#'
      assign anchor_value = '#' | append: anchor_value
    endunless
    assign cta_href = anchor_value
  endif
-%}

<div
  class="{{ root_classes }}"
  id="guarantee-{{ section.id }}"
  data-guarantee-root
  data-scroll-offset="{{ s.scroll_offset }}"
  style="
    --gt-bg: {{ s.color_bg }};
    --gt-card: {{ s.color_card }};
    --gt-navy: {{ s.color_navy }};
    --gt-orange: {{ s.color_orange }};
    --gt-orange-soft: {{ s.color_orange_soft }};
    --gt-muted: {{ s.color_muted }};
    --gt-card-max: {{ s.card_max_width }}px;
    --gt-card-radius: {{ s.card_radius }}px;
    --gt-medallion-set: {{ s.medallion_size }}px;
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <div class="guarantee__container">
    <div class="guarantee__card">
      <div class="guarantee__grid">
        {%- if s.show_medallion -%}
          <div class="guarantee__medallion-col">
            <div class="guarantee__medallion">
              {%- if s.medallion_number != blank -%}
                <span class="guarantee__number">{{ s.medallion_number }}</span>
              {%- endif -%}
              {%- if s.medallion_unit != blank -%}
                <span class="guarantee__unit">{{ s.medallion_unit }}</span>
              {%- endif -%}
              {%- if s.medallion_caption != blank -%}
                <span class="guarantee__caption">{{ s.medallion_caption }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="guarantee__content">
          {%- if s.eyebrow != blank -%}
            <p class="guarantee__eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}

          {%- if s.title != blank -%}
            <h2 class="guarantee__title">{{ s.title | escape }}</h2>
          {%- endif -%}

          {%- if s.text != blank -%}
            <div class="guarantee__text">{{ s.text }}</div>
          {%- endif -%}

          {%- if items.size > 0 -%}
            <ul class="guarantee__items">
              {%- for block in items -%}
                <li class="guarantee__item" {{ block.shopify_attributes }}>
                  <span class="guarantee__item-icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'calendar' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.8" y="4.2" width="14.4" height="13" rx="2.6"/><path d="M2.8 8.4h14.4M6.6 2.6v3.2M13.4 2.6v3.2"/><path d="M7.4 12.6l1.7 1.7 3.5-3.6"/></svg>
                      {%- when 'message' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6.2a2.4 2.4 0 012.4-2.4h9.2A2.4 2.4 0 0117 6.2v6a2.4 2.4 0 01-2.4 2.4H8.2L4.4 17.2v-2.6H5.4A2.4 2.4 0 013 12.2z"/><path d="M7 9.2h6"/></svg>
                      {%- when 'heart' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 16.8s-6.4-4-6.4-8.2A3.6 3.6 0 0110 6.2a3.6 3.6 0 016.4 2.4c0 4.2-6.4 8.2-6.4 8.2z"/><path d="M7.6 9.6l1.6 1.6 3-3"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.4l6 2.2v5.1c0 3.5-2.4 6.6-6 7.9-3.6-1.3-6-4.4-6-7.9V4.6z"/><path d="M7.4 10l1.9 1.9 3.4-3.6"/></svg>
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.9 5.4h9.3v8.2H1.9zM11.2 8.2h3.4l2.9 2.8v2.6h-6.3z"/><circle cx="5.6" cy="15.1" r="1.6"/><circle cx="14.1" cy="15.1" r="1.6"/></svg>
                      {%- when 'refresh' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16.6 8.4A6.8 6.8 0 004.6 5.6M3.4 11.6a6.8 6.8 0 0012 2.8"/><path d="M16.8 3.6v4.8H12M3.2 16.4v-4.8H8"/></svg>
                      {%- when 'wallet' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.6" y="4.8" width="14.8" height="11" rx="2.6"/><path d="M2.6 8.6h14.8"/><circle cx="13.8" cy="12" r="1.1" fill="currentColor" stroke="none"/></svg>
                      {%- when 'clock' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M10 5.6V10l3 1.9"/></svg>
                      {%- when 'sparkle' -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.6l1.9 4.7 4.7 1.9-4.7 1.9L10 15.8l-1.9-4.8L3.4 9.2l4.7-1.9z"/><path d="M15.8 13.6l.8 1.8 1.8.8-1.8.8-.8 1.8-.8-1.8-1.8-.8 1.8-.8z"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M6.7 10.2l2.2 2.2 4.4-4.6"/></svg>
                    {%- endcase -%}
                  </span>
                  {%- if block.settings.title != blank -%}
                    <h3 class="guarantee__item-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="guarantee__item-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if s.show_button and s.button_label != blank -%}
            <div class="guarantee__actions">
              <a
                class="guarantee__btn"
                href="{{ cta_href | default: '#' }}"
                {% if s.link_type == 'anchor' %}data-guarantee-anchor{% endif %}
              >
                <span>{{ s.button_label }}</span>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.8 8h10.4M9 3.8L13.2 8 9 12.2"/></svg>
              </a>

              {%- if s.note_text != blank -%}
                <span class="guarantee__note">
                  {%- case s.note_icon -%}
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1.9 5.4h9.3v8.2H1.9zM11.2 8.2h3.4l2.9 2.8v2.6h-6.3z"/><circle cx="5.6" cy="15.1" r="1.6"/><circle cx="14.1" cy="15.1" r="1.6"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M10 5.6V10l3 1.9"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.4l6 2.2v5.1c0 3.5-2.4 6.6-6 7.9-3.6-1.3-6-4.4-6-7.9V4.6z"/><path d="M7.4 10l1.9 1.9 3.4-3.6"/></svg>
                    {%- when 'check' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M6.7 10.2l2.2 2.2 4.4-4.6"/></svg>
                  {%- endcase -%}
                  <span>{{ s.note_text }}</span>
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  The CTA behaviour lives here rather than in an asset file: a missing or
  stale assets/*.js fails silently (the link just does nothing), and this
  section only needs ~60 lines. Runs after the markup above, so the element
  it looks up already exists.
{%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById('guarantee-{{ section.id }}');
    if (!root || root.dataset.guaranteeReady === 'true') return;
    root.dataset.guaranteeReady = 'true';

    /* Tried in order when the configured anchor is not on the page, which is
       the normal case on a theme that has its own product section. Ordered
       from this theme's own markers to ones nearly every product page has. */
    var FALLBACKS = [
      '#main-product',
      '[data-pdp-root]',
      'product-info',
      '[id^="MainProduct-"]',
      '[id^="ProductInfo-"]',
      '.product__info-wrapper',
      '.product__info-container',
      'form[action*="/cart/add"]',
      'main .product',
      '.shopify-section--main-product'
    ];

    var offset = parseInt(root.getAttribute('data-scroll-offset'), 10);
    if (isNaN(offset)) offset = 0;

    function query(selector) {
      try {
        return document.querySelector(selector);
      } catch (error) {
        return null; // a merchant-typed anchor may not be a valid selector
      }
    }

    function resolve(hash) {
      if (hash && hash.length > 1) {
        var exact = query(hash);
        if (exact && !root.contains(exact)) return { el: exact, exact: true };
      }
      for (var i = 0; i < FALLBACKS.length; i++) {
        var el = query(FALLBACKS[i]);
        if (el && !root.contains(el)) return { el: el, exact: false };
      }
      return null;
    }

    root.addEventListener('click', function (event) {
      var link = event.target.closest && event.target.closest('[data-guarantee-anchor]');
      if (!link || !root.contains(link)) return;

      var hash = link.getAttribute('href') || '';
      var found = resolve(hash);
      event.preventDefault();

      if (!found) {
        console.warn(
          '[guarantee] Aucune cible trouvee pour "' + hash + '". Verifie que cet ' +
            'identifiant existe sur la page, ou change l\'ancre dans les reglages ' +
            'de la section. Selecteurs de repli essayes : ' + FALLBACKS.join(', ')
        );
        return;
      }

      var top = found.el.getBoundingClientRect().top + window.pageYOffset - offset;
      window.scrollTo({
        top: top < 0 ? 0 : top,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth'
      });

      /* Keyboard and screen-reader users must follow the scroll too. */
      if (!found.el.hasAttribute('tabindex')) found.el.setAttribute('tabindex', '-1');
      found.el.focus({ preventScroll: true });

      /* Only advertise the anchor in the URL when it is the one actually used. */
      if (found.exact && window.history && window.history.replaceState) {
        window.history.replaceState(null, '', hash);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Garantie",
  "tag": "section",
  "class": "guarantee-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Essai sans risque" },
    { "type": "checkbox", "id": "show_dash", "label": "Tiret orange avant le surtitre", "default": true },
    { "type": "text", "id": "title", "label": "Titre", "default": "100 jours pour tomber amoureux." },
    {
      "type": "richtext",
