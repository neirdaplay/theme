      "default": true
    },
    { "type": "text", "id": "cart_label", "label": "Panier (accessibilité)", "default": "Panier" },
    { "type": "checkbox", "id": "show_account", "label": "Compte", "default": true },
    { "type": "text", "id": "account_label", "label": "Compte (accessibilité)", "default": "Mon compte" },
    { "type": "checkbox", "id": "show_flag", "label": "Drapeau", "default": true },
