    { "type": "text", "id": "menu_label", "label": "Titre du menu", "default": "Menu" },
    { "type": "text", "id": "all_label", "label": "Lien « tout voir »", "info": "[titre] est remplacé par le nom de la rubrique.", "default": "Voir tout : [titre]" },
    { "type": "text", "id": "close_label", "label": "Fermer (accessibilité)", "default": "Fermer le menu" },

    {
      "type": "header",
