    { "type": "text", "id": "logo_sub", "label": "Ligne sous le logo texte", "default": "Footwear" },
    { "type": "range", "id": "logo_width", "label": "Largeur du logo (bureau)", "min": 60, "max": 300, "step": 5, "unit": "px", "default": 150 },
    { "type": "range", "id": "logo_width_mobile", "label": "Largeur du logo (mobile)", "min": 60, "max": 240, "step": 5, "unit": "px", "default": 120 },
    { "type": "range", "id": "logo_text_size", "label": "Taille du logo texte (bureau)", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "logo_text_size_mobile", "label": "Taille du logo texte (mobile)", "min": 14, "max": 36, "step": 1, "unit": "px", "default": 22 },

    {
      "type": "header",
