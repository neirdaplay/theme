    { "type": "text", "id": "search_placeholder", "label": "Texte d'invite", "default": "Recherche" },
    { "type": "text", "id": "search_label", "label": "Libellé (accessibilité)", "default": "Rechercher" },
    { "type": "range", "id": "search_width", "label": "Largeur du champ", "min": 140, "max": 420, "step": 10, "unit": "px", "default": 220 },

    {
