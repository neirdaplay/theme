{%- capture hk_stars_row -%}{{ hk_star }}{{ hk_star }}{{ hk_star }}{{ hk_star }}{{ hk_star }}{%- endcapture -%}
{%- capture hk_check -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>{%- endcapture -%}
{%- capture hk_chevron -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4"/></svg>{%- endcapture -%}
{%- capture hk_left -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3.5L5.5 8l4.5 4.5"/></svg>{%- endcapture -%}
{%- capture hk_right -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3.5L10.5 8 6 12.5"/></svg>{%- endcapture -%}
{%- capture hk_close -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/></svg>{%- endcapture -%}
{%- capture hk_arrow -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.8 8h10.4M9 3.8L13.2 8 9 12.2"/></svg>{%- endcapture -%}
{%- capture hk_bag -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5.2 7.5h13.6l-1 12.3H6.2z"/><path d="M8.7 9.4V6.6a3.3 3.3 0 016.6 0v2.8"/></svg>{%- endcapture -%}
{%- capture hk_box -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/></svg>{%- endcapture -%}
{%- capture hk_shield -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.4l7.6 2.8v6c0 4.7-3.2 8.6-7.6 10.4C7.6 19.8 4.4 15.9 4.4 11.2v-6z"/><path d="M8.6 11.8l2.5 2.5 4.5-4.6"/></svg>{%- endcapture -%}
{%- capture hk_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7z"/><circle cx="6.5" cy="18.5" r="1.8"/><circle cx="17" cy="18.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture hk_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.2"/><path d="M12 6.6V12l3.6 2.2"/></svg>{%- endcapture -%}

<div
  class="{{ root_classes }}"
  id="hkf-{{ section.id }}"
  data-hkf-root
  style="
    --hk-ink: {{ s.color_ink }};
    --hk-muted: {{ s.color_muted }};
    --hk-line: {{ s.color_line }};
    --hk-soft: {{ s.color_soft }};
    --hk-accent: {{ s.color_accent }};
    --hk-green: {{ s.color_green }};
    --hk-green-soft: {{ s.color_green_soft }};
    --hk-price: {{ s.color_price }};
    --hk-star: {{ s.color_star }};
    --hk-added: {{ s.color_added }};
    --hk-red: {{ s.color_red }};
    --hk-red-rgb: {{ s.color_red.red }}, {{ s.color_red.green }}, {{ s.color_red.blue }};
    --hk-red-soft: {{ s.color_red_soft }};
    --hk-flag-bg: {{ s.color_flag_bg }};
    --hk-flag-ink: {{ s.color_flag_ink }};
    --hk-save-bg: {{ s.color_save_bg }};
    --hk-save-ink: {{ s.color_save_ink }};
    --hk-offer-img: {{ s.offer_img_size }}px;
    --hk-offer-img-m: {{ s.offer_img_size_mobile }}px;
    --hk-offer-title: {{ s.offer_title_size }}px;
    --hk-offer-title-m: {{ s.offer_title_size_mobile }}px;
    --hk-offer-price: {{ s.offer_price_size }}px;
    --hk-offer-price-m: {{ s.offer_price_size_mobile }}px;
    --hk-rating-gap: {{ s.rating_gap }}px;
    --hk-max: {{ s.container_width }}px;
    --hk-radius: {{ s.gallery_radius }}px;
    --hk-thumb-set: {{ s.thumb_size }}px;
    --hk-stage-ratio-set: {{ s.gallery_ratio }};
    --hk-stage-ratio-m: {{ s.gallery_ratio_mobile }};
    --hk-stage-fit-set: {{ s.gallery_fit }};
    --hk-sticky-top: {{ s.sticky_top }}px;
    --hk-stack-gap: {{ s.stack_gap }}px;
    --hk-ugc: {{ s.ugc_width }}px;
    --hk-guide-width: {{ s.guide_width }}px;
    --hk-face: {{ s.bought_face_size }}px;
    --hk-bought-size: {{ s.bought_size }}px;
    background: {{ s.color_bg }};
    --hk-pad-top: {{ s.padding_top }}px;
    --hk-pad-bottom: {{ s.padding_bottom }}px;
    --hk-pad-top-m: {{ s.padding_top_mobile }}px;
    --hk-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
  "
>
  {%- comment -%}
    Everything the script needs: the variant matrix so a pair's dropdowns can
    be resolved to a real variant, and the money format so totals computed in
    the browser read exactly like the ones Liquid printed.
  {%- endcomment -%}
  <script type="application/json" data-hkf-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "rootUrl": {{ routes.root_url | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "afterAdd": {{ s.after_add_action | json }},
      "addedDelay": {{ s.added_delay | json }},
      "pairsMax": {{ s.pairs_max | json }},
      "optionNames": {{ product.options | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id | json }},
            "options": {{ v.options | json }},
            "price": {{ v.price | json }},
            "compareAt": {{ v.compare_at_price | default: 0 | json }},
            "available": {{ v.available | json }},
            "image": {%- if v.image -%}{{ v.image | image_url: width: 200 | json }}{%- else -%}null{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "strings": {
        "error": {{ s.error_label | json }},
        "soldOut": {{ s.sold_out_label | json }},
        "buy": {{ s.buy_label | json }},
        "save": {{ s.save_label | json }}
      }
    }
  </script>

  <div class="hkf__container">
    <div class="hkf__grid">
      {%- comment -%} ================= Gallery ================= {%- endcomment -%}
      {%- liquid
        assign gallery_classes = 'hkf__gallery'
        unless s.gallery_bleed == 'none'
          assign gallery_classes = gallery_classes | append: ' hkf__gallery--bleed-' | append: s.gallery_bleed
        endunless
      -%}
      <div class="{{ gallery_classes }}">
        <div class="hkf__stage">
          <div class="hkf__track" data-hkf-track>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 12 -%}
                {%- liquid
                  assign img = media.preview_image
                  assign img_h = 1000
                  if img.aspect_ratio > 0
                    assign img_h = 1000 | divided_by: img.aspect_ratio | round
                  endif
                  assign img_loading = 'lazy'
                  if forloop.first
                    assign img_loading = 'eager'
                  endif
                -%}
                <div
                  class="hkf__slide"
                  data-hkf-slide="{{ forloop.index0 }}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                >
                  {{
                    img
                    | image_url: width: 1000
                    | image_tag:
                      width: 1000,
                      height: img_h,
                      widths: '400,600,800,1000',
                      sizes: '(min-width: 900px) 50vw, 100vw',
                      loading: img_loading,
                      alt: img.alt
                  }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="hkf__slide">
                <div class="hkf__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              </div>
            {%- endif -%}
          </div>

          {%- if s.show_arrows and product.media.size > 1 -%}
            <button type="button" class="hkf__nav hkf__nav--prev" data-hkf-nav="-1" aria-label="{{ s.gallery_prev_label }}" hidden>
              {{ hk_left }}
            </button>
            <button type="button" class="hkf__nav hkf__nav--next" data-hkf-nav="1" aria-label="{{ s.gallery_next_label }}">
              {{ hk_right }}
            </button>
          {%- endif -%}
        </div>

        {%- comment -%} Thumbnails under the image, not stacked beside it. {%- endcomment -%}
        {%- if s.show_thumbs and product.media.size > 1 -%}
          <div class="hkf__thumbs" role="tablist" aria-label="{{ s.thumbs_aria_label }}">
            {%- for media in product.media limit: 12 -%}
              <button
                type="button"
                class="hkf__thumb"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-hkf-thumb="{{ forloop.index0 }}"
                aria-label="{{ s.thumbs_item_label }} {{ forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 200 | image_tag: width: 100, height: 100, loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ================= Info ================= {%- endcomment -%}
      <div class="hkf__info">
        {%- if s.show_bought and s.bought_text != blank -%}
          {%- comment -%}
            Les visages sont trois réglages distincts, lus par clé pour ne pas
            recopier trois fois le même balisage. Sans aucune photo, la ligne
            garde l'icône panier d'origine.
          {%- endcomment -%}
          {%- capture bought_faces -%}
            {%- for i in (1..3) -%}
              {%- assign face_key = 'bought_face_' | append: i -%}
              {%- assign face = s[face_key] -%}
              {%- if face != blank -%}
                <span class="hkf__face">
                  {{- face | image_url: width: 140 | image_tag: width: 70, height: 70, loading: 'lazy', alt: '' -}}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- assign bought_faces = bought_faces | strip -%}
          <p class="hkf__bought">
            {%- if bought_faces != blank -%}
              <span class="hkf__faces" aria-hidden="true">{{ bought_faces }}</span>
            {%- else -%}
              {{ hk_bag }}
            {%- endif -%}
            <span>{{ s.bought_text }}</span>
          </p>
        {%- endif -%}

        <div class="hkf__head">
          {%- if s.show_title -%}
            <h1 class="hkf__title">{{ product.title | escape }}</h1>
          {%- endif -%}
          {%- if s.show_price -%}
            {%- liquid
              comment
                times: 100.0 force le calcul en virgule flottante : avec deux
                entiers, Liquid ferait une division entière et le pourcentage
                dépendrait du moteur.
              endcomment
              assign save_pct = 0
              if variant.compare_at_price > variant.price
                assign save_gap = variant.compare_at_price | minus: variant.price
                assign save_pct = save_gap | times: 100.0 | divided_by: variant.compare_at_price | round
              endif
            -%}
            <span class="hkf__prices">
              <span class="hkf__price" data-hkf-price>{{ variant.price | money }}</span>
              <s class="hkf__was" data-hkf-was {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>
                {{- variant.compare_at_price | money -}}
              </s>
              {%- if s.show_save -%}
                <span
                  class="hkf__save"
                  data-hkf-save
                  {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}
                >
                  {{- s.save_label | replace: '[x]', save_pct -}}
                </span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- Rating and review card ---------- {%- endcomment -%}
        {%- if s.show_rating -%}
          <div class="hkf__rating">
            {%- if rating_num > 0 -%}
              <span class="hkf__stars" style="--hk-star-pct: {{ rating_pct }}%; --hk-star-size: 15px;" role="img" aria-label="{{ s.rating_aria_label }}">
                <span class="hkf__stars-row hkf__stars-row--empty" aria-hidden="true">{{ hk_stars_row }}</span>
                <span class="hkf__stars-row hkf__stars-row--full" aria-hidden="true">{{ hk_stars_row }}</span>
              </span>
            {%- endif -%}
            <button
              type="button"
              class="hkf__rating-toggle"
              aria-expanded="false"
              aria-controls="hkf-revpop-{{ section.id }}"
              data-hkf-reviews-toggle
            >
              <span>{{ s.rating_summary | replace: '[score]', s.rating_score | replace: '[count]', s.rating_count }}</span>
              {{ hk_chevron }}
            </button>

            <div class="hkf__revpop" id="hkf-revpop-{{ section.id }}" data-hkf-revpop hidden>
              <button type="button" class="hkf__revpop-close" data-hkf-reviews-close aria-label="{{ s.close_label }}">
                {{ hk_close }}
              </button>

              <div class="hkf__revpop-head">
                <span class="hkf__revpop-score">{{ s.rating_score }}</span>
                {%- if rating_num > 0 -%}
                  <span class="hkf__stars" style="--hk-star-pct: {{ rating_pct }}%; --hk-star-size: 14px;" aria-hidden="true">
                    <span class="hkf__stars-row hkf__stars-row--empty">{{ hk_stars_row }}</span>
                    <span class="hkf__stars-row hkf__stars-row--full">{{ hk_stars_row }}</span>
                  </span>
                {%- endif -%}
                <span>{{ s.rating_based_on | replace: '[count]', s.rating_count }}</span>
              </div>

              {%- comment -%}
                Five buckets, 5 stars down to 1. The counts are typed, and the
                bar widths are worked out from their share of the total.
              {%- endcomment -%}
              {%- liquid
                assign c5 = s.stars_5 | plus: 0
                assign c4 = s.stars_4 | plus: 0
                assign c3 = s.stars_3 | plus: 0
                assign c2 = s.stars_2 | plus: 0
                assign c1 = s.stars_1 | plus: 0
                assign c_total = c5 | plus: c4 | plus: c3 | plus: c2 | plus: c1 | at_least: 1
              -%}
              {%- if c_total > 1 -%}
                <div class="hkf__bars">
                  {%- for level in (1..5) -%}
                    {%- liquid
                      assign star_n = 6 | minus: level
                      case star_n
                        when 5
                          assign bucket = c5
                        when 4
                          assign bucket = c4
                        when 3
                          assign bucket = c3
                        when 2
                          assign bucket = c2
                        else
                          assign bucket = c1
                      endcase
                      assign pct = bucket | times: 100.0 | divided_by: c_total
                    -%}
                    <div class="hkf__bar">
                      <span class="hkf__bar-label">{{ star_n }}{{ hk_star }}</span>
                      <span class="hkf__bar-track"><span class="hkf__bar-fill" style="width: {{ pct }}%;"></span></span>
                      <span class="hkf__bar-count">({{ bucket }})</span>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if reviews.size > 0 -%}
                <div class="hkf__revpop-sep" aria-hidden="true"></div>
                {%- for block in reviews -%}
                  <div class="hkf__review" data-hkf-review="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
                    <div class="hkf__review-top">
                      {%- if block.settings.image != blank -%}
                        <span class="hkf__review-photo">
                          {{ block.settings.image | image_url: width: 200 | image_tag: width: 100, height: 100, loading: 'lazy', alt: '' }}
                        </span>
                      {%- endif -%}
                      <span class="hkf__review-body">
                        <span class="hkf__review-name">
                          <span>{{ block.settings.name }}</span>
                          {%- if s.reviews_all_url != blank -%}
                            <a class="hkf__review-all" href="{{ s.reviews_all_url }}">{{ s.reviews_all_label }} ›</a>
                          {%- endif -%}
                        </span>
                        <span class="hkf__review-text">{{ block.settings.text }}</span>
                      </span>
                    </div>
                  </div>
                {%- endfor -%}

                {%- if reviews.size > 1 -%}
                  <div class="hkf__revpop-nav">
                    <button type="button" class="hkf__revpop-arrow" data-hkf-review-prev aria-label="{{ s.reviews_prev_label }}">{{ hk_left }}</button>
                    <div class="hkf__revpop-dots">
                      {%- for block in reviews -%}
                        <button
                          type="button"
                          class="hkf__revpop-dot"
                          data-hkf-review-dot="{{ forloop.index0 }}"
                          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                          aria-label="{{ s.reviews_go_label }} {{ forloop.index }}"
                        ></button>
                      {%- endfor -%}
                    </div>
                    <button type="button" class="hkf__revpop-arrow" data-hkf-review-next aria-label="{{ s.reviews_next_label }}">{{ hk_right }}</button>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ---------- Sell-out risk ---------- {%- endcomment -%}
        {%- if s.show_risk and s.risk_label != blank -%}
          <div class="hkf__risk">
            <button
              type="button"
              class="hkf__risk-trigger"
              aria-expanded="{{ s.risk_open }}"
              aria-controls="hkf-risk-{{ section.id }}"
              data-hkf-risk
            >
              <span class="hkf__risk-dot" aria-hidden="true"></span>
              <span>{{ s.risk_label }}</span>
              {{ hk_chevron }}
            </button>
            <div class="hkf__risk-panel" id="hkf-risk-{{ section.id }}" data-hkf-risk-panel {% unless s.risk_open %}hidden{% endunless %}>
              <div class="hkf__risk-inner">{{ s.risk_text }}</div>
            </div>
          </div>
        {%- endif -%}

        {%- if s.show_bullets and bullets.size > 0 -%}
          <ul class="hkf__bullets">
            {%- for block in bullets -%}
              <li {{ block.shopify_attributes }}>
                <span class="hkf__bullets-ic" aria-hidden="true">{{ hk_check }}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} ---------- Variant pickers ---------- {%- endcomment -%}
        {%- if s.show_picker and product.options.size > 0 -%}
          <div class="hkf__picker">
            {%- for option in product.options_with_values -%}
              {%- comment -%}
                The option's position is captured here rather than read back
                through forloop.parentloop inside the values loop, which does
                not resolve reliably.
              {%- endcomment -%}
              {%- assign opt_index = forloop.index0 -%}
              {%- assign opt_current = variant.options[opt_index] -%}
              {%- if forloop.first -%}
                {%- comment -%}
                  First option as image swatches: one variant per value gives
                  the picture, which is what a colour row needs.
                {%- endcomment -%}
                <div class="hkf__swatches" role="radiogroup" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    {%- comment -%}
                      Variants carry option1/2/3, never a property named after
                      the option, so the swatch image is found through option1.
                    {%- endcomment -%}
                    {%- assign match = product.variants | where: 'option1', value | first -%}
                    <button
                      type="button"
                      class="hkf__swatch"
                      role="radio"
                      aria-checked="{% if value == opt_current %}true{% else %}false{% endif %}"
                      tabindex="{% if value == opt_current %}0{% else %}-1{% endif %}"
                      data-hkf-opt="{{ opt_index }}"
                      data-hkf-value="{{ value | escape }}"
                      aria-label="{{ value }}"
                    >
                      {%- if match.image != blank -%}
                        {{ match.image | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'lazy', alt: '' }}
                      {%- else -%}
                        <span class="hkf__swatch-blank"></span>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="hkf__sizes" role="radiogroup" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="hkf__size"
                      role="radio"
                      aria-checked="{% if value == opt_current %}true{% else %}false{% endif %}"
                      tabindex="{% if value == opt_current %}0{% else %}-1{% endif %}"
                      data-hkf-opt="{{ opt_index }}"
                      data-hkf-value="{{ value | escape }}"
                    >
                      {{- value -}}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- if s.show_chosen or s.show_sizeguide -%}
              <p class="hkf__chosen">
                {%- if s.show_chosen -%}
                  {%- comment -%}
                    Une paire par option, le libellé venant du nom de l'option
                    Shopify sauf si le marchand en a saisi un autre.
                  {%- endcomment -%}
                  <span class="hkf__chosen-list" data-hkf-chosen>
                    {%- for option in product.options_with_values -%}
                      {%- liquid
                        assign opt_i = forloop.index0
                        assign key = 'chosen_label_' | append: forloop.index
                        assign custom = s[key]
                        assign shown = custom | default: option.name
                      -%}
                      <span class="hkf__chosen-item">
                        {{- shown }}&nbsp;:<b data-hkf-chosen-value="{{ opt_i }}">
                          {{- variant.options[opt_i] -}}
                        </b>
                      </span>
                    {%- endfor -%}
                  </span>
                {%- else -%}
                  <span></span>
                {%- endif -%}

                {%- if s.show_sizeguide and s.sizeguide_label != blank -%}
                  {%- comment -%}
                    Une page choisie s'ouvre par-dessus ; sans page, le lien
                    reste un lien et emmène le client où il pointait.
                  {%- endcomment -%}
                  {%- if guide_page != blank -%}
                    <button
                      type="button"
                      class="hkf__guide-open"
                      data-hkf-guide-open
                      aria-haspopup="dialog"
                      aria-controls="hkf-guide-{{ section.id }}"
                    >
                      {{- s.sizeguide_label -}}
                    </button>
                  {%- elsif s.sizeguide_url != blank -%}
                    <a href="{{ s.sizeguide_url }}">{{ s.sizeguide_label }}</a>
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.show_finder and s.finder_label != blank -%}
          <button type="button" class="hkf__finder" data-hkf-finder>{{ s.finder_label }}</button>
        {%- endif -%}

        {%- if s.show_endorse and s.endorse_text != blank -%}
          <div class="hkf__endorse">
            {%- if s.endorse_logo != blank -%}
              {{ s.endorse_logo | image_url: width: 160 | image_tag: width: 80, height: 24, loading: 'lazy', alt: '' }}
            {%- endif -%}
            <span>{{ s.endorse_text }}</span>
          </div>
        {%- endif -%}

        {%- comment -%} ---------- Bundles ---------- {%- endcomment -%}
        {%- if s.show_bundle and offers.size > 0 -%}
          <div class="hkf__bundle" data-hkf-bundle>
            {%- if s.bundle_note != blank -%}
              <p class="hkf__bundle-note">{{ s.bundle_note }}</p>
            {%- endif -%}

            {%- comment -%}
              Quelle offre est cochée à l'ouverture : celle marquée par défaut,
              sinon celle à une seule paire si le marchand en a gardé une.
              Sinon aucune (-1) : ne rien cocher, c'est déjà commander une
              paire, et le dépliant des couleurs n'a alors rien à demander.
            {%- endcomment -%}
            {%- liquid
              assign default_offer = -1
              for block in offers
                if block.settings.is_default and default_offer < 0
                  assign default_offer = forloop.index0
                endif
              endfor
              if default_offer < 0
                for block in offers
                  assign o_qty = block.settings.pairs | at_least: 1
                  if o_qty == 1 and default_offer < 0
                    assign default_offer = forloop.index0
                  endif
                endfor
              endif
            -%}
            <div class="hkf__offers" role="radiogroup" aria-label="{{ s.bundle_aria_label }}" data-hkf-default-offer="{{ default_offer }}">
              {%- for block in offers -%}
                {%- liquid
                  assign b = block.settings
                  assign qty = b.pairs | at_least: 1

                  comment
                    Le plein tarif de référence : le prix barré de la variante
                    s'il existe, sinon son prix de vente.
                  endcomment
                  assign base = variant.price
                  assign base_was = variant.compare_at_price
                  if base_was <= base
                    assign base_was = base
                  endif

                  assign disc_raw = b.discount_value | strip | replace: ' ', '' | replace: '%', '' | replace: '€', '' | replace: ',', '.'
                  assign disc_num = disc_raw | plus: 0.0

                  case b.discount_type
                    when 'percent'
                      assign cut = base | times: disc_num | divided_by: 100.0 | round
                      assign unit = base | minus: cut
                      assign unit_was = base_was
                    when 'amount'
                      assign cut = disc_num | times: 100 | round
                      assign unit = base | minus: cut
                      assign unit_was = base_was
                    else
                      comment
                        Mode manuel : les deux prix sont saisis tels quels.
                      endcomment
                      assign unit = b.unit_price | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                      if unit <= 0
                        assign unit = base
                      endif
                      assign unit_was = b.unit_compare | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                  endcase

                  if unit < 0
                    assign unit = 0
                  endif

                  comment
                    L'économie affichée est toujours calculée, jamais saisie :
                    elle ne peut donc pas contredire les prix voisins.
                  endcomment
                  assign offer_pct = 0
                  if unit_was > unit
                    assign offer_gap = unit_was | minus: unit
                    assign offer_pct = offer_gap | times: 100.0 | divided_by: unit_was | round
                  endif

                  comment
                    Une taille d'image propre à la carte, laissée à zéro pour
                    suivre le réglage de la section.
                  endcomment
                  assign card_style = ''
                  if b.img_size > 0
                    capture card_style
                      echo '--hk-card-img: '
                      echo b.img_size
                      echo 'px;'
                    endcapture
                  endif
                  if b.img_size_mobile > 0
                    capture card_style
                      echo card_style
                      echo '--hk-card-img-m: '
                      echo b.img_size_mobile
                      echo 'px;'
                    endcapture
                  endif
                -%}
                <button
                  type="button"
                  class="hkf__offer"
                  role="radio"
                  {% if card_style != blank %}style="{{ card_style }}"{% endif %}
                  {%- comment -%}
                    Aucune offre cochée : la première carte reste tout de même
                    atteignable au clavier, sinon le groupe serait injoignable.
                  {%- endcomment -%}
                  aria-checked="{% if forloop.index0 == default_offer %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.index0 == default_offer or default_offer < 0 and forloop.first %}0{% else %}-1{% endif %}"
                  data-hkf-offer="{{ forloop.index0 }}"
                  data-qty="{{ qty }}"
                  data-unit="{{ unit }}"
                  data-unit-was="{{ unit_was }}"
                  {%- comment -%}
                    La remise est portée par la carte, pas seulement calculée :
                    le prix doit suivre quand le client change de variante.
                  {%- endcomment -%}
                  data-disc-type="{{ b.discount_type }}"
                  data-disc-value="{{ disc_num }}"
                  data-code="{{ b.discount_code | strip | escape }}"
                  {{ block.shopify_attributes }}
                >
                  {%- comment -%}
                    Chaque bandeau peut porter ses propres couleurs. Laissées
                    vides, elles retombent sur celles de la section.
                  {%- endcomment -%}
                  {%- capture flag_style -%}
                    {%- if b.flag_bg != blank %}--hk-flag-bg: {{ b.flag_bg }};{% endif -%}
                    {%- if b.flag_ink != blank %}--hk-flag-ink: {{ b.flag_ink }};{% endif -%}
                  {%- endcapture -%}
                  <span class="hkf__offer-flag" {% if flag_style != blank %}style="{{ flag_style }}"{% endif %} {% if b.flag == blank %}hidden{% endif %}>{{ b.flag }}</span>
                  {%- if b.image != blank -%}
                    <span class="hkf__offer-img">
                      {{ b.image | image_url: width: 1000 | image_tag: widths: '200, 400, 700, 1000', loading: 'lazy', alt: '' }}
                    </span>
                  {%- endif -%}
                  <span class="hkf__offer-title">{{ b.title }}</span>
                  <span class="hkf__offer-price">
                    <s class="hkf__offer-was" data-hkf-offer-was {% unless unit_was > unit %}hidden{% endunless %}>
                      {{- unit_was | money -}}
                    </s>
                    <span class="hkf__offer-now" data-hkf-offer-now>{{ unit | money }}</span>
                    {%- if s.per_pair_label != blank or s.per_pair_short != blank -%}
                      {%- comment -%}
                        Les deux formulations coexistent dans le balisage ; la
                        requête média choisit celle qui tient. Aucune espace
                        entre elles, sinon la version masquée en laisserait une
                        derrière elle.
                      {%- endcomment -%}
                      <span class="hkf__offer-unit"
                        ><span class="hkf__offer-unit-long">{{ s.per_pair_label }}</span
                        ><span class="hkf__offer-unit-short">{{ s.per_pair_short }}</span
                      ></span>
                    {%- endif -%}
                  </span>
                  <span
                    class="hkf__offer-save"
                    data-hkf-offer-save="{{ b.save_label | escape }}"
                    {% if b.save_label == blank or offer_pct <= 0 %}hidden{% endif %}
                  >
                    {{- b.save_label | replace: '[x]', offer_pct -}}
                  </span>
                </button>
              {%- endfor -%}
            </div>

            {%- comment -%}
              One row per pair, each with the product's own option dropdowns.
              Rows are cloned from this template as the chosen quantity grows.
            {%- endcomment -%}
            <div class="hkf__pairs" data-hkf-pairs hidden>
              {%- if s.pairs_title != blank -%}
                <p class="hkf__pairs-title">{{ s.pairs_title }}</p>
              {%- endif -%}
              <div data-hkf-pair-list></div>
              <button type="button" class="hkf__pair-add" data-hkf-pair-add hidden>
                {{ s.pair_add_label }}
                {%- if s.pair_add_note != blank -%}<small>{{ s.pair_add_note }}</small>{%- endif -%}
              </button>
            </div>

            <template data-hkf-pair-template>
              <div class="hkf__pair" data-hkf-pair>
                <div class="hkf__pair-head">
                  <span data-hkf-pair-label></span>
                  <span class="hkf__pair-stock">{{ hk_check }}<span>{{ s.in_stock_label }}</span></span>
                  <button type="button" class="hkf__pair-remove" data-hkf-pair-remove aria-label="{{ s.pair_remove_label }}" hidden>
                    {{ hk_close }}
                  </button>
                </div>
                <div class="hkf__pair-body">
                  <span class="hkf__pair-img" data-hkf-pair-img></span>
                  <div class="hkf__pair-opts" data-hkf-pair-opts></div>
                </div>
              </div>
            </template>
          </div>
        {%- endif -%}

        {%- comment -%} ---------- Add to cart ---------- {%- endcomment -%}
        {%- if s.show_atc -%}
          <div class="hkf__atc">
            <button type="button" class="hkf__buy" data-hkf-add {% unless variant.available %}aria-disabled="true"{% endunless %}>
              <span class="hkf__buy-label" data-hkf-buy-label>
                {%- if variant.available -%}{{ s.buy_label }}{%- else -%}{{ s.sold_out_label }}{%- endif -%}
              </span>
              <span class="hkf__buy-price">
                <s class="hkf__buy-was" data-hkf-buy-was {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>
                  {{- variant.compare_at_price | money -}}
                </s>
                <span data-hkf-buy-total>{{ variant.price | money }}</span>
              </span>
              {{ hk_arrow }}
              {%- comment -%}
                L'état de confirmation. Il vit dans le bouton plutôt que de
                remplacer son contenu par du JS : le libellé reste traduisible
                depuis l'éditeur et rien n'est reconstruit à chaud.
              {%- endcomment -%}
              <span class="hkf__buy-done" data-hkf-buy-done aria-hidden="true">
                <span class="hkf__buy-tick">{{ hk_check }}</span>
                <span>{{ s.added_label }}</span>
              </span>
            </button>
            <p class="hkf__error" role="alert" data-hkf-error hidden></p>
          </div>
        {%- endif -%}

        {%- if s.show_reassure and reassurances.size > 0 -%}
          <ul class="hkf__reassure">
            {%- for block in reassurances -%}
              {%- liquid
                assign r = block.settings
                case r.icon
                  when 'box'
                    assign r_icon = hk_box
                  when 'shield'
                    assign r_icon = hk_shield
                  when 'truck'
                    assign r_icon = hk_truck
                  when 'clock'
                    assign r_icon = hk_clock
                  else
                    assign r_icon = hk_check
                endcase
              -%}
              <li {{ block.shopify_attributes }}>
                <span class="hkf__reassure-icon">
                  {%- if r.image != blank -%}
                    {{ r.image | image_url: width: 80 | image_tag: width: 40, height: 40, loading: 'lazy', alt: '' }}
                  {%- elsif r.flag != blank -%}
                    <span class="hkf__reassure-flag">{{ r.flag }}</span>
                  {%- elsif r.icon == 'pulse' -%}
                    <span class="hkf__pulse" data-hkf-pulse aria-hidden="true"></span>
                  {%- else -%}
                    {{ r_icon }}
                  {%- endif -%}
                </span>
                <span class="hkf__reassure-title">{{ r.title }}</span>
                {%- if r.text != blank -%}<span>{{ r.text }}</span>{%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} ---------- UGC ---------- {%- endcomment -%}
        {%- if s.show_ugc and ugcs.size > 0 -%}
          <div class="hkf__ugc">
            {%- if s.ugc_title != blank -%}
              <h2 class="hkf__ugc-title">{{ s.ugc_title }}</h2>
            {%- endif -%}
            <ul class="hkf__ugc-list">
              {%- for block in ugcs -%}
                <li {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: width: 200, height: 200, loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    ---------- Guide des tailles ----------
    Le contenu vient d'une page Shopify, rendue ici plutôt que chargée à la
    demande : rien à attendre au clic, et la page reste éditable là où le
    marchand a l'habitude de la modifier.
  {%- endcomment -%}
  {%- if s.show_sizeguide and guide_page != blank -%}
    <div class="hkf__guide" id="hkf-guide-{{ section.id }}" data-hkf-guide hidden>
      <div class="hkf__guide-scrim" data-hkf-guide-scrim></div>
      <div
        class="hkf__guide-panel"
        role="dialog"
        aria-modal="true"
        aria-label="{{ s.guide_title | default: guide_page.title | escape }}"
        data-hkf-guide-panel
      >
        <div class="hkf__guide-head">
          <h2 class="hkf__guide-title">{{ s.guide_title | default: guide_page.title }}</h2>
          <button
            type="button"
            class="hkf__guide-close"
            data-hkf-guide-close
            aria-label="{{ s.close_label | escape }}"
          >
            {{- hk_close -}}
          </button>
        </div>
        <div class="hkf__guide-body">
          {%- if s.guide_show_finder and s.finder_label != blank -%}
            <button type="button" class="hkf__finder" data-hkf-finder>{{ s.finder_label }}</button>
          {%- endif -%}
          <div class="hkf__guide-content" data-hkf-guide-content>
            {{ guide_page.content }}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('hkf-{{ section.id }}');
    if (!root || root.dataset.hkfReady === 'true') return;
    root.dataset.hkfReady = 'true';

    function $(sel, ctx) {
      return (ctx || root).querySelector(sel);
    }
    function $$(sel, ctx) {
      return Array.prototype.slice.call((ctx || root).querySelectorAll(sel));
    }

    var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var config;
    try {
      config = JSON.parse($('[data-hkf-config]').textContent);
    } catch (error) {
      console.warn('[hikefoot] configuration illisible', error);
      return;
    }

    /* ---------------- Money ----------------
       Totals are worked out in the browser, so they have to come back out in
       the shop's own format rather than a guess at it. */
    function formatMoney(cents) {
      var value = (cents || 0) / 100;

      function withDelimiters(precision, thousands, decimal) {
        var fixed = value.toFixed(precision);
        var parts = fixed.split('.');
        var whole = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        return parts[1] ? whole + decimal + parts[1] : whole;
      }

      /* No literal brace pattern is written here: Shopify's Liquid lexer
         stops a tag at the first closing brace, even inside a JS string. */
      var format = config.moneyFormat;
      if (!format) return withDelimiters(2, ',', '.');

      return format.replace(/\{\{\s*(\w+)\s*\}\}/g, function (_, name) {
        switch (name) {
          case 'amount':
            return withDelimiters(2, ',', '.');
          case 'amount_no_decimals':
            return withDelimiters(0, ',', '.');
          case 'amount_with_comma_separator':
            return withDelimiters(2, '.', ',');
          case 'amount_no_decimals_with_comma_separator':
            return withDelimiters(0, '.', ',');
          case 'amount_with_apostrophe_separator':
            return withDelimiters(2, "'", '.');
          case 'amount_with_space_separator':
            return withDelimiters(2, ' ', ',');
          case 'amount_no_decimals_with_space_separator':
            return withDelimiters(0, ' ', ',');
          default:
            return withDelimiters(2, ',', '.');
        }
      });
    }

    /* ---------------- Variant matrix ---------------- */

    var variants = config.variants || [];
    var optionCount = (config.optionNames || []).length;
    var current = variants[0] || null;

    /* The picker holds one chosen value per option; a variant is whichever
       row matches all of them. */
    var chosen = [];

    function findVariant(values) {
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var ok = true;
        for (var j = 0; j < values.length; j++) {
          if (v.options[j] !== values[j]) {
            ok = false;
            break;
          }
        }
        if (ok) return v;
      }
      return null;
    }

    /* ---------------- Sticky gallery guard ---------------- */

    if (root.classList.contains('hkf--sticky')) {
      var stickyCol = $('.hkf__gallery');
      if (stickyCol) {
        var measureSticky = function () {
          var top = parseInt(getComputedStyle(root).getPropertyValue('--hk-sticky-top'), 10) || 0;
          var fits = stickyCol.offsetHeight + top + 24 <= window.innerHeight;
          root.classList.toggle('hkf--sticky-off', !fits);
        };
        measureSticky();
        window.addEventListener('resize', measureSticky);
        window.addEventListener('load', measureSticky);
        if (window.ResizeObserver) new ResizeObserver(measureSticky).observe(stickyCol);
      }
    }

    /* ---------------- Gallery ---------------- */

    var thumbs = $$('[data-hkf-thumb]');
    var slides = $$('[data-hkf-slide]');
    var stage = $('.hkf__stage');
    var track = $('[data-hkf-track]');
    var navPrev = $('[data-hkf-nav="-1"]');
    var navNext = $('[data-hkf-nav="1"]');
    var slideIndex = 0;

    function shift(px, animate) {
      if (!track) return;
      track.classList.toggle('is-dragging', !animate);
      track.style.transform = 'translate3d(' + px + 'px, 0, 0)';
    }

    function goToSlide(index, animate) {
      if (!slides.length) return;
      var target = Number(index) || 0;
      /* The rail has two ends: clamp rather than wrap, or jumping from the
         last image to the first would sweep across every slide. */
      if (target < 0) target = 0;
      if (target > slides.length - 1) target = slides.length - 1;

      var stepMove = Math.abs(target - slideIndex) === 1;
      slideIndex = target;
      shift(-slideIndex * (stage ? stage.clientWidth : 0), stepMove && animate !== false && !REDUCED);

      slides.forEach(function (slide, i) {
        slide.setAttribute('aria-hidden', i === slideIndex ? 'false' : 'true');
      });
      if (navPrev) navPrev.hidden = slideIndex === 0;
      if (navNext) navNext.hidden = slideIndex === slides.length - 1;
      thumbs.forEach(function (thumb) {
        var active = thumb.getAttribute('data-hkf-thumb') === String(slideIndex);
        thumb.setAttribute('aria-selected', active ? 'true' : 'false');
        thumb.tabIndex = active ? 0 : -1;
        if (active && thumb.scrollIntoView) thumb.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
    }

    if (stage && window.ResizeObserver) {
      var lastWidth = stage.clientWidth;
      new ResizeObserver(function () {
        if (stage.clientWidth === lastWidth) return;
        lastWidth = stage.clientWidth;
        shift(-slideIndex * lastWidth, false);
      }).observe(stage);
    }

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        goToSlide(thumb.getAttribute('data-hkf-thumb'), true);
      });
    });

    if (thumbs.length) {
      thumbs[0].parentNode.addEventListener('keydown', function (event) {
        var i = thumbs.indexOf(document.activeElement);
        if (i === -1) return;
        var next = null;
        if (event.key === 'ArrowRight') next = Math.min(i + 1, thumbs.length - 1);
        else if (event.key === 'ArrowLeft') next = Math.max(i - 1, 0);
        else return;
        event.preventDefault();
        thumbs[next].focus();
        goToSlide(thumbs[next].getAttribute('data-hkf-thumb'), true);
      });
    }

    $$('[data-hkf-nav]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        goToSlide(slideIndex + Number(btn.getAttribute('data-hkf-nav')), true);
      });
    });

    /* ---- Swipe: touch only, and only once clearly horizontal ---- */
    if (stage && track && slides.length > 1) {
      var startX = 0;
      var startY = 0;
      var delta = 0;
      var tracking = false;
      var decided = false;

      stage.addEventListener(
        'touchstart',
        function (event) {
          if (event.touches.length !== 1) return;
          startX = event.touches[0].clientX;
          startY = event.touches[0].clientY;
          delta = 0;
          tracking = true;
          decided = false;
        },
        { passive: true }
      );

      stage.addEventListener(
        'touchmove',
        function (event) {
          if (!tracking) return;
          var dx = event.touches[0].clientX - startX;
          var dy = event.touches[0].clientY - startY;
          if (!decided) {
            if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
            decided = true;
            if (Math.abs(dx) <= Math.abs(dy)) {
              tracking = false;
              return;
            }
          }
          var atStart = slideIndex === 0 && dx > 0;
          var atEnd = slideIndex === slides.length - 1 && dx < 0;
          delta = atStart || atEnd ? dx / 3 : dx;
          shift(-slideIndex * stage.clientWidth + delta, false);
        },
        { passive: true }
      );

      var release = function () {
        if (!tracking && delta === 0) return;
        tracking = false;
        var width = stage.clientWidth || 1;
        var threshold = Math.min(60, width * 0.18);
        var next = slideIndex;
        if (Math.abs(delta) > threshold) next = slideIndex + (delta < 0 ? 1 : -1);
        delta = 0;
        if (next === slideIndex) shift(-slideIndex * width, !REDUCED);
        else goToSlide(next, true);
      };

      stage.addEventListener('touchend', release, { passive: true });
      stage.addEventListener('touchcancel', release, { passive: true });
    }

    /* ---------------- Review popover ---------------- */

    var revToggle = $('[data-hkf-reviews-toggle]');
    var revPop = $('[data-hkf-revpop]');

    if (revToggle && revPop) {
      var cards = $$('[data-hkf-review]', revPop);
      var dots = $$('[data-hkf-review-dot]', revPop);
      var reviewIndex = 0;

      var showReview = function (index) {
        if (!cards.length) return;
        reviewIndex = (index + cards.length) % cards.length;
        cards.forEach(function (card, i) {
          card.hidden = i !== reviewIndex;
        });
        dots.forEach(function (dot, i) {
          dot.setAttribute('aria-current', i === reviewIndex ? 'true' : 'false');
        });
      };

      var closeReviews = function (giveFocusBack) {
        revPop.hidden = true;
        revToggle.setAttribute('aria-expanded', 'false');
        if (giveFocusBack) revToggle.focus();
      };

      revToggle.addEventListener('click', function () {
        var open = revToggle.getAttribute('aria-expanded') === 'true';
        if (open) closeReviews(false);
        else {
          revPop.hidden = false;
          revToggle.setAttribute('aria-expanded', 'true');
        }
      });

      $$('[data-hkf-reviews-close]', revPop).forEach(function (el) {
        el.addEventListener('click', function () {
          closeReviews(true);
        });
      });

      var rPrev = $('[data-hkf-review-prev]', revPop);
      var rNext = $('[data-hkf-review-next]', revPop);
      if (rPrev) rPrev.addEventListener('click', function () { showReview(reviewIndex - 1); });
      if (rNext) rNext.addEventListener('click', function () { showReview(reviewIndex + 1); });
      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { showReview(i); });
      });

      document.addEventListener('keydown', function (event) {
        if (revPop.hidden || event.key !== 'Escape') return;
        event.preventDefault();
        closeReviews(true);
      });

      document.addEventListener('click', function (event) {
        if (revPop.hidden) return;
        if (revPop.contains(event.target) || revToggle.contains(event.target)) return;
        closeReviews(false);
      });
    }

    /* ---------------- Sell-out risk ---------------- */

    var riskTrigger = $('[data-hkf-risk]');
    var riskPanel = $('[data-hkf-risk-panel]');
    if (riskTrigger && riskPanel) {
      if (!riskPanel.hidden) riskPanel.style.height = 'auto';

      riskTrigger.addEventListener('click', function () {
        var open = riskTrigger.getAttribute('aria-expanded') === 'true';
        riskTrigger.setAttribute('aria-expanded', open ? 'false' : 'true');

        if (REDUCED) {
          riskPanel.hidden = open;
          return;
        }
        if (open) {
          riskPanel.style.height = riskPanel.scrollHeight + 'px';
          void riskPanel.offsetHeight;
          riskPanel.style.height = '0px';
          riskPanel.addEventListener('transitionend', function once(e) {
            if (e.propertyName !== 'height' || e.target !== riskPanel) return;
            riskPanel.hidden = true;
            riskPanel.removeEventListener('transitionend', once);
          });
        } else {
          riskPanel.hidden = false;
          var target = riskPanel.scrollHeight;
          riskPanel.style.height = '0px';
          void riskPanel.offsetHeight;
          riskPanel.style.height = target + 'px';
          riskPanel.addEventListener('transitionend', function once(e) {
            if (e.propertyName !== 'height' || e.target !== riskPanel) return;
            riskPanel.style.height = 'auto';
            riskPanel.removeEventListener('transitionend', once);
          });
        }
      });
    }

    /* ---------------- Bundle and pairs ---------------- */

    var bundle = $('[data-hkf-bundle]');
    var offers = $$('[data-hkf-offer]');
    var pairsBox = $('[data-hkf-pairs]');
    var pairList = $('[data-hkf-pair-list]');
    var pairTemplate = $('[data-hkf-pair-template]');
    var pairAdd = $('[data-hkf-pair-add]');
    /* L'offre cochée au chargement est celle que Liquid a désignée, pas
       forcément la première du groupe. */
    var offerGroup = $('[data-hkf-default-offer]');
    var offerIndex = offerGroup ? Number(offerGroup.getAttribute('data-hkf-default-offer')) || 0 : 0;

    var priceEl = $('[data-hkf-price]');
    var wasEl = $('[data-hkf-was]');
    var saveEl = $('[data-hkf-save]');
    var buyTotal = $('[data-hkf-buy-total]');
    var buyWas = $('[data-hkf-buy-was]');
    var buyLabel = $('[data-hkf-buy-label]');
    var chosenEl = $('[data-hkf-chosen]');
    var addButton = $('[data-hkf-add]');
    var errorBox = $('[data-hkf-error]');

    function currentOffer() {
      return offers[offerIndex] || null;
    }

    function offerQty() {
      var o = currentOffer();
      return o ? Number(o.getAttribute('data-qty')) || 1 : 1;
    }

    /**
     * Recalcule les prix des cartes d'offre à partir de la variante choisie.
     * Une remise saisie en pourcentage ou en montant doit suivre le prix réel
     * du produit : la figer au rendu la rendrait fausse dès que le client
     * change de couleur ou de pointure.
     */
    function repriceOffers() {
      if (!current) return;
      offers.forEach(function (offer) {
        var type = offer.getAttribute('data-disc-type');
        if (type !== 'percent' && type !== 'amount') return;

        var value = Number(offer.getAttribute('data-disc-value')) || 0;
        var base = current.price;
        var was = current.compareAt > base ? current.compareAt : base;
        var cut = type === 'percent' ? Math.round((base * value) / 100) : Math.round(value * 100);
        var unit = Math.max(0, base - cut);

        offer.setAttribute('data-unit', unit);
        offer.setAttribute('data-unit-was', was);

        var nowEl = offer.querySelector('[data-hkf-offer-now]');
        var wasEl = offer.querySelector('[data-hkf-offer-was]');
        var saveEl = offer.querySelector('[data-hkf-offer-save]');

        if (nowEl) nowEl.textContent = formatMoney(unit);
        if (wasEl) {
          wasEl.textContent = formatMoney(was);
          wasEl.hidden = !(was > unit);
        }
        if (saveEl) {
          var label = saveEl.getAttribute('data-hkf-offer-save') || '';
          var pct = was > unit ? Math.round(((was - unit) / was) * 100) : 0;
          saveEl.hidden = !label || pct <= 0;
          if (!saveEl.hidden) saveEl.textContent = label.split('[x]').join(pct);
        }
      });
    }

    function offerUnit() {
      var o = currentOffer();
      var unit = o ? Number(o.getAttribute('data-unit')) : 0;
      return unit > 0 ? unit : current ? current.price : 0;
    }

    function offerUnitWas() {
      var o = currentOffer();
      return o ? Number(o.getAttribute('data-unit-was')) || 0 : 0;
    }

    /** Every row's dropdown values, in option order. */
    function pairRows() {
      return $$('[data-hkf-pair]', pairList || root);
    }

    function rowVariant(row) {
      var values = $$('select', row).map(function (sel) {
        return sel.value;
      });
      return findVariant(values);
    }

    function buildRow(index) {
      var frag = pairTemplate.content.cloneNode(true);
      var row = frag.querySelector('[data-hkf-pair]');
      var label = frag.querySelector('[data-hkf-pair-label]');
      var opts = frag.querySelector('[data-hkf-pair-opts]');

      label.textContent = ({{ s.pair_label | json }}).replace('[n]', index + 1);

      (config.optionNames || []).forEach(function (name, oi) {
        var wrap = document.createElement('label');
        wrap.className = 'hkf__pair-opt';
        var caption = document.createElement('span');
        caption.textContent = name;
        var select = document.createElement('select');

        /* Values in the order the product declares them, without repeats. */
        var seen = {};
        variants.forEach(function (v) {
          var value = v.options[oi];
          if (seen[value]) return;
          seen[value] = true;
          var option = document.createElement('option');
          option.value = value;
          option.textContent = value;
          select.appendChild(option);
        });
        select.value = (current && current.options[oi]) || select.value;

        select.addEventListener('change', function () {
          syncRow(row);
          renderTotals();
        });

        wrap.appendChild(caption);
        wrap.appendChild(select);
        opts.appendChild(wrap);
      });

      pairList.appendChild(frag);
      syncRow(row);
      return row;
    }

    function syncRow(row) {
      var v = rowVariant(row);
      var holder = $('[data-hkf-pair-img]', row);
      if (holder) {
        holder.innerHTML = '';
        if (v && v.image) {
          var img = document.createElement('img');
          img.src = v.image;
          img.alt = '';
          img.loading = 'lazy';
          holder.appendChild(img);
        }
      }
      var stock = $('.hkf__pair-stock', row);
      if (stock) stock.hidden = !(v && v.available);
    }

    function syncRemoveButtons() {
      var rows = pairRows();
      rows.forEach(function (row, i) {
        var btn = $('[data-hkf-pair-remove]', row);
        /* The first pair is the order itself: it can never be removed. */
        if (btn) btn.hidden = i === 0 || rows.length <= 1;
        var label = $('[data-hkf-pair-label]', row);
        if (label) label.textContent = ({{ s.pair_label | json }}).replace('[n]', i + 1);
      });
    }

    function setRowCount(target) {
      if (!pairList || !pairTemplate) return;
      var rows = pairRows();
      while (rows.length < target) {
        buildRow(rows.length);
        rows = pairRows();
      }
      while (rows.length > target) {
        rows[rows.length - 1].remove();
        rows = pairRows();
      }
      syncRemoveButtons();
    }

    function renderTotals() {
      repriceOffers();
      var qty = pairsBox && !pairsBox.hidden ? pairRows().length : offerQty();
      if (qty < 1) qty = 1;

      var unit = offerUnit();
      var unitWas = offerUnitWas();
      /* A bundle with no compare price of its own falls back to the plain
         variant price, which is what the discount is measured against. */
      if (unitWas <= unit && current) unitWas = current.compareAt > current.price ? current.compareAt : current.price;

      var total = unit * qty;
      var totalWas = unitWas * qty;

      if (buyTotal) buyTotal.textContent = formatMoney(total);
      if (buyWas) {
        buyWas.textContent = formatMoney(totalWas);
        buyWas.hidden = totalWas <= total;
      }
      if (priceEl) priceEl.textContent = formatMoney(current ? current.price : unit);
      if (wasEl && current) {
        wasEl.textContent = formatMoney(current.compareAt);
        wasEl.hidden = !(current.compareAt > current.price);
      }
      if (saveEl && current) {
        var discounted = current.compareAt > current.price;
        saveEl.hidden = !discounted;
        if (discounted) {
          var pct = Math.round(((current.compareAt - current.price) / current.compareAt) * 100);
          saveEl.textContent = config.strings.save.split('[x]').join(pct);
        }
      }
      if (pairAdd) {
        pairAdd.hidden = !(pairsBox && !pairsBox.hidden) || pairRows().length >= config.pairsMax;
      }
      fitBuyRow();
    }

    /* ---------------- Bouton d'achat : tout sur une ligne ----------------
       Le libellé est saisi par le marchand, sa largeur est donc imprévisible,
       et le prix change avec l'offre choisie. Plutôt que de laisser la rangée
       passer à la ligne, on réduit la taille du texte jusqu'à ce que libellé,
       pastille de prix et flèche tiennent côte à côte. Tout le contenu étant
       en em, un seul passage suffit à trouver le bon facteur. */
    function fitBuyRow() {
      if (!addButton) return;
      addButton.style.setProperty('--hk-buy-scale', '1');
      var cs = window.getComputedStyle(addButton);
      var avail =
        addButton.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      if (!(avail > 0)) return;

      var need = 0;
      var shown = 0;
      [].forEach.call(addButton.children, function (child) {
        var ccs = window.getComputedStyle(child);
        if (ccs.display === 'none' || ccs.position === 'absolute') return;
        need += child.getBoundingClientRect().width;
        shown += 1;
      });
      if (shown > 1) need += (parseFloat(cs.columnGap) || 0) * (shown - 1);

      if (need > avail) {
        /* 0.99 pour absorber les arrondis, 0.62 pour ne pas rendre le
           libellé illisible si quelqu'un y met une phrase entière. */
        var scale = Math.max(0.62, (avail / need) * 0.99);
        addButton.style.setProperty('--hk-buy-scale', String(scale));
      }
    }

    /** Coche une carte (ou aucune, avec -1) sans toucher aux lignes. */
    function markOffer(i) {
      offerIndex = i;
      offers.forEach(function (other, j) {
        var on = j === i;
        other.setAttribute('aria-checked', on ? 'true' : 'false');
        other.tabIndex = on || (i < 0 && j === 0) ? 0 : -1;
      });
    }

    /** La meilleure carte pour n paires : la plus grosse qui tienne dedans.
        Au-delà de la dernière, on reste sur elle et les paires
        supplémentaires gardent son tarif. */
    function offerForCount(n) {
      var best = -1;
      var bestQty = 0;
      offers.forEach(function (o, i) {
        var q = Number(o.getAttribute('data-qty')) || 1;
        if (q >= 2 && q <= n && q > bestQty) {
          best = i;
          bestQty = q;
        }
      });
      return best;
    }

    /** Accorde les cartes, le dépliant et les totaux sur offerIndex. */
    function syncOffers() {
      markOffer(offerIndex);
      var qty = offerQty();
      /* Une seule paire n'a rien à demander : le sélecteur du haut a déjà
         dit laquelle. Le dépliant ne sert qu'à partir de deux. */
      if (pairsBox) pairsBox.hidden = qty < 2;
      setRowCount(qty < 2 ? 0 : qty);
      renderTotals();
    }

    /** Le nombre de lignes a changé de lui-même : on recale la carte cochée
        dessus, pour que le tarif suive au lieu de rester sur l'ancienne. */
    function applyPairCount(n) {
      if (n < 2) {
        markOffer(-1);
        if (pairsBox) pairsBox.hidden = true;
        setRowCount(0);
      } else {
        if (pairsBox) pairsBox.hidden = false;
        setRowCount(n);
        markOffer(offerForCount(n));
      }
      renderTotals();
    }

    offers.forEach(function (offer, i) {
      offer.addEventListener('click', function () {
        /* Recliquer la carte déjà cochée la décoche : on revient à une paire,
           qui est l'état de départ quand aucune offre n'est prise. */
        offerIndex = offerIndex === i ? -1 : i;
        syncOffers();
      });
    });

    if (pairAdd) {
      pairAdd.addEventListener('click', function () {
        applyPairCount(pairRows().length + 1);
      });
    }

    if (pairList) {
      pairList.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-hkf-pair-remove]');
        if (!btn) return;
        var row = btn.closest('[data-hkf-pair]');
        if (!row || pairRows().length <= 1) return;
        row.remove();
        syncRemoveButtons();
        /* Redescendre sous le palier d'une offre doit aussi lui reprendre sa
           remise, sans quoi on paierait trois paires au prix de deux. */
        applyPairCount(pairRows().length);
      });
    }

    /* ---------------- Option pickers ---------------- */

    function applyChoice(optIndex, value) {
      chosen[optIndex] = value;
      var found = findVariant(chosen);
      if (found) current = found;

      $$('[data-hkf-opt]').forEach(function (btn) {
        if (Number(btn.getAttribute('data-hkf-opt')) !== optIndex) return;
        var on = btn.getAttribute('data-hkf-value') === value;
        btn.setAttribute('aria-checked', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
      });

      /* Chaque valeur a sa propre case, à côté de son libellé : on remplit
         case par case au lieu de réécrire toute la ligne. */
      if (chosenEl && current) {
        $$('[data-hkf-chosen-value]', chosenEl).forEach(function (slot) {
          var i = Number(slot.getAttribute('data-hkf-chosen-value'));
          slot.textContent = current.options[i] || '';
        });
      }
      if (addButton) {
        var sold = current ? !current.available : true;
        addButton.setAttribute('aria-disabled', sold ? 'true' : 'false');
        if (buyLabel) buyLabel.textContent = sold ? config.strings.soldOut : config.strings.buy;
      }
      renderTotals();
    }

    if (current) chosen = current.options.slice();

    $$('[data-hkf-opt]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyChoice(Number(btn.getAttribute('data-hkf-opt')), btn.getAttribute('data-hkf-value'));
      });
    });

    /* ---------------- Add to cart ---------------- */

    function readResponse(response) {
      return response.json().then(function (data) {
        if (!response.ok) throw new Error(data.description || data.message || config.strings.error);
        return data;
      });
    }

    /** Un code de remise groupée ne s'applique qu'en passant par /discount. */
    function discountHref(code, destination) {
      return (
        config.rootUrl.replace(/\/$/, '') +
        '/discount/' +
        encodeURIComponent(code) +
        '?redirect=' +
        encodeURIComponent(destination)
      );
    }

    /**
     * Ouvre le panier coulissant, quel qu'il soit. Renvoie false si aucun
     * tiroir n'a répondu, auquel cas il faut bien aller quelque part.
     *
     * Deux voies, dans cet ordre : l'événement, que la section « Panier
     * coulissant » écoute et marque comme traité ; puis les éléments connus.
     * On les passe tous en revue plutôt que de prendre le premier venu :
     * beaucoup de thèmes posent un <cart-drawer> sans méthode open(), et
     * s'arrêter dessus renverrait le client sur la page panier.
     */
    function openDrawer() {
      var event = new CustomEvent('pnc:open', {
        bubbles: true,
        cancelable: true,
        detail: { handled: false }
      });
      document.dispatchEvent(event);
      if (event.detail && event.detail.handled) return true;

      /* En deux passes, et dans cet ordre : le panier posé par le marchand
         d'abord, celui du thème seulement ensuite. querySelectorAll rend les
         éléments dans l'ordre du document, pas dans celui du sélecteur : sans
         cette séparation, un <cart-drawer> de thème placé plus haut dans la
         page l'emporterait sur le tiroir choisi. */
      var passes = ['[data-cart-drawer]', 'cart-drawer, #cart-drawer, .cart-drawer, cart-notification'];
      for (var p = 0; p < passes.length; p += 1) {
        var candidates = document.querySelectorAll(passes[p]);
        for (var i = 0; i < candidates.length; i += 1) {
          if (typeof candidates[i].open === 'function') {
            candidates[i].open();
            return true;
          }
        }
      }
      return false;
    }

    /** Où va le client une fois l'ajout confirmé. */
    function goAfterAdd(code) {
      var mode = config.afterAdd;

      if (mode === 'cart' || mode === 'checkout') {
        var destination = mode === 'checkout' ? '/checkout' : config.cartUrl;
        window.location.href = code ? discountHref(code, destination) : destination;
        return;
      }

      if (mode === 'drawer') {
        if (openDrawer()) {
          /* Le tiroir ne recharge pas la page : la remise groupée doit donc
             être posée à part, sans quoi elle n'existerait qu'au paiement. */
          if (code) applyDiscountInBackground(code);
          resetBuy();
          return;
        }
        /* Pas de tiroir dans ce thème : mieux vaut la page panier qu'un clic
           qui semble ne rien faire. */
        window.location.href = code ? discountHref(code, config.cartUrl) : config.cartUrl;
        return;
      }

      if (code) applyDiscountInBackground(code);
      resetBuy();
    }

    /** Pose le code de remise sans quitter la page. Au pire, il manquera. */
    function applyDiscountInBackground(code) {
      try {
        fetch(config.rootUrl.replace(/\/$/, '') + '/discount/' + encodeURIComponent(code), {
          credentials: 'same-origin'
        }).catch(function () {});
      } catch (e) {
        /* Rien à faire : le client peut encore saisir le code au paiement. */
      }
    }

    /** Rend au bouton son état normal après la confirmation. */
    function resetBuy() {
      addButton.classList.remove('is-done');
      addButton.classList.remove('is-loading');
    }

    if (addButton) {
      addButton.addEventListener('click', function () {
        if (addButton.classList.contains('is-loading')) return;
        if (addButton.classList.contains('is-done')) return;
        if (addButton.getAttribute('aria-disabled') === 'true') return;

        if (errorBox) errorBox.hidden = true;
        addButton.classList.add('is-loading');

        /* Les paires sont regroupées par variante avant l'envoi. Deux lignes
           portant le même identifiant ne doivent pas partir en deux entrées
           de quantité 1 : Shopify n'en retient alors qu'une, et le client
           payait deux paires pour n'en recevoir qu'une. */
        var items = [];
        if (pairsBox && !pairsBox.hidden) {
          var byVariant = {};
          var seen = [];
          pairRows().forEach(function (row) {
            var v = rowVariant(row);
            if (!v) return;
            if (byVariant[v.id] === undefined) {
              byVariant[v.id] = 0;
              seen.push(v.id);
            }
            byVariant[v.id] += 1;
          });
          seen.forEach(function (id) {
            items.push({ id: Number(id), quantity: byVariant[id] });
          });
        }
        if (!items.length && current) items.push({ id: current.id, quantity: 1 });

        fetch(config.cartAddUrl, {
          method: 'POST',
          headers: { Accept: 'application/javascript', 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(readResponse)
          .then(function (payload) {
            document.dispatchEvent(new CustomEvent('hkf:cart-added', { bubbles: true, detail: payload }));

            var offer = currentOffer();
            var code = offer ? offer.getAttribute('data-code') : '';

            /* La coche s'affiche d'abord ; la destination ne prend la main
               qu'ensuite, pour que le client voie que c'est parti. */
            addButton.classList.remove('is-loading');
            addButton.classList.add('is-done');

            window.setTimeout(function () {
              goAfterAdd(code);
            }, config.addedDelay);
          })
          .catch(function (error) {
            addButton.classList.remove('is-loading');
            if (errorBox) {
              errorBox.textContent = error.message || config.strings.error;
              errorBox.hidden = false;
            }
          });
      });
    }

    /* La largeur disponible change avec la fenêtre : on refait le calcul,
       mais seulement quand c'est bien la largeur qui a bougé — l'ajustement
       modifie la hauteur du bouton, ce qui relancerait l'observateur. */
    if (addButton) {
      var lastBuyWidth = addButton.clientWidth;
      var refit = function () {
        if (addButton.clientWidth === lastBuyWidth) return;
        lastBuyWidth = addButton.clientWidth;
        fitBuyRow();
      };
      window.addEventListener('resize', refit);
      if (window.ResizeObserver) new ResizeObserver(refit).observe(addButton);
      /* Les polices personnalisées arrivent après le premier rendu et
         changent la largeur du texte. */
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(fitBuyRow).catch(function () {});
      }
    }

    /* ---------------- Guide des tailles ----------------
       Un panneau par-dessus la page plutôt qu'une redirection : le client ne
       perd pas sa configuration en allant vérifier sa pointure. */
    var guide = $('[data-hkf-guide]');
    if (guide) {
      var guidePanel = $('[data-hkf-guide-panel]', guide);
      var guideReturn = null;

      /* Un tableau de pointures est plus large que le panneau : on lui donne
         sa propre boîte défilante au lieu de laisser la page s'élargir. */
      $$('table', guide).forEach(function (table) {
        if (table.parentNode && table.parentNode.classList.contains('hkf__guide-scroll')) return;
        var wrap = document.createElement('div');
        wrap.className = 'hkf__guide-scroll';
        table.parentNode.insertBefore(wrap, table);
        wrap.appendChild(table);
      });

      var openGuide = function () {
        guideReturn = document.activeElement;
        guide.hidden = false;
        void guide.offsetWidth;
        guide.classList.add('is-open');
        document.documentElement.style.overflow = 'hidden';
        var closeBtn = $('[data-hkf-guide-close]', guide);
        if (closeBtn) closeBtn.focus();
      };

      var closeGuide = function () {
        if (!guide.classList.contains('is-open')) return;
        guide.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        window.setTimeout(function () {
          if (!guide.classList.contains('is-open')) guide.hidden = true;
        }, 380);
        if (guideReturn && typeof guideReturn.focus === 'function') guideReturn.focus();
      };

      $$('[data-hkf-guide-open]').forEach(function (btn) {
        btn.addEventListener('click', openGuide);
      });
      $$('[data-hkf-guide-close], [data-hkf-guide-scrim]', guide).forEach(function (el) {
        el.addEventListener('click', closeGuide);
      });

      document.addEventListener('keydown', function (event) {
        if (!guide.classList.contains('is-open')) return;
        if (event.key === 'Escape') {
          closeGuide();
          return;
        }
        if (event.key !== 'Tab') return;
        var list = $$(
          'a[href], button:not([disabled]), select, input, [tabindex]:not([tabindex="-1"])',
          guidePanel
        ).filter(function (el) {
          return el.offsetParent !== null;
        });
        if (!list.length) return;
        var first = list[0];
        var last = list[list.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    }

    /* Premier rendu : on accorde tout sur l'offre désignée par Liquid, qui
       peut être « aucune » — auquel cas le client part sur une seule paire. */
    if (offers.length) syncOffers();
    else renderTotals();
  })();
</script>

{% schema %}
{
  "name": "Produit HikeFoot",
  "tag": "section",
  "class": "produit-hikefoot-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "Panier"
    },
    { "type": "checkbox", "id": "show_atc", "label": "Afficher le bouton d'ajout", "default": true },
    {
      "type": "select",
      "id": "after_add_action",
      "label": "Après l'ajout",
      "info": "Une remise groupée ne s'applique de façon sûre qu'en allant au panier ou au paiement.",
