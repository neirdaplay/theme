{% comment %}
  produit-hikefoot.liquid
  Shoe product page: sticky gallery on the left, everything else scrolling on
  the right — trust line, title, rating with a review card, bullets, colour
  and size pickers, multi-pair bundles, add to cart, reassurance, UGC row and
  a sell-out risk panel.

  Every part has its own on/off switch.

  Self-contained: styles and behaviour are both inlined, so this file is the
  only thing that needs to exist in the theme.
{% endcomment %}

{% style %}
/* ==========================================================================
   HikeFoot product — scoped under .hkf so the rest of the theme is untouched.
   ========================================================================== */

.hkf {
  --hk-white: #ffffff;
  --hk-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  --hk-gutter: 24px;
  --hk-thumb: var(--hk-thumb-set, 68px);
  --hk-stage-ratio: var(--hk-stage-ratio-set, 1 / 1);
  --hk-stage-fit: var(--hk-stage-fit-set, cover);

  font-family: var(--hk-font);
  color: var(--hk-ink);
  -webkit-font-smoothing: antialiased;

  /* Les marges vivent ici plutôt que dans l'attribut style : une règle en
     ligne ne se laisse pas reprendre par une requête média. */
  padding-top: var(--hk-pad-top);
  padding-bottom: var(--hk-pad-bottom);
}

@media (max-width: 899px) {
  .hkf {
    padding-top: var(--hk-pad-top-m);
    padding-bottom: var(--hk-pad-bottom-m);
  }
}

.hkf *,
.hkf *::before,
.hkf *::after {
  box-sizing: border-box;
}

:where(.hkf) :where(p) {
  margin: 0;
}

:where(.hkf) :where(h1, h2, h3) {
  margin: 0;
  font-size: inherit;
  font-weight: 700;
  line-height: 1.25;
}

:where(.hkf) :where(ul, ol) {
  margin: 0;
  padding: 0;
  list-style: none;
}

:where(.hkf) :where(button) {
  font: inherit;
  color: inherit;
  cursor: pointer;
}

:where(.hkf) :where(a) {
  color: inherit;
}

:where(.hkf) :where(img) {
  display: block;
  max-width: 100%;
}

.hkf :focus-visible {
  outline: 2px solid var(--hk-accent);
  outline-offset: 2px;
}

.hkf__sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.hkf__container {
  max-width: calc(var(--hk-max) + var(--hk-gutter) * 2);
  margin-inline: auto;
  padding-inline: var(--hk-gutter);
}

.hkf__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 40px;
  align-items: start;
}

/* --------------------------------------------------------------------------
   Sticky gallery
   -------------------------------------------------------------------------- */

@media screen and (min-width: 900px) {
  /* The gallery's grid area is as tall as the info column and is also its
     containing block, so it releases by itself at the end of the section. */
  .hkf--sticky .hkf__gallery {
    position: sticky;
    top: var(--hk-sticky-top);
  }

  /* Set by the script when the gallery is taller than the window: sticking
     it there would park its bottom off-screen for the whole scroll. */
  .hkf--sticky.hkf--sticky-off .hkf__gallery {
    position: static;
  }
}

.hkf__stage {
  position: relative;
  border-radius: var(--hk-radius);
  overflow: hidden;
  background: var(--hk-soft);
  /* Horizontal swipes belong to the gallery, vertical ones to the page. */
  touch-action: pan-y;
}

.hkf__track {
  display: flex;
  transition: transform 0.34s cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: transform;
}

.hkf__track.is-dragging {
  transition: none;
}

.hkf__slide {
  flex: 0 0 100%;
  min-width: 0;
  aspect-ratio: var(--hk-stage-ratio);
}

.hkf__slide img,
.hkf__placeholder {
  width: 100%;
  height: 100%;
  object-fit: var(--hk-stage-fit);
}

.hkf__placeholder {
  display: grid;
  place-items: center;
  color: #b6bcc4;
}

.hkf__placeholder svg {
  width: 28%;
  height: auto;
}

.hkf__nav {
  position: absolute;
  top: 50%;
  z-index: 3;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #7c848f;
  box-shadow: 0 2px 10px rgba(15, 27, 42, 0.16);
  transform: translateY(-50%);
  transition: opacity 0.18s ease, background-color 0.16s ease;
}

/* display:grid above would otherwise defeat the [hidden] attribute. */
.hkf__nav[hidden] {
  display: none;
}

.hkf__nav--prev {
  left: 10px;
}

.hkf__nav--next {
  right: 10px;
}

.hkf__nav svg {
  width: 13px;
  height: 13px;
}

/* Pointer devices only: touch screens have no hover, so there they stay on. */
@media (hover: hover) {
  .hkf__nav {
    opacity: 0;
  }

  .hkf__stage:hover .hkf__nav,
  .hkf__stage:focus-within .hkf__nav {
    opacity: 1;
  }
}

.hkf__thumbs {
  display: flex;
  gap: 10px;
  margin-top: 12px;
  overflow-x: auto;
  scrollbar-width: none;
}

.hkf__thumbs::-webkit-scrollbar {
  display: none;
}

.hkf__thumb {
  position: relative;
  flex: 0 0 auto;
  width: var(--hk-thumb);
  padding: 0;
  border: 2px solid transparent;
  border-radius: 10px;
  background: var(--hk-soft);
  overflow: hidden;
  line-height: 0;
  transition: border-color 0.16s ease;
}

.hkf__thumb img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.hkf__thumb[aria-selected="true"] {
  border-color: var(--hk-ink);
}

/* --------------------------------------------------------------------------
   Info column
   -------------------------------------------------------------------------- */

.hkf__bought {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--hk-bought-size, 11.5px);
  color: var(--hk-muted);
}

.hkf__bought > svg {
  flex: 0 0 auto;
  width: 13px;
  height: 13px;
  color: var(--hk-ink);
}

.hkf__bought b {
  color: var(--hk-ink);
}

/* ---- Buyer faces ----
   Overlapping avatars in place of the bag icon. Each one carries a ring in
   the page colour so the stack reads as separate discs rather than a blob. */
.hkf__faces {
  display: inline-flex;
  flex: 0 0 auto;
  padding-left: 2px;
}

.hkf__face {
  display: block;
  width: var(--hk-face, 26px);
  height: var(--hk-face, 26px);
  border-radius: 50%;
  overflow: hidden;
  background: var(--hk-soft);
  box-shadow: 0 0 0 2px var(--hk-white);
}

.hkf__face + .hkf__face {
  margin-left: calc(var(--hk-face, 26px) / -3.5);
}

.hkf__face img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hkf__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px 18px;
  margin-top: 8px;
}

.hkf__title {
  flex: 1 1 260px;
  min-width: 0;
  font-size: clamp(1.05rem, 0.8rem + 0.7vw, 1.3rem);
  font-weight: 700;
}

/* Prix, prix barré et pastille sur une même ligne : empilés, ils mangeaient
   de la hauteur pour rien. Le retour à la ligne reste possible si la place
   vient réellement à manquer. */
.hkf__prices {
  flex: 0 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: flex-end;
  gap: 3px 8px;
  line-height: 1.15;
}

.hkf__price {
  color: var(--hk-price);
  font-size: 20px;
  font-weight: 700;
  white-space: nowrap;
}

.hkf__was {
  color: var(--hk-muted);
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
}

.hkf__save {
  display: inline-flex;
  align-items: center;
  padding: 3px 9px;
  border-radius: 999px;
  background: var(--hk-save-bg);
  color: var(--hk-save-ink);
  font-size: 11.5px;
  font-weight: 700;
  white-space: nowrap;
}

.hkf__save[hidden] {
  display: none;
}

.hkf__was[hidden] {
  display: none;
}

/* ---- Rating ---- */

.hkf__rating {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: var(--hk-rating-gap, 4px);
}

.hkf__stars {
  position: relative;
  display: inline-flex;
  line-height: 0;
}

.hkf__stars-row {
  display: flex;
  gap: 2px;
}

.hkf__stars-row svg {
  flex: 0 0 auto;
  width: var(--hk-star-size, 15px);
  height: var(--hk-star-size, 15px);
}

.hkf__stars-row--empty {
  color: var(--hk-line);
}

.hkf__stars-row--full {
  position: absolute;
  inset: 0;
  width: var(--hk-star-pct, 100%);
  overflow: hidden;
  color: var(--hk-star);
}

.hkf__rating-toggle {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0;
  border: 0;
  background: none;
  color: var(--hk-green);
  font-size: 12.5px;
  font-weight: 600;
}

.hkf__rating-toggle svg {
  width: 11px;
  height: 11px;
  transition: transform 0.18s ease;
}

.hkf__rating-toggle[aria-expanded="true"] svg {
  transform: rotate(180deg);
}

/* ---- Review card ---- */

.hkf__revpop {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  z-index: 30;
  width: min(370px, calc(100vw - 52px));
  padding: 16px;
  border: 1px solid var(--hk-line);
  border-radius: 14px;
  background: var(--hk-white);
  box-shadow: 0 18px 44px rgba(15, 27, 42, 0.18);
  /* display:none, not visibility: a hidden-but-laid-out card widens the page. */
  animation: hkf-pop 0.18s ease;
}

.hkf__revpop[hidden] {
  display: none;
}

@keyframes hkf-pop {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.hkf__revpop-close {
  position: absolute;
  top: 12px;
  right: 12px;
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: var(--hk-soft);
}

.hkf__revpop-close svg {
  width: 10px;
  height: 10px;
}

.hkf__revpop-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-right: 32px;
  font-size: 12.5px;
  color: var(--hk-muted);
}

.hkf__revpop-score {
  font-size: 19px;
  font-weight: 700;
  color: var(--hk-ink);
}

.hkf__revpop-head b {
  color: var(--hk-ink);
}

.hkf__bars {
  margin-top: 12px;
}

.hkf__bar {
  display: flex;
  align-items: center;
  gap: 8px;
}

.hkf__bar + .hkf__bar {
  margin-top: 5px;
}

.hkf__bar-label {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 2px;
  width: 24px;
  font-size: 10.5px;
  color: var(--hk-muted);
}

.hkf__bar-label svg {
  width: 9px;
  height: 9px;
  color: var(--hk-star);
}

.hkf__bar-track {
  flex: 1 1 auto;
  height: 7px;
  border-radius: 4px;
  background: var(--hk-soft);
  overflow: hidden;
}

.hkf__bar-fill {
  display: block;
  height: 100%;
  border-radius: 4px;
  background: var(--hk-star);
}

.hkf__bar-count {
  flex: 0 0 auto;
  width: 62px;
  font-size: 10.5px;
  color: var(--hk-muted);
  text-align: right;
}

.hkf__revpop-sep {
  height: 1px;
  margin: 14px 0;
  background: var(--hk-line);
}

.hkf__review[hidden] {
  display: none;
}

.hkf__review-top {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.hkf__review-photo {
  flex: 0 0 auto;
  width: 62px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--hk-soft);
}

.hkf__review-photo img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.hkf__review-body {
  min-width: 0;
  flex: 1 1 auto;
}

.hkf__review-name {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  font-size: 12.5px;
  font-weight: 700;
}

.hkf__review-all {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--hk-muted);
  white-space: nowrap;
}

.hkf__review-text {
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.55;
  color: var(--hk-muted);
}

.hkf__revpop-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 14px;
}

.hkf__revpop-arrow {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 1px solid var(--hk-line);
  border-radius: 50%;
  background: var(--hk-white);
}

.hkf__revpop-arrow svg {
  width: 11px;
  height: 11px;
}

.hkf__revpop-dots {
  display: flex;
  gap: 5px;
}

.hkf__revpop-dot {
  width: 7px;
  height: 7px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--hk-line);
}

.hkf__revpop-dot[aria-current="true"] {
  background: var(--hk-ink);
}

/* ---- Bullets ---- */

.hkf__bullets {
  display: grid;
  gap: 7px;
  margin-top: 14px;
}

.hkf__bullets li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 13px;
  line-height: 1.45;
}

/* Coche vert foncé sur pastille vert pâle : les deux teintes viennent des
   réglages de couleur, donc la pastille suit l'accent du thème. */
.hkf__bullets-ic {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--hk-green-soft);
  color: var(--hk-green);
}

.hkf__bullets-ic svg {
  width: 12px;
  height: 12px;
}

/* ---- Variant pickers ---- */

.hkf__picker {
  margin-top: 16px;
}

.hkf__swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.hkf__swatch {
  width: 58px;
  padding: 0;
  border: 2px solid var(--hk-line);
  border-radius: 8px;
  background: var(--hk-soft);
  overflow: hidden;
  line-height: 0;
  transition: border-color 0.16s ease;
}

.hkf__swatch img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.hkf__swatch-blank {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
}

.hkf__swatch[aria-checked="true"] {
  border-color: var(--hk-ink);
}

.hkf__sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 12px;
}

.hkf__size {
  min-width: 56px;
  padding: 8px 10px;
  border: 1px solid var(--hk-line);
  border-radius: 6px;
  background: var(--hk-white);
  font-size: 12.5px;
  font-weight: 600;
  transition: border-color 0.16s ease, background-color 0.16s ease;
}

.hkf__size[aria-checked="true"] {
  border-color: var(--hk-green);
  background: var(--hk-green-soft);
  color: var(--hk-green);
}

.hkf__size[data-sold="true"] {
  color: var(--hk-line);
  text-decoration: line-through;
}

.hkf__chosen {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 4px 14px;
  margin-top: 12px;
  font-size: 12px;
  color: var(--hk-muted);
}

.hkf__chosen a,
.hkf__guide-open {
  padding: 0;
  border: 0;
  background: none;
  font: inherit;
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Une paire « libellé : valeur » par option, la valeur en gras : « Bleu / 36 »
   ne disait pas ce que chaque moitié désignait. */
.hkf__chosen-list {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 16px;
}

.hkf__chosen-item b {
  margin-left: 4px;
  color: var(--hk-ink);
  font-weight: 700;
}

.hkf__finder {
  width: 100%;
  margin-top: 12px;
  padding: 12px;
  border: 1px solid var(--hk-line);
  border-radius: 8px;
  background: var(--hk-white);
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  transition: border-color 0.16s ease;
}

.hkf__finder:hover {
  border-color: var(--hk-ink);
}

/* ---- Endorsement ---- */

.hkf__endorse {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
  font-size: 11.5px;
  line-height: 1.45;
  color: var(--hk-muted);
}

.hkf__endorse img {
  flex: 0 0 auto;
  width: auto;
  max-height: 24px;
}

.hkf__endorse b {
  color: var(--hk-ink);
}

/* --------------------------------------------------------------------------
   Bundles
   -------------------------------------------------------------------------- */

.hkf__bundle {
  margin-top: 18px;
}

.hkf__bundle-note {
  font-size: 12px;
  font-weight: 600;
  text-align: center;
  color: var(--hk-muted);
}

.hkf__bundle-note b {
  color: var(--hk-ink);
}

.hkf__offers {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin-top: 10px;
}

.hkf__offer {
  position: relative;
  padding: 26px 12px 12px;
  border: 2px solid var(--hk-line);
  border-radius: 10px;
  background: var(--hk-white);
  text-align: center;
  transition: border-color 0.16s ease;
}

.hkf__offer[aria-checked="true"] {
  border-color: var(--hk-green);
}

.hkf__offer-flag {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  padding: 4px;
  border-radius: 7px 7px 0 0;
  background: var(--hk-flag-bg);
  color: var(--hk-flag-ink);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.hkf__offer-flag[hidden] {
  display: none;
}

/* --hk-card-img est posé sur la carte quand le bloc fixe sa propre taille ;
   sinon on retombe sur le réglage de la section. */
/* display: block est indispensable : une <span> reste en ligne, et une boîte
   en ligne ignore purement et simplement width — le réglage de taille n'avait
   donc aucun effet. */
.hkf__offer-img {
  display: block;
  width: var(--hk-card-img, var(--hk-offer-img));
  max-width: 100%;
  margin-inline: auto;
}

.hkf__offer-img img {
  width: 100%;
  height: auto;
}

/* Le titre occupe sa propre ligne, en plus gros : c'est lui qu'on lit en
   premier pour choisir une offre. */
.hkf__offer-title {
  display: block;
  margin-top: 6px;
  font-size: var(--hk-offer-title);
  font-weight: 700;
  line-height: 1.15;
  white-space: nowrap;
}

/* Puis une seule ligne pour les prix : barré, remisé, mention. La remise est
   plus grosse que le prix barré, et rien ne passe à la ligne. */
.hkf__offer-price {
  display: flex;
  flex-wrap: nowrap;
  align-items: baseline;
  justify-content: center;
  gap: 4px;
  margin-top: 4px;
  font-size: var(--hk-offer-price);
  font-weight: 700;
  color: var(--hk-price);
  white-space: nowrap;
}

.hkf__offer-was {
  flex: 0 0 auto;
  color: var(--hk-muted);
  font-size: calc(var(--hk-offer-price) * 0.66);
  font-weight: 500;
}

.hkf__offer-unit {
  flex: 0 0 auto;
  font-size: calc(var(--hk-offer-price) * 0.62);
  font-weight: 500;
  color: var(--hk-muted);
}

.hkf__offer-unit-short {
  display: none;
}

/* Sur mobile la carte est deux fois moins large : on rétrécit et « par paire »
   devient « /paire » pour que la ligne de prix tienne d'un seul tenant. */
@media (max-width: 899px) {
  .hkf__offer-title {
    font-size: var(--hk-offer-title-m);
  }

  .hkf__offer-price {
    gap: 3px;
    font-size: var(--hk-offer-price-m);
  }

  .hkf__offer-was {
    font-size: calc(var(--hk-offer-price-m) * 0.6);
  }

  .hkf__offer-unit {
    font-size: calc(var(--hk-offer-price-m) * 0.6);
  }

  .hkf__offer-img {
    width: var(--hk-card-img-m, var(--hk-offer-img-m));
  }

  .hkf__offer-unit-long {
    display: none;
  }

  .hkf__offer-unit-short {
    display: inline;
  }
}

.hkf__offer-save {
  display: block;
  margin-top: 8px;
  padding: 5px;
  border-radius: 6px;
  background: var(--hk-green-soft);
  color: var(--hk-green);
  font-size: 11px;
  font-weight: 700;
}

.hkf__offer-save[hidden] {
  display: none;
}

/* ---- Per-pair pickers ---- */

.hkf__pairs {
  margin-top: 14px;
}

.hkf__pairs[hidden] {
  display: none;
}

.hkf__pairs-title {
  font-size: 12.5px;
  font-weight: 600;
  text-align: center;
  color: var(--hk-muted);
}

.hkf__pair {
  position: relative;
  margin-top: 10px;
  padding: 12px;
  border: 1px solid var(--hk-line);
  border-radius: 10px;
  background: var(--hk-white);
}

.hkf__pair-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
}

.hkf__pair-stock {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 7px;
  border-radius: 20px;
  background: var(--hk-green-soft);
  color: var(--hk-green);
  font-size: 10px;
  font-weight: 700;
}

.hkf__pair-stock svg {
  width: 8px;
  height: 8px;
}

.hkf__pair-remove {
  position: absolute;
  top: 10px;
  right: 10px;
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: none;
  color: var(--hk-muted);
}

.hkf__pair-remove[hidden] {
  display: none;
}

.hkf__pair-remove svg {
  width: 9px;
  height: 9px;
}

.hkf__pair-body {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 10px;
}

.hkf__pair-img {
  flex: 0 0 auto;
  width: 58px;
  border-radius: 6px;
  overflow: hidden;
  background: var(--hk-soft);
}

.hkf__pair-img img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.hkf__pair-opts {
  flex: 1 1 auto;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
  gap: 8px;
}

.hkf__pair-opt span {
  display: block;
  margin-bottom: 3px;
  font-size: 10px;
  color: var(--hk-muted);
}

.hkf__pair-opt select {
  width: 100%;
  padding: 7px 8px;
  border: 1px solid var(--hk-line);
  border-radius: 6px;
  background: var(--hk-white);
  color: inherit;
  font: inherit;
  font-size: 12px;
}

.hkf__pair-add {
  width: 100%;
  margin-top: 10px;
  padding: 11px;
  border: 1px dashed var(--hk-green);
  border-radius: 8px;
  background: var(--hk-green-soft);
  color: var(--hk-green);
  font-size: 12.5px;
  font-weight: 700;
}

.hkf__pair-add[hidden] {
  display: none;
}

.hkf__pair-add small {
  display: block;
  margin-top: 2px;
  font-size: 10.5px;
  font-weight: 500;
  opacity: 0.85;
}

/* --------------------------------------------------------------------------
   Add to cart
   -------------------------------------------------------------------------- */

.hkf__atc {
  margin-top: 16px;
}

/* Tout ce qui compose le bouton est dimensionné en em, gouttière comprise :
   réduire la seule taille de police suffit alors à faire tenir la rangée,
   ce dont se charge fitBuyRow(). Seul le rembourrage reste en px, pour que
   la largeur disponible ne bouge pas pendant l'ajustement. */
/* Tout est centré ensemble — libellé, pastille de prix et flèche forment un
   seul groupe au milieu du bouton, la flèche restant collée au prix. */
.hkf__buy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.85em;
  width: 100%;
  min-height: 54px;
  padding: 12px clamp(12px, 3vw, 20px);
  border: 0;
  border-radius: 8px;
  background: var(--hk-green);
  color: var(--hk-white);
  font-size: calc(clamp(12px, 3.2vw, 14.5px) * var(--hk-buy-scale, 1));
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  transition: transform 0.16s ease, filter 0.16s ease;
}

/* Le libellé ne se coupe jamais en deux lignes. */
.hkf__buy-label {
  white-space: nowrap;
}

/* Le prix vit dans sa propre pastille claire, détachée du fond du bouton. */
.hkf__buy-price {
  display: inline-flex;
  align-items: baseline;
  gap: 0.45em;
  padding: 0.36em 0.85em;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.17);
  text-transform: none;
  white-space: nowrap;
}

.hkf__buy > svg {
  flex: 0 0 auto;
  width: 1.05em;
  height: 1.05em;
}

@media (max-width: 399px) {
  .hkf__buy {
    gap: 0.6em;
    padding-inline: 10px;
  }
}

.hkf__buy:hover {
  transform: translateY(-1px);
  filter: brightness(1.05);
}

.hkf__buy[aria-disabled="true"] {
  filter: grayscale(0.7);
  cursor: not-allowed;
}

.hkf__buy:active {
  transform: scale(0.985);
}

.hkf__buy.is-loading {
  opacity: 0.75;
  pointer-events: none;
}

/* ---- Confirmation ----
   Le contenu normal s'efface et la coche se dessine à sa place, le temps
   réglé, avant que la destination ne prenne la main. */
.hkf__buy-done {
  display: none;
  align-items: center;
  gap: 0.55em;
}

.hkf__buy.is-done {
  background: var(--hk-added);
  opacity: 1;
  pointer-events: none;
}

.hkf__buy.is-done > :not(.hkf__buy-done) {
  display: none;
}

.hkf__buy.is-done .hkf__buy-done {
  display: inline-flex;
}

.hkf__buy-tick {
  display: grid;
  place-items: center;
  width: 1.5em;
  height: 1.5em;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}

.hkf__buy-tick svg {
  width: 0.95em;
  height: 0.95em;
}

/* Le trait se dessine plutôt que d'apparaître d'un bloc. */
.hkf__buy-tick svg path {
  stroke-dasharray: 16;
  stroke-dashoffset: 16;
}

.hkf__buy.is-done .hkf__buy-tick svg path {
  animation: hkf-tick 0.4s cubic-bezier(0.65, 0, 0.35, 1) 0.06s forwards;
}

.hkf__buy.is-done .hkf__buy-tick {
  animation: hkf-tick-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes hkf-tick {
  to {
    stroke-dashoffset: 0;
  }
}

@keyframes hkf-tick-pop {
  0% {
    transform: scale(0.4);
  }
  100% {
    transform: scale(1);
  }
}

/* Un trait à moitié dessiné n'est pas une coche : sans animation, on
   l'affiche entière tout de suite. */
@media (prefers-reduced-motion: reduce) {
  .hkf__buy:active {
    transform: none;
  }

  .hkf__buy-tick svg path {
    stroke-dashoffset: 0;
  }

  .hkf__buy.is-done .hkf__buy-tick,
  .hkf__buy.is-done .hkf__buy-tick svg path {
    animation: none;
  }
}

.hkf__buy-was {
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  text-transform: none;
}

.hkf__buy-was[hidden] {
  display: none;
}

.hkf__error {
  margin-top: 8px;
  padding: 9px 11px;
  border-radius: 6px;
  background: var(--hk-red-soft);
  color: var(--hk-red);
  font-size: 12px;
  font-weight: 600;
}

.hkf__error[hidden] {
  display: none;
}

/* --------------------------------------------------------------------------
   Reassurance
   -------------------------------------------------------------------------- */

/* Une seule rangée, quel que soit le nombre de colonnes : les pistes sont
   créées à la demande et se partagent la largeur à parts égales. Une colonne
   masquée ne crée pas de piste, donc les restantes se réétalent seules. */
.hkf__reassure {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  gap: 12px;
  margin-top: 16px;
  padding: 14px;
  border: 1px solid var(--hk-line);
  border-radius: 10px;
  background: var(--hk-soft);
  text-align: center;
}

/* Au-delà de quatre colonnes la rangée unique deviendrait illisible : on
   repasse alors en grille souple plutôt que d'écraser le texte. */
.hkf__reassure:has(> li:nth-child(5)) {
  grid-auto-flow: row;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
}

.hkf__reassure li {
  font-size: 11.5px;
  line-height: 1.45;
  color: var(--hk-muted);
}

/* Sous 480 px, trois colonnes hachent le texte en bouillie. La troisième
   s'efface pour laisser respirer le stock et la garantie. */
@media (max-width: 479px) {
  .hkf__reassure {
    gap: 8px;
    padding: 12px 10px;
  }

  .hkf--reassure-2 .hkf__reassure > li:nth-child(n + 3) {
    display: none;
  }

  .hkf:not(.hkf--reassure-2) .hkf__reassure li {
    font-size: 10.5px;
  }
}

.hkf__reassure-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin: 0 auto 6px;
  border-radius: 50%;
  background: var(--hk-white);
  color: var(--hk-ink);
}

.hkf__reassure-icon svg {
  width: 15px;
  height: 15px;
}

.hkf__reassure-icon img {
  width: 18px;
  height: auto;
}

.hkf__reassure-flag {
  font-size: 15px;
  line-height: 1;
}

/* ---- Live dot ----
   A solid dot with two rings expanding out of it on an offset cycle, so the
   pulse reads as continuous rather than as a blink. */
.hkf__pulse {
  position: relative;
  display: block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--hk-green);
}

.hkf__pulse::before,
.hkf__pulse::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--hk-green);
  animation: hkf-pulse 2.4s cubic-bezier(0.16, 0.6, 0.4, 1) infinite;
}

.hkf__pulse::after {
  animation-delay: 1.2s;
}

@keyframes hkf-pulse {
  0% {
    transform: scale(1);
    opacity: 0.45;
  }
  70% {
    opacity: 0;
  }
  100% {
    transform: scale(3.4);
    opacity: 0;
  }
}

/* A ring frozen mid-expansion would just look like a smudge. */
@media (prefers-reduced-motion: reduce) {
  .hkf__pulse::before,
  .hkf__pulse::after {
    display: none;
  }
}

.hkf__reassure-title {
  display: block;
  font-weight: 700;
  color: var(--hk-ink);
}

/* --------------------------------------------------------------------------
   Sell-out risk
   -------------------------------------------------------------------------- */

/* --------------------------------------------------------------------------
   Guide des tailles — panneau par-dessus la page
   -------------------------------------------------------------------------- */

.hkf__guide {
  position: fixed;
  inset: 0;
  z-index: 9998;
  pointer-events: none;
}

.hkf__guide[hidden] {
  display: none;
}

.hkf__guide-scrim {
  position: absolute;
  inset: 0;
  background: rgba(17, 22, 28, 0.42);
  opacity: 0;
  transition: opacity 0.32s ease;
}

.hkf__guide.is-open .hkf__guide-scrim {
  opacity: 1;
  pointer-events: auto;
}

.hkf__guide-panel {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  width: min(var(--hk-guide-width, 680px), 100vw);
  max-width: 100%;
  height: 100%;
  background: var(--hk-white);
  box-shadow: -18px 0 48px rgba(17, 22, 28, 0.16);
  transform: translateX(100%);
  transition: transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1);
  pointer-events: auto;
}

.hkf__guide.is-open .hkf__guide-panel {
  transform: translateX(0);
}

@media (prefers-reduced-motion: reduce) {
  .hkf__guide-panel,
  .hkf__guide-scrim {
    transition: none;
  }
}

@media (max-width: 749px) {
  .hkf__guide-panel {
    width: 100%;
    box-shadow: none;
  }
}

.hkf__guide-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex: 0 0 auto;
  padding: 20px 24px 16px;
  border-bottom: 1px solid var(--hk-line);
}

.hkf__guide-title {
  flex: 1 1 auto;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.25;
}

.hkf__guide-close {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: none;
  color: var(--hk-ink);
  transition: background 0.16s ease;
}

.hkf__guide-close:hover {
  background: var(--hk-soft);
}

.hkf__guide-close svg {
  width: 17px;
  height: 17px;
}

.hkf__guide-body {
  flex: 1 1 auto;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  padding: 18px 24px 40px;
}

.hkf__guide-body .hkf__finder {
  margin-top: 0;
  margin-bottom: 18px;
}

/* ---- Contenu venu de l'éditeur de page ----
   Le marchand écrit sa page dans Shopify : on habille ici tout ce que
   l'éditeur riche peut produire, titres, listes et tableaux compris. */
.hkf__guide-content {
  font-size: 13.5px;
  line-height: 1.65;
  color: var(--hk-ink);
}

.hkf__guide-content > * + * {
  margin-top: 14px;
}

.hkf__guide-content h1,
.hkf__guide-content h2,
.hkf__guide-content h3,
.hkf__guide-content h4 {
  margin: 0;
  font-weight: 700;
  line-height: 1.25;
}

.hkf__guide-content h1 {
  font-size: 22px;
}

.hkf__guide-content h2 {
  font-size: 18px;
}

.hkf__guide-content h3 {
  font-size: 15.5px;
}

.hkf__guide-content h1,
.hkf__guide-content h2,
.hkf__guide-content h3 {
  margin-top: 26px;
}

.hkf__guide-content p {
  margin: 0;
}

.hkf__guide-content strong,
.hkf__guide-content b {
  font-weight: 700;
}

.hkf__guide-content ul,
.hkf__guide-content ol {
  margin: 0;
  padding-left: 20px;
  list-style: revert;
}

.hkf__guide-content li + li {
  margin-top: 5px;
}

.hkf__guide-content a {
  color: var(--hk-green);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.hkf__guide-content img {
  height: auto;
  border-radius: 10px;
}

/* Un tableau de pointures est large par nature : il défile dans sa propre
   boîte plutôt que de pousser tout le panneau. */
.hkf__guide-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.hkf__guide-content table {
  width: 100%;
  min-width: 420px;
  border-collapse: collapse;
  font-size: 12.5px;
}

.hkf__guide-content th,
.hkf__guide-content td {
  padding: 9px 10px;
  border: 1px solid var(--hk-line);
  text-align: center;
  white-space: nowrap;
}

.hkf__guide-content thead th,
.hkf__guide-content tr > *:first-child {
  background: var(--hk-green-soft);
  font-weight: 700;
}

.hkf__risk {
  margin-top: 16px;
}

/* Pastille sur fond rouge pâle, calée sur son contenu : elle doit se lire
   comme une étiquette cliquable, pas comme une ligne de tableau. */
.hkf__risk-trigger {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: auto;
  max-width: 100%;
  padding: 6px 14px;
  border: 0;
  border-radius: 999px;
  background: var(--hk-red-soft);
  color: var(--hk-red);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  text-align: left;
  transition: filter 0.16s ease;
}

.hkf__risk-trigger:hover {
  filter: brightness(0.97);
}

/* Le halo autour du point reprend le rouge du réglage, en très transparent :
   c'est la seule façon d'obtenir un rgba() depuis un sélecteur de couleur. */
.hkf__risk-dot {
  position: relative;
  flex: 0 0 auto;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 3px rgba(var(--hk-red-rgb), 0.16);
}

/* Deux ondes décalées, comme la pastille « en stock », pour que la rupture
   se lise comme un compte à rebours plutôt qu'une étiquette figée. */
.hkf--risk-pulse .hkf__risk-dot::before,
.hkf--risk-pulse .hkf__risk-dot::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: currentColor;
  animation: hkf-risk-pulse 2.4s cubic-bezier(0.16, 0.6, 0.4, 1) infinite;
}

.hkf--risk-pulse .hkf__risk-dot::after {
  animation-delay: 1.2s;
}

@keyframes hkf-risk-pulse {
  0% {
    transform: scale(1);
    opacity: 0.5;
  }
  70% {
    opacity: 0;
  }
  100% {
    transform: scale(3.2);
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hkf--risk-pulse .hkf__risk-dot::before,
  .hkf--risk-pulse .hkf__risk-dot::after {
    display: none;
  }
}

.hkf__risk-trigger svg {
  flex: 0 0 auto;
  width: 12px;
  height: 12px;
  transition: transform 0.18s ease;
}

.hkf__risk-trigger[aria-expanded="true"] svg {
  transform: rotate(180deg);
}

.hkf__risk-panel {
  overflow: hidden;
  transition: height 0.26s ease;
}

.hkf__risk-panel[hidden] {
  display: none;
}

.hkf__risk-inner {
  margin-top: 8px;
  padding: 14px 16px;
  border-radius: 14px;
  background: var(--hk-red-soft);
  color: var(--hk-red);
  font-size: 12.5px;
  line-height: 1.55;
}

/* --------------------------------------------------------------------------
   UGC row
   -------------------------------------------------------------------------- */

.hkf__ugc {
  margin-top: 20px;
}

.hkf__ugc-title {
  font-size: 13.5px;
  font-weight: 700;
}

.hkf__ugc-list {
  display: flex;
  gap: 10px;
  margin-top: 10px;
  padding-bottom: 4px;
  overflow-x: auto;
  scrollbar-width: none;
}

.hkf__ugc-list::-webkit-scrollbar {
  display: none;
}

.hkf__ugc-list li {
  flex: 0 0 auto;
  width: var(--hk-ugc, 150px);
  border-radius: 10px;
  overflow: hidden;
  background: var(--hk-soft);
}

.hkf__ugc-list img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */

@media screen and (max-width: 899px) {
  .hkf {
    --hk-gutter: 18px;
  }

  .hkf__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--hk-stack-gap);
  }

  /* Phones get their own frame shape — square by default, whatever the
     desktop crop is set to. */
  .hkf__slide {
    aspect-ratio: var(--hk-stage-ratio-m);
  }

  /* Full-bleed. "gutter" cancels this section's own padding; "viewport"
     breaks out of every centred ancestor, so it also escapes the padding the
     surrounding theme adds. */
  .hkf__gallery--bleed-gutter .hkf__stage {
    margin-inline: calc(var(--hk-gutter) * -1);
    border-radius: 0;
  }

  .hkf__gallery--bleed-viewport .hkf__stage {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    border-radius: 0;
  }

  /* The thumbnails stay inside the page even when the image leaves it. */
  .hkf__gallery--bleed-gutter .hkf__thumbs,
  .hkf__gallery--bleed-viewport .hkf__thumbs {
    padding-inline: 2px;
  }

  .hkf__prices {
    justify-content: flex-start;
  }

  .hkf__pair-body {
    flex-wrap: wrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hkf *,
  .hkf *::before,
  .hkf *::after {
    transition-duration: 0.001ms !important;
    animation-duration: 0.001ms !important;
  }
}
{% endstyle %}

{%- liquid
  assign s = section.settings
  assign variant = product.selected_or_first_available_variant

  assign bullets = section.blocks | where: 'type', 'bullet'
  assign offers = section.blocks | where: 'type', 'offer'
  assign reassurances = section.blocks | where: 'type', 'reassurance'
  assign reviews = section.blocks | where: 'type', 'review'
  assign ugcs = section.blocks | where: 'type', 'ugc'

  comment
    Le réglage « page » ne donne qu'une poignée : c'est ici qu'on récupère
    la page elle-même, avec son titre et son contenu.
  endcomment
  assign guide_page = pages[s.sizeguide_page]

  assign rating_num = s.rating_value | plus: 0.0
  assign rating_pct = rating_num | divided_by: 5.0 | times: 100

  assign root_classes = 'hkf'
  if s.sticky_gallery
    assign root_classes = root_classes | append: ' hkf--sticky'
  endif
  if s.reassure_mobile == 'two'
    assign root_classes = root_classes | append: ' hkf--reassure-2'
  endif
  if s.risk_pulse
    assign root_classes = root_classes | append: ' hkf--risk-pulse'
  endif
-%}

