{% comment %}
  detail-pills.liquid
  A text column beside a card of clickable pills. Each pill opens a small
  dialog over a blurred backdrop explaining that item across three aspects —
  built for contaminants, ingredients, materials, allergens, and the like.

  Self-contained: styles and behaviour are both inlined, so this file is the
  only thing that needs to exist in the theme.
{% endcomment %}

{% style %}
/* ==========================================================================
   Detail pills — scoped under .dpills so the rest of the theme is untouched.
   ========================================================================== */

.dpills {
  /* Palette */
  --dp-navy: #16295c;
  --dp-orange: #f26a21;
  --dp-orange-soft: #fdf0e8;
  --dp-muted: #8a8f9a;
  --dp-card: #ffffff;
  --dp-line: #e5e9f0;
  --dp-tint: #eef3fb;

  /* Shape */
  --dp-max: 1060px;
  --dp-gutter: 24px;
  --dp-card-radius: 20px;
  --dp-pill-radius: 999px;

  /* Backdrop */
  --dp-backdrop: rgba(232, 238, 248, 0.55);
  --dp-blur: 12px;

  --dp-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  font-family: var(--dp-font);
  -webkit-font-smoothing: antialiased;
}

.dpills *,
.dpills *::before,
.dpills *::after {
  box-sizing: border-box;
}

/* Zero-specificity defaults so component classes always win. */
:where(.dpills) :where(p) {
  margin: 0;
}

:where(.dpills) :where(h2, h3) {
  margin: 0;
  font-size: inherit;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.15;
  color: var(--dp-navy);
}

:where(.dpills) :where(ul) {
  margin: 0;
  padding: 0;
  list-style: none;
}

:where(.dpills) :where(button) {
  font: inherit;
  color: inherit;
  cursor: pointer;
}

.dpills :focus-visible {
  outline: 2px solid var(--dp-orange);
  outline-offset: 2px;
}

.dpills__container {
  max-width: calc(var(--dp-max) + var(--dp-gutter) * 2);
  margin-inline: auto;
  padding-inline: var(--dp-gutter);
}

/* Text column and card are optically centred on each other, as in the
   reference, rather than top-aligned. */
.dpills__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
  gap: 52px;
  align-items: center;
}

/* --------------------------------------------------------------------------
   Intro column
   -------------------------------------------------------------------------- */

.dpills__eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--dp-navy);
}

.dpills__eyebrow::before {
  content: "";
  flex: 0 0 auto;
  width: 22px;
  height: 2px;
  background: var(--dp-orange);
}

.dpills--no-dash .dpills__eyebrow::before {
  display: none;
}

.dpills__title {
  margin-top: 14px;
  font-size: clamp(1.5rem, 1.05rem + 1.6vw, 2.125rem);
  color: var(--dp-navy);
}

.dpills__text {
  margin-top: 14px;
  font-size: 14.5px;
  line-height: 1.6;
  color: var(--dp-muted);
}

.dpills__verify {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 22px;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--dp-muted);
}

.dpills__verify svg {
  flex: 0 0 auto;
  width: 15px;
  height: 15px;
  margin-top: 1px;
  color: var(--dp-navy);
}

/* --------------------------------------------------------------------------
   Pill card
   -------------------------------------------------------------------------- */

.dpills__card {
  padding: 22px;
  border-radius: var(--dp-card-radius);
  background: var(--dp-card);
  box-shadow: 0 6px 30px rgba(22, 41, 92, 0.07);
}

.dpills__card-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  font-size: 10.5px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--dp-muted);
}

.dpills__card-dot {
  flex: 0 0 auto;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--dp-orange);
}

.dpills__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.dpills__pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  padding: 9px 14px;
  border: 1px solid var(--dp-line);
  border-radius: var(--dp-pill-radius);
  background: var(--dp-card);
  font-size: 13px;
  font-weight: 500;
  line-height: 1.2;
  color: var(--dp-navy);
  text-align: left;
  transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
}

/* Only pills that actually open something get the affordance. */
button.dpills__pill:hover {
  border-color: rgba(22, 41, 92, 0.32);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(22, 41, 92, 0.08);
}

.dpills__check {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: var(--dp-tint);
  color: var(--dp-navy);
}

.dpills__check svg {
  width: 10px;
  height: 10px;
}

/* Trailing "+N more" pill */
.dpills__pill--extra {
  border-color: transparent;
  background: var(--dp-orange);
  color: #fff;
  font-weight: 600;
}

button.dpills__pill--extra:hover {
  border-color: transparent;
  background: #e35c12;
}

.dpills__pill--extra .dpills__check {
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.dpills__item[hidden] {
  display: none;
}

/* --------------------------------------------------------------------------
   Modal
   -------------------------------------------------------------------------- */

.dpills__modal {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.22s ease;
}

/* display:flex above would otherwise beat the UA [hidden] rule. */
.dpills__modal[hidden] {
  display: none;
}

.dpills__modal.is-open {
  opacity: 1;
}

.dpills__backdrop {
  position: absolute;
  inset: 0;
  background: var(--dp-backdrop);
  -webkit-backdrop-filter: blur(var(--dp-blur));
  backdrop-filter: blur(var(--dp-blur));
  border: 0;
  padding: 0;
  cursor: default;
}

.dpills__dialog {
  position: relative;
  width: 100%;
  max-width: 400px;
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  padding: 24px;
  border-radius: var(--dp-card-radius);
  background: #fbfbfc;
  box-shadow: 0 24px 60px rgba(22, 41, 92, 0.22);
  transform: translateY(10px) scale(0.97);
  transition: transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.dpills__modal.is-open .dpills__dialog {
  transform: none;
}

.dpills__close {
  position: absolute;
  top: 18px;
  right: 18px;
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #eef0f4;
  color: var(--dp-navy);
  transition: background-color 0.16s ease;
}

.dpills__close:hover {
  background: #e2e6ec;
}

.dpills__close svg {
  width: 13px;
  height: 13px;
}

.dpills__panel[hidden] {
  display: none;
}

.dpills__panel-head {
  display: flex;
  align-items: center;
  gap: 13px;
  /* Room for the close button so a long title never slides under it. */
  padding-right: 40px;
}

.dpills__panel-icon {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--dp-orange-soft);
  color: var(--dp-orange);
}

.dpills__panel-icon svg {
  width: 20px;
  height: 20px;
}

.dpills__panel-title {
  font-size: 19px;
  line-height: 1.2;
}

.dpills__rows {
  display: grid;
  gap: 16px;
  margin-top: 20px;
}

.dpills__row {
  display: flex;
  align-items: flex-start;
  gap: 11px;
}

.dpills__row-icon {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 26px;
  height: 26px;
  margin-top: 1px;
  border-radius: 50%;
  background: var(--dp-tint);
  color: var(--dp-navy);
}

.dpills__row-icon svg {
  width: 13px;
  height: 13px;
}

.dpills__row-label {
  font-size: 10.5px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--dp-muted);
}

.dpills__row--accent .dpills__row-label {
  color: var(--dp-navy);
}

.dpills__row-text {
  margin-top: 6px;
  font-size: 13.5px;
  line-height: 1.5;
  color: #33384a;
}

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */

@media screen and (max-width: 899px) {
  .dpills__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 30px;
  }
}

@media screen and (max-width: 767px) {
  .dpills {
    --dp-gutter: 20px;
  }

  .dpills__card {
    padding: 18px;
  }

  .dpills__list {
    gap: 8px;
  }

  .dpills__pill {
    padding: 8px 12px;
    font-size: 12.5px;
  }

  .dpills__dialog {
    padding: 20px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .dpills__modal,
  .dpills__dialog,
  .dpills__pill {
    transition-duration: 0.001ms;
  }
}
{% endstyle %}

{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'item'

  assign extras = s.extra_items | strip | newline_to_br | split: '<br />'

  assign root_classes = 'dpills'
  unless s.show_dash
    assign root_classes = root_classes | append: ' dpills--no-dash'
  endunless
-%}

{%- capture icon_check -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>{%- endcapture -%}
{%- capture icon_plus -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M8 3.2v9.6M3.2 8h9.6"/></svg>{%- endcapture -%}

{%- if items.size > 0 -%}
  <div
    class="{{ root_classes }}"
    id="dpills-{{ section.id }}"
    data-dpills-root
    style="
      --dp-navy: {{ s.color_navy }};
      --dp-orange: {{ s.color_orange }};
      --dp-orange-soft: {{ s.color_orange_soft }};
      --dp-muted: {{ s.color_muted }};
      --dp-card: {{ s.color_card }};
      --dp-line: {{ s.color_line }};
      --dp-tint: {{ s.color_tint }};
      --dp-backdrop: {{ s.color_backdrop }};
      --dp-blur: {{ s.backdrop_blur }}px;
      --dp-max: {{ s.container_width }}px;
      --dp-card-radius: {{ s.card_radius }}px;
      --dp-pill-radius: {{ s.pill_radius }}px;
      background: linear-gradient(115deg, {{ s.color_bg_start }} 0%, {{ s.color_bg_end }} 100%);
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    "
  >
    <div class="dpills__container">
      <div class="dpills__grid">
        {%- comment -%} ---------- Intro ---------- {%- endcomment -%}
        <div class="dpills__intro">
          {%- if s.eyebrow != blank -%}
            <p class="dpills__eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}

          {%- if s.title != blank -%}
            <h2 class="dpills__title">{{ s.title | escape }}</h2>
          {%- endif -%}

          {%- if s.text != blank -%}
            <div class="dpills__text">{{ s.text }}</div>
          {%- endif -%}

          {%- if s.verify_text != blank -%}
            <p class="dpills__verify">
              {%- case s.verify_icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.4l6 2.2v5.1c0 3.5-2.4 6.6-6 7.9-3.6-1.3-6-4.4-6-7.9V4.6z"/><path d="M7.4 10l1.9 1.9 3.4-3.6"/></svg>
                {%- when 'lab' -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 2.6h4v4.2l3.6 7.4a2 2 0 01-1.8 2.9H6.2a2 2 0 01-1.8-2.9L8 6.8z"/><path d="M6.4 12.4h7.2"/></svg>
                {%- when 'award' -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="8" r="5"/><path d="M6.8 12.4L5.6 18l4.4-2.4L14.4 18l-1.2-5.6"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M6.7 10.2l2.2 2.2 4.4-4.6"/></svg>
              {%- endcase -%}
              <span>{{ s.verify_text }}</span>
            </p>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- Pill card ---------- {%- endcomment -%}
        <div class="dpills__card">
          {%- if s.card_eyebrow != blank -%}
            <p class="dpills__card-eyebrow">
              {%- if s.show_card_dot -%}
                <span class="dpills__card-dot" aria-hidden="true"></span>
              {%- endif -%}
              {{ s.card_eyebrow }}
            </p>
          {%- endif -%}

          <ul class="dpills__list">
            {%- for block in items -%}
              {%- liquid
                assign b = block.settings

                comment
                  A pill only becomes a button when there is something to show,
                  so the affordance never lies.
                endcomment
                assign has_detail = false
                if b.aspect_1 != blank or b.aspect_2 != blank or b.aspect_3 != blank
                  assign has_detail = true
                endif
              -%}
              <li {{ block.shopify_attributes }}>
                {%- if has_detail -%}
                  <button
                    type="button"
                    class="dpills__pill"
                    data-dpills-open="{{ block.id }}"
                    aria-haspopup="dialog"
                  >
                    <span class="dpills__check" aria-hidden="true">{{ icon_check }}</span>
                    <span>{{ b.label }}</span>
                  </button>
                {%- else -%}
                  <span class="dpills__pill">
                    <span class="dpills__check" aria-hidden="true">{{ icon_check }}</span>
                    <span>{{ b.label }}</span>
                  </span>
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- comment -%}
              Extra labels stay in the markup but hidden, so revealing them is
              instant and needs no second request.
            {%- endcomment -%}
            {%- for extra in extras -%}
              {%- assign extra_label = extra | strip_html | strip -%}
              {%- if extra_label != blank -%}
                <li class="dpills__item" data-dpills-extra hidden>
                  <span class="dpills__pill">
                    <span class="dpills__check" aria-hidden="true">{{ icon_check }}</span>
                    <span>{{ extra_label }}</span>
                  </span>
                </li>
              {%- endif -%}
            {%- endfor -%}

            {%- if s.extra_label != blank -%}
              <li data-dpills-extra-holder>
                {%- if s.extra_items != blank -%}
                  <button
                    type="button"
                    class="dpills__pill dpills__pill--extra"
                    data-dpills-expand
                    aria-expanded="false"
                  >
                    <span class="dpills__check" aria-hidden="true">{{ icon_plus }}</span>
                    <span>{{ s.extra_label }}</span>
                  </button>
                {%- else -%}
                  <span class="dpills__pill dpills__pill--extra">
                    <span class="dpills__check" aria-hidden="true">{{ icon_plus }}</span>
                    <span>{{ s.extra_label }}</span>
                  </span>
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul>
        </div>
      </div>
    </div>

    {%- comment -%} ---------- Modal ---------- {%- endcomment -%}
    <div class="dpills__modal" data-dpills-modal hidden>
      <button
        type="button"
        class="dpills__backdrop"
        data-dpills-close
        tabindex="-1"
        aria-hidden="true"
      ></button>

      <div class="dpills__dialog" role="dialog" aria-modal="true" data-dpills-dialog>
        <button type="button" class="dpills__close" data-dpills-close aria-label="{{ s.close_label }}">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/></svg>
        </button>

        {%- for block in items -%}
          {%- assign b = block.settings -%}
          {%- if b.aspect_1 != blank or b.aspect_2 != blank or b.aspect_3 != blank -%}
            <div class="dpills__panel" data-dpills-panel="{{ block.id }}" hidden>
              <div class="dpills__panel-head">
                <span class="dpills__panel-icon" aria-hidden="true">
                  {%- case b.icon -%}
                    {%- when 'droplet' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.4S4.6 8.1 4.6 11.7A5.4 5.4 0 0010 17a5.4 5.4 0 005.4-5.3C15.4 8.1 10 2.4 10 2.4z"/></svg>
                    {%- when 'flask' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 2.6h4v4.2l3.6 7.4a2 2 0 01-1.8 2.9H6.2a2 2 0 01-1.8-2.9L8 6.8z"/><path d="M6.4 12.4h7.2"/></svg>
                    {%- when 'molecule' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="4.4" r="2"/><circle cx="4.6" cy="14" r="2"/><circle cx="15.4" cy="14" r="2"/><path d="M8.6 6.2L6 12M11.4 6.2L14 12M6.6 14h6.8"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16.5 3.5c0 7.2-3.6 10.8-8 10.8a4.6 4.6 0 01-4.6-4.6c0-4.4 4.6-6.2 12.6-6.2z"/><path d="M3.5 16.5c2.8-4.2 6.4-7.3 10.4-9.2"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.4l6 2.2v5.1c0 3.5-2.4 6.6-6 7.9-3.6-1.3-6-4.4-6-7.9V4.6z"/><path d="M7.4 10l1.9 1.9 3.4-3.6"/></svg>
                    {%- when 'alert' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.8l7.4 13.2H2.6z"/><path d="M10 7.6v4"/><circle cx="10" cy="13.8" r="0.9" fill="currentColor" stroke="none"/></svg>
                    {%- when 'bug' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="6" y="6.6" width="8" height="9.4" rx="4"/><path d="M6 10.4H2.8M17.2 10.4H14M6.4 13.8H3.2M16.8 13.8H13.6M7.6 6.4L6 3.8M12.4 6.4L14 3.8"/></svg>
                    {%- when 'flame' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 2.4c.6 3-1.4 3.8-2.6 5.4-1.4 1.8-.4 3.6 1.2 3.6 1.4 0 2.2-1 2.2-2.4 1.6 1.2 2.4 2.8 2.4 4.2A4.8 4.8 0 015 13.6c0-4.4 6-5.8 6-11.2z"/></svg>
                    {%- when 'sparkle' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.6l1.9 4.7 4.7 1.9-4.7 1.9L10 15.8l-1.9-4.8L3.4 9.2l4.7-1.9z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M6.7 10.2l2.2 2.2 4.4-4.6"/></svg>
                  {%- endcase -%}
                </span>
                <h3 class="dpills__panel-title" id="dpills-title-{{ block.id }}">{{ b.label }}</h3>
              </div>

              <div class="dpills__rows">
                {%- for i in (1..3) -%}
                  {%- liquid
                    case i
                      when 1
                        assign row_text = b.aspect_1
                        assign row_label = s.aspect_1_label
                        assign row_icon = s.aspect_1_icon
                        assign row_accent = s.aspect_1_accent
                      when 2
                        assign row_text = b.aspect_2
                        assign row_label = s.aspect_2_label
                        assign row_icon = s.aspect_2_icon
                        assign row_accent = s.aspect_2_accent
                      when 3
                        assign row_text = b.aspect_3
                        assign row_label = s.aspect_3_label
                        assign row_icon = s.aspect_3_icon
                        assign row_accent = s.aspect_3_accent
                    endcase
                  -%}
                  {%- if row_text != blank -%}
                    <div class="dpills__row{% if row_accent %} dpills__row--accent{% endif %}">
                      <span class="dpills__row-icon" aria-hidden="true">
                        {%- case row_icon -%}
                          {%- when 'question' -%}
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M7.8 7.8a2.2 2.2 0 114.2 1c0 1.2-2 1.4-2 2.8"/><circle cx="10" cy="14.4" r="0.85" fill="currentColor" stroke="none"/></svg>
                          {%- when 'alert' -%}
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/><path d="M10 6.2v4.6"/><circle cx="10" cy="13.8" r="0.85" fill="currentColor" stroke="none"/></svg>
                          {%- when 'shield' -%}
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 2.6l5.6 2v4.8c0 3.2-2.2 6.2-5.6 7.4-3.4-1.2-5.6-4.2-5.6-7.4V4.6z"/><path d="M7.6 10l1.8 1.8 3.2-3.4"/></svg>
                          {%- when 'leaf' -%}
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16.5 3.5c0 7.2-3.6 10.8-8 10.8a4.6 4.6 0 01-4.6-4.6c0-4.4 4.6-6.2 12.6-6.2z"/></svg>
                          {%- when 'check' -%}
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.4 10.4l3.2 3.2 8-8"/></svg>
                          {%- else -%}
                            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.6"/></svg>
                        {%- endcase -%}
                      </span>
                      <div>
                        {%- if row_label != blank -%}
                          <span class="dpills__row-label">{{ row_label }}</span>
                        {%- endif -%}
                        <p class="dpills__row-text">{{ row_text }}</p>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('dpills-{{ section.id }}');
      if (!root || root.dataset.dpillsReady === 'true') return;
      root.dataset.dpillsReady = 'true';

      var modal = root.querySelector('[data-dpills-modal]');
      var dialog = root.querySelector('[data-dpills-dialog]');
      var panels = [].slice.call(root.querySelectorAll('[data-dpills-panel]'));
      var closeBtn = root.querySelector('.dpills__close');
      var lastTrigger = null;

      var FOCUSABLE =
        'button:not([tabindex="-1"]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';

      /* ---- Reveal the extra labels ---- */

      var expand = root.querySelector('[data-dpills-expand]');
      if (expand) {
        expand.addEventListener('click', function () {
          [].slice.call(root.querySelectorAll('[data-dpills-extra]')).forEach(function (li) {
            li.hidden = false;
          });
          expand.setAttribute('aria-expanded', 'true');
          /* The pill has done its job; keeping it would invite a dead click. */
          var holder = root.querySelector('[data-dpills-extra-holder]');
          if (holder) holder.hidden = true;
        });
      }

      /* ---- Modal ---- */

      function lockScroll(locked) {
        document.documentElement.style.overflow = locked ? 'hidden' : '';
        document.body.style.overflow = locked ? 'hidden' : '';
      }

      function openModal(id, trigger) {
        var active = null;
        panels.forEach(function (panel) {
          var match = panel.getAttribute('data-dpills-panel') === id;
          panel.hidden = !match;
          if (match) active = panel;
        });
        if (!active) return;

        lastTrigger = trigger || null;
        modal.hidden = false;
        lockScroll(true);

        /* Name the dialog after the item now showing. */
        var title = active.querySelector('.dpills__panel-title');
        if (title && title.id) dialog.setAttribute('aria-labelledby', title.id);

        /* Next frame so the transition has a starting state to animate from. */
        window.requestAnimationFrame(function () {
          modal.classList.add('is-open');
        });

        if (closeBtn) closeBtn.focus();
      }

      function closeModal() {
        modal.classList.remove('is-open');
        lockScroll(false);

        var finish = function () {
          modal.hidden = true;
          if (lastTrigger) lastTrigger.focus();
          lastTrigger = null;
        };

        /* Wait for the fade so the dialog does not vanish mid-animation. */
        var done = false;
        modal.addEventListener('transitionend', function once(event) {
          if (event.target !== modal || done) return;
          done = true;
          modal.removeEventListener('transitionend', once);
          finish();
        });
        window.setTimeout(function () {
          if (!done) {
            done = true;
            finish();
          }
        }, 320);
      }

      [].slice.call(root.querySelectorAll('[data-dpills-open]')).forEach(function (pill) {
        pill.addEventListener('click', function () {
          openModal(pill.getAttribute('data-dpills-open'), pill);
        });
      });

      [].slice.call(root.querySelectorAll('[data-dpills-close]')).forEach(function (el) {
        el.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function (event) {
        if (modal.hidden) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closeModal();
          return;
        }

        /* Keep Tab inside the dialog while it owns the screen. */
        if (event.key === 'Tab') {
          var items = [].slice
            .call(dialog.querySelectorAll(FOCUSABLE))
            .filter(function (el) {
              return el.offsetParent !== null;
            });
          if (!items.length) return;

          var first = items[0];
          var last = items[items.length - 1];

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });
    })();
  </script>
{%- endif -%}

