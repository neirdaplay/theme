{% comment %}
  produit-sur-mesure-pureeva.liquid
  Pureva-style product section: gallery with floating badges, trust row,
  bullets, offer card, add-to-cart, reassurance columns, box contents,
  accordions, rating row and a row of circular video buttons.

  The "personnalisez votre offre" block (household size, frequency, gifts) is
  deliberately absent, as asked.

  Self-contained: styles and behaviour are both inlined, so this file is the
  only thing that needs to exist in the theme.
{% endcomment %}

{% style %}
/* ==========================================================================
   Pureva product — scoped under .pvp so the rest of the theme is untouched.
   ========================================================================== */

.pvp {
  /* Palette */
  --pv-dark: #0d3b36;
  --pv-ink: #0f1b2a;
  --pv-muted: #6b7280;
  --pv-teal: #0fb6a8;
  --pv-green: #16a34a;
  --pv-line: #e6eaee;
  --pv-soft: #f2f6f5;
  --pv-mint: #e8f4f4;
  --pv-white: #ffffff;

  /* Shape */
  --pv-max: 1180px;
  --pv-gutter: 24px;
  --pv-radius: 14px;
  --pv-radius-lg: 20px;

  /* Written by the schema as --*-set, derived here, so the media queries
     below can still override them. An inline value on this same element
     would otherwise beat every one of them. */
  --pv-offer-img: var(--pv-offer-img-set, 54px);
  --pv-offer-img-bg: var(--pv-offer-img-bg-set, #ffffff);
  --pv-thumb: var(--pv-thumb-set, 64px);
  --pv-stack-gap: var(--pv-stack-gap-set, 16px);
  --pv-stage-ratio: var(--pv-stage-ratio-set, 1 / 1);
  --pv-stage-fit: var(--pv-stage-fit-set, cover);

  --pv-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  font-family: var(--pv-font);
  color: var(--pv-ink);
  -webkit-font-smoothing: antialiased;
}

.pvp *,
.pvp *::before,
.pvp *::after {
  box-sizing: border-box;
}

:where(.pvp) :where(p) {
  margin: 0;
}

:where(.pvp) :where(h1, h2, h3) {
  margin: 0;
  font-size: inherit;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--pv-ink);
}

:where(.pvp) :where(ul, ol) {
  margin: 0;
  padding: 0;
  list-style: none;
}

:where(.pvp) :where(button) {
  font: inherit;
  color: inherit;
  cursor: pointer;
}

:where(.pvp) :where(a) {
  color: inherit;
}

:where(.pvp) :where(img, video) {
  display: block;
  max-width: 100%;
}

.pvp :focus-visible {
  outline: 2px solid var(--pv-teal);
  outline-offset: 2px;
}

.pvp__sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.pvp__container {
  max-width: calc(var(--pv-max) + var(--pv-gutter) * 2);
  margin-inline: auto;
  padding-inline: var(--pv-gutter);
}

.pvp__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  /* The second row is flexible so the taller info column, which spans both,
     donates its extra height there instead of padding the gallery row. */
  grid-template-rows: auto 1fr;
  gap: 40px;
  align-items: start;
}

/* The info column is far taller than the gallery, so the video row is placed
   under the gallery to fill that space. Source order stays gallery / info /
   videos, which is exactly what the single-column layout wants. */
.pvp__gallery {
  grid-column: 1;
  grid-row: 1;
}

.pvp__info {
  grid-column: 2;
  grid-row: 1 / span 2;
}

.pvp__videos-cell {
  grid-column: 1;
  grid-row: 2;
}

/* --------------------------------------------------------------------------
   Gallery
   -------------------------------------------------------------------------- */

.pvp__stage {
  position: relative;
  border-radius: var(--pv-radius-lg);
  overflow: hidden;
  background: var(--pv-mint);
  /* Horizontal swipes belong to the gallery, vertical ones to the page. */
  touch-action: pan-y;
}

/* All the slides sit side by side on one rail; moving the rail is what the
   finger drags, so the images actually travel instead of cross-fading. */
.pvp__track {
  display: flex;
  transition: transform 0.34s cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: transform;
}

/* While a finger is down the rail must follow it exactly, with no easing. */
.pvp__track.is-dragging {
  transition: none;
}

.pvp__slide {
  flex: 0 0 100%;
  min-width: 0;
  aspect-ratio: var(--pv-stage-ratio);
}

/* cover fills the frame edge to edge; contain shows the whole shot and lets
   the stage background show through the sides. */
.pvp__slide img,
.pvp__placeholder {
  width: 100%;
  height: 100%;
  object-fit: var(--pv-stage-fit);
}

.pvp__placeholder {
  display: grid;
  place-items: center;
  color: #a9bdbd;
}

.pvp__placeholder svg {
  width: 30%;
  height: auto;
}

/* Circular guarantee seal, top-left of the image. */
.pvp__seal {
  position: absolute;
  top: 16px;
  left: 16px;
  z-index: 3;
  display: grid;
  place-content: center;
  justify-items: center;
  width: var(--pv-seal, 84px);
  height: var(--pv-seal, 84px);
  border-radius: 50%;
  background: var(--pv-dark);
  color: var(--pv-white);
  text-align: center;
  padding: 6px;
}

.pvp__seal-top,
.pvp__seal-bottom {
  font-size: calc(var(--pv-seal, 84px) * 0.085);
  font-weight: 600;
  line-height: 1.2;
  opacity: 0.85;
}

.pvp__seal-value {
  font-size: calc(var(--pv-seal, 84px) * 0.24);
  font-weight: 700;
  line-height: 1.05;
}

/* Floating callout pointing at part of the product. */
.pvp__callout {
  position: absolute;
  top: 26%;
  right: 14px;
  z-index: 3;
  padding: 7px 12px;
  border-radius: 10px;
  background: var(--pv-white);
  box-shadow: 0 4px 14px rgba(15, 27, 42, 0.14);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  white-space: nowrap;
}

/* Trust strip across the bottom of the image. */
.pvp__stage-trust {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  background: linear-gradient(to top, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0));
  font-size: 12px;
  font-weight: 600;
}

.pvp__stage-trust .pvp__muted {
  font-weight: 500;
}

/* ---- Thumbnails ---- */

.pvp__thumbs {
  display: flex;
  gap: 10px;
  margin-top: 12px;
  overflow-x: auto;
  scrollbar-width: none;
}

.pvp__thumbs::-webkit-scrollbar {
  display: none;
}

.pvp__thumb {
  position: relative;
  flex: 0 0 auto;
  width: var(--pv-thumb);
  padding: 0;
  border: 2px solid transparent;
  border-radius: 10px;
  background: var(--pv-mint);
  overflow: hidden;
  line-height: 0;
  transition: border-color 0.16s ease;
}

.pvp__thumb img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}

.pvp__thumb[aria-selected="true"] {
  border-color: var(--pv-dark);
}

/* --------------------------------------------------------------------------
   Info column
   -------------------------------------------------------------------------- */

.pvp__trust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
}

/* ---- Review row and its popover ---- */

.pvp__reviews {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.pvp__reviews-toggle {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0;
  border: 0;
  background: none;
  font-size: 12.5px;
  font-weight: 600;
}

.pvp__reviews-toggle > span {
  text-decoration: underline;
  text-underline-offset: 2px;
}

.pvp__reviews-toggle svg {
  width: 12px;
  height: 12px;
  transition: transform 0.18s ease;
}

.pvp__reviews-toggle[aria-expanded="true"] svg {
  transform: rotate(180deg);
}

.pvp__reviews-note {
  font-size: 12px;
  color: var(--pv-muted);
}

.pvp__revpop {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  z-index: 30;
  width: min(340px, calc(100vw - var(--pv-gutter) * 2 - 4px));
  padding: 16px;
  border: 1px solid var(--pv-line);
  border-radius: 14px;
  background: var(--pv-white);
  box-shadow: 0 18px 44px rgba(15, 27, 42, 0.18);
  /* display:none, not visibility: a hidden-but-laid-out card widens the page. */
  animation: pvp-pop-in 0.18s ease;
}

.pvp__revpop[hidden] {
  display: none;
}

@keyframes pvp-pop-in {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.pvp__revpop-close {
  position: absolute;
  top: 12px;
  right: 12px;
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--pv-soft);
  color: var(--pv-ink);
}

.pvp__revpop-close svg {
  width: 10px;
  height: 10px;
}

.pvp__revpop-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-right: 30px;
}

.pvp__revpop-score {
  flex: 0 0 auto;
  font-size: 30px;
  font-weight: 700;
  line-height: 1;
}

.pvp__revpop-meta {
  min-width: 0;
  font-size: 12.5px;
  color: var(--pv-muted);
}

.pvp__revpop-meta .pvp__stars {
  margin-bottom: 3px;
}

.pvp__revpop-meta b {
  color: var(--pv-ink);
}

.pvp__revpop-sep {
  height: 1px;
  margin: 14px 0;
  background: var(--pv-line);
}

.pvp__review[hidden] {
  display: none;
}

.pvp__review-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.pvp__review-name {
  font-size: 13px;
  font-weight: 700;
}

.pvp__review-verified {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: 20px;
  background: rgba(22, 163, 74, 0.12);
  color: var(--pv-green);
  font-size: 10.5px;
  font-weight: 700;
}

.pvp__review-verified svg {
  width: 9px;
  height: 9px;
}

.pvp__review-text {
  margin-top: 8px;
  font-size: 12.5px;
  line-height: 1.55;
  color: var(--pv-muted);
}

.pvp__revpop-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 14px;
}

.pvp__revpop-arrow {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 1px solid var(--pv-line);
  border-radius: 50%;
  background: var(--pv-white);
  color: var(--pv-ink);
}

.pvp__revpop-arrow svg {
  width: 11px;
  height: 11px;
}

.pvp__revpop-dots {
  display: flex;
  gap: 5px;
}

.pvp__revpop-dot {
  width: 7px;
  height: 7px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--pv-line);
}

.pvp__revpop-dot[aria-current="true"] {
  background: var(--pv-ink);
}

.pvp__muted {
  color: var(--pv-muted);
}

.pvp__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px 16px;
  margin-top: 10px;
}

.pvp__title {
  font-size: clamp(1.4rem, 1rem + 1.5vw, 1.9rem);
}

.pvp__subtitle {
  margin-top: 6px;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--pv-muted);
}

.pvp__perday {
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 700;
  color: var(--pv-ink);
  white-space: nowrap;
}

/* ---- Bullets ---- */

.pvp__bullets {
  display: grid;
  gap: 9px;
  margin-top: 16px;
}

.pvp__bullets li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 13.5px;
  line-height: 1.5;
}

.pvp__bullet-icon {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 18px;
  height: 18px;
  margin-top: 1px;
  border-radius: 50%;
  background: var(--pv-soft);
  color: var(--pv-dark);
}

.pvp__bullet-icon svg {
  width: 11px;
  height: 11px;
}

/* ---- Badge pills ---- */

.pvp__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.pvp__badge {
  padding: 7px 13px;
  border-radius: 8px;
  background: var(--pv-soft);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
  color: var(--pv-ink);
}

.pvp__badge--dark {
  background: var(--pv-dark);
  color: var(--pv-white);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* ---- Offer card ---- */

/* A thin gift band, not a panel: every metric here is deliberately tight. */
.pvp__offer {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
  padding: 11px 13px;
  border-radius: var(--pv-radius);
  background: var(--pv-dark);
  color: var(--pv-white);
}

/* A product tile, not a cropped pastille: light background, the whole item
   visible inside it. */
.pvp__offer-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: var(--pv-offer-img);
  height: var(--pv-offer-img);
  padding: 5px;
  border-radius: 9px;
  background: var(--pv-offer-img-bg);
  overflow: hidden;
}

/* Bounded by maxima rather than sized to 100%: a percentage height here
   would resolve against a box that is itself sized by this image, so the
   browser falls back to the natural height and the frame crops it. */
.pvp__offer-icon img {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.pvp__offer-icon svg {
  width: 26px;
  height: 26px;
  color: var(--pv-dark);
}

.pvp__offer-tag {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 4px;
  background: var(--pv-teal);
  color: #04302c;
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.pvp__offer-title {
  margin-top: 4px;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--pv-white);
}

.pvp__offer-text {
  margin-top: 3px;
  font-size: 11.5px;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.72);
}

/* The gift itself: name, its usual price struck through, and "Offert". One
   more line, no separator rule — the band has to stay a band. */
.pvp__offer-product {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 3px 7px;
  margin-top: 4px;
  font-size: 11px;
  font-weight: 600;
}

.pvp__offer-was {
  color: rgba(255, 255, 255, 0.55);
  font-weight: 500;
}

.pvp__offer-free {
  padding: 1px 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.14);
  font-size: 9.5px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* Editor-only warning: never rendered on the storefront. */
.pvp__offer-warn {
  margin-top: 8px;
  padding: 7px 9px;
  border-radius: 6px;
  background: #ffb020;
  color: #3a2600;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.4;
}

/* --------------------------------------------------------------------------
   Bundle / subscription configurator (block "bundle")
   -------------------------------------------------------------------------- */

.pvpb {
  margin-top: 20px;
}

.pvpb__summary {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 6px 16px;
  padding-bottom: 12px;
}

.pvpb__summary-title {
  font-size: 13.5px;
  font-weight: 700;
  white-space: nowrap;
}

.pvpb__summary-title {
  flex: 0 1 auto;
}

/* basis 0 so the recap shares the title's line instead of being pushed under
   it by the width of the renewal sentence. */
.pvpb__summary-prices {
  display: flex;
  flex: 1 1 0;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4px 8px;
  min-width: 0;
}

.pvpb__off {
  padding: 2px 7px;
  border-radius: 5px;
  background: var(--pv-accent-soft);
  color: var(--pv-accent-ink);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.pvpb__off[hidden],
.pvpb__was[hidden],
.pvpb__then[hidden],
.pvpb__freq-was[hidden],
.pvpb__freq-off[hidden],
.pvpb__panel[hidden],
.pvpb__gift-badge[hidden] {
  display: none;
}

.pvpb__was {
  color: var(--pv-muted);
  font-size: 13px;
  font-weight: 500;
}

.pvpb__now {
  font-size: 20px;
  font-weight: 700;
  white-space: nowrap;
}

/* The recurring line always starts on its own row under the price. */
.pvpb__then {
  flex: 1 0 100%;
  text-align: right;
  font-size: 11.5px;
  color: var(--pv-muted);
}

.pvpb__then b {
  color: var(--pv-ink);
  font-weight: 700;
}

.pvpb__card {
  padding: 16px;
  border: 1px solid var(--pv-line);
  border-radius: var(--pv-radius);
  background: var(--pv-white);
}

/* ---- Steps ---- */

.pvpb__step {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.pvpb__step + .pvpb__step,
.pvpb__choices + .pvpb__step {
  margin-top: 20px;
}

.pvpb__num {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--pv-dark);
  color: var(--pv-white);
  font-size: 11px;
  font-weight: 700;
}

.pvpb__step-body {
  flex: 1 1 auto;
  min-width: 0;
}

.pvpb__step-title {
  display: block;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
}

.pvpb__step-sub {
  display: block;
  margin-top: 2px;
  font-size: 11.5px;
  line-height: 1.4;
  color: var(--pv-muted);
}

.pvpb__why {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex: 0 0 auto;
  margin-top: 2px;
  padding: 0;
  border: 0;
  background: none;
  color: var(--pv-muted);
  font-size: 12px;
  text-decoration: underline;
}

.pvpb__why svg {
  width: 13px;
  height: 13px;
}

/* ---- Household choices ---- */

.pvpb__choices {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
  gap: 10px;
  margin-top: 12px;
}

.pvpb__choice {
  padding: 14px 10px;
  /* The border is always 2px so selecting one never shifts the row. */
  border: 2px solid var(--pv-line);
  border-radius: 10px;
  background: var(--pv-white);
  font-size: 13.5px;
  font-weight: 600;
  text-align: center;
  transition: border-color 0.16s ease;
}

.pvpb__choice[aria-checked="true"] {
  border-color: var(--pv-ink);
}

/* ---- Frequency panel ---- */

.pvpb__panel {
  margin-top: 14px;
  padding: 14px;
  border-radius: 12px;
  background: var(--pv-soft);
}

.pvpb__panel-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 4px 12px;
}

.pvpb__panel-title {
  font-size: 13.5px;
  font-weight: 700;
}

.pvpb__panel-note {
  font-size: 12px;
  font-weight: 600;
  color: var(--pv-teal);
}

.pvpb__freqs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
  margin-top: 12px;
}

.pvpb__freq {
  display: block;
  padding: 12px 13px;
  border: 2px solid var(--pv-line);
  border-radius: 10px;
  background: var(--pv-white);
  text-align: left;
  transition: border-color 0.16s ease;
}

.pvpb__freq[aria-checked="true"] {
  border-color: var(--pv-ink);
}

.pvpb__freq-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.pvpb__freq-label {
  font-size: 13.5px;
  font-weight: 700;
}

.pvpb__freq-badge {
  padding: 3px 8px;
  border-radius: 20px;
  background: var(--pv-ink);
  color: var(--pv-white);
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  white-space: nowrap;
}

.pvpb__freq-prices {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 6px;
  margin-top: 10px;
}

.pvpb__freq-was {
  color: var(--pv-muted);
  font-size: 12.5px;
}

.pvpb__freq-now {
  font-size: 16px;
  font-weight: 700;
}

.pvpb__freq-off {
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--pv-accent-soft);
  color: var(--pv-accent-ink);
  font-size: 10px;
  font-weight: 700;
}

.pvpb__freq-day {
  display: block;
  margin-top: 4px;
  font-size: 11.5px;
  color: var(--pv-muted);
}

/* ---- Gifts ---- */

.pvpb__gifts-title {
  margin-top: 16px;
  font-size: 12.5px;
  font-weight: 700;
}

.pvpb__gifts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 8px;
  margin-top: 9px;
}

.pvpb__gift {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border: 1px solid var(--pv-line);
  border-radius: 8px;
  background: var(--pv-white);
}

.pvpb__gift-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 30px;
  height: 34px;
  color: var(--pv-ink);
}

/* Same maxima trick as the offer tile: no percentage against an auto box. */
.pvpb__gift-visual img {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.pvpb__gift-visual svg {
  width: 22px;
  height: 22px;
}

/* ---- Locked state: no subscription, so the perks are shown padlocked
        rather than hidden — the visitor sees what they are giving up. ---- */

.pvpb__panel.is-locked {
  opacity: 0.75;
}

.pvpb__panel.is-locked .pvpb__freq {
  border-color: var(--pv-line);
}

.pvpb__gift-lock {
  display: none;
  align-items: center;
  justify-content: center;
  color: var(--pv-ink);
}

.pvpb__gift-lock svg {
  width: 20px;
  height: 20px;
}

.pvpb__panel.is-locked .pvpb__gift-lock {
  display: flex;
}

.pvpb__panel.is-locked .pvpb__gift-main {
  display: none;
}

/* ---- One-off purchase row ---- */

.pvpb__onetime {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: 14px;
  padding: 14px 15px;
  border: 2px solid var(--pv-ink);
  border-radius: 10px;
  font-size: 13.5px;
  font-weight: 600;
}

.pvpb__onetime[hidden] {
  display: none;
}

.pvpb__onetime-price {
  font-weight: 700;
  white-space: nowrap;
}

.pvpb__gift-body {
  min-width: 0;
}

.pvpb__gift-title {
  display: block;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.3;
}

/* The badge may wrap between its words, but never inside the struck price. */
.pvpb__gift-badge {
  display: inline-block;
  max-width: 100%;
  margin-top: 3px;
  padding: 2px 6px;
  border-radius: 4px;
  background: var(--pv-accent-soft);
  color: var(--pv-accent-ink);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

.pvpb__gift-was {
  color: var(--pv-muted);
  font-weight: 600;
  white-space: nowrap;
}

/* ---- Subscription switch ---- */

.pvpb__toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
}

.pvpb__toggle-label {
  font-size: 13px;
  font-weight: 600;
}

.pvpb__info {
  display: inline-flex;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  background: none;
  color: var(--pv-muted);
}

.pvpb__info svg {
  width: 14px;
  height: 14px;
}

.pvpb__switch {
  flex: 0 0 auto;
  position: relative;
  width: 44px;
  height: 24px;
  margin-left: auto;
  padding: 0;
  border: 0;
  border-radius: 20px;
  background: #c9d2d6;
  transition: background-color 0.18s ease;
}

.pvpb__switch::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--pv-white);
  transition: transform 0.18s ease;
}

.pvpb__switch[aria-checked="true"] {
  background: var(--pv-dark);
}

.pvpb__switch[aria-checked="true"]::after {
  transform: translateX(20px);
}

/* ---- Editor-only parse report ---- */

.pvpb__debug {
  margin-top: 12px;
  padding: 10px;
  border-radius: 8px;
  background: #ffb020;
  color: #3a2600;
  font-size: 11px;
  line-height: 1.5;
}

.pvpb__debug b {
  display: block;
  margin-bottom: 4px;
}

/* ---- Add to cart ---- */

.pvp__atc {
  margin-top: 18px;
}

.pvp__buy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  width: 100%;
  min-height: 62px;
  padding: 12px 20px;
  border: 0;
  border-radius: var(--pv-radius);
  background: var(--pv-dark);
  color: var(--pv-white);
  text-align: left;
  transition: transform 0.16s ease, background-color 0.16s ease;
}

.pvp__buy:hover {
  transform: translateY(-1px);
}

.pvp__buy-main {
  min-width: 0;
}

.pvp__buy-label {
  display: block;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
}

.pvp__buy-sub {
  display: block;
  margin-top: 3px;
  font-size: 11.5px;
  line-height: 1.3;
  color: rgba(255, 255, 255, 0.7);
}

.pvp__buy-was[hidden] {
  display: none;
}

.pvp__buy-price {
  flex: 0 0 auto;
  display: flex;
  align-items: baseline;
  gap: 7px;
  font-size: 16px;
  font-weight: 700;
  white-space: nowrap;
}

.pvp__buy-was {
  font-size: 12px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
}

.pvp__buy[aria-disabled="true"] {
  opacity: 0.6;
  pointer-events: none;
}

.pvp__buy.is-loading {
  pointer-events: none;
  position: relative;
  color: transparent;
}

.pvp__buy.is-loading > * {
  visibility: hidden;
}

.pvp__buy.is-loading::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20px;
  height: 20px;
  margin: -10px 0 0 -10px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: pvp-spin 0.7s linear infinite;
}

@keyframes pvp-spin {
  to {
    transform: rotate(360deg);
  }
}

.pvp__error {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #fdecec;
  color: #a12020;
  font-size: 12.5px;
  line-height: 1.45;
}

.pvp__error[hidden] {
  display: none;
}

.pvp__note {
  margin-top: 12px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--pv-muted);
  text-align: center;
}

.pvp__note strong {
  color: var(--pv-ink);
}

/* ---- Reassurance columns ---- */

.pvp__reassure {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 12px;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid var(--pv-line);
}

.pvp__reassure li {
  text-align: center;
}

.pvp__reassure-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 700;
}

.pvp__reassure-title svg {
  flex: 0 0 auto;
  width: 14px;
  height: 14px;
  color: var(--pv-green);
}

.pvp__reassure-text {
  margin-top: 3px;
  font-size: 11px;
  line-height: 1.4;
  color: var(--pv-muted);
}

/* ---- Accordions ---- */

.pvp__accordions {
  margin-top: 22px;
  border-top: 1px solid var(--pv-line);
}

.pvp__acc {
  border-bottom: 1px solid var(--pv-line);
}

.pvp__acc-trigger {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 15px 2px;
  border: 0;
  background: none;
  text-align: left;
  font-size: 13.5px;
  font-weight: 600;
}

.pvp__acc-trigger svg {
  flex: 0 0 auto;
  width: 14px;
  height: 14px;
  margin-left: auto;
  color: var(--pv-muted);
  transition: transform 0.24s ease;
}

.pvp__acc-trigger[aria-expanded="true"] svg {
  transform: rotate(180deg);
}

.pvp__collapse {
  overflow: hidden;
  height: 0;
  transition: height 0.28s ease;
}

.pvp__collapse[hidden] {
  display: none;
}

.pvp__collapse-inner {
  padding: 0 2px 18px;
  font-size: 13px;
  line-height: 1.65;
  color: var(--pv-muted);
}

/* ---- Box contents grid ---- */

.pvp__included {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 10px;
}

.pvp__included li {
  padding: 12px;
  border: 1px solid var(--pv-line);
  border-radius: 12px;
  background: var(--pv-white);
  text-align: center;
}

.pvp__included img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: contain;
  background: var(--pv-soft);
  border-radius: 8px;
}

.pvp__included-label {
  display: block;
  margin-top: 9px;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--pv-ink);
}

.pvp__included-flag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 5px;
  font-size: 10.5px;
  color: var(--pv-muted);
}

.pvp__included-flag svg {
  width: 10px;
  height: 10px;
  color: var(--pv-green);
}

/* ---- Rating row + FAQ link ---- */

.pvp__rating {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 2px;
  border-bottom: 1px solid var(--pv-line);
  font-size: 13px;
}

.pvp__rating-link {
  margin-left: auto;
  display: grid;
  place-items: center;
  width: 26px;
  height: 26px;
  border: 1px solid var(--pv-line);
  border-radius: 7px;
  color: var(--pv-ink);
}

.pvp__rating-link svg {
  width: 12px;
  height: 12px;
}

.pvp__faqlink {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.pvp__faqlink svg {
  width: 12px;
  height: 12px;
}

/* ---- Stars ---- */

.pvp__stars {
  position: relative;
  display: inline-flex;
  flex: 0 0 auto;
  line-height: 0;
}

.pvp__stars-row {
  display: flex;
  gap: 2px;
}

.pvp__stars-row svg {
  flex: 0 0 auto;
  width: var(--pv-star, 14px);
  height: var(--pv-star, 14px);
}

.pvp__stars-row--empty {
  color: var(--pv-star-empty);
}

/* Stars have their own colour: they read as a rating, not as branding. */
.pvp__stars-row--full {
  position: absolute;
  inset: 0;
  width: var(--pv-star-pct, 100%);
  overflow: hidden;
  color: var(--pv-star-color);
}

/* --------------------------------------------------------------------------
   Video row
   -------------------------------------------------------------------------- */

.pvp__videos {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 18px;
  margin-top: 26px;
}

.pvp__video {
  width: 96px;
  padding: 0;
  border: 0;
  background: none;
  text-align: center;
}

.pvp__video-circle {
  position: relative;
  display: block;
  width: 76px;
  height: 76px;
  margin-inline: auto;
  border-radius: 50%;
  overflow: hidden;
  background: var(--pv-soft);
  box-shadow: 0 4px 14px rgba(15, 27, 42, 0.12);
  transition: transform 0.16s ease;
}

.pvp__video:hover .pvp__video-circle {
  transform: translateY(-2px);
}

.pvp__video-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pvp__video-play {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  color: #fff;
  background: rgba(15, 27, 42, 0.22);
}

.pvp__video-play svg {
  width: 20px;
  height: 20px;
}

.pvp__video-label {
  display: block;
  margin-top: 9px;
  font-size: 11.5px;
  font-weight: 600;
  line-height: 1.3;
}

/* --------------------------------------------------------------------------
   Video dialog
   -------------------------------------------------------------------------- */

.pvp__modal {
  position: fixed;
  inset: 0;
  z-index: 95;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.22s ease;
}

.pvp__modal[hidden] {
  display: none;
}

.pvp__modal.is-open {
  opacity: 1;
}

.pvp__modal-backdrop {
  position: absolute;
  inset: 0;
  padding: 0;
  border: 0;
  background: rgba(13, 27, 30, 0.55);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  cursor: default;
}

.pvp__modal-dialog {
  position: relative;
  width: 100%;
  max-width: 360px;
  border-radius: var(--pv-radius-lg);
  overflow: hidden;
  background: #000;
  box-shadow: 0 24px 60px rgba(15, 27, 42, 0.3);
  transform: translateY(10px) scale(0.97);
  transition: transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.pvp__modal.is-open .pvp__modal-dialog {
  transform: none;
}

.pvp__modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: var(--pv-ink);
}

.pvp__modal-close svg {
  width: 13px;
  height: 13px;
}

.pvp__modal-video {
  width: 100%;
  aspect-ratio: 9 / 16;
  max-height: calc(100vh - 60px);
  object-fit: cover;
  background: #000;
}

/* Text variant of the same dialog, for the bundle's two explanations. */
.pvp__modal-dialog--text {
  max-width: 420px;
  background: var(--pv-white);
}

.pvpb__dialog-body {
  padding: 26px 22px 22px;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--pv-ink);
}

.pvpb__dialog-body p {
  margin: 0;
}

.pvpb__dialog-body p + p {
  margin-top: 10px;
}

.pvp__modal-video[hidden] {
  display: none;
}

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */

@media screen and (max-width: 899px) {
  .pvp__grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
    gap: var(--pv-stack-gap);
  }

  /* One column: let source order do the work again. */
  .pvp__gallery,
  .pvp__info,
  .pvp__videos-cell {
    grid-column: auto;
    grid-row: auto;
  }

  /* Full-bleed only makes sense stacked. "gutter" cancels this section's own
     padding; "viewport" breaks out of every centred ancestor, so it also
     escapes whatever padding the surrounding theme adds. */
  .pvp__gallery--bleed-gutter .pvp__stage {
    margin-inline: calc(var(--pv-gutter) * -1);
    border-radius: 0;
  }

  .pvp__gallery--bleed-viewport .pvp__stage {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    border-radius: 0;
  }

  /* The thumbnails follow the image out, but keep scrolling inside the page. */
  .pvp__gallery--bleed-gutter .pvp__thumbs,
  .pvp__gallery--bleed-viewport .pvp__thumbs {
    padding-inline: 2px;
  }

  .pvp__videos {
    justify-content: center;
  }
}

@media screen and (max-width: 767px) {
  .pvp {
    --pv-gutter: 18px;
    --pv-seal: 68px;
    --pv-offer-img: calc(var(--pv-offer-img-set, 54px) * 0.85);
    --pv-thumb: calc(var(--pv-thumb-set, 64px) * 0.9);
  }

  .pvp__buy {
    flex-wrap: wrap;
    gap: 8px;
  }

  .pvp__video {
    width: 80px;
  }

  .pvp__video-circle {
    width: 66px;
    height: 66px;
  }

  .pvp__videos {
    gap: 12px;
  }

  .pvpb__card {
    padding: 13px;
  }

  .pvpb__choices {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
  }

  .pvpb__choice {
    padding: 11px 4px;
    font-size: 12px;
  }

  .pvpb__freqs {
    grid-template-columns: minmax(0, 1fr);
  }

  .pvpb__gifts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pvpb__summary-prices {
    justify-content: flex-start;
  }

  .pvpb__then {
    text-align: left;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pvp *,
  .pvp *::before,
  .pvp *::after {
    transition-duration: 0.001ms !important;
    animation-duration: 0.001ms !important;
  }
}
{% endstyle %}

{%- liquid
  assign s = section.settings
  assign variant = product.selected_or_first_available_variant

  assign bullets = section.blocks | where: 'type', 'bullet'
  assign badges = section.blocks | where: 'type', 'badge'
  assign included = section.blocks | where: 'type', 'included'
  assign reassurances = section.blocks | where: 'type', 'reassurance'
  assign faqs = section.blocks | where: 'type', 'faq'
  assign reviews = section.blocks | where: 'type', 'review'
  assign videos = section.blocks | where: 'type', 'video'

  comment
    The note comes from a select, so it arrives as a string: coerce it before
    doing any arithmetic or comparison with it.
  endcomment
  assign rating_num = s.rating_value | plus: 0.0
  assign rating_pct = rating_num | divided_by: 5.0 | times: 100

  comment
    The gift. gift_id stays 0 unless there is a real, available variant to add,
    so an out-of-stock or unset gift can never make the add-to-cart call fail.
  endcomment
  assign gift_variant = s.offer_product.selected_or_first_available_variant
  assign gift_id = 0
  if s.offer_add_to_cart and gift_variant != blank and gift_variant.available
    assign gift_id = gift_variant.id
  endif

  assign offer_img = s.offer_image
  if offer_img == blank
    assign offer_img = s.offer_product.featured_image
  endif
  assign offer_img_h = 150
  if offer_img.aspect_ratio > 0
    assign offer_img_h = 150 | divided_by: offer_img.aspect_ratio | round
  endif

  comment
    The bundle configurator. Its price grid lives in two textareas, one line
    per household, so a merchant edits a table instead of 40 numbered fields.
    The default combination is resolved here because the add-to-cart button
    below has to render its price server-side — waiting for the script would
    show the bare product price for a frame.
  endcomment
  assign bundle_block = section.blocks | where: 'type', 'bundle' | first
  assign bundle_gifts = section.blocks | where: 'type', 'bundle_gift'
  assign has_bundle = false

  if bundle_block != blank
    assign has_bundle = true
    assign bb = bundle_block.settings
    assign rows_a = bb.prices_a | strip | newline_to_br | split: '<br />'
    assign rows_b = bb.prices_b | strip | newline_to_br | split: '<br />'

    assign def_h = bb.default_household | plus: 0 | minus: 1
    assign def_rows = rows_a
    if bb.default_freq == 'b'
      assign def_rows = rows_b
    endif
    assign def_parts = def_rows[def_h] | split: '|'
    assign def_first = def_parts[0] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
    assign def_was = def_parts[1] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
  endif

  comment
    Add-to-cart figures: the bundle wins over the product's own variant when
    one is configured.
  endcomment
  assign atc_now = variant.price
  assign atc_was = variant.compare_at_price
  assign atc_sub = s.buy_sub
  if has_bundle and def_first > 0
    assign atc_now = def_first
    assign atc_was = def_was
    if bb.atc_sublabel != blank
      assign atc_sub = bb.atc_sublabel
    endif
  endif

  comment
    root_url is "/" on a single-locale shop and "/fr" on a localised one, so
    append then collapse the double slash rather than hardcoding "/checkout".
  endcomment
  assign checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'
-%}

{%- capture pv_star -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.5l2.6 5.3 5.8.85-4.2 4.1.99 5.8L10 14.8l-5.19 2.75.99-5.8-4.2-4.1 5.8-.85z"/></svg>{%- endcapture -%}
{%- capture pv_stars_row -%}{{ pv_star }}{{ pv_star }}{{ pv_star }}{{ pv_star }}{{ pv_star }}{%- endcapture -%}
{%- capture pv_check -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>{%- endcapture -%}
{%- capture pv_chevron -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6l4 4 4-4"/></svg>{%- endcapture -%}
{%- capture pv_arrow -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.8 8h10.4M9 3.8L13.2 8 9 12.2"/></svg>{%- endcapture -%}
{%- capture pv_close -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3.6 3.6l8.8 8.8M12.4 3.6l-8.8 8.8"/></svg>{%- endcapture -%}
{%- capture pv_chev_left -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3.5L5.5 8l4.5 4.5"/></svg>{%- endcapture -%}
{%- capture pv_chev_right -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3.5L10.5 8 6 12.5"/></svg>{%- endcapture -%}
{%- capture pv_info -%}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.4"/><path d="M8 7.2v4M8 4.9v.1" stroke-linecap="round"/></svg>{%- endcapture -%}
{%- capture pv_i_box -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>{%- endcapture -%}
{%- capture pv_i_percent -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.2"/><path d="M15.5 8.5l-7 7"/><circle cx="9.4" cy="9.4" r="1.4"/><circle cx="14.6" cy="14.6" r="1.4"/></svg>{%- endcapture -%}
{%- capture pv_i_check -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 12.5l5 5L20.5 5.5"/></svg>{%- endcapture -%}
{%- capture pv_i_gift -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 11h17v9.5h-17z"/><path d="M2.5 7h19v4h-19zM12 7v13.5"/><path d="M12 7S10.5 3 8.2 3a2.2 2.2 0 000 4M12 7s1.5-4 3.8-4a2.2 2.2 0 010 4"/></svg>{%- endcapture -%}
{%- capture pv_i_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v10h-11zM13.5 10h4l3 3v3.5h-7z"/><circle cx="6.5" cy="18.5" r="1.8"/><circle cx="17" cy="18.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture pv_i_leaf -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20c0-9 6-14 16-14 0 10-5 15-13 15"/><path d="M4 20c2-5 5-8 9-10"/></svg>{%- endcapture -%}
{%- capture pv_i_lock -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 1.8A4.7 4.7 0 007.3 6.5V9H6.4A2.4 2.4 0 004 11.4v7.2a2.4 2.4 0 002.4 2.4h11.2a2.4 2.4 0 002.4-2.4v-7.2A2.4 2.4 0 0017.6 9h-.9V6.5A4.7 4.7 0 0012 1.8zm0 2.1a2.6 2.6 0 012.6 2.6V9H9.4V6.5A2.6 2.6 0 0112 3.9z"/></svg>{%- endcapture -%}
{%- capture pv_i_clock -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.2"/><path d="M12 6.6V12l3.6 2.2"/></svg>{%- endcapture -%}

{%- capture pv_play -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.4 3.7a1 1 0 011.5-.87l8.2 5.3a1 1 0 010 1.74l-8.2 5.3A1 1 0 016.4 14.3z"/></svg>{%- endcapture -%}

<div
  class="pvp"
  id="pvp-{{ section.id }}"
  data-pvp-root
  style="
    --pv-dark: {{ s.color_dark }};
    --pv-ink: {{ s.color_ink }};
    --pv-muted: {{ s.color_muted }};
    --pv-teal: {{ s.color_accent }};
    --pv-star-color: {{ s.color_stars }};
    --pv-star-empty: {{ s.color_stars_empty }};
    --pv-green: {{ s.color_check }};
    --pv-line: {{ s.color_line }};
    --pv-soft: {{ s.color_soft }};
    --pv-mint: {{ s.color_gallery_bg }};
    --pv-max: {{ s.container_width }}px;
    --pv-seal: {{ s.seal_size }}px;
    --pv-offer-img-set: {{ s.offer_image_size }}px;
    --pv-offer-img-bg-set: {{ s.offer_image_bg }};
    --pv-thumb-set: {{ s.thumb_size }}px;
    --pv-stack-gap-set: {{ s.stack_gap }}px;
    --pv-stage-ratio-set: {{ s.gallery_ratio }};
    --pv-stage-fit-set: {{ s.gallery_fit }};
    --pv-accent-soft: rgba({{ s.color_accent.red }}, {{ s.color_accent.green }}, {{ s.color_accent.blue }}, 0.15);
    --pv-accent-ink: {{ s.color_accent_ink }};
    background: {{ s.color_bg }};
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  "
>
  <script type="application/json" data-pvp-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "checkoutUrl": {{ checkout_url | json }},
      "afterAdd": {{ s.after_add_action | json }},
      "variantId": {{ variant.id | json }},
      "gift": {% if gift_id > 0 %}{ "id": {{ gift_id | json }}, "propName": {{ s.offer_property_label | json }}, "propValue": {{ s.offer_property_value | json }} }{% else %}null{% endif %},
      "strings": {
        "error": {{ s.error_label | json }},
        "soldOut": {{ s.sold_out_label | json }}
      }
    }
  </script>

  <div class="pvp__container">
    <div class="pvp__grid">
      {%- comment -%} ================= Gallery ================= {%- endcomment -%}
      {%- liquid
        assign gallery_classes = 'pvp__gallery'
        unless s.gallery_bleed == 'none'
          assign gallery_classes = gallery_classes | append: ' pvp__gallery--bleed-' | append: s.gallery_bleed
        endunless
      -%}
      <div class="{{ gallery_classes }}">
        <div class="pvp__stage">
          <div class="pvp__track" data-pvp-track>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media limit: 8 -%}
              {%- liquid
                assign img = media.preview_image
                assign img_h = 1000
                if img.aspect_ratio > 0
                  assign img_h = 1000 | divided_by: img.aspect_ratio | round
                endif
                assign img_loading = 'lazy'
                if forloop.first
                  assign img_loading = 'eager'
                endif
              -%}
              <div
                class="pvp__slide"
                data-pvp-slide="{{ forloop.index0 }}"
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              >
                {{
                  img
                  | image_url: width: 1000
                  | image_tag:
                    width: 1000,
                    height: img_h,
                    widths: '400,600,800,1000',
                    sizes: '(min-width: 900px) 50vw, 100vw',
                    loading: img_loading,
                    alt: img.alt
                }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="pvp__slide">
              <div class="pvp__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
            </div>
          {%- endif -%}
          </div>

          {%- if s.seal_value != blank -%}
            <div class="pvp__seal">
              {%- if s.seal_top != blank -%}<span class="pvp__seal-top">{{ s.seal_top }}</span>{%- endif -%}
              <span class="pvp__seal-value">{{ s.seal_value }}</span>
              {%- if s.seal_bottom != blank -%}<span class="pvp__seal-bottom">{{ s.seal_bottom }}</span>{%- endif -%}
            </div>
          {%- endif -%}

          {%- if s.callout_text != blank -%}
            <span class="pvp__callout">{{ s.callout_text }}</span>
          {%- endif -%}

          {%- if s.stage_trust_text != blank -%}
            <div class="pvp__stage-trust">
              {%- if s.stage_trust_word != blank -%}<span>{{ s.stage_trust_word }}</span>{%- endif -%}
              {%- if rating_num > 0 -%}
                <span class="pvp__stars" style="--pv-star-pct: {{ rating_pct }}%;" role="img" aria-label="{{ s.rating_aria_label }}">
                  <span class="pvp__stars-row pvp__stars-row--empty" aria-hidden="true">{{ pv_stars_row }}</span>
                  <span class="pvp__stars-row pvp__stars-row--full" aria-hidden="true">{{ pv_stars_row }}</span>
                </span>
              {%- endif -%}
              <span class="pvp__muted">{{ s.stage_trust_text }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="pvp__thumbs" role="tablist" aria-label="{{ s.thumbs_aria_label }}">
            {%- for media in product.media limit: 8 -%}
              <button
                type="button"
                class="pvp__thumb"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-pvp-thumb="{{ forloop.index0 }}"
                aria-label="{{ s.thumbs_item_label }} {{ forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 200
                  | image_tag: width: 100, height: 100, loading: 'lazy', alt: ''
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ================= Info ================= {%- endcomment -%}
      <div class="pvp__info">
        {%- comment -%}
          Review row: stars plus a link that opens the ratings card. It only
          renders when there is something to say.
        {%- endcomment -%}
        {%- if reviews.size > 0 or s.reviews_count != blank -%}
          {%- capture reviews_summary -%}
            {{- s.reviews_summary | replace: '[score]', s.reviews_score | replace: '[count]', s.reviews_count -}}
          {%- endcapture -%}
          <div class="pvp__reviews">
            {%- if rating_num > 0 -%}
              <span class="pvp__stars" style="--pv-star-pct: {{ rating_pct }}%; --pv-star: 15px;" role="img" aria-label="{{ s.rating_aria_label }}">
                <span class="pvp__stars-row pvp__stars-row--empty" aria-hidden="true">{{ pv_stars_row }}</span>
                <span class="pvp__stars-row pvp__stars-row--full" aria-hidden="true">{{ pv_stars_row }}</span>
              </span>
            {%- endif -%}

            <button
              type="button"
              class="pvp__reviews-toggle"
              aria-expanded="false"
              aria-controls="pvp-revpop-{{ section.id }}"
              data-pvp-reviews-toggle
            >
              <span>{{ reviews_summary | strip }}</span>
              {{ pv_chevron }}
            </button>

            {%- if s.reviews_note != blank -%}
              <span class="pvp__reviews-note">{{ s.reviews_note }}</span>
            {%- endif -%}

            <div class="pvp__revpop" id="pvp-revpop-{{ section.id }}" data-pvp-revpop hidden>
              <button type="button" class="pvp__revpop-close" data-pvp-reviews-close aria-label="{{ s.close_label }}">
                {{ pv_close }}
              </button>

              <div class="pvp__revpop-head">
                {%- if s.reviews_score != blank -%}
                  <span class="pvp__revpop-score">{{ s.reviews_score }}</span>
                {%- endif -%}
                <span class="pvp__revpop-meta">
                  {%- if rating_num > 0 -%}
                    <span class="pvp__stars" style="--pv-star-pct: {{ rating_pct }}%; --pv-star: 15px;" role="img" aria-label="{{ s.rating_aria_label }}">
                      <span class="pvp__stars-row pvp__stars-row--empty" aria-hidden="true">{{ pv_stars_row }}</span>
                      <span class="pvp__stars-row pvp__stars-row--full" aria-hidden="true">{{ pv_stars_row }}</span>
                    </span>
                  {%- endif -%}
                  <span class="pvp__revpop-based">
                    {{- s.reviews_based_on | replace: '[count]', s.reviews_count -}}
                  </span>
                </span>
              </div>

              {%- if reviews.size > 0 -%}
                <div class="pvp__revpop-sep" aria-hidden="true"></div>

                {%- for block in reviews -%}
                  <div class="pvp__review" data-pvp-review="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
                    <div class="pvp__review-head">
                      <span class="pvp__review-name">{{ block.settings.name }}</span>
                      {%- if block.settings.verified -%}
                        <span class="pvp__review-verified">{{ pv_check }} {{ s.reviews_verified_label }}</span>
                      {%- endif -%}
                    </div>
                    <p class="pvp__review-text">{{ block.settings.text }}</p>
                  </div>
                {%- endfor -%}

                {%- if reviews.size > 1 -%}
                  <div class="pvp__revpop-nav">
                    <button type="button" class="pvp__revpop-arrow" data-pvp-review-prev aria-label="{{ s.reviews_prev_label }}">
                      {{ pv_chev_left }}
                    </button>
                    <div class="pvp__revpop-dots">
                      {%- for block in reviews -%}
                        <button
                          type="button"
                          class="pvp__revpop-dot"
                          data-pvp-review-dot="{{ forloop.index0 }}"
                          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                          aria-label="{{ s.reviews_go_label }} {{ forloop.index }}"
                        ></button>
                      {%- endfor -%}
                    </div>
                    <button type="button" class="pvp__revpop-arrow" data-pvp-review-next aria-label="{{ s.reviews_next_label }}">
                      {{ pv_chev_right }}
                    </button>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="pvp__head">
          <div>
            <h1 class="pvp__title">{{ product.title | escape }}</h1>
            {%- if s.subtitle != blank -%}
              <p class="pvp__subtitle">{{ s.subtitle }}</p>
            {%- endif -%}
          </div>
          {%- if s.per_day != blank -%}
            <span class="pvp__perday">{{ s.per_day }}</span>
          {%- endif -%}
        </div>

        {%- if bullets.size > 0 -%}
          <ul class="pvp__bullets">
            {%- for block in bullets -%}
              <li {{ block.shopify_attributes }}>
                <span class="pvp__bullet-icon" aria-hidden="true">{{ pv_check }}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if badges.size > 0 -%}
          <div class="pvp__badges">
            {%- for block in badges -%}
              <span class="pvp__badge{% if block.settings.dark %} pvp__badge--dark{% endif %}" {{ block.shopify_attributes }}>
                {{- block.settings.text -}}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.offer_title != blank or s.offer_product != blank -%}
          <div class="pvp__offer">
            <span class="pvp__offer-icon" aria-hidden="true">
              {%- if offer_img != blank -%}
                {{
                  offer_img
                  | image_url: width: 300
                  | image_tag: width: 150, height: offer_img_h, loading: 'lazy', alt: ''
                }}
              {%- else -%}
                {{ pv_check }}
              {%- endif -%}
            </span>
            <div>
              {%- if s.offer_tag != blank -%}
                <span class="pvp__offer-tag">{{ s.offer_tag }}</span>
              {%- endif -%}
              {%- if s.offer_title != blank -%}
                <p class="pvp__offer-title">{{ s.offer_title }}</p>
              {%- endif -%}
              {%- if s.offer_text != blank -%}
                <div class="pvp__offer-text">{{ s.offer_text }}</div>
              {%- endif -%}

              {%- if s.offer_product != blank and s.offer_show_name -%}
                <p class="pvp__offer-product" data-pvp-gift-line>
                  <span>{{ s.offer_product.title }}</span>
                  {%- if gift_variant.compare_at_price > 0 -%}
                    <s class="pvp__offer-was">{{ gift_variant.compare_at_price | money }}</s>
                  {%- elsif gift_variant.price > 0 -%}
                    <s class="pvp__offer-was">{{ gift_variant.price | money }}</s>
                  {%- endif -%}
                  {%- if s.offer_free_label != blank -%}
                    <span class="pvp__offer-free">{{ s.offer_free_label }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- comment -%}
                Diagnostics for the merchant, in the theme editor only. Nothing
                below ever reaches a customer.
              {%- endcomment -%}
              {%- if request.design_mode and s.offer_product != blank and s.offer_add_to_cart -%}
                {%- if gift_variant == blank or gift_variant.available == false -%}
                  <p class="pvp__offer-warn">
                    Éditeur : « {{ s.offer_product.title }} » est épuisé, il ne sera pas ajouté au panier.
                  </p>
                {%- elsif gift_variant.price > 0 -%}
                  <p class="pvp__offer-warn">
                    Éditeur : « {{ s.offer_product.title }} » coûte {{ gift_variant.price | money }}.
                    Mets sa variante à 0 pour qu'il soit réellement offert.
                  </p>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ---------- Bundle configurator ---------- {%- endcomment -%}
        {%- if has_bundle -%}
          {%- liquid
            assign def_fi = 0
            if bb.default_freq == 'b'
              assign def_fi = 1
            endif
            assign months_a = bb.freq_a_months | at_least: 1

            assign onetime_cents = bb.onetime_price | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
            assign onetime_txt = ''
            if onetime_cents > 0
              assign onetime_txt = onetime_cents | money
            endif
            assign onetime_variant = bb.onetime_variant | strip | plus: 0
          -%}

          {%- comment -%}
            Every combination is emitted as its own tiny JSON island: each
            value goes through the json filter, so no string is ever pasted
            into hand-written JSON. The default combination's display strings
            are captured on the way past and used for the first paint.
          {%- endcomment -%}
          {%- capture bundle_data -%}
            {%- for fi in (0..1) -%}
              {%- liquid
                assign rows = rows_a
                assign months = months_a
                if fi == 1
                  assign rows = rows_b
                  assign months = bb.freq_b_months | at_least: 1
                endif
                assign days = months | times: 30 | at_least: 1
              -%}
              {%- for hi in (0..2) -%}
                {%- liquid
                  assign parts = rows[hi] | split: '|'

                  assign c_first = parts[0] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                  assign c_was = parts[1] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                  assign c_rec = parts[2] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                  assign c_off_n = parts[3] | strip | replace: '-', '' | replace: '%', '' | plus: 0
                  assign c_cardoff_n = parts[4] | strip | replace: '-', '' | replace: '%', '' | plus: 0
                  assign c_variant = parts[5] | strip | plus: 0
                  assign c_plan = parts[6] | strip | plus: 0

                  comment
                    The other frequency's price for the same household, scaled
                    to this period: that is what the card strikes through.
                  endcomment
                  assign parts_a = rows_a[hi] | split: '|'
                  assign rec_a = parts_a[2] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                  assign c_cardwas = rec_a | times: months | divided_by: months_a | round

                  assign c_first_txt = ''
                  if c_first > 0
                    assign c_first_txt = c_first | money
                  endif
                  assign c_was_txt = ''
                  if c_was > c_first
                    assign c_was_txt = c_was | money
                  endif
                  assign c_rec_txt = ''
                  if c_rec > 0
                    assign c_rec_txt = c_rec | money
                  endif
                  assign c_cardwas_txt = ''
                  if fi > 0 and c_cardwas > c_rec
                    assign c_cardwas_txt = c_cardwas | money
                  endif
                  assign c_perday_txt = ''
                  if c_rec > 0
                    comment
                      floor, not round: 69,90 over 180 days reads 0,38, never
                      0,39. Spelling it out also keeps the result identical
                      whichever Liquid engine renders this.
                    endcomment
                    assign c_perday = c_rec | divided_by: days | floor | money
                    assign c_perday_txt = bb.perday_template | replace: '[price]', c_perday
                  endif
                -%}
                {%- capture c_off_txt -%}{%- if c_off_n > 0 -%}-{{ c_off_n }}%{%- endif -%}{%- endcapture -%}
                {%- capture c_cardoff_txt -%}{%- if c_cardoff_n > 0 -%}-{{ c_cardoff_n }}%{%- endif -%}{%- endcapture -%}
                {%- capture c_then_txt -%}
                  {%- if c_rec > 0 -%}
                    {%- assign freq_word = bb.freq_a_label | downcase -%}
                    {%- if fi == 1 -%}{%- assign freq_word = bb.freq_b_label | downcase -%}{%- endif -%}
                    {%- assign then_price = c_rec_txt | prepend: '<b>' | append: '</b>' -%}
                    {{- bb.then_template | replace: '[price]', then_price | replace: '[freq]', freq_word -}}
                  {%- endif -%}
                {%- endcapture -%}

                {%- if hi == def_h -%}
                  {%- liquid
                    assign fslot = 'f0'
                    if fi == 1
                      assign fslot = 'f1'
                    endif
                    if fslot == 'f0'
                      assign f0_rec = c_rec_txt
                      assign f0_was = c_cardwas_txt
                      assign f0_off = c_cardoff_txt
                      assign f0_day = c_perday_txt
                    else
                      assign f1_rec = c_rec_txt
                      assign f1_was = c_cardwas_txt
                      assign f1_off = c_cardoff_txt
                      assign f1_day = c_perday_txt
                    endif
                    if fi == def_fi
                      assign d_first = c_first_txt
                      assign d_was = c_was_txt
                      assign d_off = c_off_txt
                      assign d_then = c_then_txt
                    endif
                  -%}
                {%- endif -%}

                <script type="application/json" data-pvpb-combo="{{ hi }}-{{ fi }}">
                  {
                    "first": {{ c_first_txt | json }},
                    "was": {{ c_was_txt | json }},
                    "off": {{ c_off_txt | strip | json }},
                    "then": {{ c_then_txt | strip | json }},
                    "rec": {{ c_rec_txt | json }},
                    "cardWas": {{ c_cardwas_txt | json }},
                    "cardOff": {{ c_cardoff_txt | strip | json }},
                    "perDay": {{ c_perday_txt | json }},
                    "variant": {{ c_variant | json }},
                    "plan": {{ c_plan | json }}
                  }
                </script>
              {%- endfor -%}
            {%- endfor -%}
          {%- endcapture -%}

          <div
            class="pvpb"
            data-pvpb
            data-pvpb-default-house="{{ def_h }}"
            data-pvpb-default-freq="{{ def_fi }}"
            data-pvpb-onetime-txt="{{ onetime_txt }}"
            data-pvpb-onetime-variant="{{ onetime_variant }}"
            {{ bundle_block.shopify_attributes }}
          >
            <div class="pvpb__summary">
              {%- if bb.title != blank -%}
                <span class="pvpb__summary-title">{{ bb.title }}</span>
              {%- endif -%}
              <div class="pvpb__summary-prices">
                <span class="pvpb__off" data-pvpb-off {% if d_off == blank %}hidden{% endif %}>{{ d_off }}</span>
                <s class="pvpb__was" data-pvpb-was {% if d_was == blank %}hidden{% endif %}>{{ d_was }}</s>
                <span class="pvpb__now" data-pvpb-now>{{ d_first }}</span>
                <span class="pvpb__then" data-pvpb-then {% if d_then == blank %}hidden{% endif %}>{{ d_then }}</span>
              </div>
            </div>

            <div class="pvpb__card">
              {%- comment -%} ---- Step 1: household ---- {%- endcomment -%}
              <div class="pvpb__step">
                <span class="pvpb__num" aria-hidden="true">1</span>
                <span class="pvpb__step-body">
                  <span class="pvpb__step-title" id="pvpb-step1-{{ section.id }}">{{ bb.step1_title }}</span>
                </span>
                {%- if bb.why_label != blank and bb.why_text != blank -%}
                  <button type="button" class="pvpb__why" data-pvpb-open="why" aria-haspopup="dialog">
                    <span>{{ bb.why_label }}</span>
                    {{ pv_info }}
                  </button>
                {%- endif -%}
              </div>

              <div class="pvpb__choices" role="radiogroup" aria-labelledby="pvpb-step1-{{ section.id }}">
                {%- for hi in (0..2) -%}
                  {%- liquid
                    case hi
                      when 0
                        assign h_label = bb.household_1
                      when 1
                        assign h_label = bb.household_2
                      else
                        assign h_label = bb.household_3
                    endcase
                  -%}
                  {%- if h_label != blank -%}
                    <button
                      type="button"
                      class="pvpb__choice"
                      role="radio"
                      aria-checked="{% if hi == def_h %}true{% else %}false{% endif %}"
                      tabindex="{% if hi == def_h %}0{% else %}-1{% endif %}"
                      data-pvpb-house="{{ hi }}"
                    >
                      {{- h_label -}}
                    </button>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- comment -%} ---- Step 2: product and frequency ---- {%- endcomment -%}
              <div class="pvpb__step">
                <span class="pvpb__num" aria-hidden="true">2</span>
                <span class="pvpb__step-body">
                  <span class="pvpb__step-title">{{ bb.step2_title }}</span>
                  {%- if bb.step2_subtitle != blank -%}
                    <span class="pvpb__step-sub">{{ bb.step2_subtitle }}</span>
                  {%- endif -%}
                </span>
              </div>

              <div class="pvpb__panel" data-pvpb-panel>
                <div class="pvpb__panel-head">
                  <span class="pvpb__panel-title" id="pvpb-freq-{{ section.id }}">{{ bb.freq_title }}</span>
                  {%- if bb.freq_note != blank -%}
                    <span class="pvpb__panel-note">{{ bb.freq_note }}</span>
                  {%- endif -%}
                </div>

                <div class="pvpb__freqs" role="radiogroup" aria-labelledby="pvpb-freq-{{ section.id }}">
                  {%- for fi in (0..1) -%}
                    {%- liquid
                      assign f_label = bb.freq_a_label
                      assign f_badge = ''
                      assign f_rec = f0_rec
                      assign f_was = f0_was
                      assign f_off = f0_off
                      assign f_day = f0_day
                      if fi == 1
                        assign f_label = bb.freq_b_label
                        assign f_badge = bb.freq_b_badge
                        assign f_rec = f1_rec
                        assign f_was = f1_was
                        assign f_off = f1_off
                        assign f_day = f1_day
                      endif
                    -%}
                    {%- if f_label != blank -%}
                      <button
                        type="button"
                        class="pvpb__freq"
                        role="radio"
                        aria-checked="{% if fi == def_fi %}true{% else %}false{% endif %}"
                        tabindex="{% if fi == def_fi %}0{% else %}-1{% endif %}"
                        data-pvpb-freq="{{ fi }}"
                      >
                        <span class="pvpb__freq-head">
                          <span class="pvpb__freq-label">{{ f_label }}</span>
                          {%- if f_badge != blank -%}
                            <span class="pvpb__freq-badge">{{ f_badge }}</span>
                          {%- endif -%}
                        </span>
                        <span class="pvpb__freq-prices">
                          <s class="pvpb__freq-was" data-pvpb-freq-was="{{ fi }}" {% if f_was == blank %}hidden{% endif %}>{{ f_was }}</s>
                          <span class="pvpb__freq-now" data-pvpb-freq-now="{{ fi }}">{{ f_rec }}</span>
                          <span class="pvpb__freq-off" data-pvpb-freq-off="{{ fi }}" {% if f_off == blank %}hidden{% endif %}>{{ f_off }}</span>
                        </span>
                        <span class="pvpb__freq-day" data-pvpb-freq-day="{{ fi }}">{{ f_day }}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if bundle_gifts.size > 0 -%}
                  {%- if bb.gifts_title != blank -%}
                    <p class="pvpb__gifts-title">{{ bb.gifts_title }}</p>
                  {%- endif -%}
                  <ul class="pvpb__gifts">
                    {%- for gift in bundle_gifts -%}
                      {%- liquid
                        assign g = gift.settings
                        case g.icon
                          when 'box'
                            assign g_icon = pv_i_box
                          when 'percent'
                            assign g_icon = pv_i_percent
                          when 'check'
                            assign g_icon = pv_i_check
                          when 'truck'
                            assign g_icon = pv_i_truck
                          when 'leaf'
                            assign g_icon = pv_i_leaf
                          when 'clock'
                            assign g_icon = pv_i_clock
                          else
                            assign g_icon = pv_i_gift
                        endcase
                        assign g_img_h = 68
                        if g.image.aspect_ratio > 0
                          assign g_img_h = 68 | divided_by: g.image.aspect_ratio | round
                        endif
                      -%}
                      <li class="pvpb__gift" {{ gift.shopify_attributes }}>
                        <span class="pvpb__gift-visual" aria-hidden="true">
                          <span class="pvpb__gift-main">
                            {%- if g.image != blank -%}
                              {{
                                g.image
                                | image_url: width: 140
                                | image_tag: width: 68, height: g_img_h, loading: 'lazy', alt: ''
                              }}
                            {%- else -%}
                              {{ g_icon }}
                            {%- endif -%}
                          </span>
                          <span class="pvpb__gift-lock">{{ pv_i_lock }}</span>
                        </span>
                        <span class="pvpb__gift-body">
                          <span class="pvpb__gift-title">{{ g.title }}</span>
                          <span class="pvpb__gift-badge" {% if g.badge == blank %}hidden{% endif %}>{{ g.badge }}</span>
                        </span>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>

              {%- comment -%} ---- Subscription switch ---- {%- endcomment -%}
              {%- if bb.show_toggle -%}
                <div class="pvpb__toggle">
                  <span class="pvpb__toggle-label" id="pvpb-sub-{{ section.id }}">{{ bb.toggle_label }}</span>
                  {%- if bb.toggle_text != blank -%}
                    <button type="button" class="pvpb__info" data-pvpb-open="sub" aria-haspopup="dialog" aria-label="{{ bb.toggle_label }}">
                      {{ pv_info }}
                    </button>
                  {%- endif -%}
                  <button
                    type="button"
                    class="pvpb__switch"
                    role="switch"
                    aria-checked="{{ bb.toggle_default }}"
                    aria-labelledby="pvpb-sub-{{ section.id }}"
                    data-pvpb-switch
                  ></button>
                </div>

                {%- comment -%}
                  Appears only once the subscription is switched off, and
                  becomes the selected offer.
                {%- endcomment -%}
                <div class="pvpb__onetime" data-pvpb-onetime hidden>
                  <span>{{ bb.onetime_label }}</span>
                  <span class="pvpb__onetime-price" data-pvpb-onetime-price></span>
                </div>
              {%- endif -%}

              {%- if request.design_mode -%}
                {%- liquid
                  assign bad_lines = 0
                  assign no_variant = 0
                  for fi in (0..1)
                    assign rws = rows_a
                    if fi == 1
                      assign rws = rows_b
                    endif
                    for hi in (0..2)
                      assign p = rws[hi] | split: '|'
                      assign v0 = p[0] | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.' | times: 100 | round
                      if v0 <= 0
                        assign bad_lines = bad_lines | plus: 1
                      endif
                      assign vid = p[5] | strip | plus: 0
                      if vid <= 0
                        assign no_variant = no_variant | plus: 1
                      endif
                    endfor
                  endfor
                -%}
                {%- if bad_lines > 0 or no_variant > 0 -%}
                  <div class="pvpb__debug">
                    <b>Éditeur — grille tarifaire</b>
                    {%- if bad_lines > 0 -%}
                      {{ bad_lines }} combinaison(s) sans prix lisible : vérifie que chaque ligne suit
                      « 1re commande | barré | récurrent | remise % | remise carte % | ID variante | ID selling plan ».
                    {%- endif -%}
                    {%- if no_variant > 0 -%}
                      {{ no_variant }} combinaison(s) sans ID de variante : le panier recevra le produit
                      principal, donc à un prix différent de celui affiché ici.
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if bb.why_text != blank -%}
              <template data-pvpb-dialog="why">{{ bb.why_text }}</template>
            {%- endif -%}
            {%- if bb.toggle_text != blank -%}
              <template data-pvpb-dialog="sub">{{ bb.toggle_text }}</template>
            {%- endif -%}

            {{ bundle_data }}
          </div>
        {%- endif -%}

        {%- comment -%} ---------- Add to cart ---------- {%- endcomment -%}
        <div class="pvp__atc">
          <button
            type="button"
            class="pvp__buy"
            data-pvp-add
            {% unless variant.available %}aria-disabled="true"{% endunless %}
          >
            <span class="pvp__buy-main">
              <span class="pvp__buy-label" data-pvp-label>
                {%- if variant.available -%}{{ s.buy_label }}{%- else -%}{{ s.sold_out_label }}{%- endif -%}
              </span>
              {%- if atc_sub != blank -%}
                <span class="pvp__buy-sub">{{ atc_sub }}</span>
              {%- endif -%}
            </span>
            <span class="pvp__buy-price">
              {%- comment -%}
                Always present, hidden when empty: the bundle swaps these two
                as the visitor changes their offer.
              {%- endcomment -%}
              <s class="pvp__buy-was" data-pvp-buy-was {% unless atc_was > atc_now %}hidden{% endunless %}>
                {{- atc_was | money -}}
              </s>
              <span data-pvp-buy-now>{{ atc_now | money }}</span>
            </span>
          </button>
          <p class="pvp__error" role="alert" data-pvp-error hidden></p>

          {%- if s.note_text != blank -%}
            <div class="pvp__note">{{ s.note_text }}</div>
          {%- endif -%}
        </div>

        {%- if reassurances.size > 0 -%}
          <ul class="pvp__reassure">
            {%- for block in reassurances -%}
              <li {{ block.shopify_attributes }}>
                <span class="pvp__reassure-title">
                  {{ pv_check }}
                  <span>{{ block.settings.title }}</span>
                </span>
                {%- if block.settings.text != blank -%}
                  <span class="pvp__reassure-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} ---------- Accordions ---------- {%- endcomment -%}
        {%- if included.size > 0 or faqs.size > 0 -%}
          <div class="pvp__accordions">
            {%- if included.size > 0 and s.included_title != blank -%}
              <div class="pvp__acc">
                <h2>
                  <button
                    type="button"
                    class="pvp__acc-trigger"
                    aria-expanded="{{ s.included_open }}"
                    aria-controls="pvp-included-{{ section.id }}"
                    data-pvp-acc
                  >
                    <span>{{ s.included_title }}</span>
                    {{ pv_chevron }}
                  </button>
                </h2>
                <div class="pvp__collapse" id="pvp-included-{{ section.id }}" data-pvp-collapse {% unless s.included_open %}hidden{% endunless %}>
                  <div class="pvp__collapse-inner">
                    <ul class="pvp__included">
                      {%- for block in included -%}
                        <li {{ block.shopify_attributes }}>
                          {%- if block.settings.image != blank -%}
                            {{
                              block.settings.image
                              | image_url: width: 200
                              | image_tag: width: 100, height: 100, loading: 'lazy', alt: ''
                            }}
                          {%- endif -%}
                          <span class="pvp__included-label">{{ block.settings.label }}</span>
                          {%- if block.settings.flag != blank -%}
                            <span class="pvp__included-flag">{{ pv_check }} {{ block.settings.flag }}</span>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- for block in faqs -%}
              <div class="pvp__acc" {{ block.shopify_attributes }}>
                <h2>
                  <button
                    type="button"
                    class="pvp__acc-trigger"
                    aria-expanded="false"
                    aria-controls="pvp-faq-{{ block.id }}"
                    data-pvp-acc
                  >
                    <span>{{ block.settings.question }}</span>
                    {{ pv_chevron }}
                  </button>
                </h2>
                <div class="pvp__collapse" id="pvp-faq-{{ block.id }}" data-pvp-collapse hidden>
                  <div class="pvp__collapse-inner">{{ block.settings.answer }}</div>
                </div>
              </div>
            {%- endfor -%}

            {%- if rating_num > 0 -%}
              <div class="pvp__rating">
                <span class="pvp__stars" style="--pv-star-pct: {{ rating_pct }}%;" role="img" aria-label="{{ s.rating_aria_label }}">
                  <span class="pvp__stars-row pvp__stars-row--empty" aria-hidden="true">{{ pv_stars_row }}</span>
                  <span class="pvp__stars-row pvp__stars-row--full" aria-hidden="true">{{ pv_stars_row }}</span>
                </span>
                <span>{{ s.rating_text }}</span>
                {%- if s.rating_url != blank -%}
                  <a class="pvp__rating-link" href="{{ s.rating_url }}" aria-label="{{ s.rating_link_label }}">{{ pv_arrow }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.faq_link_label != blank and s.faq_link_url != blank -%}
          <a class="pvp__faqlink" href="{{ s.faq_link_url }}">
            <span>{{ s.faq_link_label }}</span>
            {{ pv_arrow }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} ================= Videos ================= {%- endcomment -%}
      {%- if videos.size > 0 -%}
        <div class="pvp__videos-cell">
        <ul class="pvp__videos">
        {%- for block in videos -%}
          {%- liquid
            assign b = block.settings
            assign poster = b.poster
            if poster == blank
              assign poster = b.video.preview_image
            endif
            assign has_video = false
            if b.video != blank or b.video_url != blank
              assign has_video = true
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <button
              type="button"
              class="pvp__video"
              {% if has_video %}data-pvp-video="{{ block.id }}" aria-haspopup="dialog"{% endif %}
            >
              <span class="pvp__video-circle">
                {%- if poster != blank -%}
                  {{ poster | image_url: width: 200 | image_tag: width: 100, height: 100, loading: 'lazy', alt: '' }}
                {%- endif -%}
                {%- if has_video -%}
                  <span class="pvp__video-play" aria-hidden="true">{{ pv_play }}</span>
                {%- endif -%}
              </span>
              <span class="pvp__video-label">{{ b.label }}</span>
            </button>

            {%- if has_video -%}
              <template data-pvp-video-src="{{ block.id }}">
                {%- if b.video != blank -%}
                  {%- for source in b.video.sources -%}
                    {%- if source.format == 'mp4' -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                {%- elsif b.video_url != blank -%}
                  <source src="{{ b.video_url }}" type="video/mp4">
                {%- endif -%}
              </template>
            {%- endif -%}
          </li>
        {%- endfor -%}
        </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- Video dialog ---------- {%- endcomment -%}
  {%- if videos.size > 0 -%}
    <div class="pvp__modal" data-pvp-modal hidden>
      <button type="button" class="pvp__modal-backdrop" data-pvp-modal-close tabindex="-1" aria-hidden="true"></button>
      <div class="pvp__modal-dialog" role="dialog" aria-modal="true" aria-label="{{ s.video_dialog_label }}" data-pvp-modal-dialog>
        <button type="button" class="pvp__modal-close" data-pvp-modal-close aria-label="{{ s.close_label }}">
          {{ pv_close }}
        </button>
        <video class="pvp__modal-video" data-pvp-modal-video controls playsinline></video>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Bundle explanation dialog ---------- {%- endcomment -%}
  {%- if has_bundle and bb.why_text != blank or has_bundle and bb.toggle_text != blank -%}
    <div class="pvp__modal" data-pvpb-modal hidden>
      <button type="button" class="pvp__modal-backdrop" data-pvpb-modal-close tabindex="-1" aria-hidden="true"></button>
      <div class="pvp__modal-dialog pvp__modal-dialog--text" role="dialog" aria-modal="true" data-pvpb-modal-dialog>
        <button type="button" class="pvp__modal-close" data-pvpb-modal-close aria-label="{{ s.close_label }}">
          {{ pv_close }}
        </button>
        <div class="pvpb__dialog-body" data-pvpb-modal-body></div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('pvp-{{ section.id }}');
    if (!root || root.dataset.pvpReady === 'true') return;
    root.dataset.pvpReady = 'true';

    function $(sel, ctx) {
      return (ctx || root).querySelector(sel);
    }
    function $$(sel, ctx) {
      return Array.prototype.slice.call((ctx || root).querySelectorAll(sel));
    }

    var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var config;
    try {
      config = JSON.parse($('[data-pvp-config]').textContent);
    } catch (error) {
      console.warn('[pureva] configuration illisible', error);
      return;
    }

    /* ---------------- Accordions ---------------- */

    function openPanel(panel) {
      panel.hidden = false;
      if (REDUCED) {
        panel.style.height = 'auto';
        return;
      }
      var target = panel.scrollHeight;
      panel.style.height = '0px';
      void panel.offsetHeight; // force reflow so the transition runs
      panel.style.height = target + 'px';
      panel.addEventListener('transitionend', function once(e) {
        if (e.propertyName !== 'height' || e.target !== panel) return;
        panel.style.height = 'auto';
        panel.removeEventListener('transitionend', once);
      });
    }

    function closePanel(panel) {
      if (REDUCED) {
        panel.style.height = '';
        panel.hidden = true;
        return;
      }
      panel.style.height = panel.scrollHeight + 'px';
      void panel.offsetHeight;
      panel.style.height = '0px';
      panel.addEventListener('transitionend', function once(e) {
        if (e.propertyName !== 'height' || e.target !== panel) return;
        panel.hidden = true;
        panel.removeEventListener('transitionend', once);
      });
    }

    $$('[data-pvp-acc]').forEach(function (trigger) {
      var panel = document.getElementById(trigger.getAttribute('aria-controls'));
      if (!panel) return;
      /* An accordion open on load has no inline height yet. */
      if (!panel.hidden) panel.style.height = 'auto';

      trigger.addEventListener('click', function () {
        var open = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', open ? 'false' : 'true');
        if (open) closePanel(panel);
        else openPanel(panel);
      });
    });

    /* ---------------- Gallery ---------------- */

    var thumbs = $$('[data-pvp-thumb]');
    if (thumbs.length) {
      var slides = $$('[data-pvp-slide]');
      var stage = $('.pvp__stage');
      var track = $('[data-pvp-track]');
      var current = 0;

      /* Moves the rail. `animate` false pins it to the finger. */
      var shift = function (px, animate) {
        if (!track) return;
        track.classList.toggle('is-dragging', !animate);
        track.style.transform = 'translate3d(' + px + 'px, 0, 0)';
      };

      var select = function (index, animate) {
        var target = Number(index) || 0;
        /* The rail has two ends: clamp rather than wrap, or jumping from the
           last image to the first would sweep across every slide. */
        if (target < 0) target = 0;
        if (target > slides.length - 1) target = slides.length - 1;

        /* Only a one-step move is worth animating; a jump from a distant
           thumbnail would blur through everything in between. */
        var stepMove = Math.abs(target - current) === 1;
        current = target;

        shift(-current * (stage ? stage.clientWidth : 0), stepMove && animate !== false && !REDUCED);

        slides.forEach(function (slide, i) {
          slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
        });
        thumbs.forEach(function (thumb) {
          var active = thumb.getAttribute('data-pvp-thumb') === String(current);
          thumb.setAttribute('aria-selected', active ? 'true' : 'false');
          thumb.tabIndex = active ? 0 : -1;
          /* Keep the active thumbnail in view once the strip scrolls. */
          if (active && thumb.scrollIntoView) {
            thumb.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          }
        });
      };

      /* The rail is positioned in pixels, so it has to be re-measured
         whenever the stage is resized or the layout reflows. */
      if (stage && window.ResizeObserver) {
        var lastWidth = stage.clientWidth;
        new ResizeObserver(function () {
          if (stage.clientWidth === lastWidth) return;
          lastWidth = stage.clientWidth;
          shift(-current * lastWidth, false);
        }).observe(stage);
      }

      /* ---- Drag ----
         Touch only, and the rail is only captured once the gesture is
         clearly horizontal, so scrolling the page through the image still
         works. */
      if (stage && track && slides.length > 1) {
        var startX = 0;
        var startY = 0;
        var delta = 0;
        var tracking = false;
        var decided = false;

        stage.addEventListener(
          'touchstart',
          function (event) {
            if (event.touches.length !== 1) return;
            startX = event.touches[0].clientX;
            startY = event.touches[0].clientY;
            delta = 0;
            tracking = true;
            decided = false;
          },
          { passive: true }
        );

        stage.addEventListener(
          'touchmove',
          function (event) {
            if (!tracking) return;
            var dx = event.touches[0].clientX - startX;
            var dy = event.touches[0].clientY - startY;

            if (!decided) {
              if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
              decided = true;
              if (Math.abs(dx) <= Math.abs(dy)) {
                /* A vertical gesture belongs to the page. */
                tracking = false;
                return;
              }
            }

            /* Pulling past either end drags at a third of the speed, so the
               rail feels like it has a limit instead of a bug. */
            var atStart = current === 0 && dx > 0;
            var atEnd = current === slides.length - 1 && dx < 0;
            delta = atStart || atEnd ? dx / 3 : dx;
            shift(-current * stage.clientWidth + delta, false);
          },
          { passive: true }
        );

        var release = function () {
          if (!tracking && delta === 0) return;
          tracking = false;
          var width = stage.clientWidth || 1;
          /* A short flick counts as much as a long slow drag. */
          var threshold = Math.min(60, width * 0.18);
          var next = current;
          if (Math.abs(delta) > threshold) next = current + (delta < 0 ? 1 : -1);
          delta = 0;

          if (next === current) {
            shift(-current * width, !REDUCED);
          } else {
            select(next, true);
          }
        };

        stage.addEventListener('touchend', release, { passive: true });
        stage.addEventListener('touchcancel', release, { passive: true });
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          select(thumb.getAttribute('data-pvp-thumb'), true);
        });
      });

      thumbs[0].parentNode.addEventListener('keydown', function (event) {
        var i = thumbs.indexOf(document.activeElement);
        if (i === -1) return;
        var next = null;
        if (event.key === 'ArrowRight') next = Math.min(i + 1, thumbs.length - 1);
        else if (event.key === 'ArrowLeft') next = Math.max(i - 1, 0);
        else return;
        event.preventDefault();
        thumbs[next].focus();
        select(thumbs[next].getAttribute('data-pvp-thumb'), true);
      });
    }

    /* ---------------- Review popover ---------------- */

    var revToggle = $('[data-pvp-reviews-toggle]');
    var revPop = $('[data-pvp-revpop]');

    if (revToggle && revPop) {
      var reviewCards = $$('[data-pvp-review]', revPop);
      var reviewDots = $$('[data-pvp-review-dot]', revPop);
      var reviewIndex = 0;

      var showReview = function (index) {
        if (!reviewCards.length) return;
        reviewIndex = (index + reviewCards.length) % reviewCards.length;
        reviewCards.forEach(function (card, i) {
          card.hidden = i !== reviewIndex;
        });
        reviewDots.forEach(function (dot, i) {
          dot.setAttribute('aria-current', i === reviewIndex ? 'true' : 'false');
        });
      };

      var closeReviews = function (giveFocusBack) {
        revPop.hidden = true;
        revToggle.setAttribute('aria-expanded', 'false');
        if (giveFocusBack) revToggle.focus();
      };

      revToggle.addEventListener('click', function () {
        var open = revToggle.getAttribute('aria-expanded') === 'true';
        if (open) {
          closeReviews(false);
        } else {
          revPop.hidden = false;
          revToggle.setAttribute('aria-expanded', 'true');
        }
      });

      $$('[data-pvp-reviews-close]', revPop).forEach(function (el) {
        el.addEventListener('click', function () {
          closeReviews(true);
        });
      });

      var prev = $('[data-pvp-review-prev]', revPop);
      var next = $('[data-pvp-review-next]', revPop);
      if (prev) {
        prev.addEventListener('click', function () {
          showReview(reviewIndex - 1);
        });
      }
      if (next) {
        next.addEventListener('click', function () {
          showReview(reviewIndex + 1);
        });
      }
      reviewDots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          showReview(i);
        });
      });

      document.addEventListener('keydown', function (event) {
        if (revPop.hidden || event.key !== 'Escape') return;
        event.preventDefault();
        closeReviews(true);
      });

      /* A click anywhere else closes it, the way a dropdown should. */
      document.addEventListener('click', function (event) {
        if (revPop.hidden) return;
        if (revPop.contains(event.target) || revToggle.contains(event.target)) return;
        closeReviews(false);
      });
    }

    /* ---------------- Video dialog ---------------- */

    var modal = $('[data-pvp-modal]');
    if (modal) {
      var media = $('[data-pvp-modal-video]', modal);
      var closeBtn = $('.pvp__modal-close', modal);
      var lastTrigger = null;

      var lockScroll = function (locked) {
        document.documentElement.style.overflow = locked ? 'hidden' : '';
        document.body.style.overflow = locked ? 'hidden' : '';
      };

      var openModal = function (id, trigger) {
        var tpl = $('[data-pvp-video-src="' + id + '"]');
        if (!tpl) return;
        /* Sources are swapped in on demand, so no video is fetched until it
           is actually asked for. */
        media.innerHTML = tpl.innerHTML;
        media.load();

        lastTrigger = trigger;
        modal.hidden = false;
        lockScroll(true);
        window.requestAnimationFrame(function () {
          modal.classList.add('is-open');
        });
        if (closeBtn) closeBtn.focus();

        var attempt = media.play();
        if (attempt && typeof attempt.catch === 'function') attempt.catch(function () {});
      };

      var closeModal = function () {
        media.pause();
        modal.classList.remove('is-open');
        lockScroll(false);

        var done = false;
        var finish = function () {
          if (done) return;
          done = true;
          modal.hidden = true;
          media.innerHTML = '';
          if (lastTrigger) lastTrigger.focus();
          lastTrigger = null;
        };
        modal.addEventListener('transitionend', function once(e) {
          if (e.target !== modal) return;
          modal.removeEventListener('transitionend', once);
          finish();
        });
        window.setTimeout(finish, 320);
      };

      $$('[data-pvp-video]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          openModal(btn.getAttribute('data-pvp-video'), btn);
        });
      });

      $$('[data-pvp-modal-close]', modal).forEach(function (el) {
        el.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', function (event) {
        if (modal.hidden) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeModal();
        }
      });
    }

    /* ---------------- Bundle configurator ---------------- */

    var bundle = $('[data-pvpb]');
    /* What add-to-cart should post. Null means "use the product's variant". */
    var bundleLine = null;

    if (bundle) {
      var combos = {};
      $$('[data-pvpb-combo]', bundle).forEach(function (node) {
        try {
          combos[node.getAttribute('data-pvpb-combo')] = JSON.parse(node.textContent);
        } catch (error) {
          console.warn('[pureva] combinaison illisible', node.getAttribute('data-pvpb-combo'), error);
        }
      });

      var house = Number(bundle.getAttribute('data-pvpb-default-house')) || 0;
      var freq = Number(bundle.getAttribute('data-pvpb-default-freq')) || 0;
      var switchEl = $('[data-pvpb-switch]', bundle);
      var subscribed = !switchEl || switchEl.getAttribute('aria-checked') === 'true';

      var panel = $('[data-pvpb-panel]', bundle);
      var buyWas = $('[data-pvp-buy-was]');
      var buyNow = $('[data-pvp-buy-now]');

      /* Writes text and hides the node when there is nothing to say, so an
         empty discount never leaves an empty pill behind. */
      function fill(node, value, asHtml) {
        if (!node) return;
        var text = value || '';
        if (asHtml) node.innerHTML = text;
        else node.textContent = text;
        node.hidden = text === '';
      }

      var oneRow = $('[data-pvpb-onetime]', bundle);
      var oneRowPrice = $('[data-pvpb-onetime-price]', bundle);
      var oneTimeTxt = bundle.getAttribute('data-pvpb-onetime-txt') || '';
      var oneTimeVariant = Number(bundle.getAttribute('data-pvpb-onetime-variant')) || 0;

      function render() {
        var combo = combos[house + '-' + freq] || {};

        // Each frequency card shows the selected household's own prices.
        [0, 1].forEach(function (fi) {
          var c = combos[house + '-' + fi] || {};
          fill($('[data-pvpb-freq-now="' + fi + '"]', bundle), c.rec);
          fill($('[data-pvpb-freq-was="' + fi + '"]', bundle), c.cardWas);
          fill($('[data-pvpb-freq-off="' + fi + '"]', bundle), c.cardOff);
          fill($('[data-pvpb-freq-day="' + fi + '"]', bundle), c.perDay);
        });

        /* The recap always advertises the subscription, whichever way the
           switch is set: it is what the visitor gains by turning it back on. */
        fill($('[data-pvpb-now]', bundle), combo.first);
        fill($('[data-pvpb-was]', bundle), combo.was);
        fill($('[data-pvpb-off]', bundle), combo.off);
        fill($('[data-pvpb-then]', bundle), combo.then, true);

        /* No frequency is selected while the subscription is off. */
        $$('[data-pvpb-freq]', bundle).forEach(function (el) {
          var on = subscribed && Number(el.getAttribute('data-pvpb-freq')) === freq;
          el.setAttribute('aria-checked', on ? 'true' : 'false');
        });

        if (subscribed) {
          bundleLine = combo.variant ? { id: combo.variant, plan: combo.plan || 0 } : null;
          fill(buyNow, combo.first);
          fill(buyWas, combo.was);
        } else {
          /* One-off: the configured price, or the undiscounted one. */
          var oneOff = oneTimeTxt || combo.was || combo.first;
          bundleLine = oneTimeVariant ? { id: oneTimeVariant, plan: 0 } : null;
          fill(buyNow, oneOff);
          fill(buyWas, '');
          if (oneRowPrice) oneRowPrice.textContent = oneOff || '';
        }

        /* The perks stay on screen, padlocked, instead of disappearing. */
        if (panel) panel.classList.toggle('is-locked', !subscribed);
        if (oneRow) oneRow.hidden = subscribed;
      }

      /* Roving tabindex over a radiogroup, shared by both rows. */
      function wireGroup(attr, onPick) {
        var items = $$('[' + attr + ']', bundle);
        if (!items.length) return;

        function pick(item) {
          items.forEach(function (other) {
            var on = other === item;
            other.setAttribute('aria-checked', on ? 'true' : 'false');
            other.tabIndex = on ? 0 : -1;
          });
          onPick(Number(item.getAttribute(attr)));
          render();
        }

        items.forEach(function (item) {
          item.addEventListener('click', function () {
            pick(item);
          });
        });

        items[0].parentNode.addEventListener('keydown', function (event) {
          var i = items.indexOf(document.activeElement);
          if (i === -1) return;
          var next = null;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (i + 1) % items.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (i - 1 + items.length) % items.length;
          else return;
          event.preventDefault();
          items[next].focus();
          pick(items[next]);
        });
      }

      wireGroup('data-pvpb-house', function (value) {
        house = value;
      });
      wireGroup('data-pvpb-freq', function (value) {
        freq = value;
        /* Picking a frequency while padlocked is how you take the
           subscription back. */
        if (!subscribed) {
          subscribed = true;
          if (switchEl) switchEl.setAttribute('aria-checked', 'true');
        }
      });

      if (switchEl) {
        switchEl.addEventListener('click', function () {
          subscribed = switchEl.getAttribute('aria-checked') !== 'true';
          switchEl.setAttribute('aria-checked', subscribed ? 'true' : 'false');
          render();
        });
      }

      /* ---- The two explanation dialogs ---- */
      var infoModal = $('[data-pvpb-modal]');
      if (infoModal) {
        var infoBody = $('[data-pvpb-modal-body]', infoModal);
        var infoClose = $('.pvp__modal-close', infoModal);
        var infoTrigger = null;

        var closeInfo = function () {
          infoModal.classList.remove('is-open');
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          var done = false;
          var finish = function () {
            if (done) return;
            done = true;
            infoModal.hidden = true;
            if (infoTrigger) infoTrigger.focus();
            infoTrigger = null;
          };
          infoModal.addEventListener('transitionend', function once(e) {
            if (e.target !== infoModal) return;
            infoModal.removeEventListener('transitionend', once);
            finish();
          });
          window.setTimeout(finish, 320);
        };

        $$('[data-pvpb-open]', bundle).forEach(function (btn) {
          btn.addEventListener('click', function () {
            var tpl = $('[data-pvpb-dialog="' + btn.getAttribute('data-pvpb-open') + '"]', bundle);
            if (!tpl) return;
            infoBody.innerHTML = tpl.innerHTML;
            infoTrigger = btn;
            infoModal.hidden = false;
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
            window.requestAnimationFrame(function () {
              infoModal.classList.add('is-open');
            });
            if (infoClose) infoClose.focus();
          });
        });

        $$('[data-pvpb-modal-close]', infoModal).forEach(function (el) {
          el.addEventListener('click', closeInfo);
        });

        document.addEventListener('keydown', function (event) {
          if (infoModal.hidden) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closeInfo();
          }
        });
      }

      render();
    }

    /* ---------------- Add to cart ---------------- */

    var button = $('[data-pvp-add]');
    var errorBox = $('[data-pvp-error]');

    function readResponse(response) {
      return response.json().then(function (data) {
        if (!response.ok) {
          throw new Error(data.description || data.message || config.strings.error);
        }
        return data;
      });
    }

    function addMain() {
      /* The configurator wins: it knows which bundle variant matches the
         offer the visitor actually built. */
      if (bundleLine) {
        var line = { id: bundleLine.id, quantity: 1 };
        if (bundleLine.plan) line.selling_plan = bundleLine.plan;
        return fetch(config.cartAddUrl, {
          method: 'POST',
          headers: { Accept: 'application/javascript', 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [line] })
        }).then(readResponse);
      }

      /* Otherwise post the theme's own product form when there is one, so a
         variant the visitor picked elsewhere on the page carries over. */
      var form = document.querySelector('form[action*="/cart/add"]');
      if (form && !root.contains(form)) {
        return fetch(config.cartAddUrl, {
          method: 'POST',
          headers: { Accept: 'application/javascript' },
          body: new FormData(form)
        }).then(readResponse);
      }
      return fetch(config.cartAddUrl, {
        method: 'POST',
        headers: { Accept: 'application/javascript', 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: config.variantId, quantity: 1 }] })
      }).then(readResponse);
    }

    /**
     * The gift goes in as its own call, after the main product. Two reasons:
     * the theme's own form can only carry one line, and a gift that fails
     * (sold out, deleted) must never cost the customer the product they
     * actually asked for. The cart is read first so adding twice does not
     * stack two gifts.
     */
    function addGift() {
      if (!config.gift || !config.gift.id) return Promise.resolve(null);

      return fetch(config.cartUrl + '.js', { headers: { Accept: 'application/json' } })
        .then(function (response) {
          return response.ok ? response.json() : null;
        })
        .then(function (cart) {
          var already =
            cart &&
            cart.items &&
            cart.items.some(function (line) {
              return line.variant_id === config.gift.id || line.id === config.gift.id;
            });
          if (already) return null;

          var item = { id: config.gift.id, quantity: 1 };
          if (config.gift.propName) {
            item.properties = {};
            item.properties[config.gift.propName] = config.gift.propValue || '';
          }
          return fetch(config.cartAddUrl, {
            method: 'POST',
            headers: { Accept: 'application/javascript', 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [item] })
          }).then(readResponse);
        })
        .catch(function (error) {
          /* Swallowed on purpose: the product is already in the cart. */
          console.warn('[pureva] cadeau non ajouté', error);
          return null;
        });
    }

    if (button) {
      button.addEventListener('click', function () {
        if (button.classList.contains('is-loading')) return;
        if (button.getAttribute('aria-disabled') === 'true') return;

        if (errorBox) errorBox.hidden = true;
        button.classList.add('is-loading');

        addMain()
          .then(function (payload) {
            return addGift().then(function () {
              return payload;
            });
          })
          .then(function (payload) {
            document.dispatchEvent(
              new CustomEvent('pvp:cart-added', { bubbles: true, detail: payload })
            );

            if (config.afterAdd === 'checkout') {
              window.location.href = config.checkoutUrl;
              return;
            }
            if (config.afterAdd === 'cart') {
              window.location.href = config.cartUrl;
              return;
            }
            var drawer = document.querySelector('cart-drawer, [data-cart-drawer]');
            if (drawer && typeof drawer.open === 'function') drawer.open();
            button.classList.remove('is-loading');
          })
          .catch(function (error) {
            button.classList.remove('is-loading');
            if (errorBox) {
              errorBox.textContent = error.message || config.strings.error;
              errorBox.hidden = false;
            }
          });
      });
    }
  })();
</script>

