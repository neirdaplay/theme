<section class="pcl" {{ section.shopify_attributes }}>
  <div class="pcl__wrap">
    <div class="pcl__head">
      {%- if s.show_pill and s.pill_text != blank -%}
        <p class="pcl__pill">{{ s.pill_text }}</p>
      {%- endif -%}

      {%- if s.titre != blank -%}
        <h2 class="pcl__title">{{ s.titre }}</h2>
      {%- endif -%}

      {%- if s.intro != blank -%}
        <div class="pcl__intro">{{ s.intro }}</div>
      {%- endif -%}
    </div>

    {%- if profils.size > 0 -%}
      <div class="pcl__card" data-pcl-card data-pcl-multi="{{ s.allow_multi }}">
        {%- for block in profils -%}
          {%- liquid
            assign b = block.settings
            assign uid = block.id | replace: '_', '' | slice: 0, 12

            comment
              Le premier profil s'ouvre d'office si le marchand le demande :
              un accordéon entièrement fermé ne montre rien de son contenu.
            endcomment
            assign ouvert = b.ouvert
            if s.open_first and forloop.first
              assign ouvert = true
            endif

            case b.icone
              when 'cuisinier'
                assign svg = ico_cuisinier
              when 'poele'
                assign svg = ico_poele
              when 'famille'
                assign svg = ico_famille
              when 'usure'
                assign svg = ico_usure
              when 'budget'
                assign svg = ico_budget
              when 'sport'
                assign svg = ico_sport
              when 'chef'
                assign svg = ico_chef
              when 'eco'
                assign svg = ico_eco
              else
                assign svg = ''
            endcase
          -%}
          <div class="pcl__row{% if ouvert %} is-open{% endif %}" data-pcl-row {{ block.shopify_attributes }}>
            <button
              class="pcl__head-btn"
              type="button"
              data-pcl-head
              id="pcl-h-{{ uid }}"
              aria-expanded="{% if ouvert %}true{% else %}false{% endif %}"
              aria-controls="pcl-p-{{ uid }}"
            >
              {%- if b.image != blank or svg != blank -%}
                <span class="pcl__tile" aria-hidden="true">
                  {%- if b.image != blank -%}
                    {{ b.image | image_url: width: 160 | image_tag: widths: '40, 80, 120, 160', loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ svg }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              <span class="pcl__label">{{ b.titre }}</span>
              <span class="pcl__sign" aria-hidden="true"></span>
            </button>

            <div
              class="pcl__panel"
              id="pcl-p-{{ uid }}"
              role="region"
              aria-labelledby="pcl-h-{{ uid }}"
            >
              <div class="pcl__panel-in">
                <div class="pcl__avis{% if b.photo == blank %} pcl__avis--nophoto{% endif %}">
                  {%- if b.photo != blank -%}
                    <div class="pcl__photo">
                      {{
                        b.photo
                        | image_url: width: 600
                        | image_tag: widths: '160, 280, 400, 600', loading: 'lazy', alt: b.photo_alt
                      }}
                    </div>
                  {%- endif -%}

                  <div class="pcl__texte">
                    {%- if s.show_stars and b.note > 0 -%}
                      <div class="pcl__stars" role="img" aria-label="{{ b.note }}/5">
                        {%- for i in (1..5) -%}
                          {%- if i <= b.note -%}
                            {{ ico_star }}
                          {%- else -%}
                            {{ ico_star | replace: '<svg ', '<svg class="is-off" ' }}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                    {%- if b.citation != blank -%}
                      <p class="pcl__quote">{{ b.citation }}</p>
                    {%- endif -%}

                    {%- if b.nom != blank or b.ville != blank -%}
                      <p class="pcl__by">
                        {%- if s.show_check -%}
                          <span class="pcl__check" aria-hidden="true">{{ ico_check }}</span>
                        {%- endif -%}
                        {%- if b.nom != blank -%}<span class="pcl__name">{{ b.nom }}</span>{%- endif -%}
                        {%- if b.ville != blank -%}<span class="pcl__city">{{ b.ville }}</span>{%- endif -%}
                      </p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var card = document.querySelector('#shopify-section-{{ section.id }} [data-pcl-card]');
    if (!card || card.dataset.pclReady === '1') return;
    card.dataset.pclReady = '1';

    var multi = card.getAttribute('data-pcl-multi') === 'true';

    function rows() {
      return [].slice.call(card.querySelectorAll('[data-pcl-row]'));
    }

    function set(row, open) {
      row.classList.toggle('is-open', open);
      var head = row.querySelector('[data-pcl-head]');
      if (head) head.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    card.addEventListener('click', function (event) {
      var head = event.target.closest ? event.target.closest('[data-pcl-head]') : null;
      if (!head || !card.contains(head)) return;

      var row = head.closest('[data-pcl-row]');
      var open = row.classList.contains('is-open');

      /* Un seul volet ouvert à la fois, sauf si le marchand en décide
         autrement : refermer les autres évite une carte qui s'étire sur
         plusieurs écrans. */
      if (!multi) {
        rows().forEach(function (other) {
          if (other !== row) set(other, false);
        });
      }

      set(row, !open);
    });
  })();
</script>

{% schema %}
{
  "name": "Profils clients",
  "tag": "section",
  "class": "section-profils-clients",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "container_width", "label": "Largeur du contenu", "min": 480, "max": 1400, "step": 20, "unit": "px", "default": 820 },
    { "type": "range", "id": "breakpoint", "label": "Bascule mobile / bureau", "min": 600, "max": 1200, "step": 10, "unit": "px", "default": 760 },
    { "type": "range", "id": "gutter", "label": "Marge latérale (bureau)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "gutter_mobile", "label": "Marge latérale (mobile)", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top", "label": "Marge haute (bureau)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse (bureau)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Marge haute (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Marge basse (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },

