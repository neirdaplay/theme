{% comment %}
  profils-clients.liquid
  Une pastille, un titre, une accroche, puis une carte blanche où chaque
  profil de client se déplie sur un avis : photo, étoiles, citation, auteur.

  Le dépliement passe par une grille dont la rangée va de 0fr à 1fr : la
  hauteur s'anime sans qu'on ait à la mesurer, donc sans recalcul au
  redimensionnement ni à la mise à jour du contenu.

  Les icônes sont dessinées ici, au trait et en deux tons. Chaque profil peut
  leur préférer une image déposée, qui l'emporte toujours.

  Fichier autonome : styles et comportement sont en ligne.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign profils = section.blocks | where: 'type', 'profil'
-%}

{% style %}
/* ==========================================================================
   Profils clients — tout est porté par .pcl
   ========================================================================== */

#shopify-section-{{ section.id }} .pcl {
  --pcl-bg: {{ s.color_bg }};
  --pcl-title: {{ s.color_title }};
  --pcl-intro: {{ s.color_intro }};
  --pcl-card: {{ s.color_card }};
  --pcl-line: {{ s.color_line }};
  --pcl-label: {{ s.color_label }};
  --pcl-sign: {{ s.color_sign }};
  --pcl-tile: {{ s.color_tile }};
  --pcl-ico: {{ s.color_ico }};
  --pcl-accent: {{ s.color_accent }};
  --pcl-star: {{ s.color_star }};
  --pcl-quote: {{ s.color_quote }};
  --pcl-author: {{ s.color_author }};
  --pcl-city: {{ s.color_city }};
  --pcl-check: {{ s.color_check }};

  --pcl-font: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  display: block;
  background: var(--pcl-bg);
  font-family: var(--pcl-font);
  -webkit-font-smoothing: antialiased;
}

#shopify-section-{{ section.id }} .pcl *,
#shopify-section-{{ section.id }} .pcl *::before,
#shopify-section-{{ section.id }} .pcl *::after { box-sizing: border-box; }

.pcl__wrap {
  max-width: {{ s.container_width }}px;
  margin-inline: auto;
  padding: {{ s.padding_top_mobile }}px {{ s.gutter_mobile }}px {{ s.padding_bottom_mobile }}px;
}

/* --------------------------------------------------------------------------
   En-tête
   -------------------------------------------------------------------------- */

.pcl__head { text-align: center; }

.pcl__pill {
  display: inline-block;
  margin: 0 0 {{ s.pill_gap }}px;
  padding: {{ s.pill_pad_y }}px {{ s.pill_pad_x }}px;
  border-radius: {{ s.pill_radius }}px;
  background: {{ s.color_pill_bg }};
  color: {{ s.color_pill_text }};
  font-size: {{ s.pill_size }}px;
  font-weight: {{ s.pill_weight }};
  line-height: 1.2;
}

.pcl__title {
  max-width: {{ s.titre_max_mobile }}px;
  margin: 0 auto {{ s.titre_gap_mobile }}px;
  color: var(--pcl-title);
  font-size: {{ s.titre_size_mobile }}px;
  font-weight: {{ s.titre_weight }};
  line-height: 1.18;
}

.pcl__intro {
  max-width: {{ s.intro_max_mobile }}px;
  margin: 0 auto {{ s.intro_gap_mobile }}px;
  color: var(--pcl-intro);
  font-size: {{ s.intro_size_mobile }}px;
  font-weight: {{ s.intro_weight }};
  line-height: 1.5;
}

.pcl__intro p { margin: 0; }
.pcl__intro p + p { margin-top: 0.6em; }

/* --------------------------------------------------------------------------
   La carte et ses rangées
   -------------------------------------------------------------------------- */

.pcl__card {
  border-radius: {{ s.card_radius }}px;
  background: var(--pcl-card);
  overflow: hidden;
}

.pcl__row + .pcl__row { border-top: 1px solid var(--pcl-line); }

.pcl__head-btn {
  display: flex;
  align-items: center;
  gap: {{ s.tile_gap_mobile }}px;
  width: 100%;
  padding: {{ s.row_pad_mobile }}px {{ s.row_pad_x_mobile }}px;
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.pcl__tile {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  width: {{ s.tile_size_mobile }}px;
  height: {{ s.tile_size_mobile }}px;
  border-radius: {{ s.tile_radius }}px;
  background: var(--pcl-tile);
}

.pcl__tile svg,
.pcl__tile img {
  width: {{ s.icon_ratio }}%;
  height: {{ s.icon_ratio }}%;
}

.pcl__tile img { object-fit: contain; }

/* Les deux tons de l'icône, repris des réglages : aucune couleur n'est
   écrite dans les tracés. */
.pcl__tile .pcl-body {
  fill: none;
  stroke: var(--pcl-ico);
  stroke-width: {{ s.icon_stroke }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.pcl__tile .pcl-body-plein { fill: var(--pcl-ico); stroke: none; }

.pcl__tile .pcl-accent {
  fill: none;
  stroke: var(--pcl-accent);
  stroke-width: {{ s.icon_stroke }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.pcl__tile .pcl-accent-plein { fill: var(--pcl-accent); stroke: none; }

.pcl__tile .pcl-cut {
  fill: none;
  stroke: var(--pcl-tile);
  stroke-width: {{ s.icon_stroke | plus: 0.4 }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.pcl__label {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--pcl-label);
  font-size: {{ s.label_size_mobile }}px;
  font-weight: {{ s.label_weight }};
  line-height: 1.3;
}

/* Le signe : deux traits, dont l'un disparaît à l'ouverture. Un « + » qui
   devient « − » sans changer de caractère, donc sans saut de largeur. */
.pcl__sign {
  position: relative;
  flex: 0 0 auto;
  width: {{ s.sign_size }}px;
  height: {{ s.sign_size }}px;
}

.pcl__sign::before,
.pcl__sign::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: {{ s.sign_size }}px;
  height: {{ s.sign_thickness }}px;
  margin: calc({{ s.sign_thickness }}px / -2) 0 0 calc({{ s.sign_size }}px / -2);
  border-radius: 999px;
  background: var(--pcl-sign);
}

.pcl__sign::after {
  transform: rotate(90deg);
  transition: transform {{ s.anim_speed }}ms ease, opacity {{ s.anim_speed }}ms ease;
}

.pcl__row.is-open .pcl__sign::after { transform: rotate(0deg); opacity: 0; }

/* --------------------------------------------------------------------------
   Le volet dépliant
   -------------------------------------------------------------------------- */

.pcl__panel {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows {{ s.anim_speed }}ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.pcl__row.is-open .pcl__panel { grid-template-rows: 1fr; }

/* min-height: 0 est indispensable : sans lui la rangée refuse de se
   réduire sous la hauteur de son contenu, et rien ne se replie. */
.pcl__panel-in {
  min-height: 0;
  overflow: hidden;
}

@media (prefers-reduced-motion: reduce) {
  .pcl__panel,
  .pcl__sign::after { transition: none; }
}

.pcl__avis {
  display: grid;
  grid-template-columns: {{ s.photo_width_mobile }}px 1fr;
  gap: {{ s.avis_gap_mobile }}px;
  align-items: start;
  padding: 0 {{ s.row_pad_x_mobile }}px {{ s.row_pad_mobile }}px;
}

.pcl__avis--nophoto { grid-template-columns: 1fr; }

.pcl__photo {
  border-radius: {{ s.photo_radius }}px;
  overflow: hidden;
  background: var(--pcl-tile);
}

.pcl__photo img {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: {{ s.photo_ratio }};
  object-fit: cover;
}

.pcl__stars {
  display: flex;
  gap: 2px;
  margin: 0 0 {{ s.stars_gap }}px;
  color: var(--pcl-star);
}

.pcl__stars svg { width: {{ s.stars_size }}px; height: {{ s.stars_size }}px; fill: currentColor; }
.pcl__stars svg.is-off { opacity: {{ s.stars_off_opacity | divided_by: 100.0 }}; }

.pcl__quote {
  margin: 0 0 {{ s.quote_gap }}px;
  color: var(--pcl-quote);
  font-size: {{ s.quote_size_mobile }}px;
  font-weight: {{ s.quote_weight }};
  line-height: 1.45;
}

.pcl__by {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: {{ s.author_size_mobile }}px;
  line-height: 1.3;
}

.pcl__check {
  flex: 0 0 auto;
  display: inline-flex;
  width: {{ s.check_size }}px;
  height: {{ s.check_size }}px;
  color: var(--pcl-check);
}

.pcl__check svg { width: 100%; height: 100%; }
.pcl__check .pcl-disc { fill: currentColor; }
.pcl__check .pcl-tick { fill: none; stroke: var(--pcl-card); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }

.pcl__name { color: var(--pcl-author); font-weight: 700; }
.pcl__city { color: var(--pcl-city); font-weight: 400; }

/* --------------------------------------------------------------------------
   Bureau
   -------------------------------------------------------------------------- */

@media screen and (min-width: {{ s.breakpoint }}px) {
  .pcl__wrap { padding: {{ s.padding_top }}px {{ s.gutter }}px {{ s.padding_bottom }}px; }

  .pcl__title {
    max-width: {{ s.titre_max }}px;
    margin-bottom: {{ s.titre_gap }}px;
    font-size: {{ s.titre_size }}px;
  }

  .pcl__intro {
    max-width: {{ s.intro_max }}px;
    margin-bottom: {{ s.intro_gap }}px;
    font-size: {{ s.intro_size }}px;
  }

  .pcl__head-btn {
    gap: {{ s.tile_gap }}px;
    padding: {{ s.row_pad }}px {{ s.row_pad_x }}px;
  }

  .pcl__tile { width: {{ s.tile_size }}px; height: {{ s.tile_size }}px; }
  .pcl__label { font-size: {{ s.label_size }}px; }

  .pcl__avis {
    grid-template-columns: {{ s.photo_width }}px 1fr;
    gap: {{ s.avis_gap }}px;
    padding: 0 {{ s.row_pad_x }}px {{ s.row_pad }}px;
  }

  .pcl__avis--nophoto { grid-template-columns: 1fr; }
  .pcl__quote { font-size: {{ s.quote_size }}px; }
  .pcl__by { font-size: {{ s.author_size }}px; }
}
{% endstyle %}

{%- comment -%}
  ---------- Les icônes ----------
  Un corps au trait, un détail accentué. Les couleurs viennent de la feuille
  de style, donc des réglages.
{%- endcomment -%}

