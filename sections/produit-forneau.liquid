{% comment %}
  produit-forneau.liquid
  Fiche produit complète : galerie, bandeau récompense, titre, avis, prix,
  rangée de garanties, sélecteur de taille, composeur de set, bouton d'achat,
  mention d'urgence, cadeaux inclus, vidéos clients.

  Mobile d'abord. Au-delà du point de bascule, la galerie passe à gauche et
  tout le reste tient dans une colonne à droite.

  Chaque partie se coupe par une case à cocher et porte ses propres couleurs.
  Les parties qui se répètent — garanties, tailles, articles du set, cadeaux,
  vidéos — sont des blocs réordonnables.

  Le thème ne crée aucune remise : il affiche les pourcentages saisis ici.
  La vraie remise est une remise automatique réglée dans Shopify, qui doit
  reprendre les mêmes paliers.

  Fichier autonome : styles et comportement sont en ligne, rien à déposer
  dans assets/.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign p = product
  assign v = product.selected_or_first_available_variant

  assign tailles = section.blocks | where: 'type', 'taille'
  assign garanties = section.blocks | where: 'type', 'garantie'
  assign articles = section.blocks | where: 'type', 'set_item'
  assign videos = section.blocks | where: 'type', 'ugc'

  comment
    Le nom de l'option qui porte les tailles. Vide, on prend la première
    option du produit — le cas courant d'un produit à une seule déclinaison.
  endcomment
  assign option_name = s.option_taille
  if option_name == blank and p.options.size > 0
    assign option_name = p.options.first
  endif

  assign option_index = 0
  for name in p.options
    if name == option_name
      assign option_index = forloop.index0
    endif
  endfor
-%}

{% style %}
/* ==========================================================================
   Fiche produit Forneau — tout est porté par .frn
   ========================================================================== */

#shopify-section-{{ section.id }} .frn {
  --frn-bg: {{ s.color_bg }};
  --frn-ink: {{ s.color_text }};
  --frn-muted: {{ s.color_muted }};
  --frn-line: {{ s.color_line }};
  --frn-accent: {{ s.color_accent }};
  --frn-card: {{ s.color_card }};
  --frn-trust-ico: {{ s.color_trust_ico }};
  --frn-check-bg: {{ s.color_check_bg }};
  --frn-check-ink: {{ s.color_check_text }};
  --frn-item-on: {{ s.color_item_on }};
  --frn-promo-bg: {{ s.color_promo_bg }};
  --frn-promo-ink: {{ s.color_promo_text }};

  --frn-award-bg: {{ s.color_award_bg }};
  --frn-award-ink: {{ s.color_award_text }};
  --frn-award-line: {{ s.color_award_line }};

  --frn-star: {{ s.color_star }};
  --frn-price: {{ s.color_price }};
  --frn-was: {{ s.color_was }};
  --frn-tag-bg: {{ s.color_tag_bg }};
  --frn-tag-ink: {{ s.color_tag_text }};

  --frn-size-on-bg: {{ s.color_size_on_bg }};
  --frn-size-on-ink: {{ s.color_size_on_text }};
  --frn-size-off-bg: {{ s.color_size_off_bg }};
  --frn-size-off-ink: {{ s.color_size_off_text }};
  --frn-ideal-bg: {{ s.color_ideal_bg }};
  --frn-ideal-ink: {{ s.color_ideal_text }};

  --frn-set-bg: {{ s.color_set_bg }};
  --frn-set-pill-bg: {{ s.color_set_pill_bg }};
  --frn-set-pill-ink: {{ s.color_set_pill_text }};
  --frn-set-fill: {{ s.color_set_fill }};
  --frn-set-track: {{ s.color_set_track }};

  --frn-buy-bg: {{ s.color_buy_bg }};
  --frn-buy-ink: {{ s.color_buy_text }};

  --frn-urgent-bg: {{ s.color_urgent_bg }};
  --frn-urgent-ink: {{ s.color_urgent_text }};
  --frn-urgent-dot: {{ s.color_urgent_dot }};

  --frn-gift-bg: {{ s.color_gift_bg }};
  --frn-gift-size: {{ s.gift_img_size }}px;
  --frn-gift-bleed: {{ s.gift_img_bleed | divided_by: 100.0 }};
  --frn-offert-bg: {{ s.color_offert_bg }};
  --frn-offert-ink: {{ s.color_offert_text }};

  --frn-ring: {{ s.color_ugc_ring }};

  --frn-max: {{ s.container_width }}px;
  --frn-radius: {{ s.radius }}px;
  --frn-size: {{ s.font_size }}px;

  --frn-sans: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;

  /* Les titres suivent la police du reste par défaut. Le réglage reste là
     pour qui voudrait y mettre une autre pile — un sérif, par exemple. */
  --frn-serif: {% if s.font_titre != blank %}{{ s.font_titre }}{% else %}var(--frn-sans){% endif %};
  --frn-titre-weight: {{ s.font_titre_weight }};

  background: var(--frn-bg);
  color: var(--frn-ink);
  font-family: var(--frn-sans);
  font-size: var(--frn-size);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

#shopify-section-{{ section.id }} .frn *,
#shopify-section-{{ section.id }} .frn *::before,
#shopify-section-{{ section.id }} .frn *::after { box-sizing: border-box; }

.frn__wrap {
  /* La marge latérale est une variable : la galerie s'en sert pour ressortir
     exactement de ce qu'elle vaut, et les deux ne peuvent pas diverger. */
  --frn-gutter: {{ s.gutter_mobile }}px;

  max-width: var(--frn-max);
  margin-inline: auto;
  padding: {{ s.padding_top_mobile }}px var(--frn-gutter) {{ s.padding_bottom_mobile }}px;
}

.frn [hidden] { display: none !important; }

/* --------------------------------------------------------------------------
   Galerie
   -------------------------------------------------------------------------- */

.frn__gallery { margin: 0 0 14px; }

/* Pleine largeur : la galerie ressort de la marge latérale du bloc, des deux
   côtés. Les vignettes, elles, restent alignées sur le reste du texte — une
   rangée collée aux bords de l'écran se lirait mal. */
.frn__gallery--bord {
  margin-left: calc(var(--frn-gutter) * -1);
  margin-right: calc(var(--frn-gutter) * -1);
}

.frn__gallery--bord .frn__thumbs {
  margin-left: var(--frn-gutter);
  margin-right: var(--frn-gutter);
}

.frn__stage {
  position: relative;
  border-radius: var(--frn-radius);
  overflow: hidden;
  background: var(--frn-card);
}

/* Collée aux bords, une scène arrondie laisserait quatre petits coins de
   fond : elle devient donc franche. */
.frn__gallery--bord .frn__stage { border-radius: 0; }

.frn__slides {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.frn__slides::-webkit-scrollbar { display: none; }

.frn__slide {
  position: relative;
  flex: 0 0 100%;
  scroll-snap-align: center;
  {%- if s.gallery_shape == 'ratio' %}
  aspect-ratio: 100 / {{ s.gallery_ratio }};
  {%- endif %}
}

.frn__slide img {
  display: block;
  width: 100%;
}

{%- if s.gallery_shape == 'ratio' %}
/* Hauteur imposée : l'image remplit le cadre, quitte à être recadrée. */
.frn__slide img {
  height: 100%;
  object-fit: {{ s.gallery_fit }};
}
{%- else %}
/* Format d'origine : rien n'est recadré, la hauteur suit l'image. */
.frn__slide img { height: auto; }
{%- endif %}

/* Flèches : masquées sur mobile, où le glissement suffit. */
.frn__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--frn-ink);
  cursor: pointer;
}

.frn__arrow svg { width: 22px; height: 22px; fill: currentColor; }
.frn__arrow--prev { left: 4px; }
.frn__arrow--next { right: 4px; }

.frn__thumbs {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding-bottom: 2px;
}

.frn__thumbs::-webkit-scrollbar { display: none; }

.frn__thumb {
  position: relative;
  flex: 0 0 auto;
  width: {{ s.thumb_size }}px;
  height: {{ s.thumb_size }}px;
  padding: 0;
  border: 2px solid transparent;
  border-radius: 8px;
  overflow: hidden;
  background: var(--frn-card);
  cursor: pointer;
}

.frn__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
.frn__thumb[aria-current="true"] { border-color: var(--frn-ink); }

/* --------------------------------------------------------------------------
   Bandeau récompense
   -------------------------------------------------------------------------- */

/* Trois habillages pour la même mention : un filet discret, une pastille,
   ou le cadre plein. Le contenu, lui, ne change pas. */

.frn__award {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  margin: 0 0 16px;
  color: var(--frn-award-ink);
  font-size: {{ s.award_size }}px;
  font-weight: 700;
  letter-spacing: {{ s.award_tracking | divided_by: 100.0 }}em;
  line-height: 1.2;
  text-align: center;
  {%- if s.award_caps %}
  text-transform: uppercase;
  {%- endif %}
}

.frn__award-ico {
  flex: 0 0 auto;
  display: inline-flex;
  width: {{ s.award_icon_size }}px;
  height: {{ s.award_icon_size }}px;
  color: var(--frn-award-line);
}

/* Chaque icône décide elle-même de son remplissage et de son trait : la
   couronne de laurier a besoin de feuilles pleines, la médaille d'un
   contour. La feuille de style ne lui impose que sa taille et sa couleur. */
.frn__award-ico svg { width: 100%; height: 100%; }
.frn__award-ico img { width: 100%; height: 100%; object-fit: contain; }

/* Filet : deux traits fins de part et d'autre du texte. C'est la version la
   plus sobre, et celle qui respire le mieux au-dessus d'un titre. */
.frn__award--filet::before,
.frn__award--filet::after {
  content: "";
  flex: 1 1 0;
  height: 1px;
  background: var(--frn-award-line);
  opacity: 0.55;
}

/* Pastille : un fond doux, juste à la taille du texte. */
.frn__award--pastille {
  width: fit-content;
  max-width: 100%;
  margin-inline: auto;
  padding: 7px 16px;
  border-radius: 999px;
  background: var(--frn-award-bg);
}

/* Cadre : le rectangle bordé d'origine. */
.frn__award--cadre {
  padding: 9px 12px;
  border: 1px solid var(--frn-award-line);
  border-radius: 6px;
  background: var(--frn-award-bg);
}

/* --------------------------------------------------------------------------
   Titre, avis, prix
   -------------------------------------------------------------------------- */

.frn__title {
  margin: 0 0 10px;
  font-family: var(--frn-serif);
  font-size: {{ s.titre_size_mobile }}px;
  font-weight: var(--frn-titre-weight);
  line-height: 1.22;
  text-align: {{ s.align_mobile }};
}

.frn__rating {
  display: flex;
  align-items: center;
  justify-content: {% if s.align_mobile == 'center' %}center{% else %}flex-start{% endif %};
  gap: 7px;
  margin: 0 0 10px;
  font-size: calc(var(--frn-size) * 0.84);
  color: var(--frn-muted);
}

.frn__stars { display: inline-flex; gap: 1px; color: var(--frn-star); }
.frn__stars svg { width: 14px; height: 14px; fill: currentColor; }

/* Les trois éléments n'ont ni la même hauteur ni la même nature : un grand
   nombre, un prix barré, une pastille rembourrée. Alignés sur la ligne de
   base, ils partaient dans tous les sens ; centrés les uns sur les autres,
   ils forment une seule ligne. */
.frn__pricerow {
  display: flex;
  align-items: center;
  justify-content: {% if s.align_mobile == 'center' %}center{% else %}flex-start{% endif %};
  flex-wrap: wrap;
  gap: 8px 10px;
  margin: 0 0 16px;
}

.frn__price {
  font-family: var(--frn-serif);
  font-size: {{ s.prix_size_mobile }}px;
  font-weight: var(--frn-titre-weight);
  line-height: 1;
  color: var(--frn-price);
}

.frn__was {
  font-size: {{ s.was_size }}px;
  font-weight: 500;
  line-height: 1;
  color: var(--frn-was);
  text-decoration: line-through;
  text-decoration-thickness: 1px;
}

.frn__tag {
  display: inline-flex;
  align-items: center;
  padding: 5px 11px;
  border-radius: 999px;
  background: var(--frn-tag-bg);
  color: var(--frn-tag-ink);
  font-size: {{ s.tag_size }}px;
  font-weight: 800;
  letter-spacing: 0.05em;
  line-height: 1.15;
  text-transform: uppercase;
}

/* --------------------------------------------------------------------------
   Rangée de garanties
   -------------------------------------------------------------------------- */

.frn__trust {
  display: grid;
  grid-template-columns: repeat({{ garanties.size | at_least: 1 | at_most: 4 }}, 1fr);
  gap: 6px;
  margin: 0 0 18px;
  text-align: center;
}

.frn__trust-item { display: grid; justify-items: center; gap: 5px; }

.frn__trust-ico {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: {{ s.trust_icon_size }}px;
  height: {{ s.trust_icon_size }}px;
  color: var(--frn-trust-ico);
  font-size: calc({{ s.trust_icon_size }}px * 0.7);
}

/* Les icônes de garantie sont dessinées au trait, comme sur la référence :
   le remplissage les rendrait beaucoup plus lourdes à cette taille. */
.frn__trust-ico svg {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: currentColor;
  stroke-width: {{ s.trust_icon_stroke }};
  stroke-linecap: round;
  stroke-linejoin: round;
}

.frn__trust-ico img { width: 100%; height: 100%; object-fit: contain; }

.frn__trust-txt {
  font-size: {{ s.trust_text_size_mobile }}px;
  line-height: 1.25;
  color: var(--frn-ink);
}

/* --------------------------------------------------------------------------
   Guide des tailles et sélecteur
   -------------------------------------------------------------------------- */

.frn__guide {
  display: block;
  /* L'écart laisse passer la pastille « idéale », qui déborde du sélecteur
     par le haut. */
  margin: 0 0 16px;
  color: var(--frn-ink);
  font-size: calc(var(--frn-size) * 0.72);
  font-weight: 700;
  letter-spacing: 0.05em;
  text-align: right;
  text-decoration: underline;
  text-transform: uppercase;
  text-underline-offset: 3px;
}

.frn__sizes {
  position: relative;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  margin: 0 0 18px;
  border: 1px solid var(--frn-line);
  border-radius: 10px;
  /* Les coins des boutons sont coupés par le cadre : pas de rayon à répéter
     sur chacun d'eux, et aucun liseré ne dépasse. */
  overflow: hidden;
  background: var(--frn-size-off-bg);
}

/* Le fond de la taille retenue est une pièce à part, qui glisse d'une case
   à l'autre. Les boutons restent transparents : sans cela, deux fonds se
   superposeraient le temps du trajet. */
.frn__size-glide {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 0;
  height: 100%;
  background: var(--frn-size-on-bg);
  opacity: 0;
}

.frn__sizes.is-ready .frn__size-glide {
  opacity: 1;
  transition: transform {{ s.anim_speed }}ms cubic-bezier(0.22, 0.61, 0.36, 1),
    width {{ s.anim_speed }}ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.frn__size {
  position: relative;
  z-index: 1;
  padding: 12px 6px;
  min-height: 58px;
  border: 0;
  border-left: 1px solid var(--frn-line);
  background: transparent;
  color: var(--frn-size-off-ink);
  font-family: inherit;
  cursor: pointer;
  text-align: center;
  transition: color 0.2s ease;
}

/* « of-type » et non « child » : le fond glissant occupe désormais la
   première place dans le balisage. */
.frn__size:first-of-type { border-left: 0; }

.frn__size[aria-pressed="true"] { color: var(--frn-size-on-ink); }

/* Le trait de séparation disparaît de part et d'autre de la case retenue :
   il barrerait le fond vert. */
.frn__size[aria-pressed="true"],
.frn__size[aria-pressed="true"] + .frn__size { border-left-color: transparent; }

@media (prefers-reduced-motion: reduce) {
  .frn__sizes.is-ready .frn__size-glide { transition: none; }
}

.frn__size[disabled] { opacity: 0.4; cursor: not-allowed; }

/* Taille épuisée : elle reste cliquable — le visiteur doit pouvoir la
   choisir pour comprendre pourquoi le bouton d'achat se ferme. */
.frn__size--out .frn__size-v { text-decoration: line-through; }
.frn__size--out { opacity: 0.55; }

/* Avertissement réservé à l'éditeur de thème. */
.frn__warn {
  margin: -10px 0 16px;
  padding: 8px 11px;
  border: 1px dashed var(--frn-line);
  border-radius: 8px;
  font-size: calc(var(--frn-size) * 0.76);
  line-height: 1.35;
  color: var(--frn-muted);
}

.frn__size-v { display: block; font-size: calc(var(--frn-size) * 0.98); font-weight: 700; }
.frn__size-s { display: block; font-size: calc(var(--frn-size) * 0.76); opacity: 0.85; }

/* Pastille « idéale » : posée au-dessus du cadre, elle ne doit pas être
   coupée par son overflow — elle vit donc en dehors. */
.frn__ideal-wrap { position: relative; }

.frn__ideal {
  position: absolute;
  top: -9px;
  z-index: 2;
  padding: 3px 10px;
  border-radius: 999px;
  background: var(--frn-ideal-bg);
  color: var(--frn-ideal-ink);
  font-size: calc(var(--frn-size) * 0.64);
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transform: translateX(-50%);
  white-space: nowrap;
}

/* --------------------------------------------------------------------------
   Composeur de set
   -------------------------------------------------------------------------- */

.frn__set {
  margin: 0 0 16px;
  /* Serré sur téléphone : chaque pixel repris ici va au nom des articles,
     qui tiennent alors sur une ligne comme sur la référence. */
  padding: 12px 10px;
  border-radius: var(--frn-radius);
  background: var(--frn-set-bg);
}

.frn__set-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin: 0 0 12px;
}

.frn__set-title {
  margin: 0;
  font-size: calc(var(--frn-size) * 0.8);
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.frn__set-pill {
  padding: 5px 11px;
  border-radius: 999px;
  background: var(--frn-set-pill-bg);
  color: var(--frn-set-pill-ink);
  font-size: calc(var(--frn-size) * 0.72);
  font-weight: 700;
  white-space: nowrap;
}

.frn__steps { margin: 0 0 12px; }

.frn__bars { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }

.frn__bar {
  height: 5px;
  border-radius: 999px;
  background: var(--frn-set-track);
  overflow: hidden;
}

.frn__bar i {
  display: block;
  height: 100%;
  width: 0%;
  border-radius: 999px;
  background: var(--frn-set-fill);
  transition: width 0.2s ease;
}

.frn__steps-lab {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-top: 5px;
  font-size: calc(var(--frn-size) * 0.72);
  font-weight: 700;
}

.frn__items { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

.frn__item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  /* La marge à droite dégage la coche, qui est posée dans le coin plutôt
     que dans le flux : le nom de l'article récupère toute la largeur. */
  padding: 8px 30px 8px 8px;
  border: 2px solid var(--frn-line);
  border-radius: 10px;
  background: var(--frn-card);
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  color: inherit;
}

.frn__item[aria-pressed="true"] { border-color: var(--frn-item-on); }
.frn__item[disabled] { opacity: 0.5; cursor: not-allowed; }
.frn__item--vide,
.frn__item--rupture { border-style: dashed; }

/* La raison, écrite sur la carte : « Épuisé » se lit, un gris ne se lit pas. */
.frn__item-out {
  display: block;
  margin-top: 2px;
  font-size: calc(var(--frn-size) * 0.68);
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--frn-muted);
}

.frn__item-img {
  flex: 0 0 auto;
  width: {{ s.set_img_size }}px;
  height: {{ s.set_img_size }}px;
  border-radius: 6px;
  overflow: hidden;
  background: var(--frn-set-bg);
}

.frn__item-img img { width: 100%; height: 100%; object-fit: cover; }

.frn__item-txt { flex: 1 1 auto; min-width: 0; }

.frn__item-name {
  display: block;
  font-size: {{ s.set_name_size }}px;
  font-weight: 700;
  line-height: 1.2;
}

.frn__item-price {
  display: inline-block;
  margin-top: 2px;
  padding: 1px 0;
  border-radius: 5px;
  font-size: calc(var(--frn-size) * 0.82);
  font-weight: 700;
}

/* Le prix d'un article pas encore pris : c'est celui qu'il aurait une fois
   ajouté, et il mérite donc d'être vu. */
.frn__item--promo .frn__item-price {
  padding-inline: 6px;
  margin-inline-start: -6px;
  background: var(--frn-promo-bg);
  color: var(--frn-promo-ink);
}

.frn__item-was {
  display: block;
  font-size: calc(var(--frn-size) * 0.72);
  color: var(--frn-was);
  text-decoration: line-through;
}

.frn__item-mark {
  position: absolute;
  top: 7px;
  right: 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1px solid var(--frn-line);
  background: var(--frn-card);
  color: var(--frn-muted);
}

.frn__item-mark svg { width: 13px; height: 13px; fill: currentColor; }

.frn__item[aria-pressed="true"] .frn__item-mark {
  border-color: var(--frn-check-bg);
  background: var(--frn-check-bg);
  color: var(--frn-check-ink);
}

/* --------------------------------------------------------------------------
   Bouton d'achat
   -------------------------------------------------------------------------- */

.frn__buy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  /* Une seule ligne de boîtes : c'est le libellé qui passe à la ligne, pas
     les prix, qui restent à sa droite comme sur la référence. */
  flex-wrap: nowrap;
  width: 100%;
  min-height: 56px;
  padding: 14px 18px;
  border: 0;
  border-radius: 10px;
  background: var(--frn-buy-bg);
  color: var(--frn-buy-ink);
  font-family: inherit;
  font-size: calc(var(--frn-size) * 0.98);
  font-weight: 800;
  letter-spacing: 0.04em;
  line-height: 1.2;
  text-transform: uppercase;
  cursor: pointer;
}

.frn__buy[disabled] { opacity: 0.55; cursor: not-allowed; }
.frn__buy svg { width: 17px; height: 17px; fill: currentColor; flex: 0 0 auto; }

.frn__buy-money {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: baseline;
  gap: 8px;
  white-space: nowrap;
}

.frn__buy-sep { opacity: 0.55; }
.frn__buy-was { opacity: 0.7; text-decoration: line-through; font-weight: 600; }
.frn__buy-was[hidden] { display: none; }

/* La confirmation d'ajout : la coche se dessine, et les prix s'effacent le
   temps du message. */
.frn__buy-check {
  display: none;
  align-items: center;
  justify-content: center;
}

.frn__buy-check svg {
  width: 1.25em;
  height: 1.25em;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.frn__buy-check path {
  stroke-dasharray: 26;
  stroke-dashoffset: 26;
}

/* Le bouton reste fermé le temps de la confirmation, mais il ne doit pas
   pâlir : un succès affiché en grisé se lit comme une panne. */
.frn__buy.is-added[disabled] { opacity: 1; cursor: default; }

.frn__buy.is-added .frn__buy-check { display: inline-flex; }
.frn__buy.is-added .frn__buy-money { display: none; }
.frn__buy.is-added > svg:first-child { display: none; }

.frn__buy.is-added .frn__buy-check path {
  animation: frn-draw {{ s.anim_speed }}ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
}

.frn__buy.is-added {
  animation: frn-confirm {{ s.anim_speed }}ms cubic-bezier(0.34, 1.4, 0.64, 1);
}

@keyframes frn-draw {
  to { stroke-dashoffset: 0; }
}

@keyframes frn-confirm {
  0% { transform: scale(1); }
  45% { transform: scale(0.97); }
  100% { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .frn__buy.is-added { animation: none; }
  .frn__buy.is-added .frn__buy-check path { animation: none; stroke-dashoffset: 0; }
}

.frn__urgent {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 10px 0 0;
  padding: 8px 12px;
  border-radius: 999px;
  background: var(--frn-urgent-bg);
  color: var(--frn-urgent-ink);
  font-size: calc(var(--frn-size) * 0.78);
  font-weight: 600;
}

.frn__dot {
  flex: 0 0 auto;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--frn-urgent-dot);
}

{%- if s.urgent_pulse %}
/* Le battement signale une information vivante. Il s'arrête pour qui a
   demandé moins d'animation. */
.frn__dot { animation: frn-pulse 1.8s ease-in-out infinite; }

@keyframes frn-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.35); opacity: 0.55; }
}

@media (prefers-reduced-motion: reduce) {
  .frn__dot { animation: none; }
}
{%- endif %}

/* --------------------------------------------------------------------------
   Cadeaux inclus
   -------------------------------------------------------------------------- */

.frn__gift {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 12px 0 0;
  padding: 12px;
  border: 1px solid var(--frn-line);
  border-radius: var(--frn-radius);
  background: var(--frn-gift-bg);
  overflow: hidden;
}

.frn__gift-txt { flex: 1 1 auto; min-width: 0; }

/* Le titre et l'étiquette tiennent sur une seule ligne : c'est le titre qui
   se replie si la place manque, jamais l'étiquette qui descend sous lui. */
.frn__gift-name {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
  font-family: var(--frn-serif);
  font-size: {{ s.gift_title_size }}px;
  font-weight: {{ s.gift_title_weight }};
  line-height: 1.25;
}

.frn__gift-label { min-width: 0; }

.frn__offert {
  flex: 0 0 auto;
  padding: 2px 7px;
  border-radius: 4px;
  background: var(--frn-offert-bg);
  color: var(--frn-offert-ink);
  font-family: var(--frn-sans);
  font-size: {{ s.gift_badge_size }}px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.frn__gift-sub {
  display: block;
  margin: 3px 0 0;
  font-size: {{ s.gift_text_size }}px;
  line-height: 1.35;
  color: var(--frn-muted);
}

.frn__gift-sub b { color: var(--frn-ink); }

/* La taille du visuel est une variable : chaque carte peut la redéfinir
   pour elle seule, sans que la feuille de style ait à connaître les blocs. */
.frn__gift-img {
  flex: 0 0 auto;
  width: var(--frn-gift-size);
  height: var(--frn-gift-size);
  overflow: hidden;
}

.frn__gift-img img { width: 100%; height: 100%; object-fit: cover; }

/* Visuel rond ou carré, à gauche ou à droite, débordant ou non : quatre
   réglages de bloc, parce que les deux cadeaux de la référence ne sont pas
   présentés pareil. */
.frn__gift-img--rond { border-radius: 50%; }
.frn__gift-img--carre { border-radius: 8px; }
.frn__gift--gauche { flex-direction: row-reverse; }

/* Le visuel débordant sort du flux : la carte garde alors la hauteur de son
   texte, et le visuel mord sur les quatre bords plutôt que d'étirer la
   carte autour de lui. */
.frn__gift--debord .frn__gift-img {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}

.frn__gift--debord.frn__gift--droite .frn__gift-img {
  right: calc(var(--frn-gift-size) * var(--frn-gift-bleed) * -1);
}

.frn__gift--debord.frn__gift--gauche .frn__gift-img {
  left: calc(var(--frn-gift-size) * var(--frn-gift-bleed) * -1);
}

/* La place réservée au visuel pour que le texte ne passe pas dessous : ce
   qui reste de lui à l'intérieur de la carte, plus un peu d'air. */
.frn__gift--debord.frn__gift--droite .frn__gift-txt {
  padding-right: calc(var(--frn-gift-size) * (1 - var(--frn-gift-bleed)) + 4px);
}

.frn__gift--debord.frn__gift--gauche .frn__gift-txt {
  padding-left: calc(var(--frn-gift-size) * (1 - var(--frn-gift-bleed)) + 4px);
}

/* --------------------------------------------------------------------------
   Vidéos clientes
   -------------------------------------------------------------------------- */

.frn__ugc {
  display: flex;
  gap: 12px;
  margin: 16px 0 0;
  padding-bottom: 4px;
  overflow-x: auto;
  scrollbar-width: none;
}

.frn__ugc::-webkit-scrollbar { display: none; }

.frn__ugc-item {
  position: relative;
  flex: 0 0 auto;
  width: {{ s.ugc_size }}px;
  height: {{ s.ugc_size }}px;
  padding: 0;
  border: {{ s.ugc_ring_width }}px solid var(--frn-ring);
  border-radius: 50%;
  overflow: hidden;
  background: var(--frn-card);
  cursor: pointer;
}

.frn__ugc-item img { width: 100%; height: 100%; object-fit: cover; }

.frn__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  color: #15200f;
}

.frn__play svg { width: 14px; height: 14px; fill: currentColor; margin-left: 2px; }

/* Lecteur plein écran, ouvert au clic sur une vignette. */
.frn__player {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: rgba(10, 14, 8, 0.86);
}

.frn__player[hidden] { display: none !important; }

.frn__player-box {
  position: relative;
  width: min(480px, 100%);
  max-height: 86vh;
  aspect-ratio: 9 / 16;
  border-radius: 14px;
  overflow: hidden;
  background: #000;
}

.frn__player-box video,
.frn__player-box iframe {
  width: 100%;
  height: 100%;
  border: 0;
  object-fit: cover;
}

.frn__player-close {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #15200f;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}

/* --------------------------------------------------------------------------
   Bureau : galerie à gauche, tout le reste à droite.
   -------------------------------------------------------------------------- */

@media screen and (min-width: {{ s.breakpoint }}px) {
  .frn__wrap {
    display: grid;
    grid-template-columns: {{ s.gallery_width }}fr {{ 100 | minus: s.gallery_width }}fr;
    column-gap: {{ s.column_gap }}px;
    align-items: start;
    padding: {{ s.padding_top }}px 24px {{ s.padding_bottom }}px;
  }

  /* La galerie reste visible pendant qu'on parcourt la colonne de droite.
     Elle y est une colonne parmi deux : la pleine largeur n'a plus de sens,
     et la marge négative la ferait déborder sur le texte. */
  .frn__gallery {
    grid-column: 1;
    position: sticky;
    top: {{ s.gallery_sticky_top }}px;
    margin: 0;
  }

  .frn__gallery--bord .frn__thumbs { margin-inline: 0; }
  .frn__gallery--bord .frn__stage { border-radius: var(--frn-radius); }

  .frn__col { grid-column: 2; }

  /* Galerie coupée : la colonne de droite reprend toute la largeur plutôt
     que de laisser un vide à gauche. */
  .frn__wrap--nogallery { grid-template-columns: 1fr; }
  .frn__wrap--nogallery .frn__col { grid-column: 1; }

  .frn__arrow { display: inline-flex; }

  .frn__title { font-size: {{ s.titre_size }}px; text-align: {{ s.align }}; }
  .frn__price { font-size: {{ s.prix_size }}px; }

  .frn__rating,
  .frn__pricerow {
    justify-content: {% if s.align == 'center' %}center{% else %}flex-start{% endif %};
  }

  .frn__trust { gap: 10px; }
  .frn__trust-txt { font-size: {{ s.trust_text_size }}px; }
  .frn__set { padding: 18px; }
  .frn__buy { font-size: calc(var(--frn-size) * 1.02); }
}
{% endstyle %}

