{%- capture ico_medal -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="15.2" r="5.6"/><path d="M12 12.8l.9 1.8 2 .3-1.4 1.4.3 2-1.8-.9-1.8.9.3-2-1.4-1.4 2-.3zM8.4 10L6 3.2h4.2M15.6 10L18 3.2h-4.2"/></svg>{%- endcapture -%}
{%- capture ico_star_line -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.4l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8-5.4 2.8 1-6L3.3 9.8l6-.9z"/></svg>{%- endcapture -%}
{%- capture ico_crown -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.4 7.6l3.2 2.8L12 4.4l5.4 6 3.2-2.8-1.6 11.2H5z"/><path d="M5 18.4h14"/></svg>{%- endcapture -%}
{%- capture ico_prev -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 4.6L13.9 3 5 12l8.9 9 1.5-1.6L8 12z"/></svg>{%- endcapture -%}
{%- capture ico_next -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 3L7.1 4.6 14.5 12l-7.4 7.4L8.6 21l9-9z"/></svg>{%- endcapture -%}
{%- comment -%}
  Les icônes de garantie sont au trait : elles héritent de `stroke`, pas de
  `fill`, et ne portent donc aucune couleur en dur.
{%- endcomment -%}
