{%- capture ico_target -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.2"/><circle cx="12" cy="12" r="5.4"/><circle cx="12" cy="12" r="1.9"/></svg>{%- endcapture -%}
{%- capture ico_infinity -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12c1.7-2.3 3-3.6 5-3.6a3.6 3.6 0 010 7.2c-2 0-3.3-1.3-5-3.6zm0 0c-1.7 2.3-3 3.6-5 3.6a3.6 3.6 0 010-7.2c2 0 3.3 1.3 5 3.6z"/></svg>{%- endcapture -%}
{%- capture ico_leaf -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 3.8c.6 5.4-.5 9.6-3.2 12.3-2.8 2.8-6.6 2.9-9 1.1-2.2-1.7-2.6-5.6.2-8.4 2.7-2.7 6.9-3.7 12-3.4"/><path d="M4.2 20.2L12 12.4"/></svg>{%- endcapture -%}
{%- capture ico_flame -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.2 2.4c.6 2.6-.2 4.3-1.9 6-1.8 1.8-3.1 3.3-3.1 5.9a5 5 0 0010 0c0-1.9-.9-3.3-1.9-4.4"/><path d="M12 13.2c1 .9 1.6 1.8 1.6 2.9a1.7 1.7 0 11-3.3 0c0-1.1.6-2 1.7-2.9z"/></svg>{%- endcapture -%}
{%- capture ico_gift -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.4 11.4h15.2v9.2H4.4zM3.4 7.8h17.2v3.6H3.4zM12 7.8v12.8"/><path d="M12 7.8H8.6a2.2 2.2 0 110-4.4C10.8 3.4 12 7.8 12 7.8zm0 0h3.4a2.2 2.2 0 100-4.4C13.2 3.4 12 7.8 12 7.8z"/></svg>{%- endcapture -%}

{%- liquid
  assign has_gallery = false
  if s.show_gallery and p.media.size > 0
    assign has_gallery = true
  endif
-%}

<section class="frn" id="frn-{{ section.id }}" data-frn {{ section.shopify_attributes }}>
  <div class="frn__wrap{% unless has_gallery %} frn__wrap--nogallery{% endunless %}">
    {%- comment -%} ---------- Galerie ---------- {%- endcomment -%}
    {%- if has_gallery -%}
      <div class="frn__gallery{% if s.gallery_bleed %} frn__gallery--bord{% endif %}">
        <div class="frn__stage">
          <div class="frn__slides" data-frn-slides>
            {%- for media in p.media -%}
              <div class="frn__slide" data-frn-slide="{{ forloop.index0 }}">
                {%- comment -%}
                  La première image est presque toujours le plus grand élément
                  affiché d'emblée : elle part tout de suite et en priorité,
                  les suivantes attendent d'approcher de l'écran.
                {%- endcomment -%}
                {%- if forloop.first -%}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1400',
                      sizes: '(min-width: 990px) 52vw, 96vw',
                      loading: 'eager',
                      fetchpriority: 'high',
                      alt: media.alt
                  }}
                {%- else -%}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1400',
                      sizes: '(min-width: 990px) 52vw, 96vw',
                      loading: 'lazy',
                      alt: media.alt
                  }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if s.show_arrows -%}
            <button class="frn__arrow frn__arrow--prev" type="button" data-frn-prev aria-label="{{ s.prev_label | escape }}">{{ ico_prev }}</button>
            <button class="frn__arrow frn__arrow--next" type="button" data-frn-next aria-label="{{ s.next_label | escape }}">{{ ico_next }}</button>
          {%- endif -%}
        </div>

        {%- if s.show_thumbs -%}
          <div class="frn__thumbs" data-frn-thumbs>
            {%- for media in p.media -%}
              <button
                class="frn__thumb"
                type="button"
                data-frn-thumb="{{ forloop.index0 }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 240 | image_tag: widths: '80, 160, 240', loading: 'lazy', alt: '' }}
                {%- if media.media_type != 'image' -%}
                  <span class="frn__play" aria-hidden="true">{{ ico_play }}</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="frn__col">
      {%- if s.show_award and s.award_text != blank -%}
        {%- liquid
          case s.award_icon
            when 'laurier'
              assign aw_icon = ico_laurel
            when 'medaille'
              assign aw_icon = ico_medal
            when 'etoile'
              assign aw_icon = ico_star_line
            when 'couronne'
              assign aw_icon = ico_crown
            else
              assign aw_icon = ''
          endcase
        -%}
        <p class="frn__award frn__award--{{ s.award_style }}">
          {%- comment -%}
            Une image vaut mieux qu'un drapeau en émoji : Windows ne sait pas
            les dessiner et affiche « FR » à la place.
          {%- endcomment -%}
          {%- if s.award_image != blank -%}
            <span class="frn__award-ico">
              {{ s.award_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            </span>
          {%- elsif aw_icon != blank -%}
            <span class="frn__award-ico" aria-hidden="true">{{ aw_icon }}</span>
          {%- endif -%}
          <span>{{ s.award_text }}</span>
        </p>
      {%- endif -%}

      {%- if s.show_title -%}
        <h1 class="frn__title">{{ s.titre | default: p.title }}</h1>
      {%- endif -%}

      {%- if s.show_rating -%}
        <div class="frn__rating">
          <span class="frn__stars" aria-hidden="true">
            {%- for i in (1..5) -%}{{ ico_star }}{%- endfor -%}
          </span>
          <span>{{ s.rating_text }}</span>
        </div>
      {%- endif -%}

      {%- if s.show_price -%}
        <div class="frn__pricerow">
          <span class="frn__price" data-frn-price>{{ v.price | money }}</span>
          <s class="frn__was" data-frn-was {% unless v.compare_at_price > v.price %}hidden{% endunless %}>
            {{- v.compare_at_price | money -}}
          </s>
          {%- if s.tag_text != blank -%}
            <span class="frn__tag">{{ s.tag_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Garanties ---------- {%- endcomment -%}
      {%- if s.show_trust and garanties.size > 0 -%}
        <div class="frn__trust">
          {%- for block in garanties -%}
            {%- liquid
              assign g = block.settings
              case g.icone
                when 'shield'
                  assign svg = ico_shield
                when 'target'
                  assign svg = ico_target
                when 'infinity'
                  assign svg = ico_infinity
                when 'leaf'
                  assign svg = ico_leaf
                when 'flame'
                  assign svg = ico_flame
                when 'gift'
                  assign svg = ico_gift
                else
                  assign svg = ''
              endcase
            -%}
            <div class="frn__trust-item" {{ block.shopify_attributes }}>
              <span class="frn__trust-ico">
                {%- if g.image != blank -%}
                  {{ g.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                {%- elsif g.emoji != blank -%}
                  {{ g.emoji }}
                {%- elsif svg != blank -%}
                  {{ svg }}
                {%- endif -%}
              </span>
              {%- if g.texte != blank -%}
                <span class="frn__trust-txt">{{ g.texte }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Guide et tailles ---------- {%- endcomment -%}
      {%- if s.show_guide and s.guide_text != blank -%}
        {%- liquid
          comment
            Le réglage « page » rend un objet page ; les thèmes plus anciens
            rendaient son identifiant. Les deux sont acceptés pour qu'une
            configuration reprise d'un autre thème continue de pointer juste.
          endcomment
          assign guide_url = s.guide_url
          if guide_url == blank and s.guide_page != blank
            if s.guide_page.url != blank
              assign guide_url = s.guide_page.url
            else
              assign guide_url = pages[s.guide_page].url
            endif
          endif
        -%}
        <a class="frn__guide" href="{{ guide_url | default: '#' }}">{{ s.guide_text }}</a>
      {%- endif -%}

      {%- if s.show_sizes and tailles.size > 0 -%}
        <div class="frn__ideal-wrap">
          <div class="frn__sizes" role="group" aria-label="{{ s.sizes_label | escape }}" data-frn-sizes>
            {%- comment -%}
              Le fond glissant. Il est posé avant les boutons pour rester
              dessous sans avoir à empiler les z-index.
            {%- endcomment -%}
            <span class="frn__size-glide" data-frn-glide aria-hidden="true"></span>
            {%- for block in tailles -%}
              {%- liquid
                assign t = block.settings

                comment
                  La déclinaison est retrouvée ici, pas dans le script : la
                  comparaison se fait sans tenir compte de la casse ni des
                  espaces, si bien que « 20 cm », « 20cm » et « 20CM »
                  désignent la même chose. Le bouton porte ensuite
                  l'identifiant trouvé, et le script n'a plus rien à deviner.
                endcomment
                assign key = t.valeur | strip | downcase | replace: ' ', ''
                assign match_id = 0
                assign match_ok = false
                for variant in p.variants
                  assign vkey = variant.options[option_index] | strip | downcase | replace: ' ', ''
                  if vkey == key and match_id == 0
                    assign match_id = variant.id
                    assign match_ok = variant.available
                  endif
                endfor

                assign chosen = false
                if match_id != 0 and v.id == match_id
                  assign chosen = true
                endif
              -%}
              <button
                class="frn__size{% if match_id != 0 and match_ok == false %} frn__size--out{% endif %}"
                type="button"
                data-frn-size="{{ t.valeur | escape }}"
                data-frn-variant="{{ match_id }}"
                data-frn-ideal="{{ t.badge | escape }}"
                aria-pressed="{% if chosen %}true{% else %}false{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="frn__size-v">{{ t.valeur }}</span>
                {%- if t.sous_titre != blank -%}
                  <span class="frn__size-s">{{ t.sous_titre }}</span>
                {%- endif -%}
              </button>

              {%- comment -%}
                Aucune déclinaison ne porte cette valeur : le bouton reste
                cliquable, mais le marchand doit le savoir. Le message ne
                paraît que dans l'éditeur de thème.
              {%- endcomment -%}
              {%- if match_id == 0 and request.design_mode -%}
                {%- assign size_warning = true -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- comment -%}
            La pastille est positionnée par le script au-dessus du bouton qui
            la porte : sa place dépend du nombre de tailles, que le marchand
            peut changer.
          {%- endcomment -%}
          <span class="frn__ideal" data-frn-ideal-badge hidden></span>
        </div>

        {%- if size_warning -%}
          <p class="frn__warn">{{ s.sizes_warning }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} ---------- Composeur de set ---------- {%- endcomment -%}
      {%- if s.show_set and articles.size > 0 -%}
        <div
          class="frn__set"
          data-frn-set
          data-frn-tier2="{{ s.tier2_pct }}"
          data-frn-tier3="{{ s.tier3_pct }}"
          data-frn-pill="{{ s.set_pill | escape }}"
        >
          <div class="frn__set-head">
            {%- if s.set_title != blank -%}
              <p class="frn__set-title">{{ s.set_title }}</p>
            {%- endif -%}
            <span class="frn__set-pill" data-frn-pill-out>{{ s.set_pill }}</span>
          </div>

          {%- if s.show_steps -%}
            <div class="frn__steps">
              <div class="frn__bars">
                <span class="frn__bar"><i data-frn-bar="1"></i></span>
                <span class="frn__bar"><i data-frn-bar="2"></i></span>
              </div>
              <div class="frn__steps-lab">
                <span>{{ s.tier2_label }}</span>
                <span>{{ s.tier3_label }}</span>
              </div>
            </div>
          {%- endif -%}

          <div class="frn__items">
            {%- for block in articles -%}
              {%- liquid
                assign a = block.settings
                assign a_prod = a.produit
                assign a_var = a_prod.selected_or_first_available_variant

                comment
                  Le produit choisi fournit tout : nom, visuel, prix et prix
                  barré. Les trois champs de texte ne servent qu'à passer
                  outre, au cas par cas.
                endcomment
                assign a_name = a.titre
                if a_name == blank and a_prod != blank
                  assign a_name = a_prod.title
                endif

                assign a_img = a.image
                if a_img == blank and a_prod != blank
                  assign a_img = a_prod.featured_image
                endif

                comment
                  Les deux prix viennent de la fiche Shopify, et de nulle part
                  ailleurs : le thème ne les calcule pas et ne permet pas de
                  les réécrire. Un montant affiché ici qui ne serait pas celui
                  de la base finirait tôt ou tard par contredire le panier.
                endcomment
                assign a_cents = 0
                assign a_was = 0
                if a_var != blank
                  assign a_cents = a_var.price
                  if a_var.compare_at_price > a_var.price
                    assign a_was = a_var.compare_at_price
                  endif
                endif

                comment
                  Un article n'entre au panier que s'il a une déclinaison
                  disponible. Trois états, et il faut les distinguer : sans
                  eux, une carte grisée ne dit pas si le marchand a oublié le
                  produit ou si le stock est à zéro.
                endcomment
                assign a_vid = 0
                assign a_etat = 'vide'
                if a_var != blank
                  assign a_vid = a_var.id
                  if a_var.available
                    assign a_etat = 'ok'
                  else
                    assign a_etat = 'rupture'
                  endif
                endif

                assign a_ok = false
                if a_etat == 'ok'
                  assign a_ok = true
                endif

                assign a_raison = s.set_no_product
                if a_etat == 'rupture'
                  assign a_raison = s.set_sold_out
                endif

                assign a_on = a.coche
                unless a_ok
                  assign a_on = false
                endunless

                comment
                  Dans l'éditeur, un article sans produit se nomme lui-même :
                  une carte vide n'apprendrait rien au marchand.
                endcomment
                if a_name == blank and a_prod == blank and request.design_mode
                  assign a_name = s.set_no_product
                endif
              -%}

              {%- comment -%}
                En rupture, le marchand peut préférer masquer l'article plutôt
                que de montrer une carte morte.
              {%- endcomment -%}
              {%- unless a_etat == 'rupture' and s.set_hide_sold_out -%}
              <button
                class="frn__item frn__item--{{ a_etat }}"
                type="button"
                data-frn-item
                data-frn-etat="{{ a_etat }}"
                data-frn-variant="{{ a_vid }}"
                data-frn-base="{{ a_cents }}"
                data-frn-list="{{ a_was }}"
                aria-pressed="{% if a_on %}true{% else %}false{% endif %}"
                {% unless a_ok %}disabled title="{{ a_raison | escape }}"{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if a_img != blank -%}
                  <span class="frn__item-img">
                    {{ a_img | image_url: width: 200 | image_tag: widths: '80, 140, 200', loading: 'lazy', alt: '' }}
                  </span>
                {%- endif -%}
                <span class="frn__item-txt">
                  {%- if a_name != blank -%}<span class="frn__item-name">{{ a_name }}</span>{%- endif -%}
                  {%- if a_etat == 'rupture' -%}
                    {%- comment -%}
                      Une carte grisée sans explication ressemble à une panne.
                      Elle dit donc pourquoi elle ne répond pas.
                    {%- endcomment -%}
                    <span class="frn__item-out">{{ s.set_sold_out }}</span>
                  {%- endif -%}
                  {%- if a_cents > 0 -%}
                    <span class="frn__item-price" data-frn-item-price>{{ a_cents | money }}</span>
                    <span class="frn__item-was" data-frn-item-was {% unless a_was > 0 %}hidden{% endunless %}>
                      {{- a_was | money -}}
                    </span>
                  {%- endif -%}
                </span>
                {%- if a_ok -%}
                  <span class="frn__item-mark" aria-hidden="true">
                    <span data-frn-mark-on {% unless a_on %}hidden{% endunless %}>{{ ico_check }}</span>
                    <span data-frn-mark-off {% if a_on %}hidden{% endif %}>{{ ico_plus }}</span>
                  </span>
                {%- endif -%}
              </button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Achat ---------- {%- endcomment -%}
      {%- if s.show_buy -%}
        <button
          class="frn__buy"
          type="button"
          data-frn-buy
          {% unless v.available %}disabled{% endunless %}
        >
          {%- if s.buy_lock -%}{{ ico_lock }}{%- endif -%}
          <span class="frn__buy-check" data-frn-buy-check aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12.6l4.6 4.6L19 7.2"/></svg>
          </span>
          <span data-frn-buy-label>{% if v.available %}{{ s.buy_label }}{% else %}{{ s.sold_out_label }}{% endif %}</span>
          {%- if s.buy_prices -%}
            <span class="frn__buy-money">
              <span class="frn__buy-sep" aria-hidden="true">·</span>
              <s class="frn__buy-was" data-frn-buy-was hidden></s>
              <span data-frn-buy-total></span>
            </span>
          {%- endif -%}
        </button>

        {%- if s.show_urgent and s.urgent_text != blank -%}
          <p class="frn__urgent"><span class="frn__dot" aria-hidden="true"></span>{{ s.urgent_text }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        ---------- Cadeaux et vidéos clientes ----------
        Ces deux-là se suivent dans l'ordre de l'éditeur, et non par type :
        glisser le carrousel vidéo entre deux cadeaux doit se voir.

        Les vidéos qui se suivent forment une seule rangée. On regarde donc
        le bloc d'avant et celui d'après pour savoir s'il faut ouvrir ou
        refermer la rangée — plutôt que de porter un drapeau d'un tour de
        boucle à l'autre, qui se lit mal.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign prev_type = ''
          if forloop.index0 > 0
            assign pi = forloop.index0 | minus: 1
            assign prev_type = section.blocks[pi].type
          endif

          assign next_type = ''
          unless forloop.last
            assign ni = forloop.index0 | plus: 1
            assign next_type = section.blocks[ni].type
          endunless
        -%}

        {%- if block.type == 'cadeau' and s.show_gifts -%}
          {%- assign c = block.settings -%}
          <div
            class="frn__gift frn__gift--{{ c.cote | default: 'droite' }}{% if c.debord %} frn__gift--debord{% endif %}"
            {%- comment -%}
              La taille du visuel se règle carte par carte. À zéro, la carte
              ne redéfinit rien et suit le curseur de la section.
            {%- endcomment -%}
            {% if c.taille_image > 0 %}style="--frn-gift-size: {{ c.taille_image }}px;"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="frn__gift-txt">
              <span class="frn__gift-name">
                <span class="frn__gift-label">{{ c.titre }}</span>
                {%- if c.pastille != blank -%}<span class="frn__offert">{{ c.pastille }}</span>{%- endif -%}
              </span>
              {%- if c.texte != blank -%}<span class="frn__gift-sub">{{ c.texte }}</span>{%- endif -%}
            </span>
            {%- if c.image != blank -%}
              <span class="frn__gift-img frn__gift-img--{{ c.forme | default: 'rond' }}">
                {{ c.image | image_url: width: 300 | image_tag: widths: '120, 200, 300', loading: 'lazy', alt: '' }}
              </span>
            {%- endif -%}
          </div>

        {%- elsif block.type == 'ugc' and s.show_ugc -%}
          {%- if prev_type != 'ugc' -%}<div class="frn__ugc" data-frn-ugc>{%- endif -%}
          {%- liquid
            assign u = block.settings
            assign src = ''
            assign kind = ''
            if u.video != blank
              assign kind = 'file'
            elsif u.video_url != blank
              assign kind = u.video_url.type
              assign src = u.video_url.id
            endif
          -%}
          <button
            class="frn__ugc-item"
            type="button"
            data-frn-ugc-item
            data-frn-kind="{{ kind }}"
            data-frn-src="{{ src }}"
            aria-label="{{ u.titre | default: s.ugc_label | escape }}"
            {{ block.shopify_attributes }}
          >
            {%- if u.image != blank -%}
              {{ u.image | image_url: width: 400 | image_tag: widths: '120, 240, 400', loading: 'lazy', alt: '' }}
            {%- elsif u.video != blank -%}
              {{ u.video.preview_image | image_url: width: 400 | image_tag: widths: '120, 240, 400', loading: 'lazy', alt: '' }}
            {%- endif -%}
            <span class="frn__play" aria-hidden="true">{{ ico_play }}</span>
            {%- if u.video != blank -%}
              {%- comment -%}
                La vidéo hébergée est rendue ici, masquée, puis déplacée dans
                le lecteur à l'ouverture : Shopify ne sait la produire qu'en
                Liquid, pas depuis le script.
              {%- endcomment -%}
              <template data-frn-video>
                {{ u.video | video_tag: image_size: '800x', controls: true, playsinline: true }}
              </template>
            {%- endif -%}
          </button>
          {%- if next_type != 'ugc' -%}</div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%}
        Un seul lecteur pour toutes les rangées : il est vide tant qu'on n'a
        pas cliqué, et se remplit de la vidéo demandée.
      {%- endcomment -%}
      {%- if s.show_ugc and videos.size > 0 -%}
        <div class="frn__player" data-frn-player hidden>
          <div class="frn__player-box" data-frn-player-box></div>
          <button class="frn__player-close" type="button" data-frn-player-close aria-label="{{ s.close_label | escape }}">&times;</button>
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-frn-config>
    {
      "variants": {{ p.variants | json }},
      "optionIndex": {{ option_index | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "afterAdd": {{ s.after_add | json }},
      "animPrices": {{ s.anim_prices | json }},
      "animSpeed": {{ s.anim_speed | json }},
      "confirmHold": {{ s.confirm_hold | json }},
      "buyWasCompare": {{ s.buy_was_compare | json }},
      "tierOnTotal": {{ s.tier_on_total | json }},
      "setPriceHighlight": {{ s.set_price_highlight | json }},
      "sizeProperty": {{ s.sizes_property | json }},
      "buyLabel": {{ s.buy_label | json }},
      "soldOutLabel": {{ s.sold_out_label | json }},
      "addedLabel": {{ s.added_label | json }},
      "errorLabel": {{ s.error_label | json }}
    }
  </script>
</section>

<script>
  (function () {
    var root = document.getElementById('frn-{{ section.id }}');
    if (!root || root.dataset.frnReady === '1') return;
    root.dataset.frnReady = '1';

    var cfg = {};
    try {
      cfg = JSON.parse(root.querySelector('[data-frn-config]').textContent);
    } catch (e) {
      return;
    }

    function money(cents) {
      var n = (Number(cents || 0) / 100).toFixed(2);
      var withComma = n.replace('.', ',');
      /* Le format de la boutique est repris tel quel : virgule décimale et
         séparateur de milliers compris. Sans lui — une boutique mal réglée —
         on écrit le montant à la française plutôt que de ne rien afficher. */
      var fmt = cfg.moneyFormat;
      if (!fmt) return withComma + ' €';
      return fmt
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, withComma)
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, String(Math.round(cents / 100)))
        .replace(/\{\{\s*amount\s*\}\}/g, n)
        .replace(/<[^>]*>/g, '')
        .trim();
    }

    /* ---------------------------------------------------------------- *
     * Galerie
     * ---------------------------------------------------------------- */

    var slides = root.querySelector('[data-frn-slides]');
    var thumbs = [].slice.call(root.querySelectorAll('[data-frn-thumb]'));

    function goTo(i) {
      if (!slides) return;
      var slide = slides.children[i];
      if (!slide) return;
      slides.scrollTo({ left: slide.offsetLeft - slides.offsetLeft, behavior: 'smooth' });
    }

    function markThumb(i) {
      for (var k = 0; k < thumbs.length; k++) {
        thumbs[k].setAttribute('aria-current', k === i ? 'true' : 'false');
      }
    }

    thumbs.forEach(function (btn, i) {
      btn.addEventListener('click', function () {
        goTo(i);
        markThumb(i);
      });
    });

    if (slides) {
      var waiting = false;
      slides.addEventListener('scroll', function () {
        if (waiting) return;
        waiting = true;
        window.requestAnimationFrame(function () {
          waiting = false;
          var i = Math.round(slides.scrollLeft / slides.clientWidth);
          markThumb(i);
        });
      }, { passive: true });
    }

    var prev = root.querySelector('[data-frn-prev]');
    var next = root.querySelector('[data-frn-next]');
    function step(dir) {
      if (!slides) return;
      var i = Math.round(slides.scrollLeft / slides.clientWidth) + dir;
      if (i < 0) i = slides.children.length - 1;
      if (i >= slides.children.length) i = 0;
      goTo(i);
      markThumb(i);
    }
    if (prev) prev.addEventListener('click', function () { step(-1); });
    if (next) next.addEventListener('click', function () { step(1); });

    /* ---------------------------------------------------------------- *
     * Tailles
     * ---------------------------------------------------------------- */

    var sizeBtns = [].slice.call(root.querySelectorAll('[data-frn-size]'));
    var badge = root.querySelector('[data-frn-ideal-badge]');
    var sizesBox = root.querySelector('[data-frn-sizes]');
    var glide = root.querySelector('[data-frn-glide]');
    var current = null;

    /* Qui a demandé moins d'animation n'en aura aucune : ni glissement, ni
       défilement de chiffres, ni coche qui se dessine. */
    var calme =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /**
     * Le fond vert, posé sur la case retenue. Il ne glisse qu'une fois en
     * place : au premier passage il se contente d'apparaître, sans traverser
     * le sélecteur depuis la gauche.
     */
    function placeGlide() {
      if (!glide || !sizesBox) return;
      var host = sizeBtns.filter(function (b) {
        return b.getAttribute('aria-pressed') === 'true';
      })[0];
      if (!host) {
        glide.style.width = '0px';
        return;
      }
      glide.style.width = host.offsetWidth + 'px';
      glide.style.transform = 'translateX(' + host.offsetLeft + 'px)';
      if (!sizesBox.classList.contains('is-ready')) {
        /* Deux images plus tard, la position est acquise : la transition peut
           alors être armée sans produire de trajet au chargement. */
        window.requestAnimationFrame(function () {
          window.requestAnimationFrame(function () {
            sizesBox.classList.add('is-ready');
          });
        });
      }
    }

    /* La taille retenue, et si elle correspond bien à une déclinaison. Sans
       déclinaison, le choix part quand même au panier, en mention de ligne :
       la commande dit alors ce que le client a demandé. */
    var chosenSize = '';
    var sizeHasVariant = true;

    function variantById(id) {
      var list = cfg.variants || [];
      for (var i = 0; i < list.length; i++) {
        if (Number(list[i].id) === Number(id)) return list[i];
      }
      return null;
    }

    function placeBadge() {
      if (!badge) return;
      /* La première taille qui porte une pastille l'emporte : si le marchand
         en remplit deux, une seule s'affiche plutôt que deux superposées. */
      var host = null;
      for (var i = 0; i < sizeBtns.length; i++) {
        if ((sizeBtns[i].getAttribute('data-frn-ideal') || '').trim()) {
          host = sizeBtns[i];
          break;
        }
      }
      if (!host) {
        badge.hidden = true;
        return;
      }
      badge.textContent = host.getAttribute('data-frn-ideal');
      badge.hidden = false;
      /* Centrée sur son bouton : la position se recalcule, car le nombre de
         tailles est à la main du marchand. */
      badge.style.left = host.offsetLeft + host.offsetWidth / 2 + 'px';
    }

    /**
     * Écrit un montant dans un élément, en faisant défiler les chiffres
     * depuis celui qu'il affichait. Le premier passage se pose directement :
     * un compteur qui part de zéro au chargement n'annonce rien.
     */
    function setMoney(el, cents) {
      if (!el) return;
      var to = Math.round(Number(cents) || 0);
      var from = el.hasAttribute('data-frn-cents')
        ? Number(el.getAttribute('data-frn-cents'))
        : null;
      el.setAttribute('data-frn-cents', to);

      if (!cfg.animPrices || calme || from === null || from === to) {
        el.textContent = money(to);
        return;
      }

      window.cancelAnimationFrame(Number(el.getAttribute('data-frn-raf')) || 0);
      var start = 0;
      var dur = cfg.animSpeed || 340;

      function frame(now) {
        if (!start) start = now;
        var t = Math.min(1, (now - start) / dur);
        /* Sortie cubique : le défilement part vite et se pose doucement sur
           le montant exact. */
        var e = 1 - Math.pow(1 - t, 3);
        el.textContent = money(Math.round(from + (to - from) * e));
        if (t < 1) {
          el.setAttribute('data-frn-raf', window.requestAnimationFrame(frame));
        } else {
          el.textContent = money(to);
          /* L'attribut disparaît en même temps que le défilement : qui
             regarde la page sait ainsi quand le montant est définitif. */
          el.removeAttribute('data-frn-raf');
        }
      }

      el.setAttribute('data-frn-raf', window.requestAnimationFrame(frame));
    }

    function paintVariant() {
      if (!current) return;
      var priceEl = root.querySelector('[data-frn-price]');
      var wasEl = root.querySelector('[data-frn-was]');
      setMoney(priceEl, current.price);
      if (wasEl) {
        var hasWas = current.compare_at_price && current.compare_at_price > current.price;
        wasEl.hidden = !hasWas;
        if (hasWas) setMoney(wasEl, current.compare_at_price);
      }
      var buy = root.querySelector('[data-frn-buy]');
      var label = root.querySelector('[data-frn-buy-label]');
      if (buy) buy.disabled = !current.available;
      if (label) label.textContent = current.available ? cfg.buyLabel : cfg.soldOutLabel;
    }

    /**
     * Retenir une taille.
     *
     * Le marquage est appliqué d'abord, et sans condition : un bouton qui ne
     * trouve pas sa déclinaison doit quand même répondre au clic. Il ne
     * répondait pas, et le sélecteur paraissait mort dès que les valeurs
     * saisies ne tombaient pas exactement sur celles du produit.
     */
    function selectSize(btn) {
      if (!btn) return;
      sizeBtns.forEach(function (b) {
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });

      chosenSize = btn.getAttribute('data-frn-size') || '';
      var found = variantById(btn.getAttribute('data-frn-variant'));
      sizeHasVariant = !!found;
      if (found) current = found;

      placeGlide();
      paintVariant();
      paintTotals();
    }

    sizeBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        selectSize(b);
      });
    });

    /* État de départ : la taille déjà marquée, sinon la première. */
    var start = sizeBtns.filter(function (b) {
      return b.getAttribute('aria-pressed') === 'true';
    })[0] || sizeBtns[0];
    if (start) {
      chosenSize = start.getAttribute('data-frn-size') || '';
      var startVariant = variantById(start.getAttribute('data-frn-variant'));
      sizeHasVariant = !!startVariant;
      if (startVariant) current = startVariant;
      start.setAttribute('aria-pressed', 'true');
    }
    if (!current) current = (cfg.variants || [])[0] || null;

    placeBadge();
    placeGlide();
    window.addEventListener('resize', function () {
      placeBadge();
      placeGlide();
    });

    /* ---------------------------------------------------------------- *
     * Composeur de set
     * ---------------------------------------------------------------- */

    var setBox = root.querySelector('[data-frn-set]');
    var items = [].slice.call(root.querySelectorAll('[data-frn-item]'));

    function selected() {
      return items.filter(function (b) {
        return b.getAttribute('aria-pressed') === 'true';
      });
    }

    function tierPct(count) {
      if (!setBox) return 0;
      var t2 = parseFloat(setBox.getAttribute('data-frn-tier2')) || 0;
      var t3 = parseFloat(setBox.getAttribute('data-frn-tier3')) || 0;
      if (count >= 3) return t3;
      if (count >= 2) return t2;
      return 0;
    }

    function paintTotals() {
      var picked = selected();
      // Le produit principal compte pour une pièce.
      var count = 1 + picked.length;
      var pct = tierPct(count);

      /* Deux sommes, toutes deux faites de prix venus de Shopify.
         `full` additionne les prix de vente : c'est ce que le panier
         contiendra réellement.
         `barre` additionne les prix barrés, en retombant sur le prix de
         vente pour ce qui n'en a pas. */
      var full = current ? current.price : 0;
      var barre = current ? Math.max(current.price, current.compare_at_price || 0) : 0;
      if (!cfg.buyWasCompare) barre = full;

      picked.forEach(function (b) {
        var base = Number(b.getAttribute('data-frn-base')) || 0;
        var list = Number(b.getAttribute('data-frn-list')) || 0;
        /* Le prix de vente paie, le tarif de référence se barre. */
        full += base;
        barre += list > base ? list : base;
      });

      /* Le palier n'est retranché du total que si le marchand a créé la
         remise automatique correspondante dans Shopify. Un thème ne peut pas
         la créer : sans elle, retrancher ici annoncerait un montant que le
         panier ne tiendrait pas. */
      var total = cfg.tierOnTotal ? Math.round(full * (1 - pct / 100)) : full;

      var totalEl = root.querySelector('[data-frn-buy-total]');
      var wasEl = root.querySelector('[data-frn-buy-was]');
      setMoney(totalEl, total);
      if (wasEl) {
        wasEl.hidden = total >= barre;
        if (total < barre) setMoney(wasEl, barre);
      }

      // Les deux segments se remplissent l'un après l'autre.
      var b1 = root.querySelector('[data-frn-bar="1"]');
      var b2 = root.querySelector('[data-frn-bar="2"]');
      if (b1) b1.style.width = count >= 2 ? '100%' : '0%';
      if (b2) b2.style.width = count >= 3 ? '100%' : '0%';

      var pill = root.querySelector('[data-frn-pill-out]');
      if (pill && setBox) {
        var base = setBox.getAttribute('data-frn-pill') || '';
        pill.textContent = base.replace('[x]', String(pct));
        pill.hidden = pct <= 0;
      }

      paintItemPrices(count);
    }

    /**
     * Le prix de chaque article du set.
     *
     * Par défaut il n'y a rien à faire : Liquid a déjà écrit le prix et le
     * prix barré de la fiche Shopify, et ils ne doivent pas bouger.
     *
     * Quand le marchand déclare avoir créé la remise automatique, le palier
     * est montré ici aussi : un article retenu au palier atteint, un article
     * encore libre au palier qu'il ferait atteindre — l'argument de l'offre.
     */
    function paintItemPrices(count) {
      if (!cfg.tierOnTotal) return;

      items.forEach(function (b) {
        var priceEl = b.querySelector('[data-frn-item-price]');
        var base = Number(b.getAttribute('data-frn-base')) || 0;
        if (!priceEl || base <= 0) return;

        /* Le palier s'applique au prix de vente, jamais au tarif barré :
           c'est bien ce prix-là que le client paiera. */
        var on = b.getAttribute('aria-pressed') === 'true';
        var pct = tierPct(on ? count : count + 1);
        var price = Math.round(base * (1 - pct / 100));
        setMoney(priceEl, price);

        /* Le barré est le plus élevé du tarif de référence et du prix de
           vente : un produit sans prix barré en gagne un dès qu'un palier
           mord, puisqu'il descend alors sous son propre prix. */
        var list = Number(b.getAttribute('data-frn-list')) || 0;
        var haut = list > base ? list : base;
        var wasEl = b.querySelector('[data-frn-item-was]');
        if (wasEl) {
          wasEl.textContent = money(haut);
          wasEl.hidden = price >= haut;
        }

        /* La mise en avant ne vaut que pour ce qui n'est pas encore pris, et
           seulement si l'ajouter améliore vraiment le prix. */
        b.classList.toggle('frn__item--promo', cfg.setPriceHighlight && !on && pct > tierPct(count));
      });
    }

    items.forEach(function (b) {
      b.addEventListener('click', function () {
        var on = b.getAttribute('aria-pressed') === 'true';
        b.setAttribute('aria-pressed', on ? 'false' : 'true');
        var mOn = b.querySelector('[data-frn-mark-on]');
        var mOff = b.querySelector('[data-frn-mark-off]');
        if (mOn) mOn.hidden = on;
        if (mOff) mOff.hidden = !on;
        paintTotals();
      });
    });

    paintVariant();
    paintTotals();

    /* ---------------------------------------------------------------- *
     * Ajout au panier
     * ---------------------------------------------------------------- */

    var buy = root.querySelector('[data-frn-buy]');

    if (buy) {
      buy.addEventListener('click', function () {
        if (!current || buy.disabled) return;
        var label = root.querySelector('[data-frn-buy-label]');
        var before = label ? label.textContent : '';

        /* Une ligne par variante, les quantités agrégées : Shopify ne retient
           qu'une seule ligne quand le même identifiant revient deux fois. */
        var byVariant = {};
        var order = [];
        function add(id) {
          if (!id) return;
          if (byVariant[id] === undefined) {
            byVariant[id] = 0;
            order.push(id);
          }
          byVariant[id] += 1;
        }
        add(current.id);
        selected().forEach(function (b) {
          add(Number(b.getAttribute('data-frn-variant')));
        });

        var payload = order.map(function (id) {
          return { id: Number(id), quantity: byVariant[id] };
        });

        /* Une taille choisie sans déclinaison correspondante partirait dans
           le vide : elle voyage alors en mention de ligne sur le produit
           principal, pour que la commande dise ce qui a été demandé. */
        if (!sizeHasVariant && chosenSize && cfg.sizeProperty && payload.length) {
          payload[0].properties = {};
          payload[0].properties[cfg.sizeProperty] = chosenSize;
        }

        buy.disabled = true;
        window
          .fetch(cfg.cartAddUrl + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: payload })
          })
          .then(function (res) {
            if (!res.ok) throw new Error('cart');
            return res.json();
          })
          .then(function () {
            document.dispatchEvent(new CustomEvent('frn:cart-added', { bubbles: true }));
            confirm();

            if (cfg.afterAdd === 'cart') {
              window.location.href = cfg.cartUrl;
              return;
            }
            if (cfg.afterAdd === 'checkout') {
              window.location.href = '/checkout';
              return;
            }
            if (cfg.afterAdd === 'drawer') {
              /* Le tiroir du thème, quel qu'il soit. Deux passes : le premier
                 élément trouvé n'est pas toujours celui qui sait s'ouvrir. */
              var passes = ['[data-cart-drawer]', 'cart-drawer, #cart-drawer, .cart-drawer, cart-notification'];
              for (var i = 0; i < passes.length; i++) {
                var found = document.querySelectorAll(passes[i]);
                for (var j = 0; j < found.length; j++) {
                  if (typeof found[j].open === 'function') {
                    found[j].open();
                    /* Le tiroir recouvre la page, mais le bouton reste là
                       dessous : il garde sa confirmation le temps voulu
                       plutôt que de la perdre dans l'image suivante. */
                    window.setTimeout(reset, cfg.confirmHold || 1600);
                    return;
                  }
                }
              }
              window.location.href = cfg.cartUrl;
              return;
            }
            /* On reste sur la page : la confirmation a le temps d'être vue
               avant que le bouton ne reprenne son libellé. */
            window.setTimeout(reset, cfg.confirmHold || 1600);
          })
          .catch(function () {
            if (label) label.textContent = cfg.errorLabel;
            window.setTimeout(reset, 2200);
          });

        /** La coche se dessine, les prix s'effacent, le libellé confirme. */
        function confirm() {
          buy.classList.add('is-added');
          if (label) label.textContent = cfg.addedLabel;
        }

        function reset() {
          buy.classList.remove('is-added');
          buy.disabled = false;
          if (label) label.textContent = before;
        }
      });
    }

    /* ---------------------------------------------------------------- *
     * Lecteur de vidéos clientes
     * ---------------------------------------------------------------- */

    var player = root.querySelector('[data-frn-player]');
    var box = root.querySelector('[data-frn-player-box]');

    function closePlayer() {
      if (!player || !box) return;
      player.hidden = true;
      // Vider la boîte arrête la lecture, iframe comprise.
      box.textContent = '';
    }

    function openPlayer(btn) {
      if (!player || !box) return;
      var kind = btn.getAttribute('data-frn-kind');
      var src = btn.getAttribute('data-frn-src');
      box.textContent = '';

      if (kind === 'file') {
        var tpl = btn.querySelector('[data-frn-video]');
        if (!tpl) return;
        box.appendChild(tpl.content.cloneNode(true));
        var vid = box.querySelector('video');
        if (vid) {
          vid.setAttribute('controls', '');
          vid.play().catch(function () {});
        }
      } else if (kind === 'youtube' || kind === 'vimeo') {
        var frame = document.createElement('iframe');
        frame.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        frame.setAttribute('allowfullscreen', '');
        frame.src =
          kind === 'youtube'
            ? 'https://www.youtube.com/embed/' + encodeURIComponent(src) + '?autoplay=1&playsinline=1'
            : 'https://player.vimeo.com/video/' + encodeURIComponent(src) + '?autoplay=1';
        box.appendChild(frame);
      } else {
        return;
      }

      player.hidden = false;
    }

    [].slice.call(root.querySelectorAll('[data-frn-ugc-item]')).forEach(function (btn) {
      btn.addEventListener('click', function () {
        openPlayer(btn);
      });
    });

    var closeBtn = root.querySelector('[data-frn-player-close]');
    if (closeBtn) closeBtn.addEventListener('click', closePlayer);
    if (player) {
      player.addEventListener('click', function (e) {
        if (e.target === player) closePlayer();
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePlayer();
    });
  })();
</script>

