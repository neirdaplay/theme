{%- capture pn_book -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4.4h5.2A2.8 2.8 0 0112 7.2v12.4a2.2 2.2 0 00-2.2-2.2H4zM20 4.4h-5.2A2.8 2.8 0 0012 7.2v12.4a2.2 2.2 0 012.2-2.2H20z"/></svg>{%- endcapture -%}
{%- capture pn_card -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.8" y="5.4" width="18.4" height="13.2" rx="2.2"/><path d="M2.8 10h18.4M6.4 14.6h3.4"/></svg>{%- endcapture -%}
{%- capture pn_spoon -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.2 13.4L4.6 20.4M13.6 3.4c2.4 0 4 2 4 4.4s-1.8 4.6-4 4.6-4-2-4-4.6 1.6-4.4 4-4.4z"/><path d="M11.8 12.2l-2.6 2.6"/></svg>{%- endcapture -%}
{%- capture pn_leaf -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.2 3.8c.6 5.4-.5 9.6-3.2 12.3-2.8 2.8-6.6 2.9-9 1.1-2.2-1.7-2.6-5.6.2-8.4 2.7-2.7 6.9-3.7 12-3.4"/><path d="M4.2 20.2L12 12.4"/></svg>{%- endcapture -%}
{%- capture pn_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20.4S3.4 15.2 3.4 9.4a4.6 4.6 0 018.6-2.3 4.6 4.6 0 018.6 2.3c0 5.8-8.6 11-8.6 11z"/></svg>{%- endcapture -%}
{%- capture pn_infinity -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 12c1.7-2.3 3-3.6 5-3.6a3.6 3.6 0 010 7.2c-2 0-3.3-1.3-5-3.6zm0 0c-1.7 2.3-3 3.6-5 3.6a3.6 3.6 0 010-7.2c2 0 3.3 1.3 5 3.6z"/></svg>{%- endcapture -%}

<div
  class="pnc"
  id="pnc-{{ section.id }}"
  data-pnc-root
  data-cart-drawer
  hidden
  style="
    --pn-ink: {{ s.color_ink }};
    --pn-muted: {{ s.color_muted }};
    --pn-line: {{ s.color_line }};
    --pn-soft: {{ s.color_soft }};
    --pn-bg: {{ s.color_bg }};
    --pn-card: {{ s.color_card }};
    --pn-head-bg: {{ s.color_head_bg }};
    --pn-accent: {{ s.color_accent }};
    --pn-green: {{ s.color_green }};
    --pn-green-soft: {{ s.color_green_soft }};
    --pn-star: {{ s.color_star }};
    --pn-red: {{ s.color_red }};
    --pn-red-soft: {{ s.color_red_soft }};
    --pn-width: {{ s.panel_width }}px;
    --pn-pad: {{ s.panel_padding }}px;
    --pn-card-radius: {{ s.card_radius }}px;
    --pn-cta-radius: {{ s.cta_radius }}px;
    --pn-goal-edge: {{ s.goal_edge }}px;
    --pn-goal-size: {{ s.goal_dot_size }}px;
    --pn-ins-icon: {{ s.insurance_icon_size }}px;
    --pn-ribbon-bg: {{ s.color_ribbon_bg }};
    --pn-ribbon-ink: {{ s.color_ribbon_ink }};
    --pn-head-ink: {{ s.color_head_ink }};
    --pn-head-veil: {{ s.color_head_veil }};
    --pn-head-min: {{ s.head_height }}px;
    --pn-proof-bg: {{ s.color_proof_bg }};
    --pn-proof-ink: {{ s.color_proof_ink }};
    --pn-proof-star: {{ s.color_proof_star }};
    --pn-cross-bg: {{ s.color_cross_bg }};
    --pn-cross-ink: {{ s.color_cross_ink }};
    --pn-cross-accent: {{ s.color_cross_accent }};
    --pn-cta-bg: {{ s.color_cta_bg }};
    --pn-cta-ink: {{ s.color_cta_ink }};
    --pn-atout-ico: {{ s.color_atout_ico }};
    --pn-atout-sub: {{ s.color_atout_sub }};
    --pn-avis-bg: {{ s.color_avis_bg }};
    --pn-avis-ink: {{ s.color_avis_ink }};
  "
>
  <script type="application/json" data-pnc-config>
    {
      "cartUrl": {{ routes.cart_url | json }},
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartChangeUrl": {{ routes.cart_change_url | json }},
      "cartUpdateUrl": {{ routes.cart_update_url | json }},
      "rootUrl": {{ routes.root_url | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "openOnAdd": {{ s.open_on_add | json }},
      "interceptForms": {{ s.intercept_forms | json }},
      "interceptLinks": {{ s.intercept_links | json }},
      "replaceThemeDrawer": {{ s.replace_theme_drawer | json }},
      "showSwap": {{ s.show_swap | json }},
      "showLineCompare": {{ s.show_line_compare | json }},
      "showQty": {{ s.show_qty | json }},
      "showPills": {{ s.show_pills | json }},
      "optsStyle": {{ s.opts_style | json }},
      "goalMax": {{ goal_max | json }},
      "insuranceId": {{ s.insurance_product.selected_or_first_available_variant.id | default: 0 | json }},
      "insuranceAuto": {{ s.insurance_auto | json }},
      "showRibbon": {{ s.show_ribbon | json }},
      "ribbonContent": {{ s.ribbon_content | json }},
      "showDeals": {{ s.show_deals | json }},
      "showSold": {{ s.show_sold | json }},
      "soldMin": {{ s.sold_from | json }},
      "soldMax": {{ s.sold_to | json }},
      "goals": [
        {%- for block in tiers -%}
          {%- liquid
            assign b = block.settings
            assign raw = b.amount | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.'
            assign cents = raw | times: 100 | round
          -%}
          {
            "amount": {{ cents | json }},
            "label": {{ b.label | json }},
            "reward": {{ b.reward | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "crossIds": [
        {%- for block in crosses -%}
          {%- assign cp = block.settings.product -%}
          {%- if cp != blank and cp.selected_or_first_available_variant != blank -%}
            {{ cp.selected_or_first_available_variant.id | json }}{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ],
      "strings": {
        "ribbon": {{ s.ribbon_label | json }},
        "sold": {{ s.sold_label | json }},
        "discount": {{ s.discount_label | json }},
        "subtitleOne": {{ s.subtitle_one | json }},
        "subtitleMany": {{ s.subtitle_many | json }},
        "goalsMessage": {{ s.goals_message | json }},
        "goalsDone": {{ s.goals_done | json }},
        "swapLabel": {{ s.swap_label | json }},
        "error": {{ s.error_label | json }}
      }
    }
  </script>

  <div class="pnc__scrim" data-pnc-scrim></div>

  <div
    class="pnc__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ s.panel_title | escape }}"
    data-pnc-panel
  >
    {%- comment -%} ---------- En-tête ---------- {%- endcomment -%}
    <div class="pnc__head{% if s.head_image != blank %} pnc__head--image{% endif %}">
      {%- if s.head_image != blank -%}
        {%- comment -%}
          L'image et son voile sont deux couches distinctes : régler l'une ne
          touche pas l'autre, et le titre garde son contraste quelle que soit
          la photo déposée.
        {%- endcomment -%}
        <span class="pnc__head-bg" aria-hidden="true">
          {{ s.head_image | image_url: width: 1200 | image_tag: widths: '400, 700, 1000, 1200', loading: 'lazy', alt: '' }}
        </span>
        <span class="pnc__head-veil" aria-hidden="true"></span>
      {%- endif -%}

      {%- if s.show_head_icon -%}
        <span class="pnc__head-icon">
          {{ pn_bag }}
          <span class="pnc__count" data-pnc-count hidden>0</span>
        </span>
      {%- endif -%}
      <div class="pnc__titles">
        <h2 class="pnc__title">{{ s.panel_title }}</h2>
        {%- if s.show_subtitle -%}
          <p class="pnc__subtitle" data-pnc-subtitle></p>
        {%- endif -%}
      </div>
      <button type="button" class="pnc__close" data-pnc-close aria-label="{{ s.close_label | escape }}">
        {{ pn_close }}
      </button>
    </div>

    {%- comment -%} ---------- Bandeau de confiance ---------- {%- endcomment -%}
    {%- if s.show_proof -%}
      {%- liquid
        comment
          La note commande le nombre d'étoiles pleines : une seule valeur à
          tenir à jour, et l'affichage suit.
        endcomment
        assign proof_full = s.proof_stars | round
      -%}
      <div class="pnc__proof{% if s.proof_star_style == 'nues' %} pnc__proof--nues{% endif %}">
        {%- if s.proof_logo != blank or s.proof_text != blank -%}
          <span class="pnc__proof-logo">
            {%- if s.proof_logo != blank -%}
              {{ s.proof_logo | image_url: width: 300 | image_tag: widths: '100, 200, 300', loading: 'lazy', alt: s.proof_text }}
            {%- else -%}
              {{ pn_star }}<span>{{ s.proof_text }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}

        {%- if s.proof_stars > 0 -%}
          <span class="pnc__proof-stars" role="img" aria-label="{{ s.proof_score | escape }}">
            {%- for i in (1..5) -%}
              <span class="pnc__proof-star{% if forloop.index > proof_full %} pnc__proof-star--off{% endif %}">{{ pn_star }}</span>
            {%- endfor -%}
          </span>
        {%- endif -%}

        {%- if s.proof_score != blank -%}
          <span class="pnc__proof-score">{{ s.proof_score }}</span>
        {%- endif -%}

        {%- if s.proof_count != blank -%}
          <span class="pnc__proof-sep" aria-hidden="true">·</span>
          <span>{{ s.proof_count }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- Corps ---------- {%- endcomment -%}
    <div class="pnc__body" data-pnc-body>
      <p class="pnc__error" role="alert" data-pnc-error hidden></p>

      {%- if s.show_ship_note and s.ship_note != blank -%}
        <div class="pnc__ship">
          <span class="pnc__ship-icon">{{ pn_truck }}</span>
          <span>{{ s.ship_note }}</span>
        </div>
      {%- endif -%}

      {%- if s.show_goals and tiers.size > 0 and goal_max > 0 -%}
        {%- liquid
          comment
            Deux dispositions. « Proportionnel » place chaque palier à son
            montant réel : la distance se lit. « Régulier » les espace à pas
            égaux : six récompenses tiennent alors sans se chevaucher, et
            c'est la disposition de la maquette.
          endcomment
          assign last_index = tiers.size | minus: 1
        -%}
        <div class="pnc__goals pnc__goals--{{ s.goals_layout }}" data-pnc-goals data-pnc-goals-layout="{{ s.goals_layout }}">
          <p class="pnc__goals-msg" data-pnc-goals-msg></p>
          <div class="pnc__goals-track">
            <span class="pnc__goals-fill" data-pnc-goals-fill></span>
            {%- for block in tiers -%}
              {%- liquid
                assign b = block.settings
                assign raw = b.amount | strip | replace: ' ', '' | replace: '€', '' | replace: ',', '.'
                assign cents = raw | times: 100 | round

                if s.goals_layout == 'regulier' and last_index > 0
                  assign pct = forloop.index0 | times: 100.0 | divided_by: last_index
                elsif s.goals_layout == 'regulier'
                  assign pct = 50
                else
                  assign pct = cents | times: 100.0 | divided_by: goal_max
                endif

                case b.icon
                  when 'gift'
                    assign g_icon = pn_gift
                  when 'percent'
                    assign g_icon = pn_percent
                  when 'box'
                    assign g_icon = pn_box
                  when 'star'
                    assign g_icon = pn_star
                  when 'book'
                    assign g_icon = pn_book
                  when 'card'
                    assign g_icon = pn_card
                  when 'spoon'
                    assign g_icon = pn_spoon
                  when 'heart'
                    assign g_icon = pn_heart
                  else
                    assign g_icon = pn_truck
                endcase

                assign goal_edge_class = ''
                if pct >= 99
                  assign goal_edge_class = ' pnc__goal--end'
                elsif pct <= 1
                  assign goal_edge_class = ' pnc__goal--start'
                endif
              -%}
              <span
                class="pnc__goal{{ goal_edge_class }}"
                data-pnc-goal="{{ cents }}"
                data-pnc-goal-pct="{{ pct }}"
                style="left: {{ pct }}%;"
                {{ block.shopify_attributes }}
              >
                <span class="pnc__goal-dot">
                  <span class="pnc__goal-ico">{{ g_icon }}</span>
                  {%- if s.goal_check -%}
                    <span class="pnc__goal-check">{{ pn_check }}</span>
                  {%- endif -%}
                </span>
                {%- if b.label != blank -%}
                  <span class="pnc__goal-label">{{ b.label }}</span>
                {%- endif -%}
              </span>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <ul class="pnc__lines pnc__lines--{{ s.line_style }}" data-pnc-lines></ul>

      {%- comment -%}
        Le panier vide : il remplace les lignes, pas le panneau entier, pour
        que la vente croisée reste visible si le marchand le souhaite.
      {%- endcomment -%}
      <div class="pnc__empty" data-pnc-empty hidden>
        {{ pn_bag }}
        {%- if s.empty_title != blank -%}
          <p class="pnc__empty-title">{{ s.empty_title }}</p>
        {%- endif -%}
        {%- if s.empty_text != blank -%}
          <p class="pnc__empty-text">{{ s.empty_text }}</p>
        {%- endif -%}
        {%- if s.empty_cta_label != blank -%}
          <a class="pnc__empty-cta" href="{{ s.empty_cta_url | default: routes.all_products_collection_url }}">
            {{ s.empty_cta_label }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Combinaison parfaite ---------- {%- endcomment -%}
      {%- if s.show_cross and crosses.size > 0 -%}
        <div class="pnc__cross pnc__cross--{{ s.cross_style }}" data-pnc-cross>
          {%- if s.cross_title != blank or s.cross_timer -%}
            <div class="pnc__cross-head">
              {%- if s.cross_title != blank -%}
                <h3 class="pnc__cross-title">
                  {%- if s.cross_title_icon -%}{{ pn_box }}{%- endif -%}
                  <span>{{ s.cross_title }}</span>
                </h3>
              {%- else -%}
                <span></span>
              {%- endif -%}

              {%- if s.cross_timer -%}
                {%- comment -%}
                  Le compte à rebours est tenu dans la session du navigateur :
                  il ne repart pas de zéro à chaque ouverture du panneau, ce
                  qui serait une promesse en trompe-l'œil.
                {%- endcomment -%}
                <span class="pnc__timer" data-pnc-timer data-pnc-minutes="{{ s.cross_timer_minutes }}" hidden>
                  {{ pn_clock }}<span data-pnc-timer-value>--:--</span>
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="{% if s.cross_layout == 'carrousel' %}pnc__cross-rail{% else %}pnc__cross-list{% endif %}" data-pnc-cross-rail>
          {%- for block in crosses -%}
            {%- liquid
              assign b = block.settings
              assign cp = b.product
              assign cv = cp.selected_or_first_available_variant
              assign rating = b.rating | plus: 0.0
              assign star_pct = rating | divided_by: 5.0 | times: 100

              comment
                times: 100.0 force le calcul en virgule flottante : avec deux
                entiers, Liquid ferait une division entière et le pourcentage
                dépendrait du moteur. On arrondit ensuite explicitement.
              endcomment
              assign save_pct = 0
              if cv.compare_at_price > cv.price
                assign diff = cv.compare_at_price | minus: cv.price
                assign save_pct = diff | times: 100.0 | divided_by: cv.compare_at_price | round
              endif
            -%}
            {%- if cp != blank and cv != blank -%}
              <div class="pnc__cross-item" data-pnc-cross-item data-variant="{{ cv.id }}" {{ block.shopify_attributes }}>
                <a class="pnc__cross-img" href="{{ cp.url }}" tabindex="-1" aria-hidden="true">
                  {%- if cp.featured_image != blank -%}
                    {{ cp.featured_image | image_url: width: 180 | image_tag: width: 90, height: 90, loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </a>
                <div class="pnc__cross-body">
                  <a class="pnc__cross-name" href="{{ cp.url }}">{{ b.title | default: cp.title }}</a>

                  {%- if s.show_cross_rating and b.rating_count != blank -%}
                    <span class="pnc__cross-stars">
                      <span class="pnc__stars" role="img" aria-label="{{ rating }}/5">
                        {{ pn_star }}{{ pn_star }}{{ pn_star }}{{ pn_star }}{{ pn_star }}
                        <span class="pnc__stars-on" style="width: {{ star_pct }}%;" aria-hidden="true">
                          {{ pn_star }}{{ pn_star }}{{ pn_star }}{{ pn_star }}{{ pn_star }}
                        </span>
                      </span>
                      <span>{{ rating }} ({{ b.rating_count }})</span>
                    </span>
                  {%- endif -%}

                  <span class="pnc__cross-prices">
                    <span>{{ cv.price | money }}</span>
                    {%- if s.cross_show_compare and cv.compare_at_price > cv.price -%}
                      <s class="pnc__cross-was">{{ cv.compare_at_price | money }}</s>
                      {%- if save_pct > 0 -%}
                        <span class="pnc__cross-save">
                          {{- s.cross_save_label | replace: '[x]', save_pct -}}
                        </span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                </div>
                <button
                  type="button"
                  class="pnc__cross-add"
                  data-pnc-cross-add="{{ cv.id }}"
                  {% unless cv.available %}disabled{% endunless %}
                >
                  {{- s.cross_add_label -}}
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
          </div>

          {%- if s.cross_layout == 'carrousel' -%}
            {%- comment -%}
              La jauge remplace la barre de défilement, masquée : elle dit où
              l'on en est dans la série sans ajouter de chrome au panneau.
            {%- endcomment -%}
            <div class="pnc__cross-bar" data-pnc-cross-bar hidden><i data-pnc-cross-bar-fill></i></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Atouts ---------- {%- endcomment -%}
      {%- if s.show_atouts and atouts.size > 0 -%}
        <div class="pnc__atouts">
          {%- for block in atouts -%}
            {%- liquid
              assign a = block.settings
              case a.icone
                when 'shield'
                  assign a_icon = pn_shield
                when 'leaf'
                  assign a_icon = pn_leaf
                when 'truck'
                  assign a_icon = pn_truck
                when 'infinity'
                  assign a_icon = pn_infinity
                when 'heart'
                  assign a_icon = pn_heart
                when 'gift'
                  assign a_icon = pn_gift
                when 'box'
                  assign a_icon = pn_box
                when 'lock'
                  assign a_icon = pn_lock
                else
                  assign a_icon = ''
              endcase
            -%}
            <div class="pnc__atout" {{ block.shopify_attributes }}>
              {%- if a.image != blank or a_icon != blank -%}
                <span class="pnc__atout-ico" aria-hidden="true">
                  {%- if a.image != blank -%}
                    {{ a.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ a_icon }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              {%- if a.titre != blank -%}
                <span class="pnc__atout-title">{{ a.titre }}</span>
              {%- endif -%}
              {%- if a.texte != blank -%}
                <span class="pnc__atout-text">{{ a.texte }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Pied ---------- {%- endcomment -%}
    <div class="pnc__foot">
      {%- if s.show_subtotal -%}
        <p class="pnc__row">
          <span data-pnc-subtotal-label>{{ s.subtotal_label }}</span>
          <span class="pnc__row-value" data-pnc-subtotal></span>
        </p>
      {%- endif -%}

      {%- if s.show_discount_row -%}
        <p class="pnc__row pnc__row--discount{% if s.discount_style == 'simple' %} pnc__row--plain{% endif %}" data-pnc-discount-row hidden>
          <span class="pnc__row-label">
            {{ pn_tag }}<span data-pnc-discount-name>{{ s.discount_label }}</span>
          </span>
          <span class="pnc__row-value" data-pnc-discount></span>
        </p>
      {%- endif -%}

      <p class="pnc__row pnc__row--total">
        <span>{{ s.total_label }}</span>
        <span class="pnc__row-value" data-pnc-total></span>
      </p>

      {%- comment -%}
        ---------- Assurance transport ----------
        Une variante réelle, donc un vrai article de commande : le prix vient
        du produit choisi, jamais d'un nombre saisi ici qui pourrait mentir.
      {%- endcomment -%}
      {%- liquid
        assign ins_product = s.insurance_product
        assign ins_variant = ins_product.selected_or_first_available_variant
      -%}
      {%- if s.show_insurance and ins_variant != blank -%}
        <div class="pnc__ins" data-pnc-ins data-variant="{{ ins_variant.id }}">
          {%- if s.insurance_icon_size > 0 -%}
            <span class="pnc__ins-icon" aria-hidden="true">{{ pn_shield }}</span>
          {%- endif -%}
          <div class="pnc__ins-body">
            <span class="pnc__ins-title">{{ s.insurance_title | default: ins_product.title }}</span>
            {%- if s.insurance_text != blank -%}
              <span class="pnc__ins-text">{{ s.insurance_text }}</span>
            {%- endif -%}
          </div>
          <span class="pnc__ins-price">{{ ins_variant.price | money }}</span>
          <button
            type="button"
            class="pnc__switch"
            role="switch"
            aria-checked="false"
            data-pnc-ins-toggle
            aria-label="{{ s.insurance_title | default: ins_product.title | escape }}"
          ></button>
        </div>
      {%- elsif s.show_insurance and request.design_mode -%}
        {%- comment -%}
          Sans produit choisi il n'y a rien à facturer, donc rien à afficher.
          Dans l'éditeur, on le dit plutôt que de laisser un vide inexpliqué.
        {%- endcomment -%}
        <div class="pnc__ins pnc__ins--todo">
          <span class="pnc__ins-icon" aria-hidden="true">{{ pn_shield }}</span>
          <span class="pnc__ins-text">{{ s.insurance_todo }}</span>
        </div>
      {%- endif -%}

      {%- comment -%}
        Un envoi de formulaire vers /cart avec le nom « checkout » : c'est la
        façon dont Shopify attend qu'on passe au paiement, et elle emporte le
        panier, la langue et le jeton. Un simple lien vers cette même adresse
        se faisait intercepter par le panneau, qui se contentait de se
        rouvrir — d'où le bouton qui semblait ne rien faire.
      {%- endcomment -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate data-pnc-ignore>
        <button type="submit" name="checkout" class="pnc__cta" data-pnc-cta>
          {%- if s.show_lock -%}{{ pn_lock }}{%- endif -%}
          <span class="pnc__cta-label">{{ s.cta_label }}</span>
          {%- if s.cta_show_total -%}
            <span class="pnc__cta-sep" aria-hidden="true">·</span>
            <span class="pnc__cta-total" data-pnc-cta-total></span>
          {%- endif -%}
          {%- if s.show_cta_arrow -%}{{ pn_arrow }}{%- endif -%}
        </button>
      </form>

      {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
        <div class="pnc__pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'pnc__pay-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.foot_note != blank -%}
        <p class="pnc__note">{{ s.foot_note }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      ---------- Avis clients ----------
      Tout en bas, hors du pied : la bande défile horizontalement et ne prend
      jamais la place du bouton de paiement.
    {%- endcomment -%}
    {%- if s.show_avis and avis.size > 0 -%}
      <div class="pnc__avis" data-pnc-avis data-pnc-avis-auto="{{ s.avis_auto }}">
        {%- for block in avis -%}
          {%- assign r = block.settings -%}
          <div class="pnc__avis-item" {{ block.shopify_attributes }}>
            {%- if r.photo != blank -%}
              <span class="pnc__avis-photo">
                {{ r.photo | image_url: width: 160 | image_tag: widths: '60, 120, 160', loading: 'lazy', alt: '' }}
              </span>
            {%- endif -%}
            <div class="pnc__avis-body">
              <span class="pnc__avis-top">
                {%- if r.nom != blank -%}<span>{{ r.nom }}</span>{%- endif -%}
                {%- if r.badge != blank -%}
                  <span class="pnc__avis-badge">{{ pn_check_fill }}{{ r.badge }}</span>
                {%- endif -%}
              </span>
              {%- if r.texte != blank -%}
                <span class="pnc__avis-text">{{ r.texte }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Le gabarit d'une ligne. Les lignes viennent de /cart.js, donc elles sont
    clonées ici plutôt que rendues par Liquid : le panier change sans que la
    page soit rechargée.
  {%- endcomment -%}
  <template data-pnc-row>
    <li class="pnc__line" data-pnc-line>
      <a class="pnc__line-img" data-pnc-line-link tabindex="-1" aria-hidden="true">
        <img data-pnc-line-img alt="" loading="lazy" width="164" height="164">
      </a>
      <div class="pnc__line-body">
        <div class="pnc__line-top">
          <a class="pnc__line-title" data-pnc-line-title></a>
          <button type="button" class="pnc__line-remove" data-pnc-line-remove aria-label="{{ s.remove_label | escape }}">
            {%- if s.remove_icon == 'croix' -%}{{ pn_close }}{%- else -%}{{ pn_trash }}{%- endif -%}
          </button>
        </div>
        <div class="pnc__line-meta">
          {%- comment -%}
            La pastille de remise se range là où le marchand l'attend : près
            du titre, ou sous le prix avec le montant barré. Elle n'existe
            qu'une fois, à une seule de ces deux places.
          {%- endcomment -%}
          {%- if s.ribbon_place == 'titre' -%}
            <span class="pnc__ribbon pnc__ribbon--{{ s.ribbon_style }}" data-pnc-ribbon hidden>{% if s.ribbon_icon %}{{ pn_tag }}{% endif %}<span data-pnc-ribbon-text></span></span>
          {%- endif -%}
          <div class="pnc__line-opts" data-pnc-line-opts></div>
        </div>
        {%- comment -%}
          Le détail des promotions appliquées à la ligne, tel que Shopify le
          renvoie : le prix barré s'explique alors de lui-même.
        {%- endcomment -%}
        <div class="pnc__deals" data-pnc-deals hidden></div>
        <p class="pnc__sold" data-pnc-sold hidden></p>
        <p class="pnc__line-note" data-pnc-line-note hidden></p>
        <div class="pnc__line-bottom">
          <span class="pnc__qty" data-pnc-qty-box>
            <button type="button" data-pnc-qty-minus aria-label="{{ s.qty_minus_label | escape }}">&minus;</button>
            <span data-pnc-qty>1</span>
            <button type="button" data-pnc-qty-plus aria-label="{{ s.qty_plus_label | escape }}">+</button>
          </span>
          <span class="pnc__line-prices">
            <span data-pnc-line-price></span>
            <span class="pnc__line-under">
              <s class="pnc__line-was" data-pnc-line-was hidden></s>
              {%- if s.ribbon_place == 'prix' -%}
                <span class="pnc__ribbon pnc__ribbon--{{ s.ribbon_style }}" data-pnc-ribbon hidden>
                  {%- if s.ribbon_icon -%}{{ pn_tag }}{%- endif -%}
                  <span data-pnc-ribbon-text></span>
                </span>
              {%- endif -%}
            </span>
          </span>
        </div>
        <button type="button" class="pnc__swap-open" data-pnc-swap-open hidden></button>
        <div class="pnc__swap" data-pnc-swap hidden></div>
      </div>
    </li>
  </template>
</div>

<script>
  (function () {
    var root = document.getElementById('pnc-{{ section.id }}');
    if (!root || root.dataset.pncReady === '1') return;
    root.dataset.pncReady = '1';

    var config = JSON.parse(root.querySelector('[data-pnc-config]').textContent);

    function $(sel, scope) {
      return (scope || root).querySelector(sel);
    }
    function $$(sel, scope) {
      return Array.prototype.slice.call((scope || root).querySelectorAll(sel));
    }

    var panel = $('[data-pnc-panel]');
    var scrim = $('[data-pnc-scrim]');
    var linesBox = $('[data-pnc-lines]');
    var emptyBox = $('[data-pnc-empty]');
    var rowTemplate = $('[data-pnc-row]');
    var countEl = $('[data-pnc-count]');
    var subtitleEl = $('[data-pnc-subtitle]');
    var subtotalEl = $('[data-pnc-subtotal]');
    var totalEl = $('[data-pnc-total]');
    var errorBox = $('[data-pnc-error]');
    var goalsBox = $('[data-pnc-goals]');
    var goalsFill = $('[data-pnc-goals-fill]');
    var goalsMsg = $('[data-pnc-goals-msg]');
    var crossBox = $('[data-pnc-cross]');
    var discountRow = $('[data-pnc-discount-row]');
    var discountEl = $('[data-pnc-discount]');
    var discountNameEl = $('[data-pnc-discount-name]');
    var insBox = $('[data-pnc-ins]');
    var insToggle = $('[data-pnc-ins-toggle]');
    var insId = Number(config.insuranceId) || 0;
    /* Une fois l'assurance retirée à la main, on ne la repose plus : la
       proposer automatiquement est une chose, l'imposer une autre. */
    var insDeclined = false;
    var insBusy = false;

    var lastFocus = null;
    var cart = null;
    var productCache = {};

    /* ---------------- Monnaie ----------------
       Le motif est construit par concaténation : écrire les accolades
       telles quelles dans ce fichier ferait croire à Liquid qu'il s'agit
       d'une de ses balises. */
    var MONEY_TOKEN = new RegExp('\\{\\{\\s*(\\w+)\\s*\\}\\}');

    function formatMoney(cents) {
      var format = config.moneyFormat;
      if (!format) return (cents / 100).toFixed(2);
      var match = format.match(MONEY_TOKEN);
      if (!match) return format;

      var name = match[1];
      var noDecimals = name.indexOf('no_decimals') > -1;
      var commaSeparator = name.indexOf('comma_separator') > -1;
      var value = (cents / 100).toFixed(noDecimals ? 0 : 2);
      var parts = value.split('.');
      var whole = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, commaSeparator ? '.' : ',');
      var out = whole + (parts[1] ? (commaSeparator ? ',' : '.') + parts[1] : '');
      return format.replace(MONEY_TOKEN, out);
    }

    function fill(text, values) {
      var out = String(text || '');
      Object.keys(values).forEach(function (key) {
        out = out.split('[' + key + ']').join(values[key]);
      });
      return out;
    }

    function showError(message) {
      if (!errorBox) return;
      errorBox.textContent = message || config.strings.error;
      errorBox.hidden = false;
    }

    function clearError() {
      if (errorBox) errorBox.hidden = true;
    }

    /* ---------------- Ouverture et fermeture ---------------- */

    function focusables() {
      return $$(
        'a[href], button:not([disabled]), select, input, [tabindex]:not([tabindex="-1"])',
        panel
      ).filter(function (el) {
        return el.offsetParent !== null;
      });
    }

    function open() {
      if (root.classList.contains('is-open')) return;
      lastFocus = document.activeElement;
      root.hidden = false;
      /* Un reflow entre l'affichage et la classe, sans quoi le navigateur
         saute la transition et le panneau apparaît d'un bloc. */
      void root.offsetWidth;
      root.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      refresh();
      var first = $('[data-pnc-close]');
      if (first) first.focus();
      document.dispatchEvent(new CustomEvent('pnc:opened', { bubbles: true }));
    }

    function close() {
      if (!root.classList.contains('is-open')) return;
      root.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      window.setTimeout(function () {
        if (!root.classList.contains('is-open')) root.hidden = true;
      }, 380);
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      document.dispatchEvent(new CustomEvent('pnc:closed', { bubbles: true }));
    }

    /* L'API que les autres sections appellent : la section produit HikeFoot
       cherche `cart-drawer, [data-cart-drawer]` puis invoque open(). */
    root.open = open;
    root.close = close;

    if (scrim) scrim.addEventListener('click', close);
    $$('[data-pnc-close]').forEach(function (btn) {
      btn.addEventListener('click', close);
    });

    document.addEventListener('keydown', function (event) {
      if (!root.classList.contains('is-open')) return;
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      var list = focusables();
      if (!list.length) return;
      var first = list[0];
      var last = list[list.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    /* ---------------- Lecture du panier ---------------- */

    function busy(on) {
      panel.classList.toggle('is-busy', !!on);
    }

    function readJson(response) {
      return response.json().then(function (data) {
        if (!response.ok) {
          throw new Error(data.description || data.message || config.strings.error);
        }
        return data;
      });
    }

    function refresh() {
      busy(true);
      return fetch(config.cartUrl + '.js', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin'
      })
        .then(readJson)
        .then(function (data) {
          cart = data;
          render();
        })
        .catch(function (error) {
          showError(error.message);
        })
        .then(function () {
          busy(false);
        });
    }

    /* ---------------- Rendu ---------------- */

    function render() {
      if (!cart) return;
      clearError();

      /* L'assurance n'est pas un article du panier aux yeux du client : elle
         ne compte donc pas dans le nombre affiché. */
      var count = 0;
      (cart.items || []).forEach(function (item) {
        if (insId && item.variant_id === insId) return;
        count += item.quantity;
      });

      if (countEl) {
        countEl.textContent = count;
        countEl.hidden = count === 0;
      }
      if (subtitleEl) {
        subtitleEl.textContent = fill(
          count === 1 ? config.strings.subtitleOne : config.strings.subtitleMany,
          { n: count }
        );
      }

      /* L'assurance a sa propre rangée dans le pied : elle n'a rien à faire
         une seconde fois dans la liste des articles. */
      linesBox.innerHTML = '';
      var shownItems = 0;
      (cart.items || []).forEach(function (item, index) {
        if (insId && item.variant_id === insId) return;
        linesBox.appendChild(buildLine(item, index + 1));
        shownItems += 1;
      });
      linesBox.hidden = shownItems === 0;
      if (emptyBox) emptyBox.hidden = shownItems !== 0;

      /* Trois montants, et il faut prendre le bon champ pour chacun.
         items_subtotal_price est déjà net des remises d'article : s'en servir
         de « prix avant réductions » masquait toute remise posée sur la
         ligne, et la ligne de réduction disparaissait alors qu'il y en avait
         bien une. original_total_price, lui, précède toutes les remises. */
      var paid = cart.total_price || 0;

      /* Le prix avant réductions vient de plusieurs sources possibles selon
         la version de Shopify et le type de remise. On retient la plus haute :
         un montant « avant remise » ne peut, par définition, être inférieur
         à aucune des autres. La somme des lignes sert de filet quand
         original_total_price manque. */
      var fromLines = 0;
      (cart.items || []).forEach(function (item) {
        fromLines += item.original_line_price || 0;
      });
      var full = Math.max(
        cart.original_total_price || 0,
        fromLines,
        cart.items_subtotal_price || 0,
        paid
      );

      /* La remise se déduit des deux montants affichés plutôt que d'un champ
         à part : le client peut ainsi vérifier que sous-total moins remise
         donne bien le total, ce qu'un total_discount d'une autre origine ne
         garantirait pas. */
      var saved = Math.max(0, full - paid);

      if (subtotalEl) subtotalEl.textContent = formatMoney(full);
      if (totalEl) totalEl.textContent = formatMoney(paid);

      /* Le montant sur le bouton : la dernière chose lue avant le clic, donc
         celle qui doit coïncider avec le total à l'euro près. */
      var ctaTotal = $('[data-pnc-cta-total]');
      if (ctaTotal) {
        ctaTotal.textContent = formatMoney(paid);
        ctaTotal.hidden = paid <= 0;
      }
      var ctaSep = $('.pnc__cta-sep');
      if (ctaSep) ctaSep.hidden = paid <= 0;

      if (discountRow) {
        discountRow.hidden = saved <= 0;
        if (discountEl) discountEl.textContent = '−' + formatMoney(saved);

        /* Une remise posée sur la commande n'apparaît sur aucune ligne : c'est
           ici qu'elle doit être nommée, sinon le client voit un montant tomber
           sans savoir d'où il vient. */
        if (discountNameEl) {
          var orderNames = orderDiscountNames();
          discountNameEl.textContent = orderNames.length
            ? orderNames.join(', ')
            : config.strings.discount;
        }
      }

      renderGoals(cart.total_price || 0);
      renderCross();
      renderInsurance();
    }

    /**
     * Le prix barré et la pastille de remise d'une ligne, pour un plein tarif
     * donné. Appelée deux fois : sur ce que /cart.js annonce, puis sur le
     * compare_at de la variante s'il dit mieux.
     */
    /** Les noms des remises posées sur la commande entière. */
    function orderDiscountNames() {
      var orderWide = (cart && (cart.cart_level_discount_applications || cart.discount_applications)) || [];
      var names = [];
      orderWide.forEach(function (application) {
        var name = application.title || application.code || '';
        if (name && names.indexOf(name) === -1) names.push(name);
      });
      return names;
    }

    /**
     * Le nom de la remise Shopify en cours. On regarde d'abord celles posées
     * sur l'article, puis celles posées sur la commande entière : une remise
     * « 10 % sur la commande » n'apparaît nulle part dans les lignes, et
     * c'est pourtant bien la remise en cours sur le panier.
     */
    function discountName(item) {
      var allocations = (item && (item.line_level_discount_allocations || item.discounts)) || [];
      for (var i = 0; i < allocations.length; i += 1) {
        var app = allocations[i].discount_application || {};
        var title = app.title || allocations[i].title || '';
        if (title) return title;
      }
      return orderDiscountNames()[0] || '';
    }

    function paintSavings(row, full, paid, item) {
      var saved = full - paid;
      var discounted = saved > 0 && full > 0;

      var was = row.querySelector('[data-pnc-line-was]');
      if (was) {
        if (config.showLineCompare && discounted) {
          was.textContent = formatMoney(full);
          was.hidden = false;
        } else {
          was.hidden = true;
        }
      }

      var ribbon = row.querySelector('[data-pnc-ribbon]');
      if (!ribbon) return;
      if (!config.showRibbon || !discounted) {
        ribbon.hidden = true;
        return;
      }

      /* La pastille dit soit ce qu'on économise, soit comment la remise
         s'appelle dans Shopify.
         En mode automatique on prend le nom, sauf quand la ligne du dessous
         l'affiche déjà : répéter deux fois « Buy 2 Get 10 % » n'apprend rien
         de plus, alors que le pourcentage, lui, ajoute une information. */
      var pct = Math.round((saved / full) * 100);
      var name = discountName(item);
      var mode = config.ribbonContent;
      var namedBelow = config.showDeals && name;
      var text;

      if (name && (mode === 'name' || (mode === 'name_or_percent' && !namedBelow))) {
        text = name;
      } else {
        text = (config.strings.ribbon || '').split('[x]').join(pct);
      }

      /* Une pastille vide ne dit rien et ne fait qu'une tache : si le libellé
         a été effacé dans l'éditeur, on retombe sur le pourcentage brut. */
      text = String(text || '').trim();
      if (!text) text = '−' + pct + ' %';

      ribbon.querySelector('[data-pnc-ribbon-text]').textContent = text;
      ribbon.hidden = false;
    }

    function buildLine(item, line) {
      var frag = rowTemplate.content.cloneNode(true);
      var row = frag.querySelector('[data-pnc-line]');
      row.setAttribute('data-line', line);
      row.setAttribute('data-key', item.key);
      row.setAttribute('data-variant', item.variant_id);

      var link = frag.querySelector('[data-pnc-line-link]');
      var img = frag.querySelector('[data-pnc-line-img]');
      var title = frag.querySelector('[data-pnc-line-title]');

      if (link) link.href = item.url;
      if (img) {
        if (item.image) {
          img.src = item.image.replace(/(\.[a-z]+)(\?|$)/i, '_164x164$1$2');
          img.alt = '';
        } else {
          img.remove();
        }
      }
      if (title) {
        title.textContent = item.product_title || item.title;
        title.href = item.url;
      }

      /* Les déclinaisons : en pastilles, ou sur une seule ligne de texte —
         « 20CM — PETITE ». Le texte tient moins de place et se lit d'un
         trait quand il y a deux ou trois options. */
      var opts = frag.querySelector('[data-pnc-line-opts]');
      if (opts) {
        var values = [];
        if (config.showPills && item.options_with_values) {
          item.options_with_values.forEach(function (opt) {
            if (!opt.value || opt.value === 'Default Title') return;
            values.push(opt.value);
          });
        }
        if (values.length && config.optsStyle === 'texte') {
          var line = document.createElement('span');
          line.className = 'pnc__opts-line';
          line.textContent = values.join(' — ');
          opts.appendChild(line);
        } else {
          values.forEach(function (value) {
            var pill = document.createElement('span');
            pill.className = 'pnc__pill';
            pill.textContent = value;
            opts.appendChild(pill);
          });
        }
        if (!opts.childNodes.length) opts.remove();
      }

      var qtyBox = frag.querySelector('[data-pnc-qty-box]');
      if (!config.showQty && qtyBox) {
        qtyBox.remove();
      } else if (qtyBox) {
        frag.querySelector('[data-pnc-qty]').textContent = item.quantity;
        frag.querySelector('[data-pnc-qty-minus]').disabled = item.quantity <= 1;
      }

      frag.querySelector('[data-pnc-line-price]').textContent = formatMoney(item.final_line_price);

      /* La mention « X achetés » : un nombre décoratif, tiré une fois pour
         toutes depuis l'identifiant du produit, donc stable d'une visite à
         l'autre et différent d'un article à l'autre. */
      var sold = frag.querySelector('[data-pnc-sold]');
      if (sold) {
        if (config.showSold && config.strings.sold) {
          var span = Math.max(0, config.soldMax - config.soldMin);
          var seed = (item.product_id || item.variant_id || 0) % (span + 1);
          sold.textContent = config.strings.sold.split('[n]').join(config.soldMin + seed);
          sold.hidden = false;
        } else {
          sold.remove();
        }
      }

      /* La pastille ne reflète que ce que Shopify a réellement remisé. Un
         simple prix barré de fiche produit n'est pas une remise de panier :
         l'afficher comme telle donnait un pourcentage plus flatteur pour une
         paire que pour trois, ce qui laissait croire à une meilleure affaire
         sur la plus petite quantité. */
      paintSavings(row, item.original_line_price, item.final_line_price, item);

      /* Les promotions nommées, telles que Shopify les a appliquées. */
      var deals = frag.querySelector('[data-pnc-deals]');
      if (deals) {
        var allocations = item.line_level_discount_allocations || item.discounts || [];
        if (config.showDeals && allocations.length) {
          allocations.forEach(function (allocation) {
            var app = allocation.discount_application || {};
            var title = app.title || allocation.title || '';
            if (!title) return;
            var row = document.createElement('span');
            row.className = 'pnc__deal';
            row.innerHTML = TAG_ICON;
            var text = document.createElement('span');
            text.textContent =
              title + (allocation.amount ? ' (−' + formatMoney(allocation.amount) + ')' : '');
            row.appendChild(text);
            deals.appendChild(row);
          });
        }
        if (!deals.childNodes.length) deals.remove();
        else deals.hidden = false;
      }

      /* Le changement de variante n'a de sens que si le produit en a
         plusieurs : inutile de proposer un menu à un seul choix. */
      var swapOpen = frag.querySelector('[data-pnc-swap-open]');
      if (swapOpen) {
        if (config.showSwap && !item.product_has_only_default_variant) {
          swapOpen.textContent = config.strings.swapLabel;
          swapOpen.hidden = false;
          swapOpen.setAttribute('data-handle', item.handle);
        } else {
          swapOpen.remove();
          var swapBox = frag.querySelector('[data-pnc-swap]');
          if (swapBox) swapBox.remove();
        }
      }

      return frag;
    }

    function renderGoals(total) {
      if (!goalsBox) return;
      var max = config.goalMax || 0;
      if (!max) return;

      var markers = $$('[data-pnc-goal]', goalsBox);
      markers.forEach(function (marker) {
        var amount = Number(marker.getAttribute('data-pnc-goal')) || 0;
        marker.classList.toggle('is-reached', total >= amount);
      });

      /* Le remplissage.
         À pas réguliers, les pastilles ne sont plus à leur montant : la
         jauge doit donc avancer d'un cran à l'autre, et interpoler à
         l'intérieur du cran en cours. Sinon elle dépasserait largement la
         pastille atteinte, ou resterait loin derrière. */
      var pct;
      if (goalsBox.getAttribute('data-pnc-goals-layout') === 'regulier' && markers.length > 1) {
        var steps = markers
          .map(function (marker) {
            return {
              amount: Number(marker.getAttribute('data-pnc-goal')) || 0,
              pos: parseFloat(marker.getAttribute('data-pnc-goal-pct')) || 0
            };
          })
          .sort(function (a, b) {
            return a.amount - b.amount;
          });

        pct = 0;
        for (var i = 0; i < steps.length; i += 1) {
          if (total >= steps[i].amount) {
            pct = steps[i].pos;
            continue;
          }
          var from = i === 0 ? { amount: 0, pos: 0 } : steps[i - 1];
          var span = steps[i].amount - from.amount;
          var part = span > 0 ? (total - from.amount) / span : 0;
          pct = from.pos + Math.max(0, Math.min(1, part)) * (steps[i].pos - from.pos);
          break;
        }
      } else {
        pct = Math.min(100, (total / max) * 100);
      }

      if (goalsFill) goalsFill.style.width = Math.max(0, Math.min(100, pct)) + '%';

      /* Le message vise toujours le prochain palier non atteint ; une fois
         tous franchis, il félicite au lieu de rester muet. */
      var next = null;
      config.goals
        .slice()
        .sort(function (a, b) {
          return a.amount - b.amount;
        })
        .forEach(function (goal) {
          if (!next && total < goal.amount) next = goal;
        });

      if (goalsMsg) {
        if (next) {
          goalsMsg.innerHTML = fill(config.strings.goalsMessage, {
            montant: '<b>' + formatMoney(next.amount - total) + '</b>',
            objectif: '<b>' + escapeHtml(next.reward || next.label || '') + '</b>'
          });
        } else {
          goalsMsg.textContent = config.strings.goalsDone;
        }
      }
    }

    function escapeHtml(text) {
      var div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    /* L'étiquette des promotions, reprise du gabarit plutôt que recopiée en
       JavaScript. Le contenu d'un <template> est un fragment à part : il faut
       l'interroger par rowTemplate.content, pas depuis la racine. */
    var TAG_ICON = (function () {
      var source =
        (rowTemplate && rowTemplate.content.querySelector('[data-pnc-ribbon] svg')) ||
        $('.pnc__row-label svg');
      return source ? source.outerHTML : '';
    })();

    /* ---------------- Assurance transport ---------------- */

    /* L'état « occupé » et l'état du bouton vont de pair : les séparer laissait
       l'interrupteur désactivé pour de bon, puisque rien ne redessinait la
       carte une fois l'ajout terminé. */
    function setInsBusy(on) {
      insBusy = on;
      if (insToggle) insToggle.disabled = on;
    }

    function insuranceLine() {
      if (!insId || !cart) return null;
      var found = null;
      (cart.items || []).forEach(function (item, index) {
        if (item.variant_id === insId) found = { item: item, line: index + 1 };
      });
      return found;
    }

    function renderInsurance() {
      if (!insBox || !insToggle) return;
      var line = insuranceLine();
      var on = !!line;
      insToggle.setAttribute('aria-checked', on ? 'true' : 'false');

      /* Rien à assurer dans un panier vide. */
      var hasGoods = (cart.items || []).some(function (item) {
        return item.variant_id !== insId;
      });
      insBox.hidden = !hasGoods;

      if (insBusy) return;

      /* Un panier qui ne contiendrait que l'assurance n'a aucun sens : on la
         retire avec le dernier article, sinon le client verrait un total de
         2 € sur un panier annoncé vide. */
      if (!hasGoods && line) {
        setInsBusy(true);
        changeLine(line.line, 0).then(function () {
          setInsBusy(false);
        });
        return;
      }

      /* Cochée d'office au premier passage, si le client ne l'a pas refusée. */
      if (config.insuranceAuto && hasGoods && !on && !insDeclined) {
        setInsBusy(true);
        addVariant(insId, 1).then(function () {
          setInsBusy(false);
        });
      }
    }

    if (insToggle) {
      insToggle.addEventListener('click', function () {
        if (insBusy) return;
        var line = insuranceLine();
        setInsBusy(true);
        var done = function () {
          setInsBusy(false);
        };
        if (line) {
          insDeclined = true;
          changeLine(line.line, 0).then(done);
        } else {
          insDeclined = false;
          addVariant(insId, 1).then(done);
        }
      });
    }

    /* Un produit déjà dans le panier n'est plus une suggestion. */
    function renderCross() {
      if (!crossBox || !cart) return;
      var inCart = {};
      (cart.items || []).forEach(function (item) {
        inCart[item.variant_id] = true;
      });

      var visible = 0;
      $$('[data-pnc-cross-item]', crossBox).forEach(function (item) {
        var id = Number(item.getAttribute('data-variant'));
        var hide = !!inCart[id];
        item.hidden = hide;
        if (!hide) visible += 1;
      });
      crossBox.hidden = visible === 0;
    }

    /* ---------------- Modifications ---------------- */

    function changeLine(line, quantity) {
      busy(true);
      clearError();
      return fetch(config.cartChangeUrl + '.js', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ line: line, quantity: quantity })
      })
        .then(readJson)
        .then(function (data) {
          cart = data;
          render();
          document.dispatchEvent(new CustomEvent('pnc:updated', { bubbles: true, detail: data }));
        })
        .catch(function (error) {
          showError(error.message);
        })
        .then(function () {
          busy(false);
        });
    }

    /* Shopify ne sait pas changer la variante d'une ligne : on retire
       l'ancienne et on pose la nouvelle dans le même appel. */
    function swapVariant(oldId, newId, quantity) {
      var updates = {};
      updates[oldId] = 0;
      updates[newId] = quantity;

      busy(true);
      clearError();
      return fetch(config.cartUpdateUrl + '.js', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ updates: updates })
      })
        .then(readJson)
        .then(function (data) {
          cart = data;
          render();
        })
        .catch(function (error) {
          showError(error.message);
        })
        .then(function () {
          busy(false);
        });
    }

    function addVariant(id, quantity) {
      busy(true);
      clearError();
      return fetch(config.cartAddUrl + '.js', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ items: [{ id: id, quantity: quantity || 1 }] })
      })
        .then(readJson)
        .then(function () {
          return refresh();
        })
        .catch(function (error) {
          showError(error.message);
          busy(false);
        });
    }

    linesBox.addEventListener('click', function (event) {
      var row = event.target.closest('[data-pnc-line]');
      if (!row) return;
      var line = Number(row.getAttribute('data-line'));
      var qtyEl = $('[data-pnc-qty]', row);
      var quantity = qtyEl ? Number(qtyEl.textContent) || 1 : 1;

      if (event.target.closest('[data-pnc-line-remove]')) {
        changeLine(line, 0);
        return;
      }
      if (event.target.closest('[data-pnc-qty-minus]')) {
        if (quantity > 1) changeLine(line, quantity - 1);
        return;
      }
      if (event.target.closest('[data-pnc-qty-plus]')) {
        changeLine(line, quantity + 1);
        return;
      }

      var swapBtn = event.target.closest('[data-pnc-swap-open]');
      if (swapBtn) {
        openSwap(row, swapBtn);
      }
    });

    function openSwap(row, button) {
      var box = $('[data-pnc-swap]', row);
      if (!box) return;
      if (!box.hidden) {
        box.hidden = true;
        return;
      }

      var handle = button.getAttribute('data-handle');
      loadProduct(handle)
        .then(function (product) {
          buildSwap(box, row, product);
          box.hidden = false;
        })
        .catch(function (error) {
          showError(error.message);
        });
    }

    function loadProduct(handle) {
      if (productCache[handle]) return Promise.resolve(productCache[handle]);
      var base = config.rootUrl.replace(/\/$/, '');
      return fetch(base + '/products/' + handle + '.js', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin'
      })
        .then(readJson)
        .then(function (product) {
          productCache[handle] = product;
          return product;
        });
    }

    function buildSwap(box, row, product) {
      box.innerHTML = '';
      var currentId = Number(row.getAttribute('data-variant'));
      var current = null;
      product.variants.forEach(function (v) {
        if (v.id === currentId) current = v;
      });
      if (!current) current = product.variants[0];

      var chosen = current.options.slice();

      product.options.forEach(function (option, index) {
        var name = typeof option === 'string' ? option : option.name;
        var values = typeof option === 'string' ? optionValues(product, index) : option.values;

        var label = document.createElement('label');
        var span = document.createElement('span');
        span.textContent = name;
        var select = document.createElement('select');

        values.forEach(function (value) {
          var opt = document.createElement('option');
          opt.value = value;
          opt.textContent = value;
          if (chosen[index] === value) opt.selected = true;
          select.appendChild(opt);
        });

        select.addEventListener('change', function () {
          chosen[index] = select.value;
          var match = null;
          product.variants.forEach(function (v) {
            var same = true;
            chosen.forEach(function (value, i) {
              if (v.options[i] !== value) same = false;
            });
            if (same && !match) match = v;
          });
          if (!match || !match.available || match.id === currentId) return;
          var qtyEl = $('[data-pnc-qty]', row);
          swapVariant(currentId, match.id, qtyEl ? Number(qtyEl.textContent) || 1 : 1);
        });

        label.appendChild(span);
        label.appendChild(select);
        box.appendChild(label);
      });
    }

    /** Les anciennes réponses ne donnent que les noms d'options. */
    function optionValues(product, index) {
      var seen = [];
      product.variants.forEach(function (v) {
        var value = v.options[index];
        if (value && seen.indexOf(value) === -1) seen.push(value);
      });
      return seen;
    }

    if (crossBox) {
      crossBox.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-pnc-cross-add]');
        if (!btn || btn.classList.contains('is-loading')) return;
        btn.classList.add('is-loading');
        addVariant(Number(btn.getAttribute('data-pnc-cross-add')), 1).then(function () {
          btn.classList.remove('is-loading');
          btn.classList.add('is-done');
        });
      });
    }

    /* ---------------- Compte à rebours de l'offre ----------------
       L'échéance est posée une fois et gardée dans la session : rouvrir le
       panneau ne relance pas la minuterie, qui annoncerait sinon une urgence
       qui ne s'épuise jamais. */

    (function () {
      var timer = $('[data-pnc-timer]');
      if (!timer) return;
      var value = timer.querySelector('[data-pnc-timer-value]');
      var minutes = Number(timer.getAttribute('data-pnc-minutes')) || 0;
      if (!value || minutes <= 0) return;

      var KEY = 'pnc:offer-end';
      var end = 0;
      try {
        end = Number(window.sessionStorage.getItem(KEY)) || 0;
      } catch (e) {
        end = 0;
      }
      if (!end || end < Date.now()) {
        end = Date.now() + minutes * 60000;
        try {
          window.sessionStorage.setItem(KEY, String(end));
        } catch (e) {
          /* Navigation privée : la minuterie tient alors le temps de la page. */
        }
      }

      function tick() {
        var left = Math.max(0, Math.round((end - Date.now()) / 1000));
        if (left <= 0) {
          timer.hidden = true;
          window.clearInterval(handle);
          return;
        }
        var m = Math.floor(left / 60);
        var sec = left % 60;
        value.textContent = (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
        timer.hidden = false;
      }

      var handle = window.setInterval(tick, 1000);
      tick();
    })();

    /* ---------------- Jauge du carrousel ----------------
       La barre de défilement native est masquée : cette jauge la remplace,
       et dit en un coup d'œil combien de suggestions restent à droite. */

    (function () {
      var rail = $('.pnc__cross-rail');
      var bar = $('[data-pnc-cross-bar]');
      var fill = $('[data-pnc-cross-bar-fill]');
      if (!rail || !bar || !fill) return;

      function paint() {
        var visible = rail.clientWidth;
        var total = rail.scrollWidth;
        if (total <= visible + 1) {
          bar.hidden = true;
          return;
        }
        bar.hidden = false;
        var share = visible / total;
        fill.style.width = share * 100 + '%';
        var travel = rail.scrollLeft / (total - visible);
        fill.style.transform = 'translateX(' + travel * ((1 / share - 1) * 100) + '%)';
      }

      rail.addEventListener('scroll', paint, { passive: true });
      window.addEventListener('resize', paint);

      /* Au chargement, le panneau est encore masqué : le rail mesure zéro et
         la jauge se croirait inutile. Elle se recalcule donc dès que le rail
         prend sa taille, c'est-à-dire à la première ouverture. */
      if (typeof window.ResizeObserver === 'function') {
        new window.ResizeObserver(paint).observe(rail);
      } else {
        document.addEventListener('pnc:open', function () {
          window.setTimeout(paint, 60);
        });
      }

      paint();
    })();

    /* ---------------- Points d'entrée ---------------- */

    /* Le drapeau dit à l'appelant que quelqu'un a pris la main : sans lui,
       la section produit croirait qu'aucun tiroir n'existe et enverrait le
       client sur la page panier. */
    document.addEventListener('pnc:open', function (event) {
      if (event && event.detail) event.detail.handled = true;
      open();
    });
    document.addEventListener('pnc:refresh', function () {
      refresh();
    });

    /* Une marque sur <html> pour que les autres sections sachent, sans
       fouiller le DOM, qu'un panier coulissant est en place. */
    document.documentElement.setAttribute('data-pnc-drawer', '1');

    /* ---------------- Reprendre la main sur le panier du thème ----------------
       Beaucoup de thèmes — Horizon, Dawn et leurs dérivés — embarquent leur
       propre tiroir, câblé à leur icône panier et à leurs formulaires. Placer
       celui-ci ne le fait pas disparaître : les deux répondraient, et c'est
       souvent celui du thème qui gagne puisqu'il est déclaré plus haut dans
       la page. On le neutralise donc, en gardant l'élément en place pour ne
       rien casser de ce qui pourrait encore le référencer. */
    if (config.replaceThemeDrawer) {
      var takeOver = function () {
        var others = document.querySelectorAll(
          'cart-drawer, #cart-drawer, .cart-drawer, cart-notification, [data-cart-drawer]'
        );
        [].forEach.call(others, function (el) {
          if (el === root || root.contains(el) || el.contains(root)) return;
          if (el.dataset.pncTakenOver === '1') return;
          el.dataset.pncTakenOver = '1';

          /* Sa méthode d'ouverture devient la nôtre : tout ce qui pensait
             ouvrir le tiroir du thème ouvre celui-ci. */
          ['open', 'show', 'openDrawer'].forEach(function (name) {
            if (typeof el[name] === 'function') {
              el[name] = function () {
                open();
              };
            }
          });

          /* Et il ne doit plus rien peindre, même si le thème lui pose une
             classe « ouvert » de son côté. */
          el.setAttribute('hidden', '');
          el.style.setProperty('display', 'none', 'important');
        });
      };

      takeOver();
      /* Les thèmes qui montent leur tiroir après coup, ou le remontent via
         l'API de rendu de sections, sont rattrapés au vol. */
      if (window.MutationObserver) {
        new MutationObserver(takeOver).observe(document.documentElement, {
          childList: true,
          subtree: true
        });
      }
    }

    /* La section produit annonce ses ajouts : on se resynchronise, et on
       s'ouvre si le marchand l'a demandé. */
    document.addEventListener('hkf:cart-added', function () {
      if (config.openOnAdd) open();
      else refresh();
    });

    if (config.interceptLinks) {
      var cartPath = config.cartUrl.replace(/\/+$/, '');

      document.addEventListener('click', function (event) {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        var link = event.target.closest('a[href]');
        if (!link || link.hasAttribute('data-pnc-ignore')) return;
        if (link.target && link.target !== '_self') return;

        /* On compare des chemins, pas des chaînes brutes : l'en-tête d'un
           thème écrit souvent l'URL complète, et « https://.../cart » ne
           commence pas par « /cart ». */
        var url;
        try {
          url = new URL(link.href, window.location.href);
        } catch (e) {
          return;
        }
        if (url.origin !== window.location.origin) return;

        /* Égalité stricte : /cart/add et /cart/change ne sont pas la page. */
        if (url.pathname.replace(/\/+$/, '') !== cartPath) return;

        event.preventDefault();
        open();
      });
    }

    if (config.interceptForms) {
      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || form.tagName !== 'FORM') return;
        var action = form.getAttribute('action') || '';
        if (action.indexOf('/cart/add') === -1) return;
        if (form.hasAttribute('data-pnc-ignore')) return;

        event.preventDefault();
        var data = new FormData(form);
        busy(true);
        fetch(config.cartAddUrl + '.js', {
          method: 'POST',
          headers: { Accept: 'application/javascript' },
          credentials: 'same-origin',
          body: data
        })
          .then(readJson)
          .then(function () {
            if (config.openOnAdd) open();
            else refresh();
          })
          .catch(function (error) {
            showError(error.message);
          })
          .then(function () {
            busy(false);
          });
      });
    }

    /* Dans l'éditeur de thème, le panneau doit se montrer dès qu'on le
       sélectionne, sans quoi il serait impossible de le régler. */
    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:select', function (event) {
        if (event.detail && event.target && event.target.contains(root)) open();
      });
      document.addEventListener('shopify:section:deselect', function (event) {
        if (event.target && event.target.contains(root)) close();
      });
    }
  })();
</script>

